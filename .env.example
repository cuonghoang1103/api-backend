# ============================================================
# CuongHoangDev API - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# IMPORTANT: For PRODUCTION deployment, copy this to .env.production
# and use: docker-compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# QUAN TRONG: Cac bien MOI TRUONG can phai duoc dien day du truoc khi deploy

# ============================================================
# 1. SERVER
# ============================================================
PORT=3001
NODE_ENV=development

# ============================================================
# 2. DATABASE (PostgreSQL + pgvector)
# ============================================================
# Local development
DATABASE_URL="postgresql://postgres:123456@localhost:5433/cuonghoangdev_db?schema=public"

# PRODUCTION: Override in .env.production
# DATABASE_URL se duoc tu dong build trong docker-compose.prod.yml
# DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres-db:5432/cuonghoangdev_db?schema=public&sslmode=prefer

# ============================================================
# 3. JWT AUTHENTICATION
# ============================================================
# PRODUCTION: Dung openssl rand -base64 64 de tao secret ngau nhien
JWT_SECRET="<generate-with-openssl-rand-base64-64>"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_SECRET="<generate-with-openssl-rand-base64-64>"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================================
# 4. REDIS CACHE
# ============================================================
# Local development
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PRODUCTION: Override in .env.production
# REDIS_URL=redis://redis-cache:6379

# ============================================================
# 5. CORS & FRONTEND
# ============================================================
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,https://cuonghoangdev.com,https://*.vercel.app"

# ============================================================
# 6. SESSION & COOKIES
# ============================================================
# PRODUCTION: Dung openssl rand -base64 32 de tao secret ngau nhien
COOKIE_SECRET="<generate-with-openssl-rand-base64-32>"

# ============================================================
# 7. FILE UPLOAD
# ============================================================
MAX_FILE_SIZE_IMAGES=10485760
MAX_FILE_SIZE_AUDIO=104857600
MAX_FILE_SIZE_VIDEO=524288000
MAX_FILE_SIZE_DOCUMENT=73400320
UPLOAD_DIR="./uploads"

# ============================================================
# 8. RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ============================================================
# 9. ADMIN ACCOUNTS
# ============================================================
ADMIN_EMAILS="cuongthaihnhe176322@gmail.com"
ADMIN_USERNAME="admin"

# ============================================================
# 10. HUGGING FACE AI (DeepSeek R1)
# ============================================================
# Su dung OpenAI-compatible API cua Hugging Face
# Token: get from https://huggingface.co/settings/tokens
OPENROUTER_API_KEY="your-huggingface-token-here"

# ============================================================
# 11. YOUTUBE DATA API
# ============================================================
# Lay API key tai: https://console.cloud.google.com/apis/credentials
# Su dung YouTube Data API v3 de tim kiem video nhac
YOUTUBE_API_KEY="your-youtube-api-key-here"

# ============================================================
# 12. FFMPEG (Audio Processing)
# ============================================================
# FFmpeg binary path — leave empty to auto-detect from PATH.
# If running in Docker, mount the FFmpeg binary or use a base image with FFmpeg.
# FFMPEG_PATH="/usr/bin/ffmpeg"
FFMPEG_PATH=""
FFMPEG_TIMEOUT_MS=120000

# yt-dlp binary path for the "Download YouTube track to site" music feature
# (POST /music/tracks/:id/download-audio). Leave empty/unset to use `yt-dlp`
# from PATH — the Docker runtime installs it to /usr/local/bin/yt-dlp.
# YT_DLP_PATH="yt-dlp"

# ============================================================
# 13. AI CONFIG DEFAULTS
# ============================================================
AI_CHAT_MODEL="deepseek-ai/DeepSeek-R1-Distill-Qwen-32B"
AI_EMBEDDING_MODEL="gemini-embedding-002"
AI_EMBEDDING_DIMENSIONS=768
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
AI_CHUNK_SIZE=1000
AI_CHUNK_OVERLAP=200
AI_SIMILARITY_THRESHOLD=0.7

# ============================================================
# 12. OAUTH 2.0 (Google)
# ============================================================
# Lay OAuth credentials tai: https://console.cloud.google.com/
# Redirect URI: https://your-backend-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"

# ============================================================
# 13. OAUTH 2.0 (GitHub)
# ============================================================
# Register app tai: https://github.com/settings/applications/new
# Callback URL: https://your-backend-domain.com/api/auth/github/callback
GITHUB_CLIENT_ID="<your-github-oauth-app-client-id>"
GITHUB_CLIENT_SECRET="<your-github-oauth-app-client-secret>"

# ============================================================
# 14. EMAIL (for password reset, contact notifications)
# ============================================================
# Khuyen nghi: dung Gmail App Password hoac SendGrid/SES
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@cuonghoangdev.com"

# ─── Resend (RECOMMENDED for transactional email) ─────────
# Get API key: https://resend.com/api-keys (3,000 emails/month free)
# Verify your domain: https://resend.com/domains
# IMPORTANT: Resend requires a verified domain in production. For dev,
# you can use the sandbox sender onboarding@resend.dev (limited to your
# own verified email only).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CuongHoangDev <noreply@cuongthai.com>"

# ============================================================
# 15. CONTACT FORM
# ============================================================
CONTACT_ADMIN_EMAIL="cuongthaihnhe176322@gmail.com"

# ============================================================
# 16. PRODUCTION SECRETS (for docker-compose.prod.yml)
# ============================================================
# CHI DUNG TRONG .env.production - KHONG BAO GIO COMMIT FILE NAY LEN GITHUB!

# Mat khau PostgreSQL (docker-compose.prod.yml requires this)
# POSTGRES_PASSWORD="your_super_secure_postgres_password_here"

# Ma hoac passphrase cho JWT (ngan hon, dung openssl rand -hex 32)
# JWT_SECRET="your-production-jwt-secret-min-32-chars-here"
# JWT_REFRESH_SECRET="your-production-refresh-secret-min-32-chars-here"

# Cookie signing secret (dung openssl rand -base64 32)
# COOKIE_SECRET="your-production-cookie-secret-here"

# ============================================================
# 17. OPTIONAL: Debug
# ============================================================
# DEBUG_SQL="true"
# DEBUG_LOGGING="true"

# ─── Quota / Rate-limit per user (Mục #4) ───
QUOTA_PER_MINUTE=30
QUOTA_PER_DAY=500
QUOTA_PER_MONTH=10000

# ============================================================
# 18a. PAYOS PAYMENT (Course checkout — PRIMARY gateway)
# ============================================================
# Dang ky merchant tai: https://payos.vn  → tao Kenh thanh toan →
# lay Client ID, API Key, Checksum Key trong muc "Cong tich hop".
# Webhook URL (khai bao trong dashboard PayOS):
#   https://cuongthai.com/api/v1/payments/payos/webhook
PAYOS_CLIENT_ID="REPLACE_WITH_PAYOS_CLIENT_ID"
PAYOS_API_KEY="REPLACE_WITH_PAYOS_API_KEY"
PAYOS_CHECKSUM_KEY="REPLACE_WITH_PAYOS_CHECKSUM_KEY"

# ============================================================
# 18. VNPAY PAYMENT (Course checkout — secondary/fallback)
# ============================================================
# Dang ky sandbox tai: https://sandbox.vnpayment.vn/devreg
# Lay TMN_CODE va HASH_SECRET tu email sau khi dang ky.
# Production: doi sang https://pay.vnpayment.vn va lay credentials that.
VNPAY_TMN_CODE="REPLACE_WITH_SANDBOX_TMN_CODE"
VNPAY_HASH_SECRET="REPLACE_WITH_SANDBOX_HASH_SECRET"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
# URL ma VNPay redirect user ve sau khi thanh toan (frontend page)
VNPAY_RETURN_URL="https://cuongthai.com/payment/return"
# URL server-to-server IPN callback (backend xu ly)
VNPAY_IPN_URL="https://cuongthai.com/api/v1/payments/vnpay/ipn"
VNPAY_VERSION="2.1.0"
# Set =1 in dev/sandbox to skip the IP allowlist check (sandbox IPs
# are not in the production allowlist). MUST be 0/unset in production.
VNPAY_SANDBOX="1"
# Order TTL — pending orders older than this are considered expired
# and the user must create a new one. Default 15 minutes.
VNPAY_ORDER_TTL_MINUTES="15"
# Optional: override VNPay production IP allowlist (comma-separated CIDR).
# Default includes the most common ranges; extend if VNPay adds more.
# VNPAY_IP_ALLOWLIST="203.171.20.0/24,123.30.235.0/24"

# ============================================================
# 19. SENTRY (Error Tracking)
# ============================================================
# Get your DSN from: https://sentry.io/settings/.../projects/.../keys/
# When DSN is empty, Sentry is disabled and the app behaves exactly
# as before — no overhead, no network calls.
#
# Backend DSN (Node/Express):
SENTRY_DSN=""
# Frontend DSN (Next.js browser) — get a separate project for the
# frontend, or reuse the same DSN if you want events merged.
# (Read on the client as NEXT_PUBLIC_SENTRY_DSN.)
NEXT_PUBLIC_SENTRY_DSN=""

# Sample 10% of transactions. Lower = cheaper. Set 0 to disable perf
# monitoring but keep error capture.
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# Environment label (e.g. "production", "staging"). Defaults to NODE_ENV.
# SENTRY_ENVIRONMENT=""
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# Release identifier (e.g. git SHA). Helps correlate errors with deploys.
# SENTRY_RELEASE=""
# NEXT_PUBLIC_SENTRY_RELEASE=""


# ═══════════════════════════════════════════════════════════════
# CỔNG LLM — MỘT KHOÁ CHO CẢ WEB (modelapi.vn)
# ═══════════════════════════════════════════════════════════════
# Mọi tính năng AI (chat Pro/Max, phỏng vấn, My Language, Code Lab, CV
# Builder, Exp Hub, phòng thi, bản tin công nghệ, robot Maker Lab) đi qua
# ĐÚNG hai dòng dưới đây. Mã nguồn: src/services/llm/gateway.ts
#
# ⚠️ Cổng Rambo (LLM_BASE_URL + các model rb-*) ĐÃ HẾT HẠN. Thấy `rb-` ở
#    đâu là biết chỗ đó đang trỏ vào đường chết.
LLM_GATEWAY_BASE_URL=https://modelapi.vn/v1
LLM_GATEWAY_API_KEY=
# Hai tên cũ vẫn được đọc nếu hai dòng trên để trống (CV Builder / Jobs AI /
# robot đã cấu hình chúng từ trước): OPENAI_COMPAT_BASE_URL + OPENAI_COMPAT_API_KEY

# ── Phân model theo tính năng ──────────────────────────────────
# Mặc định đã hợp lý (xem PURPOSE_MODEL trong gateway.ts). Chỉ đặt biến khi
# muốn đổi, dạng LLM_MODEL_<TÊN VIỆC>:
#   LLM_MODEL_CHAT_PRO=claude-sonnet-5        AI Chat "CuongMini Pro"
#   LLM_MODEL_CHAT_MAX=claude-opus-5          AI Chat "CuongMini Max"
#   LLM_MODEL_INTERVIEW_GRADE=claude-sonnet-5 chấm từng câu trả lời
#   LLM_MODEL_INTERVIEW_REPORT=claude-opus-5  báo cáo tổng kết
#   LLM_MODEL_INTERVIEW_GENERATE=claude-opus-5
#   LLM_MODEL_LANGUAGE_TUTOR=claude-sonnet-5  LLM_MODEL_LANGUAGE_BULK=gpt-5.6-terra
#   LLM_MODEL_CODELAB_COACH=claude-sonnet-5   LLM_MODEL_CODELAB_BULK=gpt-5.6-terra
#   LLM_MODEL_CV_CRITIQUE=claude-opus-5       LLM_MODEL_CV_WRITING=claude-sonnet-5
#   LLM_MODEL_CV_PARSE=gpt-5.4-mini           LLM_MODEL_EXAM_GRADE=claude-sonnet-5
#   LLM_MODEL_EXPHUB_DOC=gpt-5.6-terra        LLM_MODEL_NEWS_BULLETIN=gpt-5.6-terra
#   LLM_MODEL_ROBOT_VOICE=gpt-5.6-terra       LLM_MODEL_CHAT_FREE_FALLBACK=gpt-5.4-mini
# Kiểm tra bằng:  npm run llm:check

# ── ĐỊNH TUYẾN LAI: việc nào chạy ở MÁY NHÀ (13/08/2026) ─────
# Máy nhà = RTX 3060 chạy Qwen3.5-9B qua llama.cpp, vào được từ VPS qua đường
# hầm ngược (172.18.0.1:18100 → 127.0.0.1:8100 ở nhà). Đo thật, cùng đề bài
# production của robot:  cổng 2.119–4.575 ms tới chữ đầu  ·  máy nhà 96–333 ms.
# Trọn một lượt gọi từ VPS xuyên hầm: 0,47–1,28 giây. Và KHÔNG TỐN TIỀN.
#
# Đổi lại: tiếng Việt 87% so với 93% của cổng (đo bằng câu có đáp án đúng/sai).
# Nên chỉ giao việc chịu được mức đó — KHÔNG giao chat_vision (9B nhìn ảnh sẽ
# bịa), cv_critique, interview_report, chat_max.
#
# ⚠️ THIẾU BẤT KỲ BIẾN NÀO ⇒ MỌI VIỆC ĐI CỔNG NHƯ CŨ. Đó là mặc định có chủ ý:
#    máy nhà mất điện hay mất mạng thì web vẫn chạy, chỉ chậm hơn và tốn tiền.
#    Robot còn có lưới đỡ ba tầng: máy nhà → cổng → Groq.
LLM_LOCAL_BASE_URL=
LLM_LOCAL_API_KEY=
# Danh sách việc, phân tách bằng dấu phẩy. Tên sai chính tả ⇒ việc đó im lặng
# đi cổng, không báo lỗi — nên xem lại ở GET /api/v1/ai/admin/llm-config, cột
# "noi" phải hiện "may-nha".
LLM_LOCAL_PURPOSES=
# Tên model máy nhà phục vụ. Bỏ trống = qwen3.5-9b-local.
LLM_LOCAL_MODEL=

# ── Xếp hàng trên máy nhà: robot được ưu tiên, web tràn sang cổng ──
#
# ⚠️ ĐÔNG NGƯỜI KHÔNG LÀM TRÀN VRAM — llama.cpp cấp phát KV cache một lần lúc
# khởi động rồi khoá cứng (đo 14/08/2026: 5.812 MiB đứng yên bất kể tải).
# Đông người làm DÀI HÀNG ĐỢI: 4 lượt cùng lúc xếp thành 3,36 · 6,72 · 10,11 ·
# 13,48 giây, vì `--parallel 1` chỉ có một luồng.
#
# Bỏ trống hết là đã có mặc định an toàn. Xem src/services/llm/hangDoi.ts.

# Số luồng máy nhà phục vụ song song. PHẢI KHỚP `--parallel` của llama-server —
# đặt cao hơn là tự dối mình, hàng đợi thả người vào rồi họ chờ ở tầng dưới.
LLM_LOCAL_SLOTS=1

# Hàng dài hơn ngần này thì người tới sau đi thẳng ra cổng, không nối đuôi.
# 0 = không bao giờ xếp hàng (máy rảnh thì vẫn dùng). Mặc định 1.
LLM_LOCAL_HANG_TOI_DA=

# Trần chờ của một lượt WEB (ms), mặc định 600.
# ⚠️ Máy nhà KHÔNG nhanh hơn cổng ở việc của web — 9B chạy 55 tok/s nên một
# câu 180 token mất 3,4s, còn cổng trả trong 1,3–2,4s. Máy nhà thắng ở chỗ
# MIỄN PHÍ. Nên trần này phải NHỎ hơn hẳn một lượt sinh: chờ đủ trần rồi vẫn
# phải đi cổng là kết cục tệ nhất (mất cả quãng chờ lẫn tiền).
LLM_LOCAL_CHO_MS=

# Trần chờ của ROBOT (ms), mặc định 8000. Ngược hẳn với web: robot được máy
# nhà trả trong 0,65s so với 4,2s của cổng, nên chờ gần như luôn đáng.
LLM_ROBOT_CHO_MS=

# ⭐ Sau mỗi lượt robot, máy nhà được GIỮ cho robot thêm ngần này (ms), mặc
# định 20000. Đây là thứ làm robot KHÔNG BAO GIỜ phải chờ: trong cửa sổ đó mọi
# lượt web đi thẳng ra cổng, không tranh slot. Xếp hàng ưu tiên một mình vẫn
# để robot chờ hết lượt đang chạy dở của người khác (3,4s) — không cắt ngang
# giữa chừng được, nên phải chặn từ cửa vào. 20s ≈ một nhịp nghe → nghĩ → nói
# → nghe tiếp. Đặt 0 để tắt.
LLM_ROBOT_GIU_MS=

# ── Việc AI CHẠY NỀN: mặc định TẮT HẾT (11/08/2026) ──────────
# Không có người ngồi chờ = không được tự tiêu tiền. Hai công tắc, đều phải
# BẬT RA MẶT mới chạy:
#   LLM_BACKGROUND_ENABLED  mọi lời gọi AI mang nhãn bulk_gen / news
#                           (các script scripts/*-bulk-gen.mjs đi lối này)
#   TECH_NEWS_AUTOPOST      riêng bản tin công nghệ 07:30 mỗi sáng
# Chạy một đợt sinh nội dung mà không bật cho cả máy:
#   docker exec -e LLM_BACKGROUND_ENABLED=true cuonghoangdev_backend node scripts/…
LLM_BACKGROUND_ENABLED=false

# ── Trần chi phí ngày (chốt chặn cuối, xem src/services/llm/budget.ts) ──
# MỀM: vượt → dừng việc chạy nền (sinh hàng loạt, bản tin sáng). Người dùng
# thật không bị ảnh hưởng. CỨNG: vượt → dừng tất. Đặt 0 để tắt.
LLM_DAILY_COST_SOFT_USD=15
LLM_DAILY_COST_HARD_USD=40
# Giá thật lấy từ Console của cổng (bảng mặc định chỉ là ước lượng theo giá
# niêm yết của nhà gốc). JSON: {"gpt-5.6-terra":{"in":0.6,"out":4}}
LLM_PRICE_OVERRIDES=

# ─── Agent lập trình của app desktop (CHỈ tài khoản Pro) ─────────
# Xem src/services/agent/quota.ts. BA dòng dưới đều có mặc định hợp lý — để
# trống hết thì tính năng vẫn chạy đúng, KHÔNG cần đặt gì trên VPS.
#
# Hạn mức token mỗi người, cửa sổ 5 giờ TRƯỢT (không reset theo mốc cố định).
# Đo thật 17/08/2026 trên mã nguồn thật: một việc 12 bước ≈ 141k token, một
# việc khó 22 bước ≈ 262k. Nên 4 triệu ≈ 15–28 việc mỗi 5 giờ. Đặt 0 = tắt trần.
AGENT_TOKEN_CAP=4000000
AGENT_WINDOW_HOURS=5
# Ví RIÊNG của agent, tính trên cả site mỗi ngày. Cạn thì CHỈ agent dừng —
# chat/chấm bài/CV của người khác vẫn chạy bằng phần ngân sách chưa ai đụng.
# Mặc định 20 = một nửa LLM_DAILY_COST_HARD_USD, nên phần còn lại của web luôn
# còn ít nhất 20 $ dư địa. ⚠️ 4 triệu token/5h ≈ 5 $/cửa sổ ≈ 25 $/ngày nếu MỘT
# người dùng cạn cả 4,8 cửa sổ — tức là không có dòng này thì một người dùng
# chăm chỉ đủ sức làm tắt AI của cả web.
AGENT_DAILY_COST_USD=20
# Ghim model riêng cho agent (mặc định gpt-5.6-sol — đo được là nhanh gấp 4 và
# tốn ít token gấp 9 so với gpt-5.5 ở việc GỌI TOOL, ngược hẳn với chat).
LLM_MODEL_AGENT_CODE=

# ─── Interview Simulator — LLM layer (Phase 4) ───────────────────
# Không có khoá cổng ở trên thì module chạy STATIC (tự đánh giá, không gọi
# LLM). Có khoá + DEFAULT_ENGINE_MODE=HYBRID thì bật AI chấm.
# LLM_PROVIDER: để trống = tuyến OpenAI của cổng (mặc định, đã chạy thật).
#               'anthropic' = ép tuyến /v1/messages của CÙNG cổng đó.
LLM_PROVIDER=
# ⚠️ Ba biến dưới là CÁCH CŨ (chỉ biết ba mức). Bản đồ LLM_MODEL_* ở trên chi
#    tiết hơn hẳn — để trống ba dòng này thì bản đồ mới có hiệu lực.
LLM_MODEL_INTERVIEW=
LLM_MODEL_REPORT=
LLM_MODEL_GENERATION=
DEFAULT_ENGINE_MODE=STATIC                # STATIC | HYBRID | FULL_AI (default when user doesn't pick)
FORCE_STATIC_MODE=false                   # kill switch: disable ALL LLM calls platform-wide
SCORE_REDFLAG_PENALTY=15                  # points deducted per factual red flag
SCORE_DISAGREEMENT_THRESHOLD=35           # flag a turn for review when Pass A vs AI diverge by this much
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3
# Trần token/người/ngày cho MỌI tính năng dùng lõi này (Language, Code Lab,
# Exp Hub, phòng thi, Voice Hub...). BỎ TRỐNG = 300.000/ngày, người Pro
# 1.000.000/ngày (code tự enforce). Đặt 0 = không giới hạn.
INTERVIEW_DAILY_TOKEN_CAP=
DRILL_DAILY_CARD_LIMIT=20

# ─── Interview Simulator — Voice / speech-to-text (Phase 9) ──────
# TTS (reading the question) is ALWAYS browser-side (free) — no config.
# STT (transcribing spoken answers): default is the browser (free, Chrome).
# Set STT_PROVIDER=groq to transcribe server-side with Groq Whisper — REUSES the
# existing GROQ_API_KEY (no new key/vendor). ~$0.02/hour of audio.
STT_PROVIDER=browser                      # browser | groq
GROQ_STT_MODEL=whisper-large-v3-turbo     # used when STT_PROVIDER=groq
STT_TIMEOUT_MS=30000

# ─────────────────────────────────────────────────────────────
# CV Builder — LLM layer (Phase 6). Keys live ONLY here (backend).
# Leave keys blank to run the whole module in STATIC mode (free tier,
# rules engine only) — everything degrades gracefully.
# ─────────────────────────────────────────────────────────────
# Model theo từng việc: mặc định lấy từ bản đồ LLM_MODEL_CV_* ở khối cổng LLM
# phía trên (critique = claude-opus-5, viết lách = claude-sonnet-5, tách JSON =
# gpt-5.4-mini). Ba dòng dưới chỉ để đè khi cần một model riêng cho CV.
LLM_MODEL_CRITIQUE=
LLM_MODEL_INTAKE=
LLM_MODEL_JD_PARSE=
LLM_MODEL_PARSE_FALLBACK=
LLM_MODEL_COVER_LETTER=
# Tuyến gọi cho từng việc: để trống = tuyến OpenAI của cổng.
# 'anthropic' = ép tuyến /v1/messages của CÙNG cổng.
LLM_PROVIDER_CRITIQUE=
LLM_PROVIDER_INTAKE=
LLM_PROVIDER_JD_PARSE=
LLM_PROVIDER_PARSE_FALLBACK=
LLM_PROVIDER_COVER_LETTER=

# Khoá: dùng chung LLM_GATEWAY_API_KEY ở khối cổng LLM phía trên. Hai tên dưới
# là cách viết cũ, vẫn được đọc nếu khoá mới để trống.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
# Set true ONLY if the configured endpoint's terms permit training on inputs —
# it then becomes disqualified for any task touching CV content (PII guard).
OPENAI_COMPAT_TRAINS_ON_INPUT=false

# Resilience
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=3
CIRCUIT_BREAKER_THRESHOLD=5
FORCE_STATIC_MODE=false

# Quotas — AI của CV Builder là Pro-only; thêm cap token/ngày để chặn chi phí.
# BỎ TRỐNG = mặc định 300000 token/ngày/user (code enforce). Đặt 0 = không giới hạn.
CV_DAILY_TOKEN_CAP=
CV_MONTHLY_TOKEN_CAP=
FREE_AI_REVIEWS_PER_MONTH=2

# ─── Tech Trends: AI news bulletin ───────────────────────────────
# Bản tin tự đăng 07:30 mỗi sáng — MẶC ĐỊNH TẮT từ 11/08/2026 (trước đó mặc
# định BẬT, nên một máy mới hoặc một biến bị quên là nó tự chạy và tự tính
# tiền). Đặt "true" để bật. Nút "chạy ngay" của admin luôn dùng được.
TECH_NEWS_AUTOPOST=false
# Which account the bulletin is published under (must be an admin user id).
TECH_NEWS_AUTHOR_ID=1

# ─── Mã hoá dữ liệu ở tầng ứng dụng (src/utils/crypto.ts) ────────
# Khoá AES-256 dùng để mã hoá dữ liệu nhạy cảm trước khi lưu DB
# (token bên thứ ba, số điện thoại, nội dung riêng tư...).
# BỎ TRỐNG = module vẫn import được nhưng gọi encrypt()/decrypt() sẽ báo lỗi rõ ràng;
# KHÔNG ảnh hưởng khởi động server (khoá được đọc lười, không đọc lúc import).
# Sinh khoá mới:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CẢNH BÁO: đổi khoá = mọi dữ liệu đã mã hoá bằng khoá cũ KHÔNG giải mã được nữa.
APP_ENCRYPTION_KEY=

# ─── Maker Lab (robot / embedded projects) ──────────────────
# Text-to-speech for the robot's voice. Providers, in fallback order:
#   google      free, no key — MẶC ĐỊNH (Edge trả 403 từ 07/08/2026)
#   edge        Microsoft read-aloud: giọng Việt hay nhất nhưng đang 403
#   openai      needs OPENAI_API_KEY
#   elevenlabs  needs ELEVENLABS_API_KEY — use this once you clone YOUR voice
MAKERLAB_TTS_PROVIDER=google
# Voice id/name for the chosen provider. Edge Vietnamese voices:
#   vi-VN-NamMinhNeural (nam) · vi-VN-HoaiMyNeural (nữ)
MAKERLAB_TTS_VOICE=vi-VN-NamMinhNeural
MAKERLAB_TTS_LANG=vi-VN
MAKERLAB_TTS_TIMEOUT_MS=20000
# Edge TTS: cần client token của Microsoft mới bật (bỏ trống = bỏ qua edge)
# MAKERLAB_EDGE_TOKEN=
# ElevenLabs — only needed when MAKERLAB_TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# MAKERLAB_ELEVEN_MODEL=eleven_flash_v2_5
# Bộ não. Với robot nói ra miệng thì độ trễ quan trọng ngang độ thông
# minh — mỗi 100 ms đều nghe ra được.
#
# compat (mặc định) = dùng lại cổng modelapi.vn đã cấu hình cho CV /
# Jobs qua OPENAI_COMPAT_BASE_URL + OPENAI_COMPAT_API_KEY. Không cần
# thêm khoá nào. Bỏ trống MAKERLAB_LLM_MODEL thì lấy gpt-5.6-terra.
#
# ⚠️ Cổng Rambo (LLM_BASE_URL, các model rb-*) ĐÃ HẾT HẠN — đừng trỏ
# robot về đó.
#
# MAKERLAB_LLM_PROVIDER=compat        # compat | groq | openai | custom
# MAKERLAB_LLM_MODEL=gpt-5.6-terra    # hoặc gpt-5.4-mini / deepseek-v4-flash cho rẻ+nhanh
# MAKERLAB_LLM_BASE_URL=              # chỉ khi provider=custom
# MAKERLAB_LLM_API_KEY=               # chỉ khi provider=custom

# Trần số lượt nói mỗi ngày mỗi thiết bị — chốt chặn chi phí khi có
# gì đó hỏng (VAD bắt nhầm tiếng phòng thì mỗi lượt là một lần gọi
# LLM + TTS). 0 = tắt trần. Mặc định 2000, rộng gấp nhiều lần mức
# dùng thật của một con robot để bàn.
# MAKERLAB_DAILY_TURN_CAP=2000
# Sensor history retention. Telemetry is the one table that grows with
# wall-clock time; the hourly cron prunes anything older than this.
MAKERLAB_TELEMETRY_RETENTION_DAYS=30

# ─── Máy đọc giọng riêng (F5-TTS trên máy nhà) ───────────────────────────────
# Với tới qua đường hầm ngược: 172.18.0.1:18092 → máy nhà 127.0.0.1:8092.
# Để trống cũng chạy — mã đã lấy đúng địa chỉ này làm mặc định.
# Máy nhà tắt thì nhóm giọng đó chỉ đơn giản KHÔNG hiện trong danh sách chọn,
# phần còn lại của máy đọc không ảnh hưởng.
F5_TTS_URL=http://172.18.0.1:18092
F5_TIMEOUT_MS=60000

# ── Cổng RIÊNG cho AI Code (agent lập trình) ──
# Chỉ đổi đường cho `agent_code`; chat/CV/bản tin vẫn đi cổng chung ở trên.
# ⚠️ Đường đúng của rambo KHÔNG phải gốc `/v1` mà là `/api/claude/v1` — gốc
# `/v1/models` trả 200 kể cả khi KHÔNG có khoá, nên đừng lấy nó làm bằng chứng.
# ⚠️ Cổng này KHÔNG tôn trọng `max_tokens` (đo 19/08/2026: đặt 24, trả 103).
AGENT_GATEWAY_BASE_URL=https://rambo.ai.vn/api/claude
AGENT_GATEWAY_API_KEY=
