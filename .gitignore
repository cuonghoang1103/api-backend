# Dependencies
node_modules/

# Build output
dist/

# Environment
.env
.env.local
.env.*.local

# Local-only seed scripts (with hardcoded credentials)
# Real seed logic is in scripts/seed-admin.cjs (CLI-driven)
scripts/seed-*user.cjs
scripts/seed-*.local.*

# Local test/scratch files (not for production)
test_socket.cjs
test_socket.js
*.local.cjs
# VPS info / credentials notes — contain plaintext root password
hoangappvps.txt
*.local.js

# Prisma
# Note: prisma/migrations/ is intentionally TRACKED. Migrations must be
# committed so that `prisma migrate deploy` works on fresh DBs and CI.
# (Previously this was ignored, which silently caused new migrations
# — e.g. 20260622_add_message_reply_support — to be missing from git.)

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Uploads (local dev) — only root uploads/, not frontend/src/app/uploads/
/uploads/

# SSL certs
nginx/ssl/
/opt/certbot/

# Backups
/opt/cuonghoangdev/backups/

# Sensitive backup files (credentials, secrets)
BACKUP*.txt
*CREDENTIALS*.txt
*BACKUP*.txt

# Docker
.dockerignore
!frontend/.dockerignore

# Legacy Java (Spring Boot - archived)
# src/main/java/
# src/main/resources/db/migration/
# pom.xml

# Build artifacts
bin/
target/
*.class
*.jar
frontend/tsconfig.tsbuildinfo

# Local backups
.env.bak-pre-rotation
*.env.bak
*.env.tmp

# Google service-account keys
# These JSON files contain a private key that grants
# programmatic access to Google APIs as the project's
# service account. If pushed to a public repo, anyone could
# impersonate the service account and (in this project's
# case) hit Google's Indexing API to index whatever URLs
# they wanted under the cuonghoang0311 quota.
#
# We block BOTH the explicit filenames AND the whole
# google-key pattern (catches google-key.json, google-
# key.prod.json, google-key.dev.json, etc.).
#
# The key file is copied into the production container
# out-of-band by the deploy script — see scripts/deploy-vps.sh.
frontend/src/config/google-key.json
frontend/src/config/google-key.*.json
**/google-key*.json
!frontend/src/config/.gitkeep

# Archived workflows and docs (kept on disk for reference, not in git)
.github/workflows-archive/
docs-archive/

# Next.js standalone build (not used by Docker, generated by `next build`)
frontend/.next/standalone/

# Next.js cache (regenerated on build)
frontend/.next/cache/
scratch/

# UI/UX Pro Max skill (uipro) — dev tooling, per-machine, not app code
.claude/skills/
content/exams/_work/

# Local AI tooling (Claude Code settings, vendored skills, skill lockfile).
# Machine-specific — settings.local.json holds per-machine permissions/paths,
# and .agents/.claude/skills are re-fetched by the tooling itself.
.claude/
.agents/
skills-lock.json

# Log của deploy.sh (ghi trên VPS, không đưa vào git)
.deploy-logs/

# Video mô phỏng dựng ra (nặng, không đưa vào git — xem scripts/sim-render.mjs)
_render/
# Mọi thư mục dựng video tạm (_render_lessons, _render_all…). Trước đây chỉ
# ignore '_render/' nên '_render10/' suýt bị commit — 11 MB mp4 vào lịch sử git.
_render*/

# Firmware secrets (device keys, WiFi passwords) — never commit
firmware/**/src/secrets.h
.pio/

# STL sinh ra được — chạy `node gen-stl.mjs ./stl` để tạo lại
firmware/**/shell/stl/

# Ảnh bìa dự án sinh bằng scripts/gen-project-covers.mjs — sinh lại được,
# và bản thật đã nằm trên R2 (media.cuongthai.com/images/projects/).
.covers/

# Thẻ bài học sinh bằng scripts/gen-lesson-card.mjs — sinh lại được từ
# content/lesson-cards/*.mjs, không cần lưu ảnh vào git.
.cards/
