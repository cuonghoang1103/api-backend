{
  "name": "ct-long-tieng",
  "productName": "CT Lồng Tiếng",
  "version": "0.1.0",
  "private": true,
  "description": "CT Lồng Tiếng — lồng tiếng Việt cho video kỹ thuật để tự học",
  "author": {
    "name": "CuongHoangDev",
    "email": "hoangnghiacuong0311@gmail.com"
  },
  "homepage": "https://cuongthai.com/long-tieng",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mock": "node scripts/dev.mjs --mock",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "vite build --config vite.main.config.ts --mode main && vite build --config vite.main.config.ts --mode preload",
    "start": "electron .",
    "start:mock": "electron . --mock",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "icon": "electron scripts/lam-icon.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "chup": "npm run build && node scripts/chup.mjs",
    "kiem-luong": "npm run build && node scripts/kiem-luong.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
