{
  "name": "labflow-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-reporter=spec",
    "api:lint": "redocly lint openapi/openapi.yaml && spectral lint openapi/openapi.yaml",
    "api:types": "openapi-typescript openapi/openapi.yaml -o client/labflow.d.ts",
    "api:docs": "redocly build-docs openapi/openapi.yaml -o docs/index.html",
    "api:mock": "prism mock openapi/openapi.yaml -p 4010",
    "api:diff": "node openapi/diff.mjs openapi/openapi-v2.3.0.yaml openapi/openapi.yaml",
    "api:drift": "node openapi/check-drift.mjs",
    "db:migrate": "node src/migrate.js",
    "db:status": "node src/migrate.js --status",
    "db:seed": "node src/seed-pg.js",
    "test:pg": "node src/seed-pg.js --reset && LABFLOW_STORE=pg LABFLOW_REDIS= node --test --test-concurrency=1 --test-reporter=spec",
    "worker": "node src/worker.js",
    "smoke": "node ops/smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bullmq": "6.3.16",
    "compression": "1.8.2",
    "express": "5.3.0",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.1",
    "redis": "5.12.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.4",
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "@redocly/cli": "2.72.1",
    "@stoplight/prism-cli": "5.14.2",
    "@stoplight/spectral-cli": "6.17.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autocannon": "8.0.0",
    "dataloader": "2.2.3",
    "graphql": "17.0.2",
    "graphql-http": "1.23.1",
    "openapi-diff": "0.24.1",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "protobufjs": "8.8.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
