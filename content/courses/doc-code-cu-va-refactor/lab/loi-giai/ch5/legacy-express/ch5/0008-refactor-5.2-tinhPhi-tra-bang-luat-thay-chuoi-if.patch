From ddfee8bd7eccf63984b4ae1a93062c3610342704 Mon Sep 17 00:00:00 2001
From: hocvien <hocvien@lab.local>
Date: Tue, 24 Nov 2026 04:35:56 +0700
Subject: [PATCH 08/11] refactor(5.2): tinhPhi tra bang luat thay chuoi if

---
 lib/phi.js | 13 +++----------
 1 file changed, 3 insertions(+), 10 deletions(-)

diff --git a/lib/phi.js b/lib/phi.js
index 0631a33..31e76d9 100644
--- a/lib/phi.js
+++ b/lib/phi.js
@@ -1,20 +1,13 @@
 // Tinh phi tre han — chep tu ben Java sang (Hung, 03/2018). "Giong het BookServlet".
 var moment = require('moment');
+var luatCua = require('./luat').luatCua;
 
 function tinhPhi(phieu, docGia) {
   var tre = moment().diff(moment(phieu.hanTra), 'days', true);
   tre = Math.ceil(tre);
   if (tre <= 0) return 0;
-  var phi = 0;
-  if (docGia.loai == 'SV') {
-    phi = tre * 2000;
-    if (phi > 50000) phi = 50000;
-  } else if (docGia.loai == 'GV') {
-    phi = tre * 1000;
-  } else {
-    phi = tre * 5000;
-  }
-  return phi;
+  var luat = luatCua(docGia.loai);
+  return Math.min(tre * luat.phiMotNgay, luat.phiToiDa);
 }
 
 module.exports = { tinhPhi: tinhPhi };
