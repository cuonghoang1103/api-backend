+++ b/lib/so-phieu.js
@@ -0,0 +1,44 @@
+// Sổ phiếu: bọc mảng phiếu đọc từ kho (Encapsulate Collection + Combine Functions into Class — bài 5.4).
+// Giữ phong cách ES5 của repo (var, function, prototype) — quy ước dự án, xem bài 8.1.
+var moment = require('moment');
+
+function SoPhieu(ds) {
+  this._ds = ds.slice();          // bản sao: không ai bên ngoài sửa được mảng bên trong
+}
+
+/** Bản sao để ghi ra kho hay trả cho client — push vào bản sao không làm đổi sổ. */
+SoPhieu.prototype.danhSach = function () {
+  return this._ds.slice();
+};
+
+SoPhieu.prototype.dangMuonCua = function (docGia) {
+  var n = 0;
+  for (var i = 0; i < this._ds.length; i++) {
+    if (this._ds[i].docGia == docGia.id && !this._ds[i].ngayTra) n++;
+  }
+  return n;
+};
+
+/** Phiếu chưa trả đầu tiên đã quá hạn của độc giả, hoặc null. */
+SoPhieu.prototype.quaHanDauTienCua = function (docGia) {
+  for (var i = 0; i < this._ds.length; i++) {
+    var p = this._ds[i];
+    if (p.docGia == docGia.id && !p.ngayTra && moment().diff(moment(p.hanTra), 'days', true) > 0) return p;
+  }
+  return null;
+};
+
+/** Thêm phiếu mới với id = id lớn nhất + 1; trả về phiếu vừa thêm. */
+SoPhieu.prototype.them = function (docGiaId, tenSach, ngayMuon, soNgay, nguoiTao, ghiChu) {
+  var id = 0;
+  for (var i = 0; i < this._ds.length; i++) if (this._ds[i].id > id) id = this._ds[i].id;
+  var p = {
+    id: id + 1, sach: tenSach, docGia: docGiaId,
+    hanTra: moment(ngayMuon).add(soNgay, 'days').format(), ngayTra: null,
+    nguoiTao: nguoiTao, ghiChu: ghiChu
+  };
+  this._ds.push(p);
+  return p;
+};
+
+module.exports = SoPhieu;
