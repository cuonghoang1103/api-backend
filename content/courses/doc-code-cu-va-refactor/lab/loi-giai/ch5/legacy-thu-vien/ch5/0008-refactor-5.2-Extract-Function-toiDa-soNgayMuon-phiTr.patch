+    // Ba luật theo loại độc giả — trước đây là ba chuỗi if rải trong muonSach/traSach (Repeated Switches, bài 4.3)
+    static int toiDa(String loai) {
+        if (loai.equals("SV")) {
+            return 3;
+        } else if (loai.equals("GV")) {
+            return 10;
+        } else {
+            return 1;
+        }
+    }
+
+    static int soNgayMuon(String loai) {
+        if (loai.equals("SV")) {
+            return 14;
+        } else if (loai.equals("GV")) {
+            return 30;
+        } else {
+            return 7;
+        }
+    }
+
+    static double phiTre(String loai, int soNgayTre) {
+        double phi = 0;
+        if (soNgayTre > 0) {
+            if (loai.equals("SV")) {
+                phi = soNgayTre * 2000;
+                if (phi > 50000) phi = 50000;
+            } else if (loai.equals("GV")) {
+                phi = soNgayTre * 1000;
+            } else {
+                phi = soNgayTre * 5000;
+            }
+        }
+        return phi;
+    }
+
     /** Seam thời gian (Extract and Override Call): test ghi đè hàm này để cố định "bây giờ". */
     protected long bayGio() {
         return System.currentTimeMillis();
