+package com.thuvien.model;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/** Test đơn vị cho luật theo loại — chạy trong mili giây, không cần CSDL hay mock servlet. */
+class LoaiDocGiaTest {
+
+    @Test
+    void docTuCotType() {
+        assertEquals(LoaiDocGia.SV, LoaiDocGia.tu("SV"));
+        assertEquals(LoaiDocGia.GV, LoaiDocGia.tu("GV"));
+        assertEquals(LoaiDocGia.KHACH, LoaiDocGia.tu("KHACH"));
+        assertEquals(LoaiDocGia.KHACH, LoaiDocGia.tu("sv"));      // giữ hành vi cũ: phân biệt hoa thường
+        assertEquals(LoaiDocGia.KHACH, LoaiDocGia.tu("NCS"));     // loại lạ rơi vào nhánh else
+        assertThrows(NullPointerException.class, () -> LoaiDocGia.tu(null));
+    }
+
+    @Test
+    void phiTre() {
+        assertEquals(18000.0, LoaiDocGia.SV.phiTre(9));
+        assertEquals(50000.0, LoaiDocGia.SV.phiTre(40));        // chạm trần
+        assertEquals(13000.0, LoaiDocGia.GV.phiTre(13));
+        assertEquals(130000.0, LoaiDocGia.KHACH.phiTre(26));    // không có trần
+        assertEquals(0.0, LoaiDocGia.SV.phiTre(0));
+        assertEquals(0.0, LoaiDocGia.KHACH.phiTre(-3));
+    }
+
+    @Test
+    void toiDaVaSoNgay() {
+        assertArrayEquals(new int[]{3, 10, 1}, new int[]{LoaiDocGia.SV.toiDa(), LoaiDocGia.GV.toiDa(), LoaiDocGia.KHACH.toiDa()});
+        assertArrayEquals(new int[]{14, 30, 7},
+                new int[]{LoaiDocGia.SV.soNgayMuon(), LoaiDocGia.GV.soNgayMuon(), LoaiDocGia.KHACH.soNgayMuon()});
+    }
+}
