             rs.close();
             long treMs = bayGio() - hanTra.getTime();
             int soNgayTre = (int) (treMs / MS_MOT_NGAY);
-            double phi = phiTre(loai, soNgayTre);
+            double phi = loai.phiTre(soNgayTre);
             ps = con.prepareStatement("UPDATE loans SET return_date = ?, fine = ? WHERE id = ?");
             ps.setTimestamp(1, new Timestamp(bayGio()));
             ps.setDouble(2, phi);
@@ -201,19 +201,6 @@ public class BookServlet extends HttpServlet {
         response.sendRedirect("books");
     }
 
