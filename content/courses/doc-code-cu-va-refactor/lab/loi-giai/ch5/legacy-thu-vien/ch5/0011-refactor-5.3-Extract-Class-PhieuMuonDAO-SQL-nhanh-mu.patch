+package com.thuvien.dao;
+
+import com.thuvien.model.LoaiDocGia;
+import com.thuvien.util.DBUtil;
+
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.sql.Statement;
+import java.sql.Timestamp;
+
+/**
+ * SQL của chức năng mượn/trả, chuyển nguyên văn từ BookServlet (Extract Class — bài 5.3).
+ * ⚠️ Các câu nối chuỗi được GIỮ NGUYÊN: đổi sang PreparedStatement là đổi hành vi (thông báo lỗi khác) — làm ở bài 6.3 với test riêng.
+ */
+public class PhieuMuonDAO {
+
+    private final Connection con;
+
+    public PhieuMuonDAO(Connection con) {
+        this.con = con;
+    }
+
+    /** Loại của độc giả, hoặc null nếu không có độc giả này. */
+    public LoaiDocGia loaiCuaDocGia(String readerId) throws SQLException {
+        Statement st = con.createStatement();
+        ResultSet rs = null;
+        try {
+            rs = st.executeQuery("SELECT * FROM readers WHERE id = " + readerId);
+            return rs.next() ? LoaiDocGia.tu(rs.getString("type")) : null;
+        } finally {
+            DBUtil.close(rs, st);
+        }
+    }
+
+    public int demDangMuon(String readerId) throws SQLException {
+        Statement st = con.createStatement();
+        ResultSet rs = null;
+        try {
+            rs = st.executeQuery("SELECT COUNT(*) FROM loans WHERE reader_id = " + readerId + " AND return_date IS NULL");
+            rs.next();
+            return rs.getInt(1);
+        } finally {
+            DBUtil.close(rs, st);
+        }
+    }
+
+    /** Giữ nguyên: không kiểm rs.next() ⇒ sách không tồn tại ném "Illegal operation on empty result set." (test bookIdKhongTonTai). */
+    public int soBanConLai(String bookId) throws SQLException {
+        Statement st = con.createStatement();
+        ResultSet rs = null;
+        try {
+            rs = st.executeQuery("SELECT available FROM books WHERE id = " + bookId);
+            rs.next();
+            return rs.getInt(1);
+        } finally {
+            DBUtil.close(rs, st);
+        }
+    }
+
+    public void themPhieu(int bookId, int readerId, Timestamp ngayMuon, Timestamp hanTra) throws SQLException {
+        PreparedStatement ps = con.prepareStatement("INSERT INTO loans(book_id, reader_id, borrow_date, due_date) VALUES (?, ?, ?, ?)");
+        try {
+            ps.setInt(1, bookId);
+            ps.setInt(2, readerId);
+            ps.setTimestamp(3, ngayMuon);
+            ps.setTimestamp(4, hanTra);
+            ps.executeUpdate();
+        } finally {
+            DBUtil.close(ps);
+        }
+    }
+}
