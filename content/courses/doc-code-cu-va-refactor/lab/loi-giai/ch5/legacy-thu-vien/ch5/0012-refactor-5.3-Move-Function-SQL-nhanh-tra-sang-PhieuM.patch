diff --git a/src/main/java/com/thuvien/dao/PhieuMuonDAO.java b/src/main/java/com/thuvien/dao/PhieuMuonDAO.java
index 13cc1be..10712fc 100644
--- a/src/main/java/com/thuvien/dao/PhieuMuonDAO.java
+++ b/src/main/java/com/thuvien/dao/PhieuMuonDAO.java
@@ -71,4 +71,51 @@ public class PhieuMuonDAO {
             DBUtil.close(ps);
         }
     }
+
+    /** Dữ liệu cần để trả một phiếu. */
+    public static class PhieuCanTra {
+        public final int bookId;
+        public final LoaiDocGia loai;
+        public final Timestamp hanTra;
+
+        PhieuCanTra(int bookId, LoaiDocGia loai, Timestamp hanTra) {
+            this.bookId = bookId;
+            this.loai = loai;
+            this.hanTra = hanTra;
+        }
+    }
+
+    /** null nếu không có phiếu. Giữ nguyên: KHÔNG lọc return_date IS NULL ⇒ trả lần hai vẫn tìm thấy (test traHaiLanCungMotPhieu). */
+    public PhieuCanTra timPhieuCanTra(String loanId) throws SQLException {
+        Statement st = con.createStatement();
+        ResultSet rs = null;
+        try {
+            rs = st.executeQuery("SELECT l.*, r.type FROM loans l JOIN readers r ON r.id = l.reader_id WHERE l.id = " + loanId);
+            if (!rs.next()) return null;
+            return new PhieuCanTra(rs.getInt("book_id"), LoaiDocGia.tu(rs.getString("type")), rs.getTimestamp("due_date"));
+        } finally {
+            DBUtil.close(rs, st);
+        }
+    }
+
+    public void ghiTra(int loanId, Timestamp ngayTra, double phi) throws SQLException {
+        PreparedStatement ps = con.prepareStatement("UPDATE loans SET return_date = ?, fine = ? WHERE id = ?");
+        try {
+            ps.setTimestamp(1, ngayTra);
+            ps.setDouble(2, phi);
+            ps.setInt(3, loanId);
+            ps.executeUpdate();
+        } finally {
+            DBUtil.close(ps);
+        }
+    }
+
+    public void congLaiSach(int bookId) throws SQLException {
+        Statement st = con.createStatement();
+        try {
+            st.executeUpdate("UPDATE books SET available = available + 1 WHERE id = " + bookId);
+        } finally {
+            DBUtil.close(st);
+        }
+    }
 }
