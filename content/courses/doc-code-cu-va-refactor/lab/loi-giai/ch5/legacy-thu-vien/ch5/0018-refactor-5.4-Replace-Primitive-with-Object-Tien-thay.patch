@@ -0,0 +1,57 @@
+package com.thuvien.model;
+
+/** Số tiền tính bằng đồng (VND không có đơn vị lẻ) — thay cho double (Replace Primitive with Object — bài 5.4). */
+public final class Tien {
+    public static final Tien KHONG = new Tien(0);
+
+    private final long dong;
+
+    private Tien(long dong) {
+        if (dong < 0) throw new IllegalArgumentException("Tiền âm: " + dong);
+        this.dong = dong;
+    }
+
+    public static Tien dong(long dong) {
+        return dong == 0 ? KHONG : new Tien(dong);
+    }
+
+    public long soDong() {
+        return dong;
+    }
+
+    public Tien nhan(int lan) {
+        return dong(dong * lan);
+    }
+
+    public Tien khongVuotQua(Tien tran) {
+        return dong <= tran.dong ? this : tran;
+    }
+
+    public boolean lonHonKhong() {
+        return dong > 0;
+    }
+
+    /**
+     * Cách in CŨ của double ("18000.0") — giữ để thông báo trả sách không đổi. Đổi sang toString() là đổi hành vi:
+     * làm ở ticket riêng (TV-97) cùng lúc sửa test đặc tả, không lẫn vào refactor này.
+     */
+    public String hienThiKieuCu() {
+        return String.valueOf((double) dong);
+    }
+
+    /** "18.000 đ" — dấu chấm ngăn nghìn kiểu Việt Nam, không phụ thuộc locale của máy chủ. */
+    @Override
+    public String toString() {
+        return String.format("%,d đ", dong).replace(',', '.');
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        return o instanceof Tien && ((Tien) o).dong == dong;
+    }
+
+    @Override
+    public int hashCode() {
+        return Long.hashCode(dong);
+    }
+}
