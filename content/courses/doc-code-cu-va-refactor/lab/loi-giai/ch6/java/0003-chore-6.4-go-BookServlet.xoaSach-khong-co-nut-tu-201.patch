+package com.thuvien.servlet;
+
+import com.thuvien.testutil.DuLieuTest;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+import javax.servlet.http.HttpSession;
+import java.io.PrintWriter;
+import java.io.StringWriter;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.mockito.Mockito.*;
+
+/** TV-104 (bài 6.4): action=delete không có nút nào từ 2016 và nối chuỗi SQL ⇒ gỡ. Khoá hành vi MỚI: coi như action lạ, không xoá gì. */
+class BookServletXoaSachTest {
+
+    @BeforeEach
+    void chuanBi() throws Exception {
+        DuLieuTest.napLai();
+    }
+
+    @Test
+    void actionDelete_khongConXoaDuoc_TV104() throws Exception {
+        HttpServletRequest req = mock(HttpServletRequest.class);
+        HttpServletResponse res = mock(HttpServletResponse.class);
+        HttpSession session = mock(HttpSession.class);
+        StringWriter body = new StringWriter();
+        when(req.getSession()).thenReturn(session);
+        when(session.getAttribute("user")).thenReturn("thuthu");
+        when(res.getWriter()).thenReturn(new PrintWriter(body, true));
+        when(req.getParameter("action")).thenReturn("delete");
+        when(req.getParameter("id")).thenReturn("0 OR id NOT IN (SELECT book_id FROM loans)");
+        int truoc = DuLieuTest.so("SELECT COUNT(*) FROM books");
+
+        new BookServlet().doPost(req, res);
+
+        assertEquals("<html><body><h3>Action khong hop le: delete</h3></body></html>", body.toString().trim());
+        assertEquals(truoc, DuLieuTest.so("SELECT COUNT(*) FROM books"));
+    }
+}
