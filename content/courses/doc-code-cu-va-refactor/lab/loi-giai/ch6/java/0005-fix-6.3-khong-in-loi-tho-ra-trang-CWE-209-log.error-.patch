@@ -123,8 +123,10 @@ class BookServletMuonSachTest {
 
     @Test
     void bookIdKhongTonTai() throws Exception {
-        // Không kiểm rs.next() ở câu SELECT available ⇒ JDBC ném lỗi, servlet in nguyên thông điệp
-        assertEquals("<html><body><h3>Loi: Illegal operation on empty result set.</h3></body></html>", muon("5", "99"));
+        // Không kiểm rs.next() ở câu SELECT available ⇒ JDBC ném lỗi. Bài 6.3 ĐỔI CÓ CHỦ ĐÍCH: trước đây in nguyên
+        // "Loi: Illegal operation on empty result set." — nay chỉ in mã tra cứu, chi tiết nằm trong log
+        String trang = muon("5", "99");
+        assertTrue(trang.matches("<html><body><h3>Loi he thong, vui long thu lai \\(ma loi [0-9a-f]{8}\\)</h3></body></html>"), trang);
     }
 
     @Test
