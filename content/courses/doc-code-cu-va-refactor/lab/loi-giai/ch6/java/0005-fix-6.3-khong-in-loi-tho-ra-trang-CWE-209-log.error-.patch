diff --git a/src/main/java/com/thuvien/servlet/BookServlet.java b/src/main/java/com/thuvien/servlet/BookServlet.java
index ff97579..c759569 100644
--- a/src/main/java/com/thuvien/servlet/BookServlet.java
+++ b/src/main/java/com/thuvien/servlet/BookServlet.java
@@ -20,6 +20,7 @@ import java.sql.ResultSet;
 import java.sql.Statement;
 import java.util.ArrayList;
 import java.util.List;
+import java.util.UUID;
 
 /**
  * Quan ly sach + muon/tra. (Tuan 2016, Hung sua 2017, Lan sua 2019)
@@ -90,9 +91,11 @@ public class BookServlet extends HttpServlet {
                 out.println("<html><body><h3>Action khong hop le: " + action + "</h3></body></html>");
             }
         } catch (Exception e) {
-            e.printStackTrace();
+            // Bài 6.3 (CWE-209): chi tiết lỗi vào log cho dev, người dùng chỉ thấy mã tra cứu
+            String maLoi = UUID.randomUUID().toString().substring(0, 8);
+            log.error("loi " + maLoi + " action=" + action, e);
             PrintWriter out = response.getWriter();
-            out.println("<html><body><h3>Loi: " + e.getMessage() + "</h3></body></html>");
+            out.println("<html><body><h3>Loi he thong, vui long thu lai (ma loi " + maLoi + ")</h3></body></html>");
         } finally {
             DBUtil.close(con);
         }
diff --git a/src/test/java/com/thuvien/servlet/BookServletMuonSachTest.java b/src/test/java/com/thuvien/servlet/BookServletMuonSachTest.java
index 6caeae8..6757437 100644
