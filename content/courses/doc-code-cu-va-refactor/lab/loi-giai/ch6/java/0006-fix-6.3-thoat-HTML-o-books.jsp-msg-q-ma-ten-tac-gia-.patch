+package com.thuvien.util;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class HtmlTest {
+
+    @Test
+    void thoatThe_vaNhay_giuChuViet() {
+        assertEquals("&lt;img src=x onerror=alert(1)&gt;", Html.thoat("<img src=x onerror=alert(1)>"));
+        assertEquals("&quot; onfocus=&quot;alert(1)", Html.thoat("\" onfocus=\"alert(1)"));
+        assertEquals("Lập trình Java &amp; &#39;Clean Code&#39;", Html.thoat("Lập trình Java & 'Clean Code'"));
+        assertEquals("", Html.thoat(null));
+        assertEquals("5", Html.thoat(5));
+    }
