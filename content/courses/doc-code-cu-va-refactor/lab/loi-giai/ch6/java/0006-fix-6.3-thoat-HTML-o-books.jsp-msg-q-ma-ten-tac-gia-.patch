+package com.thuvien.util;
+
+/**
+ * Thoát chữ trước khi in vào HTML (bài 6.3 — chống XSS). Chỉ đổi 5 ký tự có nghĩa trong HTML;
+ * KHÔNG dùng StringEscapeUtils.escapeHtml của commons-lang 2.6 vì nó đổi cả chữ Việt có dấu thành &#7889;… (trang vẫn
+ * hiện đúng nhưng golden master đổi từng byte và trang nặng thêm).
+ */
+public final class Html {
+
+    public static String thoat(Object giaTri) {
+        if (giaTri == null) return "";
+        String s = String.valueOf(giaTri);
+        StringBuilder sb = new StringBuilder(s.length() + 16);
+        for (int i = 0; i < s.length(); i++) {
+            char c = s.charAt(i);
+            switch (c) {
+                case '&': sb.append("&amp;"); break;
+                case '<': sb.append("&lt;"); break;
+                case '>': sb.append("&gt;"); break;
+                case '"': sb.append("&quot;"); break;
+                case '\'': sb.append("&#39;"); break;
+                default: sb.append(c);
+            }
+        }
+        return sb.toString();
+    }
+
+    private Html() { }
+}
