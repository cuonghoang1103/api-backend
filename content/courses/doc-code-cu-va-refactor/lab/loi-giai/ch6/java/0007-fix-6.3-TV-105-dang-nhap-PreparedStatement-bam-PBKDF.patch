+package com.thuvien.servlet;
+
+import com.thuvien.testutil.DuLieuTest;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import javax.servlet.RequestDispatcher;
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+import javax.servlet.http.HttpSession;
+
+import static org.mockito.Mockito.*;
+
+/** Đăng nhập bằng mật khẩu (LoginServlet.doPost) — bài 6.3 / TV-105. Cần CSDL lab. */
+class LoginServletMatKhauTest {
+
+    private final LoginServlet servlet = new LoginServlet();
+    private HttpServletRequest req;
+    private HttpServletResponse res;
+    private HttpSession session;
+
+    @BeforeAll
+    static void cotDuRong() throws Exception {
+        // migration của bài 6.3 (db/migrations/V6_3__mat_khau_bam.sql) — chạy lại nhiều lần vẫn được
+        DuLieuTest.chay("ALTER TABLE users MODIFY password VARCHAR(255) NOT NULL");
+    }
+
+    @BeforeEach
+    void chuanBi() throws Exception {
+        DuLieuTest.chay("UPDATE users SET password = 'admin123' WHERE username = 'admin'");   // như dump gốc: mật khẩu thô
+        req = mock(HttpServletRequest.class);
+        res = mock(HttpServletResponse.class);
+        session = mock(HttpSession.class);
+        when(req.getSession()).thenReturn(session);
+        when(req.getRequestDispatcher("login.jsp")).thenReturn(mock(RequestDispatcher.class));
+    }
+
+    private void dangNhap(String ten, String matKhau) throws Exception {
+        when(req.getParameter("username")).thenReturn(ten);
+        when(req.getParameter("password")).thenReturn(matKhau);
+        servlet.doPost(req, res);
+    }
+
+    @Test
+    void dungMatKhau_vao() throws Exception {
+        dangNhap("admin", "admin123");
+        verify(res).sendRedirect("books");
+        verify(session).setAttribute("user", "admin");
+    }
+
+    @Test
+    void saiMatKhau_oLaiTrangLogin() throws Exception {
+        dangNhap("admin", "admin12");
+        verify(res, never()).sendRedirect(anyString());
+        verify(req).setAttribute("error", "Sai tên đăng nhập hoặc mật khẩu");
+    }
+
+    @Test
+    void sqlInjection_khongVaoDuoc_TV105() throws Exception {
+        dangNhap("admin' -- ", "bat-ky");
+        verify(res, never()).sendRedirect(anyString());
+    }
+
+    @Test
+    void matKhauKhacChuHoa_khongVaoDuoc_TV105() throws Exception {
+        // code cũ: MySQL so bằng collation utf8_general_ci ⇒ "ADMIN123" và "admin123   " cũng vào. Đổi CÓ CHỦ ĐÍCH.
+        dangNhap("admin", "ADMIN123");
+        verify(res, never()).sendRedirect(anyString());
+    }
+
+    @Test
+    void sauLanDangNhapDau_matKhauDuocBam_TV105() throws Exception {
+        dangNhap("admin", "admin123");
+        org.junit.jupiter.api.Assertions.assertEquals(1,
+                DuLieuTest.so("SELECT COUNT(*) FROM users WHERE username = 'admin' AND password LIKE 'pbkdf2-sha256$600000$%'"));
+        dangNhap("admin", "admin123");   // lần hai: so với bản băm
+        verify(res, times(2)).sendRedirect("books");
+    }
+}
diff --git a/src/test/java/com/thuvien/util/MatKhauTest.java b/src/test/java/com/thuvien/util/MatKhauTest.java
new file mode 100644
index 0000000..4d1257a
--- /dev/null
+++ b/src/test/java/com/thuvien/util/MatKhauTest.java
@@ -0,0 +1,27 @@
+package com.thuvien.util;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+class MatKhauTest {
+
+    @Test
+    void bamHaiLan_khacNhau_vanKhop() {
+        String a = MatKhau.bam("123456"), b = MatKhau.bam("123456");
+        assertNotEquals(a, b);                       // muối ngẫu nhiên ⇒ hai người cùng mật khẩu không lộ nhau
+        assertTrue(a.startsWith("pbkdf2-sha256$600000$"));
+        assertTrue(MatKhau.khop("123456", a) && MatKhau.khop("123456", b));
+        assertFalse(MatKhau.khop("1234567", a));
+        assertFalse(MatKhau.nenBamLai(a));
+    }
+
+    @Test
+    void matKhauThoDoiCu_khopChinhXac_vaCanBamLai() {
+        assertTrue(MatKhau.khop("admin123", "admin123"));
+        assertFalse(MatKhau.khop("ADMIN123", "admin123"));
+        assertFalse(MatKhau.khop("admin123 ", "admin123"));
+        assertTrue(MatKhau.nenBamLai("admin123"));
+        assertFalse(MatKhau.khop(null, "admin123"));
+    }
+}
