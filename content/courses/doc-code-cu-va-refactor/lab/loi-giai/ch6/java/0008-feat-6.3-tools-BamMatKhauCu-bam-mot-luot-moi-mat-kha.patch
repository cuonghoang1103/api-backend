+package com.thuvien.tools;
+
+import com.thuvien.util.DBUtil;
+import com.thuvien.util.MatKhau;
+
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.Statement;
+
+/**
+ * Chạy MỘT LẦN sau migration V6_3 (bài 6.3): băm mọi mật khẩu còn lưu thô — kể cả tài khoản lâu không đăng nhập,
+ * thứ mà "nâng cấp dần khi đăng nhập" không bao giờ chạm tới. Chạy lại không đổi gì (đã băm thì bỏ qua).
+ */
+public final class BamMatKhauCu {
+
+    public static void main(String[] args) throws Exception {
+        int daBam = 0, boQua = 0;
+        try (Connection con = DBUtil.getConnection();
+             Statement st = con.createStatement();
+             ResultSet rs = st.executeQuery("SELECT id, username, password FROM users ORDER BY id");
+             PreparedStatement up = con.prepareStatement("UPDATE users SET password = ? WHERE id = ?")) {
+            while (rs.next()) {
+                if (!MatKhau.nenBamLai(rs.getString("password"))) { boQua++; continue; }
+                up.setString(1, MatKhau.bam(rs.getString("password")));
+                up.setInt(2, rs.getInt("id"));
+                up.executeUpdate();
+                daBam++;
+                System.out.println("da bam: " + rs.getString("username"));
+            }
+        }
+        System.out.println("xong: " + daBam + " tai khoan da bam, " + boQua + " bo qua (da bam tu truoc)");
+    }
+
+    private BamMatKhauCu() { }
+}
