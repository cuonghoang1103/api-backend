From b9292ac62121d364a0e1a2210cca8efe3af81bea Mon Sep 17 00:00:00 2001
From: Hoc Vien <hocvien@example.com>
Date: Tue, 24 Nov 2026 06:06:57 +0700
Subject: [PATCH 1/7] build(7.1): compiler 3.1 -> 3.13.0 (release=8), war 2.2
 -> 3.4.0, surefire 3.5.2, sourceEncoding UTF-8
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

JDK 8: 49 test xanh. JDK 17 (release 8): bien dich duoc, 7 test do NoClassDefFound
javax/xml/bind/DatatypeConverter — API co luc bien dich (ct.sym cua 8), mat luc chay (JEP 320).
---
 pom.xml | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/pom.xml b/pom.xml
index 8845cee..c9b04cd 100644
--- a/pom.xml
+++ b/pom.xml
@@ -17,8 +17,9 @@
 
   <properties>
     <pmd.boLuat>tools/smell-pmd.xml</pmd.boLuat>
-    <maven.compiler.source>1.8</maven.compiler.source>
-    <maven.compiler.target>1.8</maven.compiler.target>
+    <!-- Bài 7.1: release (cờ javac release) thay cho source/target — khoá cả API của JDK đích, không chỉ dạng bytecode -->
+    <maven.compiler.release>8</maven.compiler.release>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
   </properties>
 
   <dependencies>
@@ -95,12 +96,17 @@
       <plugin>
         <groupId>org.apache.maven.plugins</groupId>
         <artifactId>maven-compiler-plugin</artifactId>
-        <version>3.1</version>
+        <version>3.13.0</version>
       </plugin>
       <plugin>
         <groupId>org.apache.maven.plugins</groupId>
         <artifactId>maven-war-plugin</artifactId>
-        <version>2.2</version>
+        <version>3.4.0</version>
+      </plugin>
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-surefire-plugin</artifactId>
+        <version>3.5.2</version>
       </plugin>
       <plugin>
         <groupId>org.pitest</groupId>
-- 
