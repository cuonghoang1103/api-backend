 14 files changed, 66 insertions(+), 56 deletions(-)

diff --git a/Dockerfile b/Dockerfile
index dd8a08b..ce00f81 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,4 +1,4 @@
-# Bài 7.1: dựng bằng JDK 17, bytecode release 17 (mốc 2), chạy Tomcat 9 + JDK 17. Từ đây JDK 8 không chạy được WAR nữa.
+# Bài 7.5 (mốc 3): dựng bằng JDK 17, chạy Tomcat 10.1 + JDK 17 — jakarta.servlet (Jakarta EE 10).
 # Ảnh này do khoá học thêm vào (Mục 0.1) — dự án gốc không có Docker.
 FROM maven:3.9-eclipse-temurin-17 AS build
 WORKDIR /src
@@ -7,7 +7,7 @@ RUN mvn -q -B dependency:go-offline
 COPY src ./src
 RUN mvn -q -B package -DskipTests
 
-FROM tomcat:9.0-jdk17-temurin
+FROM tomcat:10.1-jdk17-temurin
 RUN rm -rf /usr/local/tomcat/webapps/*
 COPY --from=build /src/target/thuvien.war /usr/local/tomcat/webapps/thuvien.war
 EXPOSE 8080
