17 loi bien dich (javax.persistence/validation, @ConstructorBinding chi con cho ham dung).
Test dac ta bat: GET /api/sach/ 200 -> 404 (Spring 6 bo khop dau / cuoi) — giu ca hai duong co chu dich (TV-120).
migrator: bo use-new-id-generator-mappings, server.max-http-header-size -> max-http-request-header-size.
8 test xanh; HTTP giong buoc truoc.
---
 pom.xml                                              |  4 +---
 src/main/java/com/thuvien/api/Sach.java              | 10 +++++-----
 src/main/java/com/thuvien/api/SachController.java    |  5 +++--
 src/main/java/com/thuvien/api/SachMoi.java           |  4 ++--
 src/main/java/com/thuvien/api/ThuVienProperties.java |  2 --
 src/main/resources/application.properties            |  3 +--
 6 files changed, 12 insertions(+), 16 deletions(-)

diff --git a/pom.xml b/pom.xml
index 753a772..0ab2f87 100644
--- a/pom.xml
+++ b/pom.xml
@@ -7,7 +7,7 @@
   <parent>
     <groupId>org.springframework.boot</groupId>
     <artifactId>spring-boot-starter-parent</artifactId>
-    <version>2.7.18</version>
+    <version>3.0.13</version>
     <relativePath/>
   </parent>
   <groupId>com.thuvien</groupId>
@@ -15,8 +15,6 @@
   <version>1.4.0</version>
   <properties>
     <java.version>17</java.version>
