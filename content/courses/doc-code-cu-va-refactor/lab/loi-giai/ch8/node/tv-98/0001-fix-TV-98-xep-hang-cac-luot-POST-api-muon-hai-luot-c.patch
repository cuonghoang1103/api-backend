+++ b/__tests__/tuan-tu.test.js
@@ -0,0 +1,14 @@
+// TV-98, góp ý review: lượt xử lý ném lỗi đồng bộ không được làm treo hàng đợi
+const express = require('express');
+const request = require('supertest');
+const tuanTu = require("../lib/tuan-tu");
+
+test('lượt đầu ném lỗi đồng bộ ⇒ lượt sau vẫn được phục vụ', async () => {
+  const app = express();
+  let lan = 0;
+  app.post('/x', tuanTu((req, res) => { lan++; if (lan === 1) throw new Error('loi dong bo'); res.status(201).end(); }));
+  app.use((err, req, res, next) => res.status(500).end());
+  const dau = await request(app).post('/x').timeout(1000).catch((e) => ({ status: 'treo: ' + e.code }));
+  const sau = await request(app).post('/x').timeout(1000).catch((e) => ({ status: 'treo: ' + e.code }));
+  expect([dau.status, sau.status]).toEqual([500, 201]);
+});
diff --git a/lib/tuan-tu.js b/lib/tuan-tu.js
new file mode 100644
index 0000000..ba85c14
--- /dev/null
+++ b/lib/tuan-tu.js
@@ -0,0 +1,16 @@
+// TV-98: chay cac luot xu ly LAN LUOT trong mot tien trinh — luot sau bat dau khi luot truoc da tra loi xong.
+// Moi nhanh deu ket thuc res (finish), khach ngat giua chung (close), hoac nem loi dong bo (next(e) => Express tra 500).
+// KHONG bao ve khi chay nhieu tien trinh (cluster/PM2 -i) — xem phan rui ro cua PR.
+var hang = Promise.resolve();
+
+module.exports = function tuanTu(xuLy) {
+  return function (req, res, next) {
+    hang = hang.then(function () {
+      return new Promise(function (xong) {
+        res.on('finish', xong);
+        res.on('close', xong);
+        try { xuLy(req, res); } catch (e) { next(e); }
+      });
+    });
+  };
+};
