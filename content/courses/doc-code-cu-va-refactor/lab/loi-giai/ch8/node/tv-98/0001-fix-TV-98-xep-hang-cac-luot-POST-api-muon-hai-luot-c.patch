diff --git a/__tests__/muon.dong-thoi.test.js b/__tests__/muon.dong-thoi.test.js
new file mode 100644
index 0000000..5d32ca5
--- /dev/null
+++ b/__tests__/muon.dong-thoi.test.js
@@ -0,0 +1,30 @@
+// TV-98 "app báo tạo phiếu nhưng thủ thư không thấy": hai lượt mượn cùng lúc (test tái hiện của bài 5.5, nay commit cùng bản sửa)
+const fs = require('fs');
+const path = require('path');
+const request = require('supertest');
+const app = require('../app');
+
+const TEP = path.join(__dirname, '..', 'data', 'phieu.json');
+const GOC = fs.readFileSync(TEP, 'utf8');
+const muon = (body) => request(app).post('/api/muon').send(body);
+
+beforeEach(() => fs.writeFileSync(TEP, GOC));
+afterAll(() => fs.writeFileSync(TEP, GOC));
+
+test('hai lượt mượn đồng thời ⇒ hai phiếu khác id, tệp có 7 phiếu', async () => {
+  const [a, b] = await Promise.all([
+    muon({ docGia: 2, sach: 'Refactoring' }),
+    muon({ docGia: 3, sach: 'Clean Architecture' }),
+  ]);
+  expect([a.status, b.status]).toEqual([201, 201]);
+  expect([a.body.phieu, b.body.phieu].sort()).toEqual([6, 7]);
+  expect(JSON.parse(fs.readFileSync(TEP, 'utf8'))).toHaveLength(7);
+});
+
+test('năm lượt đồng thời, có lượt bị từ chối ⇒ mọi lượt 201 đều nằm trong tệp', async () => {
+  const kq = await Promise.all([2, 3, 2, 3, 99].map((d, i) => muon({ docGia: d, sach: 'Sach ' + i })));
+  const ds = JSON.parse(fs.readFileSync(TEP, 'utf8'));
+  const daTao = kq.filter((r) => r.status === 201).map((r) => r.body.phieu);
+  expect(daTao.every((id) => ds.some((p) => p.id === id))).toBe(true);
+  expect(ds).toHaveLength(5 + daTao.length);
+});
diff --git a/__tests__/tuan-tu.test.js b/__tests__/tuan-tu.test.js
