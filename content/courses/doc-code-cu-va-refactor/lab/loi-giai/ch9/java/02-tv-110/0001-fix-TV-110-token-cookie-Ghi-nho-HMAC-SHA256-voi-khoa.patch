diff --git a/src/main/java/com/thuvien/servlet/LoginServlet.java b/src/main/java/com/thuvien/servlet/LoginServlet.java
index 77e1810..46a73e4 100644
--- a/src/main/java/com/thuvien/servlet/LoginServlet.java
+++ b/src/main/java/com/thuvien/servlet/LoginServlet.java
@@ -47,7 +47,7 @@ public class LoginServlet extends HttpServlet {
             if (!c.getName().equals("remember")) continue;
             String[] phan = c.getValue().split(":", -1);   // TV-96: đúng "ten:token" — thiếu token hay thừa đuôi đều bỏ qua
             if (phan.length != 2) continue;
-            if (TokenUtil.makeToken(phan[0]).equals(phan[1])) return phan[0];
+            if (TokenUtil.khop(phan[0], phan[1])) return phan[0];   // TV-110: HMAC, so thoi gian khong doi
         }
         return null;
     }
@@ -69,9 +69,10 @@ public class LoginServlet extends HttpServlet {
                 if (MatKhau.nenBamLai(rs.getString("password"))) bamLai(con, rs.getInt("id"), p);
                 request.getSession().setAttribute(Constants.SESSION_USER, rs.getString("username"));
                 request.getSession().setAttribute("role", rs.getString("role"));
-                if (request.getParameter("remember") != null) {
+                if (request.getParameter("remember") != null && TokenUtil.batGhiNho()) {   // TV-110: chua cau hinh khoa ⇒ khong phat cookie
                     Cookie c = new Cookie("remember", rs.getString("username") + ":" + TokenUtil.makeToken(rs.getString("username")));
                     c.setMaxAge(60 * 60 * 24 * 30);
+                    c.setHttpOnly(true);   // TV-110: JavaScript (XSS) khong doc duoc cookie
