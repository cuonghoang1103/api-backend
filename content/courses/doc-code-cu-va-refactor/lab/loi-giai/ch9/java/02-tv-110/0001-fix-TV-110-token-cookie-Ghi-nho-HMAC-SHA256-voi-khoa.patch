diff --git a/src/main/java/com/thuvien/util/TokenUtil.java b/src/main/java/com/thuvien/util/TokenUtil.java
index 065fcaf..975b345 100644
--- a/src/main/java/com/thuvien/util/TokenUtil.java
+++ b/src/main/java/com/thuvien/util/TokenUtil.java
@@ -1,21 +1,47 @@
 package com.thuvien.util;
 
-import java.security.MessageDigest;
 import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
 import java.util.HexFormat;
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
 
 /**
- * Token cho cookie "ghi nho dang nhap". MD5 cua username + "thuvien2016".
+ * Token cho cookie "ghi nho dang nhap" = HMAC-SHA256(khoa, username), khoa lay tu bien moi truong THUVIEN_REMEMBER_KEY
+ * (hoac -Dthuvien.remember.key). TV-110: truoc day la MD5(username + "thuvien2016") — ai doc duoc ma nguon deu tu duc duoc cookie admin.
+ * Khong co khoa (hoac khoa ngan hon 32 ky tu) ⇒ tat "ghi nho": makeToken tra null, khop luon false.
+ * Doi khoa = moi cookie cu het hieu luc (cach thu hoi duy nhat hien co — xem TV-123).
  */
 public class TokenUtil {
 
+    static final int DO_DAI_KHOA_TOI_THIEU = 32;
+
+    static String khoa() {
+        String k = System.getProperty("thuvien.remember.key", System.getenv("THUVIEN_REMEMBER_KEY"));
+        return k != null && k.length() >= DO_DAI_KHOA_TOI_THIEU ? k : null;
+    }
+
+    public static boolean batGhiNho() {
+        return khoa() != null;
+    }
+
+    /** null neu chua cau hinh khoa. */
     public static String makeToken(String username) {
+        String k = khoa();
+        if (k == null) return null;
         try {
-            MessageDigest md = MessageDigest.getInstance("MD5");
-            byte[] b = md.digest((username + "thuvien2016").getBytes(StandardCharsets.UTF_8));
-            return HexFormat.of().formatHex(b);
+            Mac mac = Mac.getInstance("HmacSHA256");
+            mac.init(new SecretKeySpec(k.getBytes(StandardCharsets.UTF_8), "HmacSHA256"));
+            return HexFormat.of().formatHex(mac.doFinal(username.getBytes(StandardCharsets.UTF_8)));
         } catch (Exception e) {
-            return "";
+            throw new IllegalStateException("khong tao duoc HMAC-SHA256", e);
         }
     }
+
+    /** So token trong thoi gian khong doi (MessageDigest.isEqual) — khong lo so ky tu dung qua thoi gian tra loi. */
+    public static boolean khop(String username, String token) {
+        String dung = makeToken(username);
+        return dung != null && token != null
+                && MessageDigest.isEqual(dung.getBytes(StandardCharsets.US_ASCII), token.getBytes(StandardCharsets.US_ASCII));
+    }
 }
diff --git a/src/test/java/com/thuvien/servlet/LoginServletCookieTest.java b/src/test/java/com/thuvien/servlet/LoginServletCookieTest.java
index b32b9d2..5cc0008 100644
--- a/src/test/java/com/thuvien/servlet/LoginServletCookieTest.java
+++ b/src/test/java/com/thuvien/servlet/LoginServletCookieTest.java
@@ -1,6 +1,8 @@
 package com.thuvien.servlet;
 
 import com.thuvien.util.TokenUtil;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
 import org.junit.jupiter.api.BeforeEach;
 import org.junit.jupiter.api.Test;
 
@@ -21,6 +23,16 @@ class LoginServletCookieTest {
     private HttpSession session;
     private RequestDispatcher trangLogin;
 
+    @BeforeAll
+    static void datKhoa() {
+        System.setProperty("thuvien.remember.key", "khoa-thu-chi-dung-cho-test-0123456789abcdef");   // TV-110
+    }
+
+    @AfterAll
+    static void xoaKhoa() {
+        System.clearProperty("thuvien.remember.key");
+    }
+
     @BeforeEach
     void chuanBi() {
         req = mock(HttpServletRequest.class);
@@ -83,4 +95,24 @@ class LoginServletCookieTest {
         voiCookie(new Cookie("remember", "admin:"));
         verify(trangLogin).forward(req, res);
     }
+
+    @Test
+    void cookieDucTuBiMatCu_khongConDangNhap_TV110() throws Exception {
+        // md5("admin" + "thuvien2016") — cookie admin ai doc ma nguon cung tu duc duoc (bai 8.5: 302 /books)
+        voiCookie(new Cookie("remember", "admin:a316eabce65f3759e1ce2d96db99486c"));
+        verify(trangLogin).forward(req, res);
+        verify(session, never()).setAttribute(anyString(), any());
+    }
+
+    @Test
+    void chuaCauHinhKhoa_cookieNaoCungBiBoQua_TV110() throws Exception {
+        String dung = "thuthu:" + TokenUtil.makeToken("thuthu");
+        System.clearProperty("thuvien.remember.key");
+        try {
+            voiCookie(new Cookie("remember", dung));
+            verify(trangLogin).forward(req, res);
+        } finally {
+            datKhoa();
+        }
+    }
 }
diff --git a/src/test/java/com/thuvien/util/TokenUtilDacTaTest.java b/src/test/java/com/thuvien/util/TokenUtilDacTaTest.java
index 763423b..69c7577 100644
--- a/src/test/java/com/thuvien/util/TokenUtilDacTaTest.java
+++ b/src/test/java/com/thuvien/util/TokenUtilDacTaTest.java
@@ -1,14 +1,38 @@
 package com.thuvien.util;
 
+import org.junit.jupiter.api.AfterEach;
 import org.junit.jupiter.api.Test;
 
 import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
 
+/** TV-110: token = HMAC-SHA256(khoa, username). Gia tri mong doi tinh bang cong cu KHAC (openssl), khong chep tu chinh code. */
 class TokenUtilDacTaTest {
 
+    static final String KHOA_TEST = "khoa-thu-chi-dung-cho-test-0123456789abcdef";
+
+    @AfterEach
+    void xoaKhoa() {
+        System.clearProperty("thuvien.remember.key");
+    }
+
+    @Test
+    void tokenCuaAdmin_laHmacSha256_TV110() {
+        // printf 'admin' | openssl dgst -sha256 -hmac 'khoa-thu-chi-dung-cho-test-0123456789abcdef'
+        System.setProperty("thuvien.remember.key", KHOA_TEST);
+        assertEquals("8300c6842be45044399efd0b703567fb317e6e90539c193fa9d5cfeb54cbc6a0", TokenUtil.makeToken("admin"));
+    }
+
+    @Test
+    void khongConLaMd5BiMatVietCung_TV110() {
+        System.setProperty("thuvien.remember.key", KHOA_TEST);
+        assertNotEquals("a316eabce65f3759e1ce2d96db99486c", TokenUtil.makeToken("admin"));   // MD5("admin" + "thuvien2016")
+    }
+
     @Test
-    void tokenCuaAdmin() {
-        // Đặc tả hành vi HIỆN TẠI (MD5 của username + "thuvien2016") — không phải hành vi đúng
-        assertEquals("a316eabce65f3759e1ce2d96db99486c", TokenUtil.makeToken("admin"));
+    void khoaNganHon32KyTu_tatGhiNho_TV110() {
+        System.setProperty("thuvien.remember.key", "thuvien2016");
+        assertNull(TokenUtil.makeToken("admin"));
     }
 }
