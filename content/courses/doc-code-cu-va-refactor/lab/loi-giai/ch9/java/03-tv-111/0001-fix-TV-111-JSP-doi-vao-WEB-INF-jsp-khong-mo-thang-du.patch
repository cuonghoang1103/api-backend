diff --git a/e2e/src/test/java/com/thuvien/e2e/MuonSachQuaHttpTest.java b/e2e/src/test/java/com/thuvien/e2e/MuonSachQuaHttpTest.java
index ade918e..b2485c7 100644
--- a/e2e/src/test/java/com/thuvien/e2e/MuonSachQuaHttpTest.java
+++ b/e2e/src/test/java/com/thuvien/e2e/MuonSachQuaHttpTest.java
@@ -112,12 +112,20 @@ class MuonSachQuaHttpTest {
     }
 
     @Test
-    void moThangJsp_khongCanDangNhap() throws Exception {
+    void moThangJsp_khongConMoDuoc_TV111() throws Exception {
         http = HttpClient.newHttpClient();                   // khách lạ, không cookie
-        HttpResponse<String> sach = get("books.jsp");
-        assertEquals(500, sach.statusCode());                // rủi ro trong bản đồ chương 2 (JSP mở thẳng — TV-111, chưa sửa)
-        assertTrue(sach.body().matches("(?s).*\\(ma loi [0-9a-f]{8}\\).*"));   // TV-109: chỉ còn mã tra cứu
-        assertFalse(sach.body().contains("Exception"));     // trước TV-109: JasperException + 31 dòng stack trace + mã nguồn JSP
-        assertEquals(200, get("report.jsp").statusCode());   // report.jsp hiện được cho người lạ
+        // trước TV-111: books.jsp 500 (sau TV-109 chỉ còn mã lỗi), report.jsp 200 — bản đồ rủi ro chương 2
+        for (String jsp : new String[] {"books.jsp", "readers.jsp", "report.jsp", "header.jsp", "login.jsp", "error.jsp", "WEB-INF/jsp/books.jsp"}) {
+            assertEquals(404, get(jsp).statusCode(), jsp);
+        }
+        assertEquals(302, get("books").statusCode());        // qua servlet thì vẫn bị đưa về trang đăng nhập
+    }
+
+    @Test
+    void trangLoiVanChiHienMaTraCuu_TV109() throws Exception {
+        HttpResponse<String> r = get("report?days=abc");    // NumberFormatException không ai bắt ⇒ 500 ⇒ error-page (nay ở WEB-INF/jsp)
+        assertEquals(500, r.statusCode());
+        assertTrue(r.body().matches("(?s).*\\(ma loi [0-9a-f]{8}\\).*"));
+        assertFalse(r.body().contains("Exception"));
     }
 }
