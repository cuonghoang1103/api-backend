Subject: [PATCH] fix(TV-113): ghi tra + cong lai sach trong mot giao dich (loi
 giua hai cau thi rollback ca hai)

---
 .../java/com/thuvien/dao/PhieuMuonDAO.java    | 21 +++++++++++++++++
 .../com/thuvien/service/MuonTraService.java   |  5 ++--
 .../thuvien/service/MuonTraServiceTest.java   |  8 +++----
 .../servlet/BookServletTraSachTest.java       | 23 +++++++++++++++++++
 4 files changed, 50 insertions(+), 7 deletions(-)

diff --git a/src/main/java/com/thuvien/dao/PhieuMuonDAO.java b/src/main/java/com/thuvien/dao/PhieuMuonDAO.java
index f895f31..9a35a80 100644
--- a/src/main/java/com/thuvien/dao/PhieuMuonDAO.java
+++ b/src/main/java/com/thuvien/dao/PhieuMuonDAO.java
@@ -128,6 +128,27 @@ public class PhieuMuonDAO {
         }
     }
 
+    /**
+     * TV-113: ghi trả + cộng lại sách trong MỘT giao dịch. Trước đây hai câu UPDATE chạy autocommit riêng lẻ:
+     * câu thứ hai lỗi (mất kết nối, khoá chờ quá hạn…) ⇒ phiếu đã "trả" mà sách không về kho — lệch vĩnh viễn.
+     * Trả 0 (phiếu đã trả trước đó — TV-108) thì không cộng sách. Lỗi ⇒ rollback cả hai rồi ném lại.
+     */
+    public int traPhieu(int loanId, int bookId, Timestamp ngayTra, Tien phi) throws SQLException {
+        boolean tuDongCu = con.getAutoCommit();
+        con.setAutoCommit(false);
+        try {
+            int soDong = ghiTra(loanId, ngayTra, phi);
+            if (soDong == 1) congLaiSach(bookId);
+            con.commit();
+            return soDong;
+        } catch (SQLException | RuntimeException e) {
+            con.rollback();
+            throw e;
+        } finally {
+            con.setAutoCommit(tuDongCu);
+        }
+    }
+
     public void congLaiSach(int bookId) throws SQLException {
         PreparedStatement st = con.prepareStatement("UPDATE books SET available = available + 1 WHERE id = ?");
         try {
diff --git a/src/main/java/com/thuvien/service/MuonTraService.java b/src/main/java/com/thuvien/service/MuonTraService.java
index fa9022c..46540e2 100644
--- a/src/main/java/com/thuvien/service/MuonTraService.java
+++ b/src/main/java/com/thuvien/service/MuonTraService.java
@@ -44,8 +44,9 @@ public class MuonTraService {
         PhieuMuonDAO.PhieuCanTra phieu = dao.timPhieuCanTra(loanId);
         if (phieu == null) return new KetQua("readers", "Không tìm thấy phiếu mượn", false);
         Tien phi = phieu.phiTre(bayGio.getAsLong());
-        if (dao.ghiTra(loanId, new Timestamp(bayGio.getAsLong()), phi) == 0) return new KetQua("readers", "Phiếu này đã trả rồi", false);
-        dao.congLaiSach(phieu.bookId);
+        if (dao.traPhieu(loanId, phieu.bookId, new Timestamp(bayGio.getAsLong()), phi) == 0) {   // TV-113: một giao dịch
+            return new KetQua("readers", "Phiếu này đã trả rồi", false);
+        }
         return new KetQua("readers", phi.lonHonKhong() ? "Trả sách. Phí trễ hạn: " + phi.hienThiKieuCu() : "Trả sách thành công", true);
     }
 
