+
+    @Test
+    void nghienCuuSinh_muonToiDa5Cuon_han21Ngay_TV95() throws Exception {
+        // Đi hết đường thật: cột readers.type → LoaiDocGia.tu → luật → INSERT + trigger (không chỉ test enum)
+        DuLieuTest.chay("INSERT INTO readers (id, name, type, phone) VALUES (6, 'Vũ Thị Ngọc', 'NCS', '0901000006')");
+        for (String sach : new String[] {"1", "2", "3", "4", "6"}) {
+            assertEquals("books?msg=Mượn thành công", muon("6", sach), "sách " + sach);
+        }
+        assertEquals("books?msg=Vượt quá số sách được mượn", muon("6", "7"));   // cuốn thứ 6
+        assertEquals(5, DuLieuTest.so("SELECT COUNT(*) FROM loans WHERE reader_id = 6 AND return_date IS NULL"));
+        assertEquals(21, DuLieuTest.so("SELECT DATEDIFF(due_date, borrow_date) FROM loans WHERE reader_id = 6 AND book_id = 1"));
+    }
