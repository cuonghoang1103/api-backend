+package com.thuvien.dao;
+
+import com.thuvien.model.Loan;
+import com.thuvien.model.Reader;
+
+import java.sql.Connection;
+import java.sql.PreparedStatement;
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * SQL của trang độc giả, chuyển NGUYÊN VĂN từ ReaderServlet (Extract Class — TV-122, cùng kiểu PhieuMuonDAO của bài 5.3).
+ * Nhận Connection từ ngoài: người gọi mở/đóng (một kết nối cho cả request, như code cũ).
+ */
+public class DocGiaDAO {
+
+    private final Connection con;
+
+    public DocGiaDAO(Connection con) {
+        this.con = con;
+    }
+
+    public List<Reader> danhSach() throws SQLException {
+        List<Reader> readers = new ArrayList<Reader>();
+        try (PreparedStatement st = con.prepareStatement("SELECT * FROM readers ORDER BY id"); ResultSet rs = st.executeQuery()) {
+            while (rs.next()) {
+                Reader r = new Reader();
+                r.setId(rs.getInt("id"));
+                r.setName(rs.getString("name"));
+                r.setType(rs.getString("type"));
+                r.setPhone(rs.getString("phone"));
+                readers.add(r);
+            }
+        }
+        return readers;
+    }
+
+    /** Phiếu chưa trả, hạn trả sớm nhất lên đầu. */
+    public List<Loan> phieuDangMuon() throws SQLException {
+        List<Loan> loans = new ArrayList<Loan>();
+        try (PreparedStatement st = con.prepareStatement("SELECT l.*, b.title, r.name FROM loans l JOIN books b ON b.id = l.book_id "
+                + "JOIN readers r ON r.id = l.reader_id WHERE l.return_date IS NULL ORDER BY l.due_date");
+             ResultSet rs = st.executeQuery()) {
+            while (rs.next()) {
+                Loan l = new Loan();
+                l.id = rs.getInt("id");
+                l.bookId = rs.getInt("book_id");
+                l.readerId = rs.getInt("reader_id");
+                l.bookTitle = rs.getString("title");
+                l.readerName = rs.getString("name");
+                l.borrowDate = rs.getTimestamp("borrow_date");
+                l.dueDate = rs.getTimestamp("due_date");
+                loans.add(l);
+            }
+        }
+        return loans;
+    }
+
+    public void them(String name, String type, String phone) throws SQLException {
+        try (PreparedStatement st = con.prepareStatement("INSERT INTO readers(name, type, phone) VALUES (?, ?, ?)")) {
+            st.setString(1, name);
+            st.setString(2, type);
+            st.setString(3, phone);
+            st.executeUpdate();
+        }
+    }
+
+    /** CẢNH BÁO (TV-125, chưa sửa): khoá ngoại ON DELETE CASCADE xoá luôn phiếu của độc giả, kể cả phiếu đang mượn. */
+    public void xoa(int id) throws SQLException {
+        try (PreparedStatement st = con.prepareStatement("DELETE FROM readers WHERE id = ?")) {
+            st.setInt(1, id);
+            st.executeUpdate();
+        }
+    }
+}
