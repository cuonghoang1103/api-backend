a      = 00001100 12
b      = 00001010 10
a & b  = 00001000 8
a | b  = 00001110 14
a ^ b  = 00000110 6
~a     = 11110011 -13
a << 2 = 00110000 48
a >> 2 = 00000011 3
12 (32 bits) = 00000000000000000000000000001100
-12 (32 bits) = 11111111111111111111111111110100
-7 >> 1 = -4
-7 / 2 (truncated) = -3
-1 >>> 28 = 15
1 << 10 = 1024
7 & 1 = 1  8 & 1 = 0
x            = 00110100 52
x & 1        = 0
(x >> 2) & 1 = 1
x | (1 << 0) = 00110101 53
x & ~(1 << 2)= 00110000 48
x ^ (1 << 5) = 00010100 20
x & (x - 1)  = 00110000 48
x & -x       = 00000100 4
