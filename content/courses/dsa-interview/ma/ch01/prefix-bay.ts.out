nums = [1,2,-1,3,-2,2], k = 3
correct (seen starts {0:1})  = 4
forgot {0:1}                 = 2   <- misses every subarray that starts at index 0
sliding window               = 1   <- a negative number breaks "shrinking only lowers the sum"
sliding window on [1,0,1], k=1 = 3, correct = 4   <- zeros break it too
-7 % 5               = -2
((-7 % 5) + 5) % 5   = 3
2**53 + 1 === 2**53  = true   <- a prefix sum above 2^53 silently loses precision
