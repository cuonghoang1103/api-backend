twoSum([2, 7, 11, 15], 9) = [1, 2]   binary = [1, 2]   brute = [1, 2]
twoSum([2, 3, 4], 6) = [1, 3]   binary = [1, 3]   brute = [1, 3]
twoSum([-1, 0], -1) = [1, 2]   binary = [1, 2]   brute = [1, 2]
twoSum([1, 3, 4, 6, 8, 11], 10) = [3, 4]   binary = [3, 4]   brute = [3, 4]
twoSum([1, 2, 3], 100) = []   binary = []   brute = []
