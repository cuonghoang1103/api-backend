<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- VÍ DỤ ĐỂ ĐỌC, KHÔNG NẠP: dáng của LaunchAgent bám trụ kiểu Silver Sparrow (2021) — chạy lúc đăng nhập + mỗi giờ. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.capnhat</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>-c</string><string>~/Library/Application Support/capnhat/chay.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
</dict>
</plist>
