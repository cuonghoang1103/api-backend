<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ví dụ LaunchAgent (Chương 14, bài 14.3) — tương đương một unit systemd Restart=on-failure.
     KHÔNG nạp trong bài; nạp thật thì: cp vào ~/Library/LaunchAgents rồi launchctl bootstrap gui/$(id -u) <file>. -->
<plist version="1.0">
<dict>
  <key>Label</key>             <string>com.cuongthai.hot</string>
  <key>ProgramArguments</key>  <array><string>/opt/homebrew/bin/node</string><string>/Users/dev/app/hot.js</string></array>
  <key>RunAtLoad</key>         <true/>
  <key>KeepAlive</key>         <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key>  <integer>10</integer>
  <key>EnvironmentVariables</key> <dict><key>NODE_ENV</key><string>production</string></dict>
  <key>StandardOutPath</key>   <string>/tmp/hot.out.log</string>
  <key>StandardErrorPath</key> <string>/tmp/hot.err.log</string>
</dict>
</plist>
