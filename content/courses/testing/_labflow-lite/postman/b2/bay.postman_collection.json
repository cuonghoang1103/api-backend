{
  "info": {
    "name": "Traps",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login as thay (no bookings yet)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"thay\",\n  \"password\": \"labflow-demo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "T1 every booking is confirmed",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('T1 every booking is CONFIRMED', () => {",
              "  pm.response.json().forEach((b) => pm.expect(b.status).to.eql('CONFIRMED'));",
              "});",
              "pm.test('T1 fixed: there is at least one, and all are CONFIRMED', () => {",
              "  const list = pm.response.json();",
              "  pm.expect(list).to.have.length.above(0);",
              "  list.forEach((b) => pm.expect(b.status).to.eql('CONFIRMED'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "T2 a test without an assertion",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('T2 status is down', () => {",
              "  pm.response.json().status === 'down';",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "T3 typo in a variable name",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings/{{bookingID}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "console.log('sent to', pm.request.url.getPath());",
              "pm.test('T3 another user gets 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "T4 eql or equal",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('T4a to.eql (deep)', () => pm.expect(pm.response.json()).to.eql({ status: 'ok' }));",
              "pm.test('T4b to.equal (same object?)', () => pm.expect(pm.response.json()).to.equal({ status: 'ok' }));"
            ]
          }
        }
      ]
    },
    {
      "name": "T5 assertion outside pm.test",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.expect(pm.response.code).to.eql(500);",
              "pm.test('T5 this line runs?', () => pm.expect(1).to.eql(1));"
            ]
          }
        }
      ]
    },
    {
      "name": "T6 schema",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('T6 health matches its schema', () => {",
              "  pm.response.to.have.jsonSchema({",
              "    type: 'object', required: ['status', 'version'],",
              "    properties: { status: { enum: ['ok'] }, version: { type: 'string' } },",
              "  });",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [],
  "variable": [
    {
      "key": "token",
      "value": ""
    }
  ]
}
