{
  "info": {
    "name": "D tokens that must be refused",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login once",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"an\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "alg none",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bad}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b64 = (o) => btoa(JSON.stringify(o)).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "pm.variables.set('bad', b64({ alg: 'none' }) + '.' + b64({ sub: 'boss', role: 'ADMIN', exp: 9999999999 }) + '.');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refused with 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "role changed, old signature",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bad}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const [h, p, s] = pm.collectionVariables.get('token').split('.');",
              "const claims = JSON.parse(atob(p.replace(/-/g, '+').replace(/_/g, '/')));",
              "claims.role = 'ADMIN';",
              "pm.variables.set('bad', h + '.' + btoa(JSON.stringify(claims)).replace(/=+$/, '') + '.' + s);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refused with 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "garbage",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bad}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('bad', 'not-a-jwt');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refused with 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ],
  "event": [],
  "variable": [
    {
      "key": "password",
      "value": "labflow-demo"
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}
