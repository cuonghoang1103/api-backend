{
  "info": {
    "name": "D2 a broken pre-request",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Login once",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"an\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "role changed \u2014 typo in the pre-request",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/bookings",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bad}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const [h, p, s] = pm.collectionVariables.get('tokn').split('.');",
              "const claims = JSON.parse(atob(p.replace(/-/g, '+').replace(/_/g, '/')));",
              "claims.role = 'ADMIN';",
              "pm.variables.set('bad', h + '.' + btoa(JSON.stringify(claims)).replace(/=+$/, '') + '.' + s);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refused with 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ],
  "event": [],
  "variable": [
    {
      "key": "password",
      "value": "labflow-demo"
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}