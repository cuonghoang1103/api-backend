    {
      "name": "2 Bookings",
      "item": [
        {
          "name": "Create booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lab\": \"BE-201\",\n  \"date\": \"2026-12-01\",\n  \"start\": \"09:00\",\n  \"end\": \"11:00\",\n  \"seats\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test('201 + Location', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.response.to.have.header('Location', '/api/bookings/' + b.id);",
                  "});",
                  "pm.test('body is the booking we sent', () => {",
                  "  pm.expect(b).to.include({ lab: 'BE-201', date: '2026-12-01', start: '09:00', end: '11:00', seats: 20 });",
                  "  pm.expect(b.status).to.eql('CONFIRMED');",
                  "  pm.expect(b.minutes).to.eql(120);",
                  "});",
                  "pm.collectionVariables.set('bookingId', b.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read it back",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200, same booking', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('bookingId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Another student cannot read it",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenBinh}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 NOT_FOUND (not 403: do not confirm it exists)', () => {",
                  "  pm.response.to.have.status(404);",
                  "  pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Same slot again",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lab\": \"BE-201\",\n  \"date\": \"2026-12-01\",\n  \"start\": \"10:00\",\n  \"end\": \"12:00\",\n  \"seats\": 20\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 OVERLAP', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().error.code).to.eql('OVERLAP');",
                  "});"
                ]
              }
            }
          ]
        },
