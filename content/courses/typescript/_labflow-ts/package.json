{
  "name": "labflow-ts",
  "version": "1.0.0",
  "private": true,
  "description": "LabFlow TS — the shared project of the CuongThai TypeScript course (LabFlow Lite rules, converted to TypeScript).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-reporter=spec \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "lab1": "node scripts/cham-lab-1.mjs",
    "lab2": "node scripts/cham-lab-2.mjs",
    "lab3": "node scripts/cham-lab-3.mjs",
    "lab4": "node scripts/cham-lab-4.mjs",
    "lab5": "node scripts/cham-lab-5.mjs",
    "lab6": "node scripts/cham-lab-6.mjs",
    "lab7": "node scripts/cham-lab-7.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
