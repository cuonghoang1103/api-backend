{
  "name": "cuongthai-desktop",
  "version": "0.5.167",
  "private": true,
  "description": "Ứng dụng desktop CuongThai — Electron + React + TypeScript",
  "author": {
    "name": "CuongHoangDev",
    "email": "hoangnghiacuong0311@gmail.com"
  },
  "homepage": "https://cuongthai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/cuonghoang1103/api-backend.git"
  },
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "node --max-old-space-size=6144 ./node_modules/vite/bin/vite.js build",
    "build:main": "vite build --config vite.main.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:agent": "npm run build && node scripts/smoke-agent.mjs",
    "smoke:dev": "npm run build:main && node scripts/smoke-dev.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:mac:ky": "node scripts/ky-mac.mjs",
    "dist:mac:thu": "node scripts/ky-mac.mjs --thu",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "thu:python": "npm run build && node scripts/thu-python.mjs",
    "phat-hanh": "node scripts/phat-hanh.mjs",
    "do:bo-cuc": "rm -rf node_modules/.vite && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build --config vite.bo-cuc.config.ts && node scripts/do-bo-cuc.mjs",
    "do:bong": "node scripts/do-bong-robot.mjs",
    "thu:robot": "vite build --config vite.bo-cuc.config.ts && node scripts/thu-robot-nhac.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "electron-updater": "^6.8.9",
    "libflacjs": "^5.6.0",
    "onnxruntime-node": "1.23.2"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^2.15.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tiptap/extension-bubble-menu": "^2.27.2",
    "@tiptap/extension-collaboration": "^2.27.2",
    "@tiptap/extension-collaboration-cursor": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.7.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.5",
    "dompurify": "^3.4.13",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.2.5",
    "framer-motion": "^11.18.2",
    "highlight.js": "^11.12.0",
    "isomorphic-dompurify": "^3.19.0",
    "jsdom": "^25.0.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.453.0",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "pyodide": "^314.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "sharp": "^0.34.5",
    "socket.io-client": "^4.8.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.19",
    "tiptap-markdown": "^0.8.10",
    "typescript": "^5.6.3",
    "unpdf": "^1.8.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.5",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^3.23.8",
    "zustand": "^4.5.7"
  }
}
