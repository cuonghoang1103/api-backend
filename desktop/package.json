{
  "name": "cuongthai-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Ứng dụng desktop CuongThai — Electron + React + TypeScript",
  "author": {
    "name": "CuongHoangDev",
    "email": "hoangnghiacuong0311@gmail.com"
  },
  "homepage": "https://cuongthai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/cuonghoang1103/api-backend.git"
  },
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "vite build --config vite.main.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:dev": "npm run build:main && node scripts/smoke-dev.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.453.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  }
}
