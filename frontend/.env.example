# ─── Database (NextAuth) ───────────────────────────────────────────────
# Shared NeonDB — used by both frontend (NextAuth) and backend (Spring Boot)
# Get connection string from: https://neon.tech → your project → Connection Details
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# ─── NextAuth Configuration ───────────────────────────────────────────
# NEXTAUTH_URL is auto-detected in most deployments (Vercel, etc.)
# Only set this explicitly if you encounter redirect issues in local dev.
NEXTAUTH_URL=http://localhost:3000

# AUTH_SECRET — REQUIRED. Generate with:
#   openssl rand -base64 32
# This replaces NEXTAUTH_SECRET from v4.
AUTH_SECRET="replace-with-your-generated-secret-key"

# ─── OAuth Providers ────────────────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Apple (KHÔNG bắt buộc — thiếu thì nút Apple TỰ ẨN trên cả web và app desktop)
#
# Cần tạo Ở TRANG APPLE DEVELOPER, và ĐÂY LÀ CHỖ DỄ SAI NHẤT:
#   1. Một **Services ID** (Identifiers → dấu +  → Services IDs). Đây KHÔNG phải
#      Bundle ID của app iOS (`com.cuongthai.app`). App iOS dùng luồng NATIVE nên
#      nó không cần Services ID, còn web thì bắt buộc — hai thứ khác nhau, và
#      dùng nhầm Bundle ID cho web thì Apple trả `invalid_client`.
#      → Bật "Sign In with Apple", Configure:
#         Domain:       cuongthai.com
#         Return URL:   https://cuongthai.com/api/auth/callback/apple
#      (Return URL phải khớp TỪNG KÝ TỰ, kể cả có/không dấu / cuối.)
#   2. Một **khoá .p8** (Keys → dấu + → bật "Sign In with Apple"). Tải MỘT LẦN
#      DUY NHẤT — Apple không cho tải lại. Ghi lại Key ID.
#   3. Team ID: góc trên bên phải trang Apple Developer (10 ký tự).
#
# ⛔ KHÔNG commit file .p8. Dán nội dung vào biến dưới, xuống dòng viết thành \n:
#      APPLE_PRIVATE_KEY="<cả nội dung file .p8, kể cả hai dòng BEGIN/END,
#                          mỗi chỗ xuống dòng thay bằng hai ký tự \ và n>"
#
# `client_secret` của Apple là JWT có HẠN (tối đa 6 tháng). Web TỰ KÝ lại mỗi lần
# khởi động từ 4 biến này (src/lib/appleSecret.ts) nên không ai phải gia hạn tay.
APPLE_CLIENT_ID=com.cuongthai.web       # Services ID, KHÔNG phải Bundle ID iOS
APPLE_TEAM_ID=your-10-char-team-id
APPLE_KEY_ID=your-10-char-key-id
APPLE_PRIVATE_KEY=<noi-dung-file-p8-mot-dong>
# Đường lùi: dán sẵn secret đã tự ký ở nơi khác. Dùng cái này thì PHẢI tự nhớ
# tạo lại trước khi hết 6 tháng — ngày nó chết sẽ không có deploy nào để đổ lỗi.
# APPLE_CLIENT_SECRET=

# Facebook: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ─── Admin Configuration ────────────────────────────────────────────────
# Comma-separated list of emails that get ADMIN role on login
# Example: admin@example.com,another-admin@gmail.com
ADMIN_EMAILS=cuongthaihnhe176322@gmail.com

# ─── API Configuration ─────────────────────────────────────────────────
# Backend URL — used for local dev only
# On Vercel, set NEXT_PUBLIC_API_URL to your Render backend URL
NEXT_PUBLIC_API_URL=http://localhost:8082

# ─── YouTube Data API ──────────────────────────────────────────────────
# Get key from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in your project
# NOTE: This key is used server-side only (backend/src/routes/music.routes.ts).
# It should be set as YOUTUBE_API_KEY in the backend/.env, not frontend/.env.
NEXT_PUBLIC_YOUTUBE_API_KEY=

# ─── Sentry (Frontend Error Tracking) ───────────────────────────────────
# Get your DSN from: https://sentry.io/settings/.../projects/.../keys/
# When DSN is empty, Sentry is disabled and the app behaves exactly
# as before — no overhead, no network calls.
NEXT_PUBLIC_SENTRY_DSN=""

# Sample 10% of transactions. Lower = cheaper.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# Environment label (e.g. "production", "staging"). Defaults to NODE_ENV.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# Release identifier (e.g. git SHA). Helps correlate errors with deploys.
# NEXT_PUBLIC_SENTRY_RELEASE=""
