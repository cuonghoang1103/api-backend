{
  "name": "cuongmini",
  "version": "0.2.1",
  "private": true,
  "description": "CuongMini CLI — trợ lý lập trình chạy trong terminal, dùng lõi AI Code của CuongThai.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "cuongmini": "dist/cuongmini.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
