{
  "name": "cuongthai-ai-code",
  "displayName": "CuongMini Code — AI lập trình của CuongThai",
  "description": "CuongMini Code — AI lập trình của CuongThai ngay trong VS Code — chat, sửa code, chạy lệnh, skill, MCP, GitHub. Cài là dùng: đăng nhập bằng tài khoản cuongthai.com (có app desktop thì tự chạy qua app).",
  "version": "0.8.4",
  "publisher": "cuongthai",
  "license": "UNLICENSED",
  "private": true,
  "icon": "media/icon.png",
  "galleryBanner": { "color": "#4c1d95", "theme": "dark" },
  "homepage": "https://cuongthai.com",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["AI", "Chat", "Programming Languages"],
  "keywords": ["ai", "agent", "chat", "cuongthai", "cuongmini", "code assistant", "copilot", "tiếng việt"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "CuongMini Code đọc, sửa file và chạy lệnh trong thư mục — chỉ chạy khi bạn TIN thư mục (Workspace Trust). / CuongMini Code reads, edits and runs commands in the folder — it only runs in trusted workspaces." },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "cuongthai", "title": "CuongMini Code", "icon": "media/activity.svg" }
      ]
    },
    "views": {
      "cuongthai": [
        { "type": "webview", "id": "cuongthai.chat", "name": "CuongMini Code", "icon": "media/activity.svg" }
      ]
    },
    "commands": [
      { "command": "cuongthai.moChat", "title": "Mở khung chat", "category": "CuongMini", "icon": "$(comment-discussion)" },
      { "command": "cuongthai.viecMoi", "title": "Việc mới", "category": "CuongMini", "icon": "$(add)" },
      { "command": "cuongthai.lichSu", "title": "Lịch sử việc", "category": "CuongMini", "icon": "$(history)" },
      { "command": "cuongthai.hoiDoanChon", "title": "Hỏi AI về đoạn đang chọn", "category": "CuongMini" },
      { "command": "cuongthai.themFile", "title": "Thêm vào CuongMini Code", "category": "CuongMini" },
      { "command": "cuongthai.suaLoi", "title": "Nhờ AI sửa lỗi này", "category": "CuongMini" },
      { "command": "cuongthai.moApp", "title": "Mở app CuongThai", "category": "CuongMini" },
      { "command": "cuongthai.dangXuat", "title": "Đăng xuất (chế độ không cần app)", "category": "CuongMini" },
      { "command": "cuongthai.batTatMayTinh", "title": "Bật/tắt điều khiển máy tính (chụp màn hình, chuột, phím)", "category": "CuongMini" },
      { "command": "cuongthai.hienTrinhDuyet", "title": "Hiện trình duyệt AI (để tự đăng nhập) / Show AI browser", "category": "CuongMini", "icon": "$(globe)" },
      { "command": "cuongthai.anTrinhDuyet", "title": "Ẩn trình duyệt AI — chạy ngầm / Hide AI browser", "category": "CuongMini" },
      { "command": "cuongthai.ketNoiFigma", "title": "Kết nối Figma (token chỉ đọc) / Connect Figma", "category": "CuongMini" }
    ],
    "menus": {
      "view/title": [
        { "command": "cuongthai.lichSu", "when": "view == cuongthai.chat", "group": "navigation@1" },
        { "command": "cuongthai.viecMoi", "when": "view == cuongthai.chat", "group": "navigation@2" }
      ],
      "editor/title/context": [
        { "command": "cuongthai.themFile", "group": "cuongthai@1" }
      ],
      "editor/context": [
        { "command": "cuongthai.hoiDoanChon", "when": "editorHasSelection", "group": "cuongthai@1" }
      ],
      "explorer/context": [
        { "command": "cuongthai.themFile", "group": "cuongthai@1" }
      ],
      "commandPalette": [
        { "command": "cuongthai.suaLoi", "when": "false" }
      ]
    },
    "keybindings": [
      { "command": "cuongthai.moChat", "key": "ctrl+alt+c", "mac": "cmd+alt+c" },
      { "command": "cuongthai.hoiDoanChon", "key": "ctrl+alt+l", "mac": "cmd+alt+l", "when": "editorHasSelection" }
    ],
    "configuration": {
      "title": "CuongMini Code",
      "properties": {
        "cuongthai.cheDo": {
          "type": "string",
          "enum": ["tuDong", "docLap", "app"],
          "enumDescriptions": [
            "Có app desktop CuongThai đang mở thì chạy qua app, không thì chạy ngay trong VS Code.",
            "Luôn chạy ngay trong VS Code (đăng nhập bằng tài khoản cuongthai.com), kể cả khi có app.",
            "Chỉ chạy qua app desktop CuongThai."
          ],
          "default": "tuDong",
          "description": "AI Code chạy ở đâu."
        },
        "cuongthai.kemFileDangMo": {
          "type": "boolean",
          "default": true,
          "description": "Tự gửi kèm tên file đang mở và đoạn đang chọn làm ngữ cảnh cho AI."
        },
        "cuongthai.dieuKhienMayTinh": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Cho agent **điều khiển máy tính**: chụp màn hình, bấm chuột, gõ phím (tool `may_*`). Mọi thao tác vẫn hỏi bạn từng lần, kể cả chế độ \"Bỏ qua hết\". macOS cần cấp quyền Ghi màn hình + Trợ năng cho VS Code. / Let the agent control the computer (screenshot, mouse, keyboard) — every action still asks."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "node build.mjs && npx --yes @vscode/vsce@3.2.1 package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "6.0.5",
    "@types/vscode": "^1.90.0",
    "dompurify": "^3.2.3",
    "esbuild": "^0.24.2",
    "jpeg-js": "0.4.4",
    "marked": "^15.0.4",
    "pngjs": "7.0.0",
    "typescript": "^5.7.2"
  }
}
