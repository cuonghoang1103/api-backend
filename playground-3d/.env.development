VITE_BASE_HREF=/

# Chỉ có tác dụng với `npm run dev` (vite --mode development).
# Lộ `window.game` ra console để gỡ lỗi: đọc được `game.audio.playlist`,
# `game.weather`, `game.menu.open('options')`…
#
# ⚠️ ĐỪNG đặt biến này vào `.env` — file đó áp cho CẢ bản dựng production, và
#    `window.game` sẽ lọt vào gói phát hành. Đã dẫm đúng bẫy này ngày 30/7.
#    (`vite.config.js` gọi `import 'dotenv/config'` nạp `.env` vào process.env,
#    mà giá trị trong process.env THẮNG mọi file `.env.<mode>` — kể cả khi nó là
#    chuỗi rỗng.)
VITE_GAME_PUBLIC=1
