@font-face {
  font-family: 'Pally-Regular';
  src: url('../fonts/Pally-Regular.woff2') format('woff2'),
       url('../fonts/Pally-Regular.woff') format('woff'),
       url('../fonts/Pally-Regular.ttf') format('truetype');
  font-weight: 400;
  font-display: swap;
  font-style: normal;
}
@font-face {
  font-family: 'Pally-Medium';
  src: url('../fonts/Pally-Medium.woff2') format('woff2'),
       url('../fonts/Pally-Medium.woff') format('woff'),
       url('../fonts/Pally-Medium.ttf') format('truetype');
  font-weight: 500;
  font-display: swap;
  font-style: normal;
}
@font-face {
  font-family: 'Pally-Bold';
  src: url('../fonts/Pally-Bold.woff2') format('woff2'),
       url('../fonts/Pally-Bold.woff') format('woff'),
       url('../fonts/Pally-Bold.ttf') format('truetype');
  font-weight: 700;
  font-display: swap;
  font-style: normal;
}

.fonts-loader
    position fixed
    top calc(100% + 1px)
    left 0

    // Ba ô ẩn này chỉ để BUỘC trình duyệt tải phông sớm, trước khi game vẽ chữ
    // lên canvas. Canvas không kích hoạt việc tải phông: nếu phông chưa tải xong
    // thì `fillText` lặng lẽ vẽ bằng phông mặc định, và vì texture chỉ vẽ MỘT
    // LẦN nên chữ sai phông đó nằm lại vĩnh viễn trong thế giới.
    //
    // Trước đây hai ô đầu trỏ vào "Nunito" và "Amatic SC" — hai phông Google đã
    // bị gỡ khỏi trang, nên chúng chẳng tải gì cả. Nay cả ba đều trỏ vào Pally,
    // phông tự phục vụ trong static/fonts/.
    .pally-regular
        font-family "Pally-Regular", sans-serif
        font-weight 400
        font-style normal

    .pally-bold
        font-family "Pally-Bold", sans-serif
        font-weight 700

    .pally
        font-family "Pally-Medium", sans-serif
        font-weight 500
