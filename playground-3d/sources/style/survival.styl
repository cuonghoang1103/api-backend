/*
 * ─── Chế độ Sinh tồn ────────────────────────────────────────────────────────
 * Bảng số nép GÓC TRÁI DƯỚI (góc phải đã có ba nút ☰ / bản đồ / thoát) và màn
 * thua phủ giữa màn hình.
 *
 * Cả hai ẩn hẳn khi chưa bật chế độ — `pointer-events none` ở mọi trạng thái,
 * vì đây là bảng ĐỌC, bấm nhầm vào nó lúc đang lái là mất lái.
 */

.survival-hud
    position absolute
    left 20px
    bottom 20px
    z-index 2
    width 210px
    padding 12px 14px 10px
    background radial-gradient(ellipse at top left, #251f2b, #1d1721)
    border-left 2px solid #ff6a7c
    opacity 0
    transform translateY(12px)
    transition opacity 0.35s, transform 0.35s
    pointer-events none
    -webkit-user-select none
    -moz-user-select none
    user-select none

    html.is-mode-touch &
        left 12px
        bottom 12px
        width 168px
        padding 9px 10px 7px

    &.is-visible
        opacity 1
        transform translateY(0)

    /* Máu tụt dưới 30% thì cả bảng thở đỏ — đọc được bằng đuôi mắt lúc đang lái */
    &.is-critical
        border-left-color #ff2f48
        animation survival-pulse 0.9s ease-in-out infinite

    /* Vừa ăn đòn: giật một cái. Lớp này do Survival.js gỡ ra sau 320ms */
    &.is-hurt
        animation survival-shake 0.32s ease-out

    .survival-health
        display flex
        align-items center
        margin-bottom 9px

        .survival-health-track
            position relative
            flex 1
            height 8px
            margin-right 9px
            background #3a2f3d
            overflow hidden

        .survival-health-bar
            position absolute
            top 0
            left 0
            width 100%
            height 100%
            background linear-gradient(90deg, #ff2f48, #ff8a5c)
            transform-origin 0 50%
            will-change transform
            transition transform 0.18s linear

        .survival-health-value
            min-width 26px
            color #ffffff
            font-size 15px
            font-weight 700
            text-align right

    .survival-stats
        display grid
        grid-template-columns 1fr 1fr
        gap 3px 8px
        margin-bottom 7px

        .survival-stat
            display flex
            align-items baseline
            justify-content space-between
            font-size 13px

            i
                color #b9a9c4
                font-style normal

            b
                color #ffffff
                font-weight 700

    .survival-state
        margin 0
        padding-top 6px
        border-top 1px solid #3a2f3d
        color #d5ff95
        font-size 13px
        line-height 1em

@keyframes survival-pulse
    0%, 100%
        box-shadow 0 0 0 rgba(255, 47, 72, 0)
    50%
        box-shadow -4px 0 22px rgba(255, 47, 72, 0.55)

@keyframes survival-shake
    0%
        transform translate(0, 0)
    25%
        transform translate(-4px, 1px)
    60%
        transform translate(3px, -1px)
    100%
        transform translate(0, 0)

/*
 * Thanh máu quái trùm — trên cùng, giữa. Cố ý tách hẳn khỏi bảng số góc trái:
 * đây là thứ phải nhìn liên tục trong lúc đánh nhau, để lẫn vào bảng kia thì
 * mắt phải rời khỏi đường đi.
 */
.survival-boss
    position absolute
    /*
     * DƯỚI CÙNG, giữa — không phải trên đầu.
     *
     * Đã thử `top: 18px` rồi `top: 132px` và cả hai đều chồng lên khung thông
     * báo: đúng lúc trùm xuất hiện cũng là lúc thông báo "Sóng N — QUÁI TRÙM"
     * đang hiện, mà khung đó cao tới ~230px khi tiêu đề xuống hai dòng. Dưới
     * cùng thì sạch: chỗ đó chỉ có cửa hàng, mà cửa hàng chỉ mở trong nhịp nghỉ
     * — không bao giờ cùng lúc với một con trùm đang sống.
     */
    bottom 20px
    left 50%
    z-index 2
    width 320px
    margin-left -160px
    padding 8px 12px 10px
    background radial-gradient(ellipse at top left, #2b1a33, #1d1021)
    border-top 2px solid #b678ff
    text-align center
    opacity 0
    transform translateY(-10px)
    transition opacity 0.35s, transform 0.35s
    pointer-events none

    html.is-mode-touch &
        width 220px
        margin-left -110px

    &.is-visible
        opacity 1
        transform translateY(0)

    .survival-boss-name
        margin 0 0 6px
        color #d861a8
        font-size 15px
        font-weight 700
        line-height 1em
        letter-spacing 0.04em

    .survival-boss-track
        position relative
        height 9px
        background #3a2f3d
        overflow hidden

    .survival-boss-bar
        position absolute
        top 0
        left 0
        width 100%
        height 100%
        background linear-gradient(90deg, #b678ff, #ff5ad4)
        transform-origin 0 50%
        will-change transform
        transition transform 0.2s linear

/*
 * Cửa hàng — giữa dưới, NGAY TRÊN bảng số. Chỉ hiện trong nhịp nghỉ, nên nó
 * không bao giờ chắn tầm nhìn lúc đang bị vây.
 */
.survival-shop
    position absolute
    left 50%
    bottom 20px
    z-index 3
    width 560px
    margin-left -280px
    padding 12px 14px 10px
    background radial-gradient(ellipse at top left, #251f2b, #1a151e)
    border-top 2px solid #d5ff95
    opacity 0
    transform translateY(14px)
    transition opacity 0.3s, transform 0.3s
    pointer-events none
    -webkit-user-select none
    -moz-user-select none
    user-select none

    html.is-mode-touch &
        width @css{ min(560px, calc(100% - 24px)) }
        left 12px
        margin-left 0

    &.is-visible
        opacity 1
        transform translateY(0)
        pointer-events auto

    .survival-shop-head
        display flex
        justify-content space-between
        align-items baseline
        margin-bottom 9px

        .survival-shop-title
            color #d5ff95
            font-size 16px
            font-weight 700

        .survival-shop-money
            color #ffd34a
            font-size 16px
            font-weight 700

            &::after
                content '$'
                margin-left 2px
                opacity 0.65

    .survival-shop-items
        display grid
        grid-template-columns repeat(5, 1fr)
        gap 6px

        html.is-mode-touch &
            grid-template-columns repeat(2, 1fr)

    .survival-shop-item
        display flex
        flex-direction column
        padding 8px 7px
        background #302838
        border none
        color #ffffff
        text-align left
        cursor pointer
        transition background 0.15s, opacity 0.15s
        font-family inherit

        &:hover
            background #3d3347

        /* Không đủ tiền hoặc đã kịch cấp — mờ đi chứ đừng giấu, người chơi cần
           biết còn những gì để dành tiền */
        &.is-locked
            opacity 0.38
            cursor default

            &:hover
                background #302838

        .survival-shop-key
            display inline-block
            margin-bottom 4px
            color #b9a9c4
            font-size 11px

        .survival-shop-name
            margin-bottom 2px
            font-size 14px
            font-weight 700
            line-height 1.1em

        .survival-shop-desc
            margin-bottom 6px
            color #b9a9c4
            font-size 11px
            line-height 1.25em

        .survival-shop-price
            margin-top auto
            color #ffd34a
            font-size 13px
            font-weight 700

        .survival-shop-level
            color #d5ff95
            font-size 11px

    .survival-shop-hint
        margin 8px 0 0
        color #b9a9c4
        font-size 11px
        text-align center

.survival-defeated
    position absolute
    top 0
    left 0
    display flex
    align-items center
    justify-content center
    width 100%
    height 100%
    z-index 3
    background rgba(20, 6, 12, 0.55)
    opacity 0
    pointer-events none
    transition opacity 0.4s

    &.is-visible
        opacity 1

    .survival-defeated-panel
        padding 26px 40px
        background radial-gradient(ellipse at top left, #2b1a20, #1d1015)
        border-top 3px solid #ff2f48
        text-align center

    .survival-defeated-title
        margin 0 0 8px
        color #ff6a7c
        font-size 3.4rem
        line-height 1em

    .survival-defeated-wave
        margin 0 0 4px
        color #ffffff
        font-size 17px

    .survival-defeated-hint
        margin 0
        color #b9a9c4
        font-size 14px
