/*
 * ─── Chế độ Sinh tồn ────────────────────────────────────────────────────────
 * Bảng số nép GÓC TRÁI DƯỚI (góc phải đã có ba nút ☰ / bản đồ / thoát) và màn
 * thua phủ giữa màn hình.
 *
 * Cả hai ẩn hẳn khi chưa bật chế độ — `pointer-events none` ở mọi trạng thái,
 * vì đây là bảng ĐỌC, bấm nhầm vào nó lúc đang lái là mất lái.
 */

.survival-hud
    position absolute
    left 20px
    bottom 20px
    z-index 2
    width 210px
    padding 12px 14px 10px
    background radial-gradient(ellipse at top left, #251f2b, #1d1721)
    border-left 2px solid #ff6a7c
    opacity 0
    transform translateY(12px)
    transition opacity 0.35s, transform 0.35s
    pointer-events none
    -webkit-user-select none
    -moz-user-select none
    user-select none

    html.is-mode-touch &
        left 12px
        bottom 12px
        width 168px
        padding 9px 10px 7px

    &.is-visible
        opacity 1
        transform translateY(0)

    /* Máu tụt dưới 30% thì cả bảng thở đỏ — đọc được bằng đuôi mắt lúc đang lái */
    &.is-critical
        border-left-color #ff2f48
        animation survival-pulse 0.9s ease-in-out infinite

    /* Vừa ăn đòn: giật một cái. Lớp này do Survival.js gỡ ra sau 320ms */
    &.is-hurt
        animation survival-shake 0.32s ease-out

    .survival-health
        display flex
        align-items center
        margin-bottom 9px

        .survival-health-track
            position relative
            flex 1
            height 8px
            margin-right 9px
            background #3a2f3d
            overflow hidden

        .survival-health-bar
            position absolute
            top 0
            left 0
            width 100%
            height 100%
            background linear-gradient(90deg, #ff2f48, #ff8a5c)
            transform-origin 0 50%
            will-change transform
            transition transform 0.18s linear

        .survival-health-value
            min-width 26px
            color #ffffff
            font-size 15px
            font-weight 700
            text-align right

    .survival-stats
        display grid
        grid-template-columns 1fr 1fr
        gap 3px 8px
        margin-bottom 7px

        .survival-stat
            display flex
            align-items baseline
            justify-content space-between
            font-size 13px

            i
                color #b9a9c4
                font-style normal

            b
                color #ffffff
                font-weight 700

    .survival-state
        margin 0
        padding-top 6px
        border-top 1px solid #3a2f3d
        color #d5ff95
        font-size 13px
        line-height 1em

@keyframes survival-pulse
    0%, 100%
        box-shadow 0 0 0 rgba(255, 47, 72, 0)
    50%
        box-shadow -4px 0 22px rgba(255, 47, 72, 0.55)

@keyframes survival-shake
    0%
        transform translate(0, 0)
    25%
        transform translate(-4px, 1px)
    60%
        transform translate(3px, -1px)
    100%
        transform translate(0, 0)

.survival-defeated
    position absolute
    top 0
    left 0
    display flex
    align-items center
    justify-content center
    width 100%
    height 100%
    z-index 3
    background rgba(20, 6, 12, 0.55)
    opacity 0
    pointer-events none
    transition opacity 0.4s

    &.is-visible
        opacity 1

    .survival-defeated-panel
        padding 26px 40px
        background radial-gradient(ellipse at top left, #2b1a20, #1d1015)
        border-top 3px solid #ff2f48
        text-align center

    .survival-defeated-title
        margin 0 0 8px
        color #ff6a7c
        font-size 3.4rem
        line-height 1em

    .survival-defeated-wave
        margin 0 0 4px
        color #ffffff
        font-size 17px

    .survival-defeated-hint
        margin 0
        color #b9a9c4
        font-size 14px
