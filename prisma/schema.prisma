// 5. SKILLS & PROJECTS
// ============================================================

model Skill {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(100)
  slug            String   @unique(map: "uk_skill_slug") @db.VarChar(100)
  category        String?  @db.VarChar(50)
  proficiency     Int      @default(3)
  description     String?  @db.Text
  yearsExperience Int      @default(0) @map("years_experience")
  isFeatured      Boolean  @default(false) @map("is_featured")
  displayOrder    Int      @default(0) @map("display_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  projects ProjectSkill[]

  @@index([category], name: "idx_skills_category")
  @@index([isFeatured], name: "idx_skills_is_featured")
  @@index([displayOrder], name: "idx_skills_display_order")
  @@map("skills")
}

model Project {
  id            Int       @id @default(autoincrement())
  title         String    @db.VarChar(255)
  slug          String    @unique(map: "uk_project_slug") @db.VarChar(255)
  description   String?   @db.Text
  content       String?   @db.Text
  thumbnailUrl  String?   @map("thumbnail_url") @db.VarChar(500)
  images        String?   @db.Text
  projectUrl    String?   @map("project_url") @db.VarChar(500)
  videoUrl      String?   @map("video_url") @db.VarChar(500)
  githubUrl     String?   @map("github_url") @db.VarChar(500)
  techStack     String?   @map("tech_stack") @db.Text
  role          String?   @db.VarChar(100)
  duration      String?   @db.VarChar(100)
  status        String    @default("COMPLETED") @db.VarChar(20)
  isFeatured    Boolean   @default(false) @map("is_featured")
  startDate     DateTime? @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  // ─── Case study / build log fields (Phase 2, additive) ───
  // category — free-form string ("Web", "AI", "DevOps"…).
  // difficulty — BEGINNER | INTERMEDIATE | ADVANCED.
  // bodyMdx — Markdown source of truth.
  // bodyHtml — server-rendered cache of bodyMdx; backfilled
  // lazily on first public read if empty.
  // schemaCode / schemaLang — optional code block for the
  // "Database Schema" section on the case-study page.
  // viewCount — denormalised counter, fire-and-forget on
  // public detail reads. Not transactional.
  // likeCount — denormalised counter for anonymous likes,
  // kept consistent with project_likes table by routes.
  // isPublished — admin can flip to false to hide a project
  // without deleting it; defaults to true so existing
  // projects stay public.
  category      String?   @db.VarChar(80)
  difficulty    String?   @db.VarChar(20)
  bodyMdx       String?   @map("body_mdx") @db.Text
  bodyHtml      String?   @map("body_html") @db.Text
  schemaCode    String?   @map("schema_code") @db.Text
  schemaLang    String?   @map("schema_lang") @db.VarChar(40)
  viewCount     Int       @default(0) @map("view_count")
  likeCount     Int       @default(0) @map("like_count")
  isPublished   Boolean   @default(true) @map("is_published")
  // pinOrder — ghim lên đầu /projects (NULL = không ghim; số nhỏ đứng trước).
  // Tách khỏi isFeatured vì seeder mặc định isFeatured = true cho mọi dự án,
  // nên "featured" không phân biệt được dự án nào thật sự được ghim.
  pinOrder      Int?      @map("pin_order")
  // ─── English translation columns (Phase 3, additive) ───
  // The site ships a VI/EN switch that flips content live
  // (cookie `locale` + `locale-changed` event, no reload).
  // Translations live in sibling columns instead of a
  // separate `project_translations` table on purpose: every
  // project has at most two languages, the public read is a
  // single row fetch on the hot path, and a join per read
  // would buy nothing. NULL means "not translated yet" —
  // the API falls back to the Vietnamese column so a
  // half-translated project still renders, never blank.
  //
  // bodyHtmlEn mirrors bodyHtml: a server-rendered cache of
  // bodyMdxEn, backfilled lazily on first read when empty.
  titleEn       String?   @map("title_en") @db.VarChar(255)
  descriptionEn String?   @map("description_en") @db.Text
  roleEn        String?   @map("role_en") @db.VarChar(100)
  durationEn    String?   @map("duration_en") @db.VarChar(100)
  bodyMdxEn     String?   @map("body_mdx_en") @db.Text
  bodyHtmlEn    String?   @map("body_html_en") @db.Text
  schemaCodeEn  String?   @map("schema_code_en") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  skills     ProjectSkill[]
  milestones ProjectMilestone[]
  features   ProjectFeature[]
  resources  ProjectResource[]
  likes      ProjectLike[]
  listItems  ProjectListItem[]

  @@index([status], name: "idx_projects_status")
  @@index([isFeatured], name: "idx_projects_is_featured")
  @@index([category], name: "idx_projects_category")
  @@index([difficulty], name: "idx_projects_difficulty")
  @@index([isPublished], name: "idx_projects_is_published")
  @@map("projects")
}

model ProjectMilestone {
  id            Int       @id @default(autoincrement())
  projectId     Int       @map("project_id")
  phase         String    @db.VarChar(40)
  title         String    @db.VarChar(255)
  description   String?   @db.Text
  date          DateTime? @db.Date
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  // codeBlock / codeLang — optional VSCode-style code review
  // snippet shown below the milestone description. The
  // content is plain text (no syntax tree in DB); highlighting
  // is rendered client-side via Shiki / highlight.js based on
  // codeLang. Free-form VARCHAR(40) to keep the same set of
  // languages as project.schemaLang.
  codeBlock     String?   @map("code_block") @db.Text
  codeLang      String?   @map("code_lang") @db.VarChar(40)
  // EN siblings — see the note on Project. codeBlock itself
  // is not duplicated (code is language-neutral); only the
  // prose around it is translated.
  titleEn       String?   @map("title_en") @db.VarChar(255)
  descriptionEn String?   @map("description_en") @db.Text
  order         Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order], name: "idx_project_milestones_project_order")
  @@map("project_milestones")
}

model ProjectFeature {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  title         String   @db.VarChar(255)
  description   String?  @db.Text
  status        String   @default("PLANNED") @db.VarChar(20)
  // EN siblings — see the note on Project.
  titleEn       String?  @map("title_en") @db.VarChar(255)
  descriptionEn String?  @map("description_en") @db.Text
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order], name: "idx_project_features_project_order")
  @@index([projectId, status], name: "idx_project_features_project_status")
  @@map("project_features")
}

model ProjectResource {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  title         String   @db.VarChar(255)
  url           String   @db.VarChar(1000)
  type          String   @default("LINK") @db.VarChar(20)
  fileSize      Int?     @map("file_size")
  description   String?  @db.Text
  // EN siblings — see the note on Project. `url` is shared.
  titleEn       String?  @map("title_en") @db.VarChar(255)
  descriptionEn String?  @map("description_en") @db.Text
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order], name: "idx_project_resources_project_order")
  @@map("project_resources")
}

// ─────────────────────────────────────────────────────────────────
// ProjectListItem — single table for the three "list of strings"
// sections (Core Knowledge / Portfolio Bonus / Completion
// Outcomes). Using a kind enum keeps the schema compact and
// the API uniform: one CRUD pair handles all three.
// ─────────────────────────────────────────────────────────────────
enum ProjectListKind {
  CORE_KNOWLEDGE
  PORTFOLIO_BONUS
  COMPLETION_OUTCOME
}

model ProjectListItem {
  id        Int             @id @default(autoincrement())
  projectId Int             @map("project_id")
  kind      ProjectListKind
  // The "content" is the user-facing string the editor stores
  // and the public page renders. VARCHAR(500) so titles like
  // "NextAuth.js v5 flow (JWT, sessions)" fit comfortably.
  content   String          @db.VarChar(500)
  // EN sibling — see the note on Project.
  contentEn String?         @map("content_en") @db.VarChar(500)
  order     Int             @default(0)
  createdAt DateTime        @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, order], name: "idx_project_list_items_project_kind_order")
  @@map("project_list_items")
}

model ProjectLike {
  // Anonymous like record, keyed by IP HMAC-SHA256 hash so
  // the user can hit "like" repeatedly without inflating
  // the count. Unique (project_id, ip_hash) enforces
  // idempotency at the DB level; the API layer also
  // catches and treats the duplicate as success.
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  ipHash    String   @map("ip_hash") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, ipHash], name: "uk_project_like_project_ip")
  @@index([projectId], name: "idx_project_likes_project")
  @@map("project_likes")
}

model ProjectSkill {
  projectId Int
  skillId   Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId], map: "pk_project_skills")
  @@map("project_skills")
}

// ============================================================
// 6. COURSE MODULE (Education / LMS)
// ============================================================

model CourseCategory {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  slug        String   @unique(map: "uk_course_category_slug") @db.VarChar(100)
  description String?  @db.Text
  icon        String?  @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  courses Course[]

  @@map("course_categories")
}

model Semester {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  code        String   @unique(map: "uk_semester_code") @db.VarChar(20)
  ordinal     Int      @unique(map: "uk_semester_ordinal")
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  courses Course[]

  @@map("semesters")
}

model Course {
  id                     Int       @id @default(autoincrement())
  categoryId             Int?      @map("category_id")
  instructorId           Int?      @map("instructor_id")
  semesterId             Int?      @map("semester_id")
  courseCode             String?   @map("course_code") @db.VarChar(50)
  academyType            String    @default("GENERAL") @map("academy_type") @db.VarChar(30)
  title                  String    @db.VarChar(255)
  slug                   String    @unique(map: "uk_course_slug") @db.VarChar(255)
  shortDescription       String?   @map("short_description") @db.VarChar(500)
  description            String?   @db.Text
  thumbnailUrl           String?   @map("thumbnail_url") @db.VarChar(500)
  previewVideoUrl        String?   @map("preview_video_url") @db.VarChar(500)
  price                  Decimal   @default(0) @db.Decimal(10, 2)
  discountPrice          Decimal?  @map("discount_price") @db.Decimal(10, 2)
  discountExpiresAt      DateTime? @map("discount_expires_at")
  accessType             String    @default("FREE") @map("access_type") @db.VarChar(10)
  enrollmentDurationDays Int       @default(0) @map("enrollment_duration_days")
  level                  String    @default("BEGINNER") @db.VarChar(20)
  language               String    @default("Vietnamese") @db.VarChar(20)
  isFree                 Boolean   @default(false) @map("is_free")
  isFeatured             Boolean   @default(false) @map("is_featured")
  isPublished            Boolean   @default(false) @map("is_published")
  publishedAt            DateTime? @map("published_at")
  totalDurationSeconds   Int       @default(0) @map("total_duration_seconds")
  totalLessons           Int       @default(0) @map("total_lessons")
  totalStudents          Int       @default(0) @map("total_students")
  totalReviews           Int       @default(0) @map("total_reviews")
  avgRating              Decimal   @default(0) @db.Decimal(3, 2)
  requirements           String?   @db.Text
  whatYouLearn           String?   @map("what_you_learn") @db.Text
  // Free-text note shown above the course-level "Tài liệu" list to guide
  // students on how to use the attached materials.
  documentsNote          String?   @map("documents_note") @db.Text
  startDate              DateTime? @map("start_date")
  endDate                DateTime? @map("end_date")
  status                 String    @default("DRAFT") @db.VarChar(20)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  category     CourseCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  instructor   User?            @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  semester     Semester?        @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  sections     CourseSection[]
  documents    CourseDocument[]
  enrollments  Enrollment[]
  certificates Certificate[]
  reviews      CourseReview[]
  tags         CourseTag[]
  orders       CourseOrder[]
  courseCodes  CourseCode[]
  exams        Exam[]

  @@index([categoryId], name: "idx_courses_category")
  @@index([instructorId], name: "idx_courses_instructor")
  @@index([semesterId], name: "idx_courses_semester")
  @@index([status], name: "idx_courses_status")
  @@index([isFeatured], name: "idx_courses_featured")
  @@index([isPublished], name: "idx_courses_published")
  @@index([courseCode], name: "idx_courses_code")
  @@index([academyType], name: "idx_courses_academy_type")
  @@index([accessType], name: "idx_courses_access_type")
  @@index([isPublished, status, createdAt(sort: Desc)], name: "idx_courses_published_status_created")
  @@index([isPublished, isFeatured], name: "idx_courses_published_featured")
  @@index([categoryId, isPublished], name: "idx_courses_category_published")
  @@map("courses")
}

model CourseSection {
  id          Int      @id @default(autoincrement())
  courseId    Int      @map("course_id")
  title       String   @db.VarChar(255)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isLocked    Boolean  @default(false) @map("is_locked")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  // Câu hỏi Exam Room được gán về chương này (xem ExamQuestion.sectionId).
  examQuestions ExamQuestion[]

  @@index([courseId], name: "idx_sections_course")
  @@map("course_sections")
}

model Lesson {
  id                   Int      @id @default(autoincrement())
  sectionId            Int      @map("section_id")
  title                String   @db.VarChar(255)
  slug                 String?  @db.VarChar(255)
  description          String?  @db.Text
  content              String?  @db.Text
  lessonType           String   @default("VIDEO") @map("lesson_type") @db.VarChar(20)
  videoUrl             String?  @map("video_url") @db.VarChar(500)
  videoDurationSeconds Int      @default(0) @map("video_duration_seconds")
  thumbnailUrl         String?  @map("thumbnail_url") @db.VarChar(500)
  isFreePreview        Boolean  @default(false) @map("is_free_preview")
  isPublished          Boolean  @default(false) @map("is_published")
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  section        CourseSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  details        LessonDetail?
  documents      CourseDocument[]
  assignments    Assignment[]
  lessonProgress LessonProgress[]
  aiAnswers      LessonAiAnswer[]
  tutorAsks      LessonTutorAsk[]
  phuDe          LessonTranscript?
  videoYeuThich  VideoYeuThich[]   @relation("VideoYeuThichBaiGiang")

  @@index([sectionId], name: "idx_lessons_section")
  @@index([isPublished], name: "idx_lessons_published")
  @@map("lessons")
}

/// Phụ đề tiếng Anh của video bài giảng, đã LÀM SẠCH.
///
/// ⚠️ Lưu `cues` đã khử trùng lặp, KHÔNG lưu VTT thô. Phụ đề tự động của
/// YouTube chạy kiểu cửa sổ trượt: mỗi dòng lặp lại đuôi dòng trước, nên
/// bản thô 98 KB chỉ còn 13 KB sau khi ghép thành dòng từ liên tục rồi cắt
/// theo câu (đo thật 19/09/2026 trên bài 159). Nhập thô thì bảng phụ đề
/// hiện ra 70% là chữ lặp — không ai đọc nổi.
model LessonTranscript {
  id       Int    @id @default(autoincrement())
  lessonId Int    @unique @map("lesson_id")
  videoId  String @map("video_id") @db.VarChar(24)
  lang     String @default("en") @db.VarChar(12)

  /// [{ "t": giây, "en": "câu" }] — đã cắt theo câu, có mốc để chạm là tua.
  cues  Json @db.JsonB
  soCau Int  @map("so_cau")
  soTu  Int  @map("so_tu")

  /// Bản dịch tiếng Việt, sinh sau bằng Qwen máy nhà. `null` = chưa dịch.
  dichVi Json? @map("dich_vi") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([videoId], name: "idx_lesson_transcripts_video")
  @@map("lesson_transcripts")
}

/// Video do NGƯỜI DÙNG tự thêm (dán link hoặc chia sẻ từ app YouTube/TikTok).
///
/// Tách hẳn khỏi `LessonTranscript` vì nó không gắn với `Lesson` nào: bài
/// giảng là nội dung của web, còn đây là video riêng của từng người.
model VideoNguoiDung {
  id      Int    @id @default(autoincrement())
  userId  Int    @map("user_id")
  /// 'youtube' | 'tiktok'
  nguon   String @db.VarChar(16)
  videoId String @map("video_id") @db.VarChar(64)

  /// Nhóm lớn của hàng chip: hoathinh | nhac | lichsu | kinhdoanh | ...
  /// Bài giảng Academy không dùng cột này (luôn là 'academy').
  nhomLon String @default("khac") @map("nhom_lon") @db.VarChar(24)

  tieuDe String  @db.VarChar(300)
  tacGia String? @map("tac_gia") @db.VarChar(200)
  anhBia String? @map("anh_bia") @db.VarChar(600)
  giay   Int?

  /// [{ "t": giây, "en": "câu" }] — cùng dạng với `LessonTranscript.cues`.
  cues  Json @db.JsonB
  soCau Int  @map("so_cau")
  soTu  Int  @map("so_tu")

  dichVi Json? @map("dich_vi") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation("VideoNguoiDungChuSoHuu", fields: [userId], references: [id], onDelete: Cascade)

  yeuThich VideoYeuThich[] @relation("VideoYeuThichTuThem")

  @@unique([userId, nguon, videoId], name: "uk_video_nguoi_dung")
  @@index([userId], name: "idx_video_nguoi_dung_user")
  @@index([userId, nhomLon], name: "idx_video_nguoi_dung_nhom_lon")
  @@map("video_nguoi_dung")
}

/// Video yêu thích trong màn "Học bằng video".
///
/// Trỏ tới ĐÚNG MỘT nguồn: bài giảng của web hoặc video người dùng tự thêm.
/// Ràng buộc CHECK nằm trong migration (Prisma không khai được CHECK).
model VideoYeuThich {
  id            Int  @id @default(autoincrement())
  userId        Int  @map("user_id")
  lessonId      Int? @map("lesson_id")
  videoTuThemId Int? @map("video_tu_them_id")

  createdAt DateTime @default(now()) @map("created_at")

  user        User            @relation("VideoYeuThichChuSoHuu", fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson?         @relation("VideoYeuThichBaiGiang", fields: [lessonId], references: [id], onDelete: Cascade)
  videoTuThem VideoNguoiDung? @relation("VideoYeuThichTuThem", fields: [videoTuThemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], name: "idx_video_yeu_thich_user")
  @@map("video_yeu_thich")
}

// Cache câu trả lời gia sư AI cho các câu hỏi GỢI Ý cố định (chip) của một bài.
// Ai bấm cùng một chip trên cùng một bài đều nhận cùng câu trả lời — người sau
// nhận NGAY, khỏi tốn AI. Câu hỏi gõ tay (free-form) KHÔNG cache. Khoá:
// (lessonId, cacheKey, lang); cacheKey = key của chip ('start','exercises'…).
model LessonAiAnswer {
  id        Int      @id @default(autoincrement())
  lessonId  Int      @map("lesson_id")
  cacheKey  String   @map("cache_key") @db.VarChar(40)
  lang      String   @db.VarChar(4)
  answer    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, cacheKey, lang], name: "lessonId_cacheKey_lang")
  @@index([lessonId], name: "idx_lesson_ai_answers_lesson")
  @@map("lesson_ai_answers")
}

/// Một lượt hỏi gia sư AI của một bài, LƯU LẠI để người sau đọc được.
///
/// Khác `LessonAiAnswer` ở chỗ căn bản: cái kia là CACHE theo `cacheKey` của
/// mấy chip gợi ý — một câu trả lời cho một khoá, ghi đè liên tục, không có
/// người hỏi. Cái này là LỊCH SỬ: ai hỏi gì, AI trả lời ra sao, giữ nguyên văn.
///
/// Câu hỏi và câu trả lời để `@db.Text` và KHÔNG cắt ở bất cứ đâu — một câu
/// trả lời gia sư bị cắt giữa chừng còn tệ hơn không lưu, vì người đọc không
/// biết phần thiếu nằm ở đâu.
model LessonTutorAsk {
  id       Int @id @default(autoincrement())
  lessonId Int @map("lesson_id")
  userId   Int @map("user_id")

  question String @db.Text
  answer   String @db.Text

  /// 'vi' | 'en' — cùng một câu hỏi hỏi hai thứ tiếng là hai lượt khác nhau.
  lang String @default("vi") @db.VarChar(4)

  createdAt DateTime @default(now()) @map("created_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lessonId, createdAt], map: "idx_lesson_tutor_ask_lesson")
  @@index([userId], map: "idx_lesson_tutor_ask_user")
  @@map("lesson_tutor_asks")
}

model LessonDetail {
  id       Int @id @default(autoincrement())
  lessonId Int @unique(map: "uk_lesson_detail_lesson") @map("lesson_id")

  // ── The lesson's video, in up to THREE parallel tracks ──────────────────
  // A lesson can carry the instructor's own Vietnamese recording, an English
  // recording, and a curated third-party YouTube lecture at the same time;
  // the learn page shows a VN / EN / YT switcher and opens on
  // `defaultVideoTrack`. Every track is optional — a lesson with only the YT
  // link (the normal state until the courses are re-recorded) shows a single
  // pill, and a lesson with none shows no player at all.
  //
  // `videoPlatform` / `videoUrl` below are the ORIGINAL single-video columns.
  // They stay as the legacy fallback (and are kept in sync with the default
  // track on write) so every older reader — course cards, the Academy
  // curriculum, the R2 signing helpers — keeps working untouched.
  videoPlatform String  @default("EMBED") @map("video_platform") @db.VarChar(30)
  videoUrl      String? @map("video_url") @db.VarChar(500)

  // VI / EN: normally the instructor's own recording. EMBED = YouTube,
  // DIRECT = a private R2 object played through a short-lived signed URL.
  videoUrlVi      String? @map("video_url_vi") @db.VarChar(500)
  videoPlatformVi String? @map("video_platform_vi") @db.VarChar(30)
  videoUrlEn      String? @map("video_url_en") @db.VarChar(500)
  videoPlatformEn String? @map("video_platform_en") @db.VarChar(30)

  // YT: a curated third-party lecture. Always an EMBED (YouTube), and always
  // credited — `videoYtCredit` holds "Channel — Video title" so the player
  // can name the source instead of passing someone else's work off as ours.
  videoUrlYt    String? @map("video_url_yt") @db.VarChar(500)
  videoYtCredit String? @map("video_yt_credit") @db.VarChar(255)

  // 'VI' | 'EN' | 'YT' — which pill is selected when the lesson opens. Falls
  // back at read time to the first track that actually has a URL.
  defaultVideoTrack String @default("YT") @map("default_video_track") @db.VarChar(8)

  sourceCodeUrl String?  @map("source_code_url") @db.VarChar(500)
  teachingNotes String?  @map("teaching_notes") @db.Text
  // Quiz (lessonType=QUIZ): { timeLimitSeconds, questions: [{ id, question,
  // options: string[], correctIndex, points }] }. Student answers are NOT
  // stored — the quiz is replayable and scored client-side on submit.
  quizData      Json?    @map("quiz_data")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_details")
}

model CourseDocument {
  id            Int      @id @default(autoincrement())
  // A document belongs to EITHER a lesson (lessonId) OR the whole course
  // (courseId) — the fixed "Tài liệu" area shown at course level. Exactly
  // one is set; both are nullable so the same table backs both.
  lessonId      Int?     @map("lesson_id")
  courseId      Int?     @map("course_id")
  title         String   @db.VarChar(255)
  fileUrl       String   @map("file_url") @db.VarChar(500)
  fileSizeBytes BigInt   @default(0) @map("file_size_bytes")
  fileType      String?  @map("file_type") @db.VarChar(50)
  downloadCount Int      @default(0) @map("download_count")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([lessonId], name: "idx_documents_lesson")
  @@index([courseId], name: "idx_documents_course")
  @@map("course_documents")
}

// ─────────────────────────────────────────────────────────────────────
// Exam Room (Phòng thi) — a real FPTU-style exam experience attached to a
// Course. Two kinds:
//   • FE (Final Exam)     → multiple-choice, auto-graded (single & multi-select).
//   • PE (Practical Exam) → peType CODE | WRITE | SPEAK.
// Attempts are persisted with full history (score, answers, AI feedback).
// Real exam papers are imported from scanned images via a seed script; the
// "Final Exam" lesson chapters remain as study/guide material and link here.
// ─────────────────────────────────────────────────────────────────────
model Exam {
  id               Int      @id @default(autoincrement())
  courseId         Int      @map("course_id")
  // 'FE' = Final Exam (multiple choice) | 'PE' = Practical Exam
  kind             String   @default("FE") @db.VarChar(10)
  // For PE only: 'CODE' | 'WRITE' | 'SPEAK'. Null for FE.
  peType           String?  @map("pe_type") @db.VarChar(10)
  // Bilingual "EN|||VI".
  title            String   @db.VarChar(255)
  description      String?  @db.Text
  // Distinguishes multiple papers per course, e.g. "SP26", "FA25", "Đề 1".
  code             String?  @db.VarChar(60)
  durationMinutes  Int      @default(60) @map("duration_minutes")
  totalPoints      Decimal  @default(10) @map("total_points") @db.Decimal(6, 2)
  passMark         Decimal  @default(4) @map("pass_mark") @db.Decimal(6, 2)
  shuffleQuestions Boolean  @default(false) @map("shuffle_questions")
  shuffleOptions   Boolean  @default(false) @map("shuffle_options")
  // 'REAL' (đề trường thật) | 'SAMPLE' (tự soạn).
  source           String   @default("SAMPLE") @db.VarChar(10)
  // Bilingual exam-room instructions (HTML with .ml-en/.ml-vi).
  instructions     String?  @db.Text
  // Optional downloadable starter/"Given" file (PE): students download,
  // extract, and work on it. URL (public path or R2) + display name.
  attachmentUrl    String?  @map("attachment_url") @db.VarChar(500)
  attachmentName   String?  @map("attachment_name") @db.VarChar(200)
  isPublished      Boolean  @default(false) @map("is_published")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  course            Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions         ExamQuestion[]
  attempts          ExamAttempt[]
  bookmarks         ExamBookmark[]
  questionBookmarks ExamQuestionBookmark[]
  comments          ExamQuestionComment[]

  @@index([courseId], name: "idx_exams_course")
  @@index([courseId, kind], name: "idx_exams_course_kind")
  @@index([isPublished], name: "idx_exams_published")
  @@map("exams")
}

model ExamQuestion {
  id              Int      @id @default(autoincrement())
  examId          Int      @map("exam_id")
  // 'MCQ' (FE) | 'CODE' | 'WRITE' | 'SPEAK' (PE)
  kind            String   @default("MCQ") @db.VarChar(10)
  sortOrder       Int      @default(0) @map("sort_order")
  points          Decimal  @default(1) @db.Decimal(6, 2)
  // Bilingual prompt / problem statement (HTML; long PE uses .ml-en/.ml-vi).
  prompt          String   @db.Text
  // Optional scanned question image stored in R2.
  imageUrl        String?  @map("image_url") @db.VarChar(500)
  // ── MCQ (FE) ──
  // options: [{ text: "EN|||VI" }, ...]
  options         Json?    @db.JsonB
  // Supports single- AND multi-select ("choose two correct answers").
  correctIndexes  Int[]    @default([]) @map("correct_indexes")
  // Bilingual "why this is the answer" (EN|||VI or ml-* HTML).
  explanation     String?  @db.Text
  // ── PE ──
  language        String?  @db.VarChar(30)
  starterCode     String?  @map("starter_code") @db.Text
  // Reference solution the author wrote & test-ran (revealed after grading).
  sampleSolution  String?  @map("sample_solution") @db.Text
  // Example console I/O expected by the problem.
  expectedOutput  String?  @map("expected_output") @db.Text
  // rubric: [{ id, criterion: "EN|||VI", weight, maxScore }]
  rubric          Json?    @db.JsonB
  // SPEAK: derived sub-questions [{ text: "EN|||VI" }].
  speakingPrompts Json?    @map("speaking_prompts") @db.JsonB
  // Chương (CourseSection) mà câu hỏi này thuộc về — để "học chương nào luyện câu
  // chương đó" trong Academy. Nullable + additive: câu cũ chưa gán vẫn chạy bình
  // thường; được điền dần bằng scripts/exam-classify-chapters.mjs (AI phân loại).
  sectionId       Int?     @map("section_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  exam      Exam                   @relation(fields: [examId], references: [id], onDelete: Cascade)
  section   CourseSection?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  bookmarks ExamQuestionBookmark[]
  comments  ExamQuestionComment[]

  @@index([examId], name: "idx_exam_questions_exam")
  @@index([sectionId], name: "idx_exam_questions_section")
  @@map("exam_questions")
}

// Bản đồ BỀN câu hỏi → chương, theo NỘI DUNG câu (promptHash) chứ không theo id.
// Re-seed đề xoá+tạo lại câu (id đổi, section_id mất) nhưng nội dung câu giữ
// nguyên → map này sống sót. Khoá chương dùng CourseSection.sortOrder (vị trí,
// bền) chứ không dùng sectionId. Phân loại AI ghi vào đây 1 lần; script
// exam-reapply-chapters.mjs (không AI) khớp câu hiện tại theo promptHash → sortOrder
// → sectionId hiện tại, chạy định kỳ (cron) để tự lành sau mỗi lần re-seed.
model ExamChapterMap {
  id           Int      @id @default(autoincrement())
  courseCode   String   @map("course_code") @db.VarChar(40)
  promptHash   String   @map("prompt_hash") @db.VarChar(64)
  sectionOrder Int      @map("section_order")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([courseCode, promptHash], name: "uk_exam_chapter_map")
  @@index([courseCode], name: "idx_exam_chapter_map_course")
  @@map("exam_chapter_map")
}

model ExamAttempt {
  id               Int       @id @default(autoincrement())
  // No FK to User (interview pattern) — keeps the migration additive.
  userId           Int       @map("user_id")
  examId           Int       @map("exam_id")
  // IN_PROGRESS | SUBMITTED | GRADED | EXPIRED
  status           String    @default("IN_PROGRESS") @db.VarChar(15)
  startedAt        DateTime  @default(now()) @map("started_at")
  submittedAt      DateTime? @map("submitted_at")
  // startedAt + durationMinutes — used for server-side timer enforcement.
  expiresAt        DateTime? @map("expires_at")
  timeSpentSeconds Int       @default(0) @map("time_spent_seconds")
  score            Decimal?  @db.Decimal(6, 2)
  maxScore         Decimal?  @map("max_score") @db.Decimal(6, 2)
  passed           Boolean?
  // Per-question answers keyed by questionId:
  //   MCQ   → number[] (selected indexes)
  //   CODE  → { zipR2Key, fileName }
  //   WRITE → string (English essay)
  //   SPEAK → { audioR2Keys: string[], transcripts: string[] }
  answers          Json      @default("{}") @db.JsonB
  // Per-question grading + overall AI feedback.
  feedback         Json?     @db.JsonB
  // Anti-cheat: { tabSwitches, blurCount, ... }.
  integritySignals Json?     @map("integrity_signals") @db.JsonB
  // AUTO (FE) | AI | MANUAL | SELF (PE)
  gradingMode      String    @default("AUTO") @map("grading_mode") @db.VarChar(10)
  // "Start Exam with CuongMini" (Pro only) — gates the live per-question AI
  // chat/reveal-answer routes. Set once at attempt creation, never after.
  aiAssisted       Boolean   @default(false) @map("ai_assisted")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([userId, examId], name: "idx_exam_attempts_user_exam")
  @@index([examId], name: "idx_exam_attempts_exam")
  @@index([userId, status], name: "idx_exam_attempts_user_status")
  @@map("exam_attempts")
}

// A student saving a whole exam paper to retake later ("Đề đã lưu").
model ExamBookmark {
  id        Int      @id @default(autoincrement())
  // No FK to User (matches ExamAttempt / interview pattern → additive migration).
  userId    Int      @map("user_id")
  examId    Int      @map("exam_id")
  createdAt DateTime @default(now()) @map("created_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId], name: "uk_exam_bookmark")
  @@index([userId], name: "idx_exam_bookmarks_user")
  @@map("exam_bookmarks")
}

// A student saving a single question they found hard/interesting, with an
// optional personal note. Auto-foldered by semester → subject on the client
// via the denormalized examId → course. ("Sổ tay ôn tập" — câu đã lưu.)
model ExamQuestionBookmark {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  questionId Int      @map("question_id")
  // Denormalized so the notebook can group by exam/course without a join hop.
  examId     Int      @map("exam_id")
  note       String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  exam     Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId], name: "uk_exam_question_bookmark")
  @@index([userId], name: "idx_exam_qbookmarks_user")
  @@index([examId], name: "idx_exam_qbookmarks_exam")
  @@map("exam_question_bookmarks")
}

// Bình luận/trao đổi ngay dưới MỘT câu hỏi cụ thể (mọi tài khoản, không chỉ
// người đang thi câu đó) — theo mẫu TechTrendComment/SocialComment (1 cấp
// trả lời qua parentId). isAi=true khi CuongMini tự đăng câu trả lời của nó
// (userId vẫn trỏ về một User thật — tài khoản "cuongmini", xem
// scripts seed — không có cột isBot riêng trên User để giữ migration nhỏ).
//
// BỀN qua re-seed đề (xem deploy.sh "Exam Room seed" — xoá+tạo lại TOÀN BỘ
// ExamQuestion mỗi deploy, id đổi mỗi lần): questionId là CACHE nhanh, có
// thể null tạm sau reseed; examId (không đổi) + promptHash (nội dung câu,
// cùng thuật toán scripts/_exam-hash.mjs) là khoá THẬT để
// scripts/exam-reapply-comments.mjs nối lại questionId đúng câu mới sau mỗi
// deploy — giống hệt cơ chế ExamChapterMap cho sectionId, không có bản đồ
// riêng: promptHash nằm ngay trên chính dòng bình luận.
model ExamQuestionComment {
  id         Int      @id @default(autoincrement())
  examId     Int      @map("exam_id")
  questionId Int?     @map("question_id")
  promptHash String   @map("prompt_hash") @db.VarChar(64)
  userId     Int      @map("user_id")
  parentId   Int?     @map("parent_id")
  content    String   @db.Text
  isAi       Boolean  @default(false) @map("is_ai")
  isEdited   Boolean  @default(false) @map("is_edited")
  likesCount Int      @default(0) @map("likes_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  exam     Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  question ExamQuestion?         @relation(fields: [questionId], references: [id], onDelete: SetNull)
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   ExamQuestionComment?  @relation("ExamQuestionCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ExamQuestionComment[] @relation("ExamQuestionCommentReplies")

  @@index([questionId], name: "idx_exam_qcomments_question")
  @@index([examId, promptHash], name: "idx_exam_qcomments_reapply")
  @@index([parentId], name: "idx_exam_qcomments_parent")
  @@index([userId], name: "idx_exam_qcomments_user")
  @@map("exam_question_comments")
}

model Enrollment {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  courseId        Int       @map("course_id")
  enrolledAt      DateTime  @default(now()) @map("enrolled_at")
  expiresAt       DateTime? @map("expires_at")
  status          String    @default("ACTIVE") @db.VarChar(20)
  progressPercent Decimal   @default(0) @map("progress_percent") @db.Decimal(5, 2)
  lastLessonId    Int?      @map("last_lesson_id")
  lastAccessedAt  DateTime? @map("last_accessed_at")
  courseCodeId    Int?      @map("course_code_id")
  // How the user gained access: 'FREE' | 'PAID' | 'CODE' | 'ADMIN' | 'INSTRUCTOR'
  source          String    @default("FREE") @db.VarChar(20)

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificate    Certificate?
  lessonProgress LessonProgress[]
  usedCourseCode CourseCode?      @relation(fields: [courseCodeId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId], map: "uk_enrollment_user_course")
  @@index([userId], name: "idx_enrollments_user")
  @@index([courseId], name: "idx_enrollments_course")
  @@index([status], name: "idx_enrollments_status")
  @@index([userId, status], name: "idx_enrollments_user_status")
  @@index([courseId, status], name: "idx_enrollments_course_status")
  @@index([expiresAt], name: "idx_enrollments_expires_at")
  @@map("enrollments")
}

model CourseCode {
  id        Int       @id @default(autoincrement())
  code      String    @db.VarChar(10)
  courseId  Int       @map("course_id")
  maxUses   Int       @default(1) @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  isActive  Boolean   @default(true) @map("is_active")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@unique([courseId, code], map: "uk_course_code_course_code")
  @@index([code], name: "idx_course_codes_code")
  @@index([courseId], name: "idx_course_codes_course")
  @@map("course_codes")
}

model LessonProgress {
  id                  Int       @id @default(autoincrement())
  enrollmentId        Int       @map("enrollment_id")
  lessonId            Int       @map("lesson_id")
  isCompleted         Boolean   @default(false) @map("is_completed")
  completedAt         DateTime? @map("completed_at")
  watchTimeSeconds    Int       @default(0) @map("watch_time_seconds")
  lastPositionSeconds Int       @default(0) @map("last_position_seconds")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId], map: "uk_progress_enrollment_lesson")
  @@index([enrollmentId], name: "idx_progress_enrollment")
  @@index([lessonId], name: "idx_progress_lesson")
  @@map("lesson_progress")
}

model Assignment {
  id           Int       @id @default(autoincrement())
  lessonId     Int       @map("lesson_id")
  title        String    @db.VarChar(255)
  instructions String?   @db.Text
  deadline     DateTime? @db.Timestamp(6)
  sortOrder    Int       @default(0) @map("sort_order")
  isPublished  Boolean   @default(true) @map("is_published")
  maxScore     Float     @default(10.0) @map("max_score")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  lesson      Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([lessonId], name: "idx_assignments_lesson")
  @@map("assignments")
}

model AssignmentSubmission {
  id            Int      @id @default(autoincrement())
  assignmentId  Int      @map("assignment_id")
  userId        Int      @map("user_id")
  submissionUrl String   @map("submission_url") @db.VarChar(500)
  notes         String?  @db.Text
  status        String   @default("SUBMITTED") @db.VarChar(30)
  grade         Float?   @db.DoublePrecision
  feedback      String?  @db.Text
  submittedAt   DateTime @default(now()) @map("submitted_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId], map: "uk_submission_assignment_user")
  @@index([assignmentId], name: "idx_assignment_submissions_assignment")
  @@index([userId], name: "idx_assignment_submissions_user")
  @@map("assignment_submissions")
}

model Certificate {
  id                Int       @id @default(autoincrement())
  certificateNumber String    @unique(map: "uk_certificate_number") @db.VarChar(64)
  userId            Int       @map("user_id")
  courseId          Int       @map("course_id")
  enrollmentId      Int?      @unique @map("enrollment_id")
  issuedAt          DateTime? @map("issued_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId], map: "uk_certificate_user_course")
  @@map("certificates")
}

model CourseReview {
  id         Int      @id @default(autoincrement())
  courseId   Int      @map("course_id")
  userId     Int      @map("user_id")
  rating     Int
  title      String?  @db.VarChar(255)
  content    String?  @db.Text
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId], map: "uk_review_course_user")
  @@index([courseId], name: "idx_reviews_course")
  @@index([userId], name: "idx_reviews_user")
  @@map("course_reviews")
}

model CourseTag {
  id        Int      @id @default(autoincrement())
  courseId  Int      @map("course_id")
  tag       String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId], name: "idx_course_tags_course")
  @@map("course_tags")
}

// ============================================================
// 7. SHOP MODULE (E-Commerce)
// ============================================================

model ProductCategory {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  slug        String? @db.VarChar(100)
  description String? @db.Text
  sortOrder   Int     @default(0) @map("sort_order")

  products Product[]

  @@map("product_categories")
}

model Product {
  id               Int      @id @default(autoincrement())
  name             String   @unique @db.VarChar(255)
  slug             String   @unique(map: "uk_product_slug") @db.VarChar(255)
  description      String?  @db.Text
  shortDescription String?  @map("short_description") @db.VarChar(500)
  thumbnailUrl     String?  @map("thumbnail_url") @db.VarChar(500)
  images           String?  @db.Text
  price            Decimal  @db.Decimal(10, 2)
  originalPrice    Decimal? @map("original_price") @db.Decimal(10, 2)
  stockQuantity    Int      @default(0) @map("stock_quantity")
  soldCount        Int      @default(0) @map("sold_count")
  featured         Boolean  @default(false)
  isHot            Boolean  @default(false) @map("is_hot")
  isNew            Boolean  @default(false) @map("is_new")
  active           Boolean  @default(true)
  // Manual display order (admin-sortable). Lower = shown first.
  sortOrder        Int      @default(0) @map("sort_order")
  categoryId       Int?     @map("category_id")
  // PHYSICAL (needs shipping) | DIGITAL (delivered instantly on payment)
  type             String   @default("DIGITAL") @db.VarChar(20)
  fileUrl          String?  @map("file_url") @db.VarChar(500)
  // Digital deliverable shown to the buyer after payment: account info,
  // activation/license key, redemption link, etc. (guidance = how to use it).
  digitalContent   String?  @map("digital_content") @db.Text
  specs            Json     @default("{}") @db.JsonB
  guidance         String?  @db.Text
  // Denormalized review aggregates (recomputed on review add/moderate/delete).
  ratingAvg        Decimal  @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount      Int      @default(0) @map("rating_count")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  category ProductCategory? @relation(fields: [categoryId], references: [id])
  reviews  ProductReview[]
  keys     ProductKey[]

  @@index([categoryId], name: "idx_products_category")
  @@index([active], map: "idx_products_active")
  @@index([featured], map: "idx_products_featured")
  @@index([createdAt(sort: Desc)], name: "idx_products_created")
  @@map("products")
}

// A pool of UNIQUE digital deliverables (license keys, accounts, credentials)
// for a digital product. Each buyer is assigned ONE previously-unassigned key
// at fulfillment, so two buyers never get the same key. Products with no keys
// fall back to the single `Product.digitalContent` (legacy behaviour).
model ProductKey {
  id          Int       @id @default(autoincrement())
  productId   Int       @map("product_id")
  // The actual credential handed to the buyer (account, key, etc.).
  content     String    @db.Text
  // AVAILABLE = in stock; SOLD = assigned to a buyer; DISABLED = withheld.
  status      String    @default("AVAILABLE") @db.VarChar(20)
  orderItemId Int?      @map("order_item_id")
  buyerUserId Int?      @map("buyer_user_id")
  assignedAt  DateTime? @map("assigned_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status], name: "idx_product_keys_product_status")
  @@map("product_keys")
}

model ShopOrder {
  id                Int       @id @default(autoincrement())
  orderCode         String    @unique(map: "uk_order_code") @db.VarChar(50)
  userId            Int?      @map("user_id")
  buyerName         String    @map("buyer_name") @db.VarChar(255)
  buyerEmail        String    @map("buyer_email") @db.VarChar(255)
  buyerPhone        String?   @map("buyer_phone") @db.VarChar(50)
  buyerAddress      String?   @map("buyer_address") @db.Text
  subtotal          Decimal   @db.Decimal(10, 2)
  discountAmount    Decimal   @default(0) @map("discount_amount")
  discountCode      String?   @map("discount_code") @db.VarChar(50)
  total             Decimal   @db.Decimal(10, 2)
  // Payment/main status: PENDING | PAID | CANCELLED | FAILED | REFUNDED
  status            String    @db.VarChar(20)
  // PHYSICAL | DIGITAL | MIXED — derived from the items at checkout.
  orderType         String    @default("DIGITAL") @map("order_type") @db.VarChar(20)
  // Shipping / fulfillment lifecycle (physical goods): PENDING | PROCESSING |
  // SHIPPED | DELIVERED | COMPLETED. Digital orders jump straight to COMPLETED.
  fulfillmentStatus String    @default("PENDING") @map("fulfillment_status") @db.VarChar(20)
  shippingFee       Decimal   @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  shippingProvince  String?   @map("shipping_province") @db.VarChar(120)
  trackingNumber    String?   @map("tracking_number") @db.VarChar(120)
  shippedAt         DateTime? @map("shipped_at")
  deliveredAt       DateTime? @map("delivered_at")
  paymentMethod     String    @default("SIMULATED") @map("payment_method") @db.VarChar(50)
  paymentStatus     String    @default("PENDING") @map("payment_status") @db.VarChar(20)
  paymentId         String?   @map("payment_id") @db.VarChar(100)
  paidAt            DateTime? @map("paid_at")
  // ─── Refund tracking (set by admin, mirrors CourseOrder) ──
  // refundAmount: how much was actually returned (partial ≤ total). Null = not refunded.
  refundAmount      Decimal?  @map("refund_amount") @db.Decimal(10, 2)
  refundReason      String?   @map("refund_reason") @db.VarChar(500)
  refundedAt        DateTime? @map("refunded_at")
  refundedBy        Int?      @map("refunded_by")
  notes             String?   @db.Text
  // ─── Thêm 13/09/2026 ────────────────────────────────────────────
  // Số điểm đã trừ từ ví cho đơn này (0 = trả hoàn toàn bằng tiền).
  pointsUsed        Int       @default(0) @map("points_used")
  // Đơn chưa trả hết hạn sau ngần này thì không cho trả nữa. Chặn cảnh
  // người mua mở tab hôm qua, hôm nay bấm trả, trong khi giá/tồn đã đổi.
  expiresAt         DateTime? @map("expires_at")
  // Khoá client sinh, chặn double-click đẻ ra hai đơn giống hệt.
  idempotencyKey    String?   @map("idempotency_key") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user            User?                   @relation(fields: [userId], references: [id])
  items           ShopOrderItem[]
  keyReplacements KeyReplacementRequest[]

  @@unique([userId, idempotencyKey], name: "uk_shop_order_idempotency")
  @@index([userId], name: "idx_orders_user")
  @@index([status], name: "idx_orders_status")
  @@index([createdAt(sort: Desc)], name: "idx_orders_created")
  @@index([status, createdAt(sort: Desc)], name: "idx_orders_status_created")
  @@map("shop_orders")
}

model ShopOrderItem {
  id             Int     @id @default(autoincrement())
  orderId        Int     @map("order_id")
  productName    String  @map("product_name") @db.VarChar(255)
  productSlug    String? @map("product_slug") @db.VarChar(255)
  productImage   String? @map("product_image") @db.VarChar(500)
  price          Decimal @db.Decimal(10, 2)
  quantity       Int     @default(1)
  total          Decimal @db.Decimal(10, 2)
  productType    String? @map("product_type") @db.VarChar(20)
  fileUrl        String? @map("file_url") @db.VarChar(500)
  // Snapshot of the digital deliverable at purchase time (account/key/guide).
  digitalContent String? @map("digital_content") @db.Text
  credentials    String? @db.Text

  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // NOTE: productName/productImage/price/fileUrl are DENORMALIZED snapshots of
  // the product at purchase time — intentionally NOT a live FK to Product, so
  // a product can be renamed or deleted without breaking order history. The
  // fulfillment path matches products by name separately (no relation needed).

  @@index([orderId], name: "idx_order_items_order")
  @@map("shop_order_items")
}

// A user's personal "code wallet" — discount codes, course activation
// codes, etc. Rows are either typed in by the user (source=MANUAL) or
// auto-saved when the user actually uses a code (source=AUTO), e.g. on
// course-code activation or certificate → 10% coupon redemption.
model UserSavedCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  label     String    @db.VarChar(120)
  code      String    @db.VarChar(80)
  // DISCOUNT | COURSE | OTHER
  codeType  String    @default("OTHER") @map("code_type") @db.VarChar(20)
  note      String?   @db.VarChar(255)
  expiresAt DateTime? @map("expires_at")
  // MANUAL (typed by the user) | AUTO (saved on use)
  source    String    @default("MANUAL") @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code], map: "uk_user_saved_code")
  @@index([userId], name: "idx_user_saved_code_user")
  @@map("user_saved_codes")
}

// Verified-purchase product reviews (star rating + optional comment). One
// review per user per product; the aggregate is denormalized onto Product.
model ProductReview {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  userId     Int      @map("user_id")
  rating     Int
  comment    String?  @db.Text
  isApproved Boolean  @default(true) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId], map: "uk_product_review_user")
  @@index([productId], name: "idx_product_review_product")
  @@map("product_reviews")
}

model DiscountCode {
  id                Int       @id @default(autoincrement())
  code              String    @unique(map: "uk_discount_code") @db.VarChar(50)
  userId            Int?      @map("user_id")
  discountType      String    @default("PERCENT") @map("discount_type") @db.VarChar(20)
  discountValue     Decimal   @db.Decimal(10, 2)
  minOrderAmount    Decimal   @default(0) @map("min_order_amount") @db.Decimal(10, 2)
  maxDiscountAmount Decimal?  @map("max_discount_amount") @db.Decimal(10, 2)
  maxUses           Int?      @map("max_uses")
  usedCount         Int       @default(0) @map("used_count")
  startsAt          DateTime? @map("starts_at")
  expiresAt         DateTime? @map("expires_at")
  active            Boolean   @default(true)
  description       String?   @db.VarChar(255)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseOrders CourseOrder[]

  @@index([code], name: "idx_discount_code")
  @@index([userId], name: "idx_discount_code_user_id")
  @@map("discount_codes")
}

// ============================================================
// 7b. ORPHANED UPLOAD CLEANUP
// Tracks uploads that have been started but not yet linked to a post.
// Used to clean up orphaned R2 objects from:
//   - User navigated away mid-upload
//   - Network timeout / browser crash
//   - Post submission that somehow skipped the media (e.g. bug)
// ============================================================
model PendingUpload {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  r2Key     String   @map("r2_key") @db.VarChar(700)
  url       String   @db.VarChar(700)
  thumbnail String?  @db.VarChar(700)
  fileSize  BigInt   @map("file_size")
  mimeType  String   @map("mime_type") @db.VarChar(100)
  fileName  String?  @map("file_name") @db.VarChar(255)
  status    String   @default("PENDING") @map("status") @db.VarChar(20)
  // PENDING = uploaded to R2, waiting to be linked to a post
  // CONFIRMED = successfully linked to a SocialMedia row
  // EXPIRED = cron job marked as orphaned, R2 object deleted
  expiresAt DateTime @updatedAt @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One pending upload per (user, R2 key). If the user re-uploads
  // the same file, we refresh the TTL instead of creating a duplicate.
  @@unique([userId, r2Key], map: "uk_pending_upload_user_key")
  @@index([userId, status], name: "idx_pending_upload_user_status")
  @@index([status, expiresAt], name: "idx_pending_upload_status_expires")
  @@map("pending_uploads")
}

// ============================================================
// 8. MUSIC MODULE (Spotify Clone)
// ============================================================

model MusicTrack {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(255)
  artist          String    @db.VarChar(255)
  audioUrl        String?   @map("audio_url") @db.VarChar(700)
  coverImage      String?   @map("cover_image") @db.VarChar(700)
  durationSeconds Int?      @map("duration_seconds")
  fileSize        BigInt?   @map("file_size")
  publicId        String?   @map("public_id") @db.VarChar(500)
  cloudinaryUrl   String?   @map("cloudinary_url") @db.VarChar(700)
  supabasePath    String?   @map("supabase_path") @db.VarChar(500)
  localPath       String?   @map("local_path") @db.VarChar(500)
  // Content bucket: "NORMAL" (regular music, the default) or "REMIX"
  // (DJ / remix tracks shown ONLY on the /music/remix deck, never in the
  // normal library or the "Tất cả" listing). Filtered server-side in
  // musicService.getTracks so the two libraries stay fully separated.
  category        String    @default("NORMAL") @db.VarChar(16)
  // Loại theo NGÔN NGỮ cho bộ lọc Nhạc Việt / Anh / Trung (05/10/2026): "vi" | "en" | "zh".
  // Trống = chưa ai gán — app tự đoán theo tên bài (chữ Hán → zh, có dấu tiếng Việt → vi).
  language        String?   @map("language") @db.VarChar(8)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime? @updatedAt @map("updated_at")

  playlists  MusicPlaylistTrack[]
  histories  MusicHistory[]
  queueItems MusicQueueItem[]
  likes      MusicLike[]
  playCounts MusicPlayCount[]
  lyrics     MusicLyrics?

  @@index([category], name: "idx_music_tracks_category")
  @@map("music_tracks")
}

model MusicPlaylist {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  coverUrl    String?  @map("cover_url") @db.VarChar(700)
  userId      Int?     @map("user_id")
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user   User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks MusicPlaylistTrack[]
  /// Người được chủ playlist chia sẻ riêng (05/10/2026) — chỉ có tác dụng khi isPublic = false.
  shares MusicPlaylistShare[]

  @@index([userId], name: "idx_playlists_user")
  @@map("music_playlists")
}

/// Playlist RIÊNG TƯ chia sẻ cho người được chỉ định (05/10/2026). Ba chế độ suy từ dữ liệu:
/// isPublic = true → công khai · isPublic = false + không dòng nào ở đây → riêng tư · có dòng → chia sẻ.
model MusicPlaylistShare {
  id         Int      @id @default(autoincrement())
  playlistId Int      @map("playlist_id")
  userId     Int      @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  playlist MusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId], name: "uk_playlist_share", map: "uk_playlist_share")
  @@index([userId], name: "idx_playlist_share_user")
  @@map("music_playlist_shares")
}

model MusicPlaylistTrack {
  id         Int      @id @default(autoincrement())
  playlistId Int      @map("playlist_id")
  trackId    Int      @map("track_id")
  position   Int      @default(0)
  addedAt    DateTime @default(now()) @map("added_at")

  playlist MusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    MusicTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId], map: "uk_playlist_track")
  @@index([playlistId], name: "idx_playlist_tracks_playlist")
  @@index([trackId], name: "idx_playlist_tracks_track")
  @@map("music_playlist_tracks")
}

// ============================================================
// 8b. MUSIC LISTENING HISTORY
// ============================================================
model MusicHistory {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  trackId  Int      @map("track_id")
  playedAt DateTime @default(now()) @map("played_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  track MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId], name: "music_history_user_track_unique")
  @@index([userId, playedAt(sort: Desc)], name: "idx_history_user_time")
  @@index([userId], name: "idx_history_user")
  @@map("music_history")
}

// ============================================================
// 8c. MUSIC PLAY QUEUE (Phase 1)
// ============================================================
model MusicQueueItem {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  trackId   Int      @map("track_id")
  position  Float    @default(0)
  intent    String   @default("queue") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  track MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId], name: "music_queue_user_track_unique")
  @@index([userId, position], name: "idx_queue_user_position")
  @@map("music_queue_items")
}

// ============================================================
// 8d. MUSIC LIKES (Phase 2a)
// ============================================================
// One row per (userId, trackId). Idempotent: a "like" is an INSERT,
// an "unlike" is a DELETE. The unique constraint enforces this at
// the DB layer; the service uses upsert+delete to keep the API
// "fire and forget".
model MusicLike {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  trackId   Int      @map("track_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  track MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId], name: "music_likes_user_track_unique")
  @@index([trackId], name: "idx_music_likes_track")
  @@index([userId, createdAt(sort: Desc)], name: "idx_music_likes_user_recent")
  @@map("music_likes")
}

// ============================================================
// 8e. MUSIC PLAY COUNTS (Phase 2a)
// ============================================================
// One row per (userId, trackId). `count` is incremented each time
// the user actually plays the track (driven by the existing
// POST /api/v1/music/history endpoint, no new round-trip).
//
// Why a separate table instead of GROUP BY MusicHistory?
// MusicHistory is unique-on-(userId, trackId) (last-play semantics),
// so it can only count "did the user ever play this". To answer
// "how many times has the user played this" we need an additive
// counter that survives repeats — that's what this table is for.
//
// `lastPlayedAt` is denormalized so the "Most Played" sort can
// break ties with recency without joining MusicHistory.
model MusicPlayCount {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  trackId      Int      @map("track_id")
  count        Int      @default(0)
  lastPlayedAt DateTime @default(now()) @map("last_played_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  track MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId], name: "music_play_counts_user_track_unique")
  @@index([userId, count(sort: Desc)], name: "idx_music_play_counts_user_count")
  @@map("music_play_counts")
}

// ============================================================
// 8f. MUSIC LYRICS (Phase 2b) — synced karaoke lyrics
// ============================================================
// One row per track (1:1, UNIQUE track_id). `synced` holds the
// time-synced lines as JSON: [{ "t": <seconds:number>, "text": <string> }]
// sorted ascending by `t`. `plain` is a newline-separated fallback
// used when a track has lyrics but no timestamps (format='plain').
// `format` lets the client decide between karaoke-scroll and a plain
// block without inspecting the JSON. Editing is an idempotent upsert
// on the unique track_id, so re-saving never creates a duplicate row.
model MusicLyrics {
  id          Int      @id @default(autoincrement())
  trackId     Int      @unique @map("track_id")
  format      String   @default("synced") @db.VarChar(16)
  synced      Json?
  plain       String?  @db.Text
  updatedById Int?     @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  track MusicTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@map("music_lyrics")
}

// ============================================================
// 9. DEV POSTS (Source Code Hub / Social Sharing)
// ============================================================

model DevPost {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(255)
  description   String?  @db.Text
  content       String?  @db.Text
  sourceUrl     String?  @map("source_url") @db.VarChar(555)
  videoUrl      String?  @map("video_url") @db.VarChar(555)
  downloadCount Int      @default(0) @map("download_count")
  category      String   @default("General") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  comments PostComment[]

  @@index([category], name: "idx_dev_posts_category")
  @@index([downloadCount(sort: Desc)], name: "idx_dev_posts_download_count")
  @@map("dev_posts")
}

model PostComment {
