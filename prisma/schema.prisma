// ===== NOTEBOOK — per-user, per-language, nested folders =====
model LangNotebookFolder {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  languageId Int      @map("language_id")
  parentId   Int?     @map("parent_id")
  name       String   @db.VarChar(120)
  icon       String?  @db.VarChar(64)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User                 @relation("UserLangNotebookFolders", fields: [userId], references: [id], onDelete: Cascade)
  language Language             @relation(fields: [languageId], references: [id], onDelete: Cascade)
  parent   LangNotebookFolder?  @relation("LangNbSub", fields: [parentId], references: [id], onDelete: Cascade)
  children LangNotebookFolder[] @relation("LangNbSub")
  entries  LangNotebookEntry[]

  @@index([userId, languageId, sortOrder], name: "idx_lang_nb_folder_user")
  @@map("lang_notebook_folders")
}

model LangNotebookEntry {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  languageId     Int       @map("language_id")
  folderId       Int?      @map("folder_id")
  kind           String    @default("note") @db.VarChar(32) // note | explanation | vocab | grammar | pronunciation | writing
  title          String    @db.VarChar(255)
  body           String    @db.Text // markdown
  reading        String?   @db.VarChar(255)
  meaning        String?   @db.Text
  sortOrder      Int       @default(0) @map("sort_order")
  // SRS (simplified SM-2) — spaced-repetition review of saved entries.
  easeFactor     Float     @default(2.5) @map("ease_factor")
  intervalDays   Int       @default(0) @map("interval_days")
  repetitions    Int       @default(0)
  nextReviewAt   DateTime? @map("next_review_at")
  lastReviewedAt DateTime? @map("last_reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user     User                @relation("UserLangNotebookEntries", fields: [userId], references: [id], onDelete: Cascade)
  language Language            @relation(fields: [languageId], references: [id], onDelete: Cascade)
  folder   LangNotebookFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId, languageId, folderId], name: "idx_lang_nb_entry_user")
  @@index([userId, nextReviewAt], name: "idx_lang_nb_entry_due")
  @@map("lang_notebook_entries")
}

// ============================================================
// MONEYFLOW — Personal finance module (Phase 1)
// ------------------------------------------------------------
// Private, per-user data. Every model carries `userId Int` and is
// ALWAYS queried with `where: { userId }` in the service layer —
// the id is derived from the server session (req.userId), never
// from the client. Money is Decimal(18,2); no floats anywhere.
// Type/status fields are plain strings (validated in the route
// layer with express-validator) rather than Prisma enums so the
// vocab can grow without a migration.
// ============================================================

// ===== WALLETS (accounts) =====
model Wallet {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  name       String   @db.VarChar(120) // "Tiền mặt", "Vietcombank", "Momo"
  type       String   @db.VarChar(20) // CASH | BANK | EWALLET | OTHER
  icon       String?  @db.VarChar(40) // emoji or icon name
  color      String?  @db.VarChar(20) // hex for UI
  balance    Decimal  @default(0) @db.Decimal(18, 2) // maintained by transactions
  currency   String   @default("VND") @db.VarChar(8)
  isArchived Boolean  @default(false) @map("is_archived")
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  adjustments WalletAdjustment[]

  @@index([userId], name: "idx_fin_wallets_user")
  @@map("finance_wallets")
}

// Audit trail for manual balance adjustments and wallet-to-wallet
// transfers. A transfer creates a matched pair (out of A, into B).
model WalletAdjustment {
  id                   Int      @id @default(autoincrement())
  userId               Int      @map("user_id")
  walletId             Int      @map("wallet_id")
  kind                 String   @db.VarChar(20) // ADJUSTMENT | TRANSFER
  amount               Decimal  @db.Decimal(18, 2) // signed: + credit, - debit
  balanceAfter         Decimal  @map("balance_after") @db.Decimal(18, 2)
  counterpartyWalletId Int?     @map("counterparty_wallet_id") // the other side of a transfer
  reason               String?  @db.Text
  createdAt            DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, walletId], name: "idx_fin_wallet_adj_user_wallet")
  @@map("finance_wallet_adjustments")
}

// ===== INCOME / SALARY =====
model IncomeSource {
  id                  Int      @id @default(autoincrement())
  userId              Int      @map("user_id")
  name                String   @db.VarChar(150) // "Công ty A", "Freelance"
  type                String   @db.VarChar(20) // SALARY | FREELANCE | PART_TIME | OTHER
  payType             String   @map("pay_type") @db.VarChar(20) // MONTHLY | HOURLY | PER_JOB
  baseSalary          Decimal? @map("base_salary") @db.Decimal(18, 2) // for MONTHLY
  hourlyRate          Decimal? @map("hourly_rate") @db.Decimal(18, 2) // for HOURLY
  currency            String   @default("VND") @db.VarChar(8) // VND | USD — what baseSalary/hourlyRate are denominated in
  otMultiplierNormal  Decimal  @default(1.5) @map("ot_multiplier_normal") @db.Decimal(4, 2)
  otMultiplierHoliday Decimal  @default(2.0) @map("ot_multiplier_holiday") @db.Decimal(4, 2)
  isActive            Boolean  @default(true) @map("is_active")
  note                String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  workLogs      WorkLog[]
  incomeEntries IncomeEntry[]

  @@index([userId], name: "idx_fin_income_sources_user")
  @@map("finance_income_sources")
}

model WorkLog {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  sourceId       Int      @map("source_id")
  date           DateTime @db.Date
  hoursNormal    Decimal  @default(0) @map("hours_normal") @db.Decimal(5, 2)
  hoursOT        Decimal  @default(0) @map("hours_ot") @db.Decimal(5, 2)
  hoursOTHoliday Decimal  @default(0) @map("hours_ot_holiday") @db.Decimal(5, 2)
  note           String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  source IncomeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceId, date], name: "uk_fin_worklog_user_source_date")
  @@index([userId, date], name: "idx_fin_worklogs_user_date")
  @@map("finance_work_logs")
}

model IncomeEntry {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  sourceId  Int?     @map("source_id")
  walletId  Int      @map("wallet_id") // which wallet it went into
  amount    Decimal  @db.Decimal(18, 2)
  currency  String   @default("VND") @db.VarChar(8)
  date      DateTime @db.Date
  type      String   @db.VarChar(20) // SALARY | BONUS | OT_PAYOUT | FREELANCE | OTHER
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  source IncomeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([userId, date], name: "idx_fin_income_entries_user_date")
  @@index([userId, sourceId], name: "idx_fin_income_entries_user_source")
  @@map("finance_income_entries")
}

// ===== DEBTS =====
model Debt {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  lenderName    String   @map("lender_name") @db.VarChar(150) // "App X", "Ngân hàng Y"
  lenderType    String   @map("lender_type") @db.VarChar(20) // LOAN_APP | BANK | PERSON | CREDIT_CARD | OTHER
  principal     Decimal  @db.Decimal(18, 2) // original amount borrowed
  currency      String   @default("VND") @db.VarChar(8)
  interestType  String   @map("interest_type") @db.VarChar(20) // FLAT_MONTHLY | REDUCING_BALANCE | EQUAL_PRINCIPAL | INTEREST_ONLY | DAILY_PERCENT | NO_INTEREST
  interestRate  Decimal  @map("interest_rate") @db.Decimal(8, 4) // %/month (FLAT/REDUCING) or %/day (DAILY_PERCENT) — or per `rateUnit`
  /// Đơn vị của `interestRate` (28/09/2026): DAY | MONTH | YEAR. NULL = cách
  /// hiểu cũ (%/ngày cho DAILY_PERCENT, %/tháng cho mọi kiểu khác) — mọi khoản
  /// đã có giữ nguyên nghĩa, không phải đổi dữ liệu.
  rateUnit      String?  @map("rate_unit") @db.VarChar(8)
  /// Phí trả nợ trước hạn, % trên số gốc trả trước. NULL = chưa khai (tính
  /// như 0 và nói rõ là chưa khai), 0 = hợp đồng không thu phí.
  prepayFeePct  Decimal? @map("prepay_fee_pct") @db.Decimal(6, 3)
  startDate     DateTime @map("start_date") @db.Date
  termMonths    Int?     @map("term_months")
  paymentDay    Int?     @map("payment_day") // day of month due (1-31)
  status        String   @default("ACTIVE") @db.VarChar(20) // ACTIVE | PAID_OFF | OVERDUE
  note          String?  @db.Text
  attachmentUrl String?  @map("attachment_url") @db.VarChar(500) // contract photo on R2
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  payments DebtPayment[]      @relation("DebtToPayment")
  schedule DebtScheduleItem[] @relation("DebtToSchedule")

  @@index([userId, status], name: "idx_fin_debts_user_status")
  @@map("finance_debts")
}

model DebtScheduleItem {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  debtId        Int       @map("debt_id")
  installmentNo Int       @map("installment_no") // 1-based sequence
  dueDate       DateTime  @map("due_date") @db.Date
  amountDue     Decimal   @map("amount_due") @db.Decimal(18, 2) // principalPart + interestPart
  principalPart Decimal   @map("principal_part") @db.Decimal(18, 2)
  interestPart  Decimal   @map("interest_part") @db.Decimal(18, 2)
  isPaid        Boolean   @default(false) @map("is_paid")
  paidAt        DateTime? @map("paid_at")
  paymentId     Int?      @map("payment_id") // link to the DebtPayment that settled it
  createdAt     DateTime  @default(now()) @map("created_at")

  debt Debt @relation("DebtToSchedule", fields: [debtId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate, isPaid], name: "idx_fin_debt_sched_user_due_paid")
  @@index([debtId, installmentNo], name: "idx_fin_debt_sched_debt_seq")
  @@map("finance_debt_schedule_items")
}

model DebtPayment {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  debtId    Int      @map("debt_id")
  walletId  Int?     @map("wallet_id") // which wallet the payment came from
  amount    Decimal  @db.Decimal(18, 2)
  date      DateTime @db.Date
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  debt Debt @relation("DebtToPayment", fields: [debtId], references: [id], onDelete: Cascade)

  @@index([userId, date], name: "idx_fin_debt_payments_user_date")
  @@index([debtId], name: "idx_fin_debt_payments_debt")
  @@map("finance_debt_payments")
}

// ===== EXPENSES =====
model ExpenseCategory {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  name          String   @db.VarChar(120) // "Ăn uống", "Đi lại"
  icon          String?  @db.VarChar(40)
  color         String?  @db.VarChar(20)
  order         Int      @default(0)
  monthlyBudget Decimal? @map("monthly_budget") @db.Decimal(18, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@index([userId], name: "idx_fin_expense_categories_user")
  @@map("finance_expense_categories")
}

model Expense {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  categoryId  Int      @map("category_id")
  walletId    Int      @map("wallet_id")
  amount      Decimal  @db.Decimal(18, 2)
  currency    String   @default("VND") @db.VarChar(8)
  date        DateTime @db.Date
  description String?  @db.VarChar(500)
  receiptUrl  String?  @map("receipt_url") @db.VarChar(500) // photo on R2
  isRecurring Boolean  @default(false) @map("is_recurring")
  recurringId Int?     @map("recurring_id") // link to RecurringTransaction
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, date], name: "idx_fin_expenses_user_date")
  @@index([userId, categoryId], name: "idx_fin_expenses_user_category")
  @@map("finance_expenses")
}

model RecurringTransaction {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  kind        String   @db.VarChar(10) // EXPENSE | INCOME
  amount      Decimal  @db.Decimal(18, 2)
  categoryId  Int?     @map("category_id")
  walletId    Int      @map("wallet_id")
  description String   @db.VarChar(200) // "Tiền nhà", "Netflix"
  frequency   String   @db.VarChar(10) // MONTHLY | WEEKLY | YEARLY
  dayOfMonth  Int?     @map("day_of_month")
  nextRunAt   DateTime @map("next_run_at")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId, nextRunAt, isActive], name: "idx_fin_recurring_user_next_active")
  @@map("finance_recurring_transactions")
}

// ============================================================
// MONEYFLOW — Phase 2 (Investments & Savings). Same rules as Phase 1:
// per-user (userId Int), Decimal(18,2) money, no floats, scoped in service.
// ============================================================

// ===== INVESTMENTS =====
model Investment {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  type            String   @db.VarChar(10) // SELF (skills/courses) | ASSET (stocks/gold/crypto)
  name            String   @db.VarChar(200) // "Khóa Unity", "Vàng SJC"
  amount          Decimal  @db.Decimal(18, 2) // money put in
  currency        String   @default("VND") @db.VarChar(8)
  date            DateTime @db.Date
  walletId        Int?     @map("wallet_id") // wallet the money came from (optional)
  expectedOutcome String?  @map("expected_outcome") @db.Text // SELF: expected skill/return
  currentValue    Decimal? @map("current_value") @db.Decimal(18, 2) // ASSET: manually updated value
  status          String   @default("ACTIVE") @db.VarChar(12) // ACTIVE | COMPLETED | SOLD
  outcomeNote     String?  @map("outcome_note") @db.Text // SELF: "kết quả nhận được" on completion
  note            String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId, type], name: "idx_fin_investments_user_type")
  @@map("finance_investments")
}

// ===== SAVINGS =====
model SavingsAccount {
  id                  Int      @id @default(autoincrement())
  userId              Int      @map("user_id")
  bankName            String   @map("bank_name") @db.VarChar(150)
  amount              Decimal  @db.Decimal(18, 2)
  currency            String   @default("VND") @db.VarChar(8)
  interestRatePerYear Decimal  @map("interest_rate_per_year") @db.Decimal(6, 3) // %/year
  termMonths          Int      @map("term_months")
  startDate           DateTime @map("start_date") @db.Date
  maturityDate        DateTime @map("maturity_date") @db.Date // computed on create
  autoRenew           Boolean  @default(false) @map("auto_renew")
  walletId            Int?     @map("wallet_id") // funding wallet (optional)
  status              String   @default("ACTIVE") @db.VarChar(12) // ACTIVE | MATURED | WITHDRAWN
  note                String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([userId, status], name: "idx_fin_savings_accounts_user_status")
  @@map("finance_savings_accounts")
}

/// Mục tiêu CHI TIÊU theo kỳ — ngày / tuần / tháng.
///
/// Khác `ExpenseCategory.monthlyBudget` (trần cho MỘT nhóm chi): đây là trần
/// cho TỔNG chi trong kỳ, thứ người dùng thật sự theo dõi hằng ngày.
///
/// `amount = 0` + `isActive = false` là TẮT, không xoá hàng — giữ lại
/// `updatedAt` để còn biết mục tiêu đặt từ bao giờ.
model FinanceSpendingGoal {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  /// DAY | WEEK | MONTH
  period    String   @db.VarChar(8)
  amount    Decimal  @db.Decimal(18, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ⚠️ KHÔNG khai quan hệ tới `User` — mọi model tiền nong ở đây
  // (`SavingsGoal`, `FinanceFxRate`, …) đều chỉ giữ `userId` trần. Khai
  // quan hệ ở một model lẻ thì phải thêm back-relation vào `User`, và
  // `prisma generate` chết nếu quên.
  @@unique([userId, period], name: "uk_fin_goal_user_period", map: "uk_fin_goal_user_period")
  @@map("finance_spending_goals")
}

model SavingsGoal {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  name          String    @db.VarChar(150) // "Mua MacBook", "Quỹ khẩn cấp"
  targetAmount  Decimal   @map("target_amount") @db.Decimal(18, 2)
  currentAmount Decimal   @default(0) @map("current_amount") @db.Decimal(18, 2)
  deadline      DateTime? @db.Date
  icon          String?   @db.VarChar(40)
  status        String    @default("ACTIVE") @db.VarChar(12) // ACTIVE | ACHIEVED
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([userId], name: "idx_fin_savings_goals_user")
  @@map("finance_savings_goals")
}

// User-entered VND↔USD exchange rate. Append-only history: each update
// inserts a row; the newest row is the current rate used to convert USD
// amounts into VND across dashboard/report aggregations.
model FinanceFxRate {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  vndPerUsd Decimal  @map("vnd_per_usd") @db.Decimal(18, 2) // ₫ for 1 $
  note      String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], name: "idx_fin_fx_rates_user_created")
  @@map("finance_fx_rates")
}

// ── Admin announcements ("Diễn đàn / Tin tức") ────────────────────
// Site-wide announcements the super-admin posts (maintenance, updates,
// new docs, general notices). Broadcast to all online users via socket
// on create; the /forum page is the persistent record.
model Announcement {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(255)
  body          String   @db.Text
  // 'maintenance' | 'update' | 'docs' | 'general'
  category      String   @default("general") @db.VarChar(20)
  coverImageUrl String?  @map("cover_image_url") @db.VarChar(500)
  isPinned      Boolean  @default(false) @map("is_pinned")
  authorId      Int?     @map("author_id")
  author        User?    @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isPinned, createdAt], name: "idx_announcements_pinned_created")
  @@map("announcements")
}

// ═══════════════════════════════════════════════════════════════════
//  INTERVIEW SIMULATOR  (Phase 2 — STATIC self-assessment engine)
//  AI/Voice/Coding/System-Design/RAG modes are ACCOMMODATED via enum
//  values + nullable columns but NOT implemented in Phase 2.
//  All tables are self-contained: user ownership is a plain `userId Int`
//  + index (NO FK to `users`) to keep this module decoupled from the
//  core schema. Everything is gated behind the INTERVIEW_ENABLED
//  frontend flag, so these tables are inert until the feature ships.
//  Question full-text search (search_vector tsvector + GIN) is added by
//  a separate hand-written raw-SQL migration, mirroring the Projects
//  module — it is intentionally NOT modelled here.
// ═══════════════════════════════════════════════════════════════════

enum InterviewLevel {
  INTERN
  FRESHER
  JUNIOR
  MID
  SENIOR
  LEAD
  PRINCIPAL
}

enum InterviewQuestionType {
  CONCEPTUAL
  CODING
  SYSTEM_DESIGN
  BEHAVIORAL
  SCENARIO
  MCQ
}

enum InterviewQuestionSource {
  SEED
  ADMIN
  AI_GENERATED
  IMPORTED
}

enum InterviewContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InterviewSessionMode {
  TEXT
  VOICE
  CODING
  SYSTEM_DESIGN
}

enum InterviewEngineMode {
  STATIC
  HYBRID
  FULL_AI
}

enum InterviewLanguage {
  VI
  EN
}

enum InterviewSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum InterviewHireRecommendation {
  STRONG_NO
  NO
  LEAN_NO
  LEAN_YES
  YES
  STRONG_YES
}

enum InterviewMasteryLevel {
  UNSEEN
  SHAKY
  LEARNING
  SOLID
  MASTERED
}

model InterviewDomain {
  id          Int                    @id @default(autoincrement())
  slug        String                 @unique @db.VarChar(80)
  name        String                 @db.VarChar(120)
  nameVi      String?                @map("name_vi") @db.VarChar(120)
  description String?                @db.Text
  icon        String?                @db.VarChar(60)
  sortOrder   Int                    @default(0) @map("sort_order")
  status      InterviewContentStatus @default(PUBLISHED)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  tracks InterviewTrack[]

  @@map("interview_domains")
}

model InterviewTrack {
  id          Int                    @id @default(autoincrement())
  domainId    Int                    @map("domain_id")
  domain      InterviewDomain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  slug        String                 @unique @db.VarChar(100)
  name        String                 @db.VarChar(150)
  nameVi      String?                @map("name_vi") @db.VarChar(150)
  description String?                @db.Text
  icon        String?                @db.VarChar(60)
  sortOrder   Int                    @default(0) @map("sort_order")
  status      InterviewContentStatus @default(PUBLISHED)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  topics   InterviewTopic[]
  sessions InterviewSession[]

  @@index([domainId], name: "idx_interview_tracks_domain")
  @@map("interview_tracks")
}

model InterviewTopic {
  id        Int                    @id @default(autoincrement())
  trackId   Int                    @map("track_id")
  track     InterviewTrack         @relation(fields: [trackId], references: [id], onDelete: Cascade)
  slug      String                 @unique @db.VarChar(120)
  name      String                 @db.VarChar(150)
  nameVi    String?                @map("name_vi") @db.VarChar(150)
  weight    Int                    @default(1) // weighted sampling
  sortOrder Int                    @default(0) @map("sort_order")
  status    InterviewContentStatus @default(PUBLISHED)
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")

  concepts    InterviewConcept[]
  questions   InterviewQuestion[]
  reviewCards InterviewReviewCard[]

  @@index([trackId], name: "idx_interview_topics_track")
  @@map("interview_topics")
}

model InterviewConcept {
  id        Int            @id @default(autoincrement())
  topicId   Int            @map("topic_id")
  topic     InterviewTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  slug      String         @unique @db.VarChar(140)
  name      String         @db.VarChar(200)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  questions   InterviewQuestion[]
  reviewCards InterviewReviewCard[]

  @@index([topicId], name: "idx_interview_concepts_topic")
  @@map("interview_concepts")
}

model InterviewCompanyProfile {
  id              Int                    @id @default(autoincrement())
  slug            String                 @unique @db.VarChar(80)
  name            String                 @db.VarChar(150)
  styleDescriptor String                 @map("style_descriptor") @db.Text
  rigor           Int                    @default(3) // 1-5, injected into interviewer persona
  status          InterviewContentStatus @default(PUBLISHED)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  sessions InterviewSession[]

  @@map("interview_company_profiles")
}

model InterviewQuestion {
  id                Int                     @id @default(autoincrement())
  topicId           Int                     @map("topic_id")
  topic             InterviewTopic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  conceptId         Int?                    @map("concept_id")
  concept           InterviewConcept?       @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  level             InterviewLevel
  type              InterviewQuestionType   @default(CONCEPTUAL)
  difficulty        Int                     @default(3) // 1-5
  body              String                  @db.Text // markdown, display language
  bodyVi            String?                 @map("body_vi") @db.Text
  bodyEn            String?                 @map("body_en") @db.Text
  referenceAnswer   String?                 @map("reference_answer") @db.Text
  referenceAnswerEn String?                 @map("reference_answer_en") @db.Text
  rubric            Json                    @default("[]") @db.JsonB // [{id,criterion,weight}] (display language)
  rubricEn          Json?                   @map("rubric_en") @db.JsonB // English rubric (used when session.language=EN)
  mustMention       String[]                @default([]) @map("must_mention")
  shouldMention     String[]                @default([]) @map("should_mention")
  // English keyword sets — used by the objective (keyword) grader when
  // session.language=EN, so an English answer is matched against English keys
  // instead of the Vietnamese ones (which made EN answers fail the keyword pass).
  mustMentionEn     String[]                @default([]) @map("must_mention_en")
  shouldMentionEn   String[]                @default([]) @map("should_mention_en")
  redFlags          String[]                @default([]) @map("red_flags")
  synonyms          Json                    @default("{}") @db.JsonB // { term: [aliases] }
  mcqOptions        Json?                   @map("mcq_options") @db.JsonB // [{id,text,correct}]
  tags              String[]                @default([])
  source            InterviewQuestionSource @default(SEED)
  status            InterviewContentStatus  @default(DRAFT)
  rubricReviewed    Boolean                 @default(false) @map("rubric_reviewed")
  authorId          Int?                    @map("author_id")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  versions    InterviewQuestionVersion[]
  turns       InterviewTurn[]
  reviewCards InterviewReviewCard[]

  @@index([topicId, level, status], name: "idx_interview_questions_topic_level")
  @@index([conceptId], name: "idx_interview_questions_concept")
  @@map("interview_questions")
}

model InterviewQuestionVersion {
  id         Int               @id @default(autoincrement())
  questionId Int               @map("question_id")
  question   InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version    Int
  snapshot   Json              @db.JsonB
  editorId   Int?              @map("editor_id")
  createdAt  DateTime          @default(now()) @map("created_at")

  @@unique([questionId, version], name: "uk_interview_qversion")
  @@map("interview_question_versions")
}

model InterviewSession {
  id               Int                      @id @default(autoincrement())
  userId           Int                      @map("user_id")
  trackId          Int                      @map("track_id")
  track            InterviewTrack           @relation(fields: [trackId], references: [id], onDelete: Restrict)
  companyProfileId Int?                     @map("company_profile_id")
  companyProfile   InterviewCompanyProfile? @relation(fields: [companyProfileId], references: [id], onDelete: SetNull)
  level            InterviewLevel
  mode             InterviewSessionMode     @default(TEXT)
  engineMode       InterviewEngineMode      @default(STATIC) @map("engine_mode")
  language         InterviewLanguage        @default(VI)
  status           InterviewSessionStatus   @default(IN_PROGRESS)
  focusedMode      Boolean                  @default(false) @map("focused_mode")
  config           Json                     @default("{}") @db.JsonB
  startedAt        DateTime?                @map("started_at")
  endedAt          DateTime?                @map("ended_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  turns  InterviewTurn[]
  report InterviewReport?

  @@index([userId, status], name: "idx_interview_sessions_user")
  @@index([trackId], name: "idx_interview_sessions_track")
  @@map("interview_sessions")
}

model InterviewTurn {
  id                 Int                @id @default(autoincrement())
  sessionId          Int                @map("session_id")
  session            InterviewSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId         Int?               @map("question_id")
  question           InterviewQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  order              Int
  questionText       String             @map("question_text") @db.Text
  userAnswer         String?            @map("user_answer") @db.Text
  selfScore          Json?              @map("self_score") @db.JsonB
  deterministicScore Json?              @map("deterministic_score") @db.JsonB
  aiFollowUps        Json?              @map("ai_follow_ups") @db.JsonB
  turnScore          Json?              @map("turn_score") @db.JsonB
  timeSpentMs        Int?               @map("time_spent_ms")
  integritySignals   Json?              @map("integrity_signals") @db.JsonB
  needsReview        Boolean            @default(false) @map("needs_review")
  injectionAttempted Boolean            @default(false) @map("injection_attempted")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@unique([sessionId, order], name: "uk_interview_turn_order")
  @@index([questionId], name: "idx_interview_turns_question")
  @@map("interview_turns")
}

model InterviewReport {
  id                 Int                          @id @default(autoincrement())
  sessionId          Int                          @unique @map("session_id")
  session            InterviewSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  overallScore       Float?                       @map("overall_score")
  letterGrade        String?                      @map("letter_grade") @db.VarChar(2)
  scoreBreakdown     Json                         @default("{}") @map("score_breakdown") @db.JsonB
  strengths          String[]                     @default([])
  weaknesses         String[]                     @default([])
  actionableAdvice   String?                      @map("actionable_advice") @db.Text
  suggestedResources Json?                        @map("suggested_resources") @db.JsonB
  hireRecommendation InterviewHireRecommendation? @map("hire_recommendation")
  pdfR2Key           String?                      @map("pdf_r2_key") @db.VarChar(300)
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")

  @@map("interview_reports")
}

model InterviewReviewCard {
  id              Int                   @id @default(autoincrement())
  userId          Int                   @map("user_id")
  topicId         Int                   @map("topic_id")
  topic           InterviewTopic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  conceptId       Int?                  @map("concept_id")
  concept         InterviewConcept?     @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  questionId      Int?                  @map("question_id")
  question        InterviewQuestion?    @relation(fields: [questionId], references: [id], onDelete: SetNull)
  sourceSessionId Int?                  @map("source_session_id")
  easeFactor      Float                 @default(2.5) @map("ease_factor")
  intervalDays    Int                   @default(0) @map("interval_days")
  repetitions     Int                   @default(0)
  lapses          Int                   @default(0)
  dueAt           DateTime?             @map("due_at")
  lastReviewedAt  DateTime?             @map("last_reviewed_at")
  masteryLevel    InterviewMasteryLevel @default(UNSEEN) @map("mastery_level")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@unique([userId, conceptId], name: "uk_interview_reviewcard_user_concept")
  @@index([userId, dueAt], name: "idx_interview_reviewcards_due")
  @@index([topicId], name: "idx_interview_reviewcards_topic")
  @@map("interview_review_cards")
}

// ── Ops / AI-phase tables (created now, INERT until Phase 4 wires the LLM layer) ──
model InterviewPromptTemplate {
  id        Int               @id @default(autoincrement())
  key       String            @db.VarChar(80)
  name      String            @db.VarChar(150)
  content   String            @db.Text
  language  InterviewLanguage @default(VI)
  version   Int               @default(1)
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@unique([key, version], name: "uk_interview_prompt_key_version")
  @@map("interview_prompt_templates")
}

model InterviewLLMCallLog {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  sessionId    Int?     @map("session_id")
  // Which product made the call: interview | language | cv | chat | bulk_gen.
  // `step` only says which model tier to route to, so Interview grading and the
  // My Language tutor both log step='interview' and were indistinguishable —
  // there was no way to answer "which users are spending Pro AI on what".
  // Nullable: rows written before this column existed keep their history.
  feature      String?  @db.VarChar(24)
  step         String   @db.VarChar(40)
  provider     String   @db.VarChar(40)
  model        String   @db.VarChar(80)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costUsd      Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 6)
  success      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], name: "idx_interview_llmlog_user")
  @@index([feature, createdAt], name: "idx_interview_llmlog_feature")
  @@map("interview_llm_call_logs")
}

// ── Phase 6: Knowledge base / RAG ────────────────────────────────────
// Admin-curated authoritative material that grounds the AI grader/report so it
// stops hallucinating stale framework details. Retrieval is LEXICAL (tsvector,
// see the search migration) — semantic/pgvector is a future upgrade (prod runs
// postgis, no vector ext). authorId is a plain Int (module convention, no FK).
model InterviewKnowledgeDocument {
  id         Int                    @id @default(autoincrement())
  title      String                 @db.VarChar(300)
  content    String                 @db.Text // markdown source
  sourceType String                 @default("ADMIN_WRITTEN") @map("source_type") @db.VarChar(30) // ADMIN_WRITTEN|UPLOADED_PDF|UPLOADED_MD|SCRAPED_DOC|REFERENCE_ANSWER
  topicIds   Int[]                  @default([]) @map("topic_ids")
  trackIds   Int[]                  @default([]) @map("track_ids")
  level      InterviewLevel? // null = all levels
  language   InterviewLanguage      @default(VI)
  version    Int                    @default(1)
  status     InterviewContentStatus @default(PUBLISHED)
  sourceUrl  String?                @map("source_url") @db.Text
  authorId   Int?                   @map("author_id")
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  chunks InterviewKnowledgeChunk[]

  @@index([status], name: "idx_interview_kdoc_status")
  @@map("interview_knowledge_documents")
}

model InterviewKnowledgeChunk {
  id          Int                        @id @default(autoincrement())
  documentId  Int                        @map("document_id")
  document    InterviewKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex  Int                        @map("chunk_index")
  headingPath String?                    @map("heading_path") @db.Text // breadcrumb, e.g. "Streams > Backpressure"
  content     String                     @db.Text
  tokenCount  Int                        @default(0) @map("token_count")
  // Denormalized scope from the parent doc → fast topic-scoped retrieval without a join.
  topicIds    Int[]                      @default([]) @map("topic_ids")
  trackIds    Int[]                      @default([]) @map("track_ids")
  level       InterviewLevel?
  language    InterviewLanguage          @default(VI)
  status      InterviewContentStatus     @default(PUBLISHED)
  createdAt   DateTime                   @default(now()) @map("created_at")

  @@unique([documentId, chunkIndex], name: "uk_interview_kchunk_order")
  @@index([documentId], name: "idx_interview_kchunk_doc")
  @@map("interview_knowledge_chunks")
}

// ═══════════════════════════════════════════════════════════════════
//  CV BUILDER MODULE  (Phase 1 — foundation)
//  Honest, IT-focused CV builder. Sits alongside the Interview module
//  and reuses its LLM / quota / Pro / R2 plumbing. The CV is stored as
//  STRUCTURED data (profile → items → bullets), never a text blob —
//  that is what enables multi-template render, ATS-safe export, per-job
//  tailoring, and AI critique at the level of a single claim.
//
//  Convention (identical to the Interview module): `userId Int` carries
//  NO foreign key to User. Account-deletion cascade is done in the
//  service layer (hard-delete endpoint, a later phase). Relations WITHIN
//  the module (profile → item → bullet, document → version …) cascade
//  normally via onDelete: Cascade.
// ═══════════════════════════════════════════════════════════════════

enum CvMarket {
  VN
  INTERNATIONAL
}

enum CvLanguage {
  VI
  EN
}

enum CvExperienceLevel {
  STUDENT
  FRESHER
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum CvType {
  INDUSTRY
  ACADEMIC
  GOVERNMENT
}

// A CvItem is a unified record for anything that carries achievement
// bullets: a job, a project, a degree, an open-source contribution, a
// publication, an award, or volunteering. The `kind` discriminates.
enum CvItemKind {
  EXPERIENCE
  PROJECT
  EDUCATION
  OPEN_SOURCE
  PUBLICATION
  AWARD
  VOLUNTEER
}

enum CvBulletStrength {
  WEAK
  OK
  STRONG
}

enum CvSkillCategory {
  LANGUAGE
  FRAMEWORK
  DATABASE
  INFRA
  TOOL
  PRACTICE
  SOFT
}

enum CvEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  VOLUNTEER
}

enum CvDocumentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CvReviewMode {
  STATIC
  AI
}

enum CvReviewVerdict {
  INTERVIEW
  MAYBE
  REJECT
}

enum CvImportSource {
  PDF
  DOCX
  GITHUB
  LINKEDIN_ARCHIVE
  JSON_RESUME
  PASTE
}

enum CvImportStatus {
  PENDING
  PARSING
  PARSED
  COMMITTED
  FAILED
}

enum CvExportFormat {
  PDF
  DOCX
  TXT
  MD
  JSON
}

enum CvExportStatus {
  PENDING
  RENDERING
  READY
  FAILED
}

enum CvCoverLetterTone {
  FORMAL
  DIRECT
  WARM
}

// The user's MASTER career record — one per user. Contains everything
// they have ever done, including things that won't appear on any single
// CV. Individual CvDocuments are just curated views of this source.
model CvProfile {
  id            Int                @id @default(autoincrement())
  userId        Int                @unique @map("user_id")
  // Contact block
  fullName      String?            @map("full_name") @db.VarChar(150)
  headline      String?            @db.VarChar(200) // e.g. "Backend Engineer"
  email         String?            @db.VarChar(150)
  phone         String?            @db.VarChar(40)
  location      String?            @db.VarChar(150)
  links         Json               @default("{}") @db.JsonB // { github, linkedin, portfolio, website }
  photoR2Key    String?            @map("photo_r2_key") @db.VarChar(300)
  dateOfBirth   DateTime?          @map("date_of_birth") // VN market only; INTERNATIONAL strips it
  summary       String?            @db.Text
  // Preferences — seed defaults for new tailored CVs
  targetRoles   String[]           @default([]) @map("target_roles")
  seniority     CvExperienceLevel?
  locationsPref String[]           @default([]) @map("locations_pref")
  remotePref    String?            @map("remote_pref") @db.VarChar(20) // REMOTE|ONSITE|HYBRID|ANY
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  items          CvItem[]
  skills         CvSkill[]
  certifications CvCertification[]
  languageSkills CvLanguageSkill[]
  documents      CvDocument[]

  @@map("cv_profiles")
}

// A bullet-bearing entry: job / project / degree / etc. (see CvItemKind).
model CvItem {
  id             Int               @id @default(autoincrement())
  profileId      Int               @map("profile_id")
  profile        CvProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind           CvItemKind
  title          String            @db.VarChar(250) // role / project name / degree
  organization   String?           @db.VarChar(250) // company / school / publisher
  location       String?           @db.VarChar(150)
  employmentType CvEmploymentType? @map("employment_type")
  startDate      DateTime?         @map("start_date")
  endDate        DateTime?         @map("end_date") // null + isCurrent = ongoing
  isCurrent      Boolean           @default(false) @map("is_current")
  url            String?           @db.VarChar(500) // repo / demo / publication link
  techStack      String[]          @default([]) @map("tech_stack")
  context        String?           @db.Text // private notes, never rendered
  gpa            String?           @db.VarChar(20) // EDUCATION only
  sortOrder      Int               @default(0) @map("sort_order")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  bullets CvBullet[]

  @@index([profileId, kind], name: "idx_cv_items_profile_kind")
  @@map("cv_items")
}

// The atomic unit — one achievement line. This is where the value is.
// Every AI-touched bullet must trace back to `userStatedFacts`; a claim
// with no supporting user input is a hard failure (a ClarifyingQuestion
// is emitted instead). `verified` gates export.
model CvBullet {
  id              Int              @id @default(autoincrement())
  itemId          Int              @map("item_id")
  item            CvItem           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text            String           @db.Text // the rendered line
  userStatedFacts String?          @map("user_stated_facts") @db.Text // provenance anchor
  provenance      Json?            @db.JsonB // claim → supporting user fact
  verified        Boolean          @default(false) // user confirmed accurate
  aiGenerated     Boolean          @default(false) @map("ai_generated")
  metrics         Json?            @db.JsonB // extracted numbers, reusable & checkable
  skillsEvidenced String[]         @default([]) @map("skills_evidenced") // powers skills-vs-evidence gap
  strength        CvBulletStrength @default(OK) // computed by the rules engine
  variants        Json             @default("[]") @db.JsonB // alt phrasings for tailoring
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([itemId], name: "idx_cv_bullets_item")
  @@map("cv_bullets")
}

// A skill claim. Evidence is matched against CvBullet.skillsEvidenced at
// lint time — a skill with no evidencing bullet is a liability the
// rules engine surfaces (the interview will test it).
model CvSkill {
  id          Int             @id @default(autoincrement())
  profileId   Int             @map("profile_id")
  profile     CvProfile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String          @db.VarChar(100)
  category    CvSkillCategory @default(TOOL)
  proficiency String?         @db.VarChar(30) // never rendered as bars/stars (ATS-harmful)
  yearsUsed   Float?          @map("years_used")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([profileId], name: "idx_cv_skills_profile")
  @@map("cv_skills")
}

model CvCertification {
  id           Int       @id @default(autoincrement())
  profileId    Int       @map("profile_id")
  profile      CvProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String    @db.VarChar(200)
  issuer       String?   @db.VarChar(200)
  issueDate    DateTime? @map("issue_date")
  expiryDate   DateTime? @map("expiry_date")
  credentialId String?   @map("credential_id") @db.VarChar(150)
  url          String?   @db.VarChar(500)
  sortOrder    Int       @default(0) @map("sort_order")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([profileId], name: "idx_cv_certs_profile")
  @@map("cv_certifications")
}

// English proficiency is a first-class credential in the VN outsourcing
// market (FPT, KMS, NashTech…) — IELTS/TOEIC scores belong here and the
// VN template surfaces them prominently.
model CvLanguageSkill {
  id          Int       @id @default(autoincrement())
  profileId   Int       @map("profile_id")
  profile     CvProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  language    String    @db.VarChar(60) // "English", "Japanese"
  proficiency String?   @db.VarChar(60) // "Native", "Professional working"
  certName    String?   @map("cert_name") @db.VarChar(60) // IELTS | TOEIC | JLPT
  certScore   String?   @map("cert_score") @db.VarChar(40) // "7.5", "900", "N2"
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([profileId], name: "idx_cv_langskills_profile")
  @@map("cv_language_skills")
}

// A specific tailored CV derived from the master profile. Rendering is a
// separate concern (templates); this row is the SELECTION + config.
model CvDocument {
  id              Int               @id @default(autoincrement())
  profileId       Int               @map("profile_id")
  profile         CvProfile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId          Int               @map("user_id") // denormalized for fast listing + IDOR guard
  name            String            @db.VarChar(150) // "Backend @ KMS"
  market          CvMarket          @default(VN)
  language        CvLanguage        @default(VI)
  experienceLevel CvExperienceLevel @default(JUNIOR) @map("experience_level")
  cvType          CvType            @default(INDUSTRY) @map("cv_type")
  templateId      Int?              @map("template_id")
  template        CvTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Code-defined template id ('ats' | 'technical' | 'vietnam' | 'senior') — the
  // renderer uses this, not the CvTemplate row (which stays for an admin-managed
  // template library later).
  templateKey     String?           @map("template_key") @db.VarChar(60)
  targetJobId     Int?              @map("target_job_id") // soft ref to CvJobTarget (module convention)
  sectionOrder    Json              @default("[]") @db.JsonB
  includedItemIds Json              @default("{}") @map("included_item_ids") @db.JsonB // items/bullets/skills in THIS cv
  pageTarget      Int               @default(1) @map("page_target")
  includePhoto    Boolean           @default(false) @map("include_photo")
  status          CvDocumentStatus  @default(DRAFT)
  version         Int               @default(1)
  outcomeLabel    String?           @map("outcome_label") @db.VarChar(200) // "got KMS interview"
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  versions     CvVersion[]
  reviews      CvReview[]
  coverLetters CvCoverLetter[]
  exports      CvExport[]

  @@index([userId, status], name: "idx_cv_documents_user")
  @@index([profileId], name: "idx_cv_documents_profile")
  @@map("cv_documents")
}

// Full snapshot history — diffable. Lets a user compare the CV that got
// an interview against the one that didn't.
model CvVersion {
  id         Int        @id @default(autoincrement())
  documentId Int        @map("document_id")
  document   CvDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int
  snapshot   Json       @db.JsonB // full structured data at this version
  note       String?    @db.VarChar(300)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@unique([documentId, version], name: "uk_cv_version")
  @@map("cv_versions")
}

// A job posting the user targets. Untrusted input — parsed JD text is
// wrapped in delimiters before any LLM sees it; injection is flagged.
model CvJobTarget {
  id                 Int      @id @default(autoincrement())
  userId             Int      @map("user_id")
  title              String   @db.VarChar(250)
  company            String?  @db.VarChar(200)
  sourceUrl          String?  @map("source_url") @db.VarChar(500)
  rawJobDescription  String   @map("raw_job_description") @db.Text
  parsedRequirements Json?    @map("parsed_requirements") @db.JsonB // must-have, nice-to-have, keywords
  injectionAttempted Boolean  @default(false) @map("injection_attempted")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([userId], name: "idx_cv_jobs_user")
  @@map("cv_job_targets")
}

// Output of one analysis run — STATIC rules engine or AI critique.
model CvReview {
  id             Int              @id @default(autoincrement())
  documentId     Int              @map("document_id")
  document       CvDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId         Int              @map("user_id")
  mode           CvReviewMode     @default(STATIC)
  verdict        CvReviewVerdict?
  score          Int? // 0..100
  atsScore       Int?             @map("ats_score")
  sixSecondTest  String?          @map("six_second_test") @db.Text
  issues         Json             @default("[]") @db.JsonB // [{severity, location, problem, whyItMatters, suggestedFix}]
  strengths      Json             @default("[]") @db.JsonB
  interviewRisks Json             @default("[]") @map("interview_risks") @db.JsonB // the killer feature
  keywordGaps    Json             @default("[]") @map("keyword_gaps") @db.JsonB
  jobTargetId    Int?             @map("job_target_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([documentId], name: "idx_cv_reviews_document")
  @@map("cv_reviews")
}

// Render definition. Every template must pass the ATS linter and the PDF
// round-trip test in CI (a later phase). Fewer, better — four total.
model CvTemplate {
  id           Int      @id @default(autoincrement())
  key          String   @unique @db.VarChar(60)
  name         String   @db.VarChar(120)
  description  String?  @db.Text
  renderSpec   Json     @default("{}") @map("render_spec") @db.JsonB
  atsSafe      Boolean  @default(true) @map("ats_safe")
  bestFor      Json     @default("{}") @map("best_for") @db.JsonB // { market, level hints }
  previewR2Key String?  @map("preview_r2_key") @db.VarChar(300)
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  documents CvDocument[]

  @@map("cv_templates")
}

// An import run (upload / GitHub / paste …). Raw upload is retained so a
// failed parse can be retried without re-uploading. Parse is a first
// draft the user reviews — never written to the profile authoritatively.
model CvImportJob {
  id              Int            @id @default(autoincrement())
  userId          Int            @map("user_id")
  source          CvImportSource
  status          CvImportStatus @default(PENDING)
  rawContentR2Key String?        @map("raw_content_r2_key") @db.VarChar(300)
  rawText         String?        @map("raw_text") @db.Text
  parsedResult    Json?          @map("parsed_result") @db.JsonB
  confidenceFlags Json?          @map("confidence_flags") @db.JsonB // which fields the parser is unsure about
  hiddenTextFound Boolean        @default(false) @map("hidden_text_found") // white-on-white / zero-size fonts
  error           String?        @db.Text
  reviewedByUser  Boolean        @default(false) @map("reviewed_by_user")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([userId, status], name: "idx_cv_imports_user")
  @@map("cv_import_jobs")
}

// Read-only GitHub OAuth snapshot. Repos scored by substance so only
// real projects are surfaced as CV candidates.
model CvGitHubProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  username        String    @db.VarChar(100)
  repos           Json      @default("[]") @db.JsonB
  languageProfile Json      @default("{}") @map("language_profile") @db.JsonB
  lastSyncedAt    DateTime? @map("last_synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("cv_github_profiles")
}

model CvCoverLetter {
  id          Int               @id @default(autoincrement())
  documentId  Int               @map("document_id")
  document    CvDocument        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId      Int               @map("user_id")
  jobTargetId Int?              @map("job_target_id")
  body        String            @db.Text
  tone        CvCoverLetterTone @default(DIRECT)
  version     Int               @default(1)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([documentId], name: "idx_cv_coverletters_document")
  @@map("cv_cover_letters")
}

// Every AI rewrite proposed — powers the before/after diff and the
// accept-rate signal (a user rejecting most rewrites = wrong voice).
model CvSuggestionLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  bulletId  Int?     @map("bullet_id")
  original  String   @db.Text
  proposed  String   @db.Text
  rationale String?  @db.Text
  accepted  Boolean? // null = pending
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId], name: "idx_cv_suggestions_user")
  @@map("cv_suggestion_logs")
}

// A generated export artifact in R2. `roundTripOk` records whether the
// PDF's text re-extracted correctly (ATS-readability gate).
model CvExport {
  id          Int            @id @default(autoincrement())
  documentId  Int            @map("document_id")
  document    CvDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId      Int            @map("user_id")
  format      CvExportFormat
  status      CvExportStatus @default(PENDING)
  r2Key       String?        @map("r2_key") @db.VarChar(300)
  fileName    String?        @map("file_name") @db.VarChar(200)
  roundTripOk Boolean?       @map("round_trip_ok")
  error       String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@index([documentId], name: "idx_cv_exports_document")
  @@map("cv_exports")
}

// Per-task LLM cost/token accounting, isolated from the Interview log so
// the CV cost dashboard is clean. Failed calls logged with zero tokens.
model CvLLMCallLog {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  documentId   Int?     @map("document_id")
  task         String   @db.VarChar(40) // critique | intake | jd_parse | parse_fallback | cover_letter
  provider     String   @db.VarChar(40)
  model        String   @db.VarChar(80)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costUsd      Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 6)
  success      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], name: "idx_cv_llmlog_user")
  @@map("cv_llm_call_logs")
}

// ─── My Language — Roadmap (learning path) ───────────────────────────
// A per-language visual roadmap (roadmap.sh style): ordered stages, each with
// nodes that link into the existing section pages (vocab/grammar/…). Fully
// additive. Node completion is per-user and manual (LangRoadmapDone).
model LangRoadmapNode {
  id          Int      @id @default(autoincrement())
  languageId  Int      @map("language_id")
  stage       Int      @default(0) // group index (0,1,2,…)
  stageLabel  String   @map("stage_label") @db.VarChar(120) // "N5", "IELTS nền (B2)"
  order       Int      @default(0) // order within the stage
  side        String   @default("center") @db.VarChar(10) // center | left | right
  kind        String   @default("primary") @db.VarChar(16) // primary | alternative | info
  title       String   @db.VarChar(255)
  subtitle    String?  @db.VarChar(255)
  level       String?  @db.VarChar(20) // A1..C2 | N5..N1 — used to deep-link the section
  icon        String?  @db.VarChar(48) // lucide icon name
  description String?  @db.Text // the "intro" shown when the node is opened
  linkType    String?  @map("link_type") @db.VarChar(32) // section key: vocab|grammar|listening|reading|conversation|roleplay|writing|alphabet | external
  linkRef     String?  @map("link_ref") @db.VarChar(255) // optional override (e.g. external URL)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  language Language          @relation(fields: [languageId], references: [id], onDelete: Cascade)
  doneBy   LangRoadmapDone[]

  @@index([languageId, stage, order], name: "idx_lang_roadmap_lang")
  @@map("lang_roadmap_nodes")
}

model LangRoadmapDone {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  nodeId    Int      @map("node_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  node LangRoadmapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId], map: "uk_lang_roadmap_done")
  @@index([userId], name: "idx_lang_roadmap_done_user")
  @@map("lang_roadmap_done")
}

// ─── My Language — Practice (Duolingo-style gamification) ────────────
// Per-user, per-language game state (XP / streak / daily goal / hearts /
// reminder pref) + per-lesson crown progress. Fully additive. Exercises are
// generated client-side from the existing vocab content; only the game state is
// server-authoritative here.
model LangGameState {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  languageId       Int       @map("language_id")
  xp               Int       @default(0)
  streak           Int       @default(0)
  longestStreak    Int       @default(0) @map("longest_streak")
  lastPracticeDate DateTime? @map("last_practice_date")
  dailyGoalXp      Int       @default(30) @map("daily_goal_xp")
  dailyXp          Int       @default(0) @map("daily_xp")
  dailyXpDate      String?   @map("daily_xp_date") @db.VarChar(10)
  weeklyXp         Int       @default(0) @map("weekly_xp")
  weekKey          String?   @map("week_key") @db.VarChar(10)
  hearts           Int       @default(5)
  heartsUpdatedAt  DateTime  @default(now()) @map("hearts_updated_at")
  reminderEnabled  Boolean   @default(false) @map("reminder_enabled")
  reminderHour     Int       @default(20) @map("reminder_hour")
  lastReminderAt   DateTime? @map("last_reminder_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([userId, languageId], map: "uk_lang_game_user_lang")
  @@map("lang_game_states")
}

model LangLessonProgress {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  languageId      Int       @map("language_id")
  lessonKey       String    @map("lesson_key") @db.VarChar(80)
  crown           Int       @default(0)
  bestScore       Int       @default(0) @map("best_score")
  timesCompleted  Int       @default(0) @map("times_completed")
  lastCompletedAt DateTime? @map("last_completed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonKey], map: "uk_lang_lesson_user_key")
  @@index([userId, languageId], name: "idx_lang_lesson_user_lang")
  @@map("lang_lesson_progress")
}

// ============================================================
// 31. GAME LIBRARY ("Playground") — added 2026-07-16
// ============================================================
// DB-backed replacement for the old static GAMES_DATA array in
// frontend/src/types/games.ts. Games are admin-curated; plays
// (scores) are recorded per game and may be anonymous.
//
// `kind` preserves the pre-existing capability of hosting a
// standalone HTML game in /public via an iframe (the `love-me`
// game) alongside React component games — the old GameRenderer
// supported this and dropping it would regress that game.
// React games resolve `componentKey` through the client-side
// registry (components/games/registry.ts).

enum GameDifficulty {
  EASY
  MEDIUM
  HARD
}

enum GameStatus {
  DRAFT
  PUBLISHED
  COMING_SOON
}

enum GameKind {
  REACT
  IFRAME
}

model GameCategory {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(80)
  nameVi    String?  @map("name_vi") @db.VarChar(80)
  slug      String   @unique(map: "uk_game_category_slug") @db.VarChar(80)
  icon      String?  @db.VarChar(40)
  color     String?  @db.VarChar(16)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  games Game[]

  @@index([sortOrder], name: "idx_game_category_sort")
  @@map("game_categories")
}

model Game {
  id              Int            @id @default(autoincrement())
  title           String         @db.VarChar(160)
  titleVi         String?        @map("title_vi") @db.VarChar(160)
  slug            String         @unique(map: "uk_game_slug") @db.VarChar(160)
  description     String         @db.Text
  descriptionVi   String?        @map("description_vi") @db.Text
  longDescription String?        @map("long_description") @db.Text
  coverImage      String?        @map("cover_image") @db.VarChar(500)
  screenshots     String[]       @default([])
  difficulty      GameDifficulty @default(EASY)
  status          GameStatus     @default(DRAFT)
  featured        Boolean        @default(false)
  sortOrder       Int            @default(0) @map("sort_order")
  playCount       Int            @default(0) @map("play_count")
  // REACT → resolved via the client registry; IFRAME → iframeSrc.
  kind            GameKind       @default(REACT)
  componentKey    String?        @map("component_key") @db.VarChar(64)
  iframeSrc       String?        @map("iframe_src") @db.VarChar(500)
  estimatedTime   String?        @map("estimated_time") @db.VarChar(40)
  techStack       String[]       @default([]) @map("tech_stack")
  tags            String[]       @default([])
  controls        String?        @db.Text
  controlsVi      String?        @map("controls_vi") @db.Text
  categoryId      Int            @map("category_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  category GameCategory @relation(fields: [categoryId], references: [id])
  plays    GamePlay[]

  @@index([status, featured], name: "idx_game_status_featured")
  @@index([categoryId], name: "idx_game_category")
  @@index([sortOrder], name: "idx_game_sort")
  @@map("games")
}

model GamePlay {
  id       Int      @id @default(autoincrement())
  gameId   Int      @map("game_id")
  // Nullable: anonymous plays are allowed. SetNull (not Cascade) so
  // deleting an account anonymises its scores instead of silently
  // rewriting every leaderboard.
  userId   Int?     @map("user_id")
  score    Int      @default(0)
  duration Int?
  playedAt DateTime @default(now()) @map("played_at")

  game Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([gameId, score(sort: Desc)], name: "idx_game_play_game_score")
  @@index([userId], name: "idx_game_play_user")
  @@index([playedAt(sort: Desc)], name: "idx_game_play_time")
  @@map("game_plays")
}

// ===== LANDING PROMO ==================================================
// Short muted promo clips shown in the marquee on the public landing page ("/").
// Admin-managed: the video bytes live in R2 (uploaded via the presign flow) and
// only the URL + metadata live here. Site content, not user data → no user FK.
model LandingPromo {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(160)
  tagline    String?  @db.VarChar(255)
  videoUrl   String   @map("video_url") @db.VarChar(500)
  posterUrl  String?  @map("poster_url") @db.VarChar(500)
  href       String?  @db.VarChar(255)
  accent     String?  @db.VarChar(16)
  featureKey String?  @map("feature_key") @db.VarChar(48)
  isActive   Boolean  @default(true) @map("is_active")
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isActive, order], name: "idx_landing_promo_active_order")
  @@map("landing_promos")
}

// ─────────────────────────────────────────────────────────────────────────
// Voice Hub — admin-only creator channel: Vlog / Reaction / Kinh nghiệm code
// / Podcast (voice) / Tutorial. Media is a YouTube embed, a self-hosted R2
// video, or audio-only. Mirrors the Tech Trends pattern (slug + status +
// publishedAt + featured + viewCount) plus media/series/chapters. Comments
// are auth-only with one level of replies + likes. Fully additive.
// ─────────────────────────────────────────────────────────────────────────

model VoiceSeries {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(255)
  slug          String   @unique(map: "uk_voice_series_slug") @db.VarChar(255)
  description   String?  @db.Text
  coverImageUrl String?  @map("cover_image_url") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  posts VoicePost[]

  @@map("voice_series")
}

model VoicePost {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(255)
  slug            String    @unique(map: "uk_voice_post_slug") @db.VarChar(255)
  summary         String?   @db.Text
  // Rich show-notes. `description` is the Markdown source the admin edits;
  // `descriptionHtml` is the rendered HTML cached at write time.
  description     String?   @db.Text
  descriptionHtml String?   @map("description_html") @db.Text
  type            String    @default("VLOG") @db.VarChar(20) // VLOG | REACTION | CODE_EXP | PODCAST | TUTORIAL
  mediaKind       String    @default("YOUTUBE") @db.VarChar(20) // YOUTUBE | R2_VIDEO | AUDIO
  youtubeId       String?   @map("youtube_id") @db.VarChar(32)
  videoUrl        String?   @map("video_url") @db.VarChar(555)
  audioUrl        String?   @map("audio_url") @db.VarChar(555)
  thumbnailUrl    String?   @map("thumbnail_url") @db.VarChar(500)
  durationSec     Int?      @map("duration_sec")
  chapters        Json?     @db.JsonB // [{ t: number(seconds), label: string }]
  tags            String[]  @default([])
  status          String    @default("DRAFT") @db.VarChar(20) // DRAFT | PUBLISHED | SCHEDULED
  isFeatured      Boolean   @default(false) @map("is_featured")
  isPinned        Boolean   @default(false) @map("is_pinned")
  viewCount       Int       @default(0) @map("view_count")
  likeCount       Int       @default(0) @map("like_count")
  seriesId        Int?      @map("series_id")
  authorId        Int?      @map("author_id")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  series   VoiceSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  author   User?          @relation("VoicePostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  comments VoiceComment[]
  likes    VoiceLike[]

  @@index([type], name: "idx_voice_post_type")
  @@index([status], name: "idx_voice_post_status")
  @@index([isFeatured], name: "idx_voice_post_featured")
  @@index([publishedAt(sort: Desc)], name: "idx_voice_post_published_at")
  @@index([seriesId], name: "idx_voice_post_series")
  @@index([authorId], name: "idx_voice_post_author")
  @@map("voice_posts")
}

model VoiceLike {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post VoicePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId], name: "uk_voice_like")
  @@index([postId], name: "idx_voice_likes_post")
  @@index([userId], name: "idx_voice_likes_user")
  @@map("voice_likes")
}

model VoiceComment {
  id         Int      @id @default(autoincrement())
  postId     Int      @map("post_id")
  userId     Int      @map("user_id")
  parentId   Int?     @map("parent_id")
  content    String   @db.Text
  likesCount Int      @default(0) @map("likes_count")
  isEdited   Boolean  @default(false) @map("is_edited")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  post    VoicePost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  VoiceComment?      @relation("VoiceCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies VoiceComment[]     @relation("VoiceCommentReplies")
  likes   VoiceCommentLike[]

  @@index([postId, createdAt(sort: Desc)], name: "idx_voice_comments_post_time")
  @@index([parentId], name: "idx_voice_comments_parent")
  @@index([userId], name: "idx_voice_comments_user")
  @@map("voice_comments")
}

model VoiceCommentLike {
  id        Int      @id @default(autoincrement())
  commentId Int      @map("comment_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment VoiceComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId], name: "uk_voice_comment_like")
  @@index([commentId], name: "idx_voice_comment_likes_comment")
  @@index([userId], name: "idx_voice_comment_likes_user")
  @@map("voice_comment_likes")
}

// ════════════════════════════════════════════════════════════════
//  CODE LAB — coding-practice + learning-roadmap module
//  Hierarchy:  CodeGroup ▸ CodeTrack ▸ CodeModule ▸ CodeExercise
//  Plus per-user CodeProgress (save attempt / mark solved).
//  All content authored in ENGLISH. Additive — no changes to
//  existing tables. Mirrors the Snippet* (Exp Hub) pipeline.
// ════════════════════════════════════════════════════════════════

// Coarse skill tier used on tracks + modules (ordering the roadmap).
enum CodeLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED

  @@map("code_level")
}

// Per-exercise difficulty badge (LeetCode-style, four tiers).
enum CodeDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT

  @@map("code_difficulty")
}

// Publication state for tracks / exercises. DRAFT = admin-only.
enum CodeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("code_status")
}

// Per-user practice status for a single exercise.
enum CodeProgressStatus {
  IN_PROGRESS
  SOLVED

  @@map("code_progress_status")
}

// ─── Top-level groups (the tabs across the top of the hub) ───────
model CodeGroup {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  slug        String   @unique(map: "uk_code_group_slug") @db.VarChar(100)
  description String?  @db.Text
  // Lucide icon name OR an absolute R2 image URL.
  icon        String?  @db.VarChar(500)
  // Accent hex color for the group tab (e.g. "#3178c6"). Null = derived.
  color       String?  @db.VarChar(20)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tracks      CodeTrack[]
  // Tracks shown in this group in ADDITION to their primary group (many-to-many).
  extraTracks CodeGroupTrackLink[] @relation("GroupExtraTracks")

  @@index([sortOrder], name: "idx_code_group_order")
  @@map("code_groups")
}

// ─── Tracks (a learning path for one technology) ─────────────────
model CodeTrack {
  id            Int        @id @default(autoincrement())
  groupId       Int        @map("group_id")
  name          String     @db.VarChar(150)
  slug          String     @unique(map: "uk_code_track_slug") @db.VarChar(150)
  // Primary language/tech key ("java", "python", "sql", "spring", "nextjs"…).
  language      String     @db.VarChar(40)
  description   String?    @db.Text
  icon          String?    @db.VarChar(500)
  color         String?    @db.VarChar(20)
  coverImageUrl String?    @map("cover_image_url") @db.VarChar(2000)
  docsUrl       String?    @map("docs_url") @db.VarChar(500)
  // Overall entry level of the track (roadmap ordering hint).
  level         CodeLevel  @default(BEGINNER)
  sortOrder     Int        @default(0) @map("sort_order")
  status        CodeStatus @default(PUBLISHED)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  group       CodeGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  modules     CodeModule[]
  exercises   CodeExercise[]
  labRooms    CodeLabRoom[]
  // Additional groups this track is featured in (besides its primary group).
  extraGroups CodeGroupTrackLink[] @relation("TrackExtraGroups")

  @@index([groupId, sortOrder], name: "idx_code_track_group_order")
  @@index([slug], name: "idx_code_track_slug")
  @@map("code_tracks")
}

// ─── Track ↔ Group extra memberships (many-to-many) ──────────────
// A track has ONE primary group (CodeTrack.groupId) plus zero or more extra
// groups here, so e.g. PostgreSQL can appear in both "CuongThai" and "Database".
model CodeGroupTrackLink {
  groupId   Int @map("group_id")
  trackId   Int @map("track_id")
  sortOrder Int @default(0) @map("sort_order")

  group CodeGroup @relation("GroupExtraTracks", fields: [groupId], references: [id], onDelete: Cascade)
  track CodeTrack @relation("TrackExtraGroups", fields: [trackId], references: [id], onDelete: Cascade)

  @@id([groupId, trackId])
  @@index([trackId], name: "idx_cgtl_track")
  @@map("code_group_track_links")
}

// ─── Modules (ordered chapters/stages inside a track) ────────────
model CodeModule {
  id                Int       @id @default(autoincrement())
  trackId           Int       @map("track_id")
  name              String    @db.VarChar(150)
  slug              String    @db.VarChar(150)
  description       String?   @db.Text
  level             CodeLevel @default(BEGINNER)
  sortOrder         Int       @default(0) @map("sort_order")
  // ─── NTU-style long-form LESSON (P2) ─────────────────────────────
  // A comprehensive tutorial for this module — intro, concepts explained
  // with annotated code + output, old-vs-new comparisons, best practices —
  // stored as the SAME ordered DocBlock array used by Exp Hub docs
  // ({type: heading|prose|code|mermaid|image|links}). Rendered above the
  // module's exercises. Additive/nullable — null = no lesson yet.
  lessonBlocks      Json?     @map("lesson_blocks")
  lessonModel       String?   @map("lesson_model") @db.VarChar(80)
  lessonGeneratedAt DateTime? @map("lesson_generated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  track     CodeTrack      @relation(fields: [trackId], references: [id], onDelete: Cascade)
  exercises CodeExercise[]

  // slug is unique within a track (not globally).
  @@unique([trackId, slug], name: "uk_code_module_track_slug")
  @@index([trackId, sortOrder], name: "idx_code_module_track_order")
  @@map("code_modules")
}

// ─── Exercises (the graded practice problems) ────────────────────
model CodeExercise {
  id         Int            @id @default(autoincrement())
  moduleId   Int            @map("module_id")
  // Denormalised for fast track-wide queries / progress rollups.
  trackId    Int            @map("track_id")
  title      String         @db.VarChar(255)
  slug       String         @unique(map: "uk_code_exercise_slug") @db.VarChar(255)
  difficulty CodeDifficulty @default(EASY)
  sortOrder  Int            @default(0) @map("sort_order")
  status     CodeStatus     @default(PUBLISHED)
  // Primary language for the editor/solution ("java", "python"…).
  language   String         @db.VarChar(40)

  // ─── Problem body (all English, NTU-style) ─────────────────────
  // The problem statement, rendered as sanitized HTML on the client.
  problemHtml               String?   @map("problem_html") @db.Text
  // Vietnamese twin of the statement. Optional: the page falls back to English
  // per field, so a partly-translated exercise still reads correctly.
  problemHtmlVi             String?   @map("problem_html_vi") @db.Text
  // "Knowledge to learn & apply" — JSON array of strings.
  concepts                  Json?     @map("concepts")
  // Prerequisite concepts / links — JSON array of strings.
  prerequisites             Json?     @map("prerequisites")
  // Free-text specs shown as their own sections.
  inputSpec                 String?   @map("input_spec") @db.Text
  outputSpec                String?   @map("output_spec") @db.Text
  constraints               String?   @db.Text
  // Worked examples: JSON array of { input, output, explanation }.
  examplesJson              Json?     @map("examples_json")
  // Progressive hints: JSON array of strings (revealed one by one).
  hintsJson                 Json?     @map("hints_json")
  // Starter code: JSON array of { name, language, code } (like Snippet.codeBlocks).
  starterCodeJson           Json?     @map("starter_code_json")
  // Official solution: JSON array of { name, language, code }.
  solutionCodeJson          Json?     @map("solution_code_json")
  // Walkthrough of the solution (sanitized HTML).
  solutionExplanationHtml   String?   @map("solution_explanation_html") @db.Text
  solutionExplanationHtmlVi String?   @map("solution_explanation_html_vi") @db.Text
  // The original assignment sheet this exercise reproduces, when there is one
  // (LAB211 ships Word/PDF lab sheets). `briefPdfUrl` is what the page embeds —
  // always a PDF, converted from the .docx where needed, because browsers
  // cannot render .docx. `briefFileUrl` is the untouched source file, offered
  // as a download next to it.
  briefPdfUrl               String?   @map("brief_pdf_url") @db.VarChar(2000)
  briefFileUrl              String?   @map("brief_file_url") @db.VarChar(2000)
  // Per-exercise teaching resources an admin attaches: a walkthrough video, the
  // repository the solution lives in, and a downloadable starter/source archive.
  githubUrl                 String?   @map("github_url") @db.VarChar(2000)
  sourceUrl                 String?   @map("source_url") @db.VarChar(2000)
  // Cached AI walkthrough of THIS exercise (DocBlock[]), shared by every reader
  // because it describes the assignment, not the person reading it.
  aiExplanationJson         Json?     @map("ai_explanation_json")
  aiExplainedAt             DateTime? @map("ai_explained_at")
  // Optional UML/diagram image (R2) + extra images [{ url, caption }].
  diagramImageUrl           String?   @map("diagram_image_url") @db.VarChar(2000)
  // Optional Mermaid diagram illustrating the problem (a class diagram for OOP
  // tasks, a flowchart for algorithm tasks) — rendered above the problem so the
  // learner can picture the structure, NTU-style. Additive/nullable.
  diagramMermaid            String?   @map("diagram_mermaid") @db.Text
  imagesJson                Json?     @map("images_json")
  // Extra references.
  youtubeUrl                String?   @map("youtube_url") @db.VarChar(500)
  referenceUrl              String?   @map("reference_url") @db.VarChar(500)
  // Freeform tags: JSON array of strings.
  tags                      Json?
  // Meta.
  estimatedMinutes          Int?      @map("estimated_minutes")
  points                    Int       @default(10)
  viewCount                 Int       @default(0) @map("view_count")
  solveCount                Int       @default(0) @map("solve_count")

  authorId Int? @map("author_id")

  // Full-text search vector over title + problem + concepts (config 'simple').
  // Maintained by Postgres; queried only via $queryRaw. Unsupported so Prisma
  // tracks the column but never reads/writes it. (Same pattern as Snippet.)
  searchVector Unsupported("tsvector")? @map("search_vector")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  module       CodeModule             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  track        CodeTrack              @relation(fields: [trackId], references: [id], onDelete: Cascade)
  author       User?                  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  progress     CodeProgress[]
  tutorAsks    CodeExerciseTutorAsk[]
  labRoomItems CodeLabRoomItem[]

  @@index([moduleId, sortOrder], name: "idx_code_exercise_module_order")
  @@index([trackId], name: "idx_code_exercise_track")
  @@index([status], name: "idx_code_exercise_status")
  @@index([difficulty], name: "idx_code_exercise_difficulty")
  @@index([language], name: "idx_code_exercise_language")
  @@index([slug], name: "idx_code_exercise_slug")
  @@map("code_exercises")
}

/// Một lượt hỏi gia sư AI của một bài Code Lab, LƯU LẠI để người sau đọc được.
///
/// Cùng hợp đồng với `LessonTutorAsk` (bên Academy) và cố ý là BẢNG RIÊNG chứ
/// không nhét chung một bảng đa hình: hai bên trỏ vào hai bảng cha khác nhau,
/// và một khoá ngoại thật bắt được dữ liệu mồ côi mà cột `kind` + `refId` thì
/// không. Cái giá là một bảng nữa; cái được là DB tự canh toàn vẹn.
model CodeExerciseTutorAsk {
  id         Int @id @default(autoincrement())
  exerciseId Int @map("exercise_id")
  userId     Int @map("user_id")

  /// Nguyên văn, KHÔNG cắt ở bất cứ đâu.
  question String @db.Text
  answer   String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  exercise CodeExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([exerciseId, createdAt], map: "idx_code_ex_tutor_ask_ex")
  @@index([userId], map: "idx_code_ex_tutor_ask_user")
  @@map("code_exercise_tutor_asks")
}

// ─── Per-user practice progress (one row per user+exercise) ──────
model CodeProgress {
  id         Int                @id @default(autoincrement())
  userId     Int                @map("user_id")
  exerciseId Int                @map("exercise_id")
  status     CodeProgressStatus @default(IN_PROGRESS)
  // The user's last saved attempt: JSON array of { name, language, code }.
  savedCode  Json?              @map("saved_code")
  solvedAt   DateTime?          @map("solved_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise CodeExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId], name: "uk_code_progress_user_exercise")
  @@index([userId, status], name: "idx_code_progress_user_status")
  @@index([exerciseId], name: "idx_code_progress_exercise")
  @@map("code_progress")
}

// ─── Phòng Lab (10/09/2026) ─────────────────────────────────────
//
// Người học chọn một nhóm bài trong track, đặt một mục tiêu LOC, rồi làm từng
// bài trong một "phòng" riêng có gia sư AI kèm và một vòng nộp bài để AI chấm
// thay thầy. Ba bảng, không phải một:
//
//   CodeLabRoom        cái phòng: mục tiêu, bài đang làm
//   CodeLabRoomItem    một bài đã chọn trong phòng — trạng thái, LOC, kết quả chấm
//   CodeLabRoomMessage một lượt hội thoại với gia sư, gắn với ĐÚNG một bài
//
// Vì sao LOC chép vào `CodeLabRoomItem` thay vì đọc lại từ đề mỗi lần: LOC là
// con số người học đã nhìn thấy và đã dựa vào đó để chọn. Nếu sau này ai sửa
// tiêu đề bài thì tổng LOC của một phòng đang làm dở KHÔNG được phép nhảy —
// mục tiêu 750 mà tự đổi thành 780 là thứ không giải thích được với người dùng.

enum CodeLabRoomItemStatus {
  PENDING
  IN_PROGRESS
  PASSED

  @@map("code_lab_room_item_status")
}

model CodeLabRoom {
  id      Int    @id @default(autoincrement())
  userId  Int    @map("user_id")
  /// Phòng luôn thuộc đúng một track — 54 bài LAB211 là một track.
  trackId Int    @map("track_id")
  name    String @db.VarChar(200)

  /// Mục tiêu LOC của phòng. Mặc định 750 theo đúng yêu cầu tính năng.
  locGoal Int @default(750) @map("loc_goal")

  /// Bài đang mở trong phòng. SetNull chứ không Cascade: bỏ một bài ra khỏi
  /// phòng thì phòng vẫn còn, chỉ là không còn bài nào đang mở.
  activeItemId Int? @unique(map: "uk_lab_room_active_item") @map("active_item_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  track      CodeTrack            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  activeItem CodeLabRoomItem?     @relation("LabRoomActiveItem", fields: [activeItemId], references: [id], onDelete: SetNull)
  items      CodeLabRoomItem[]    @relation("LabRoomItems")
  messages   CodeLabRoomMessage[]

  @@index([userId, updatedAt(sort: Desc)], name: "idx_lab_room_user")
  @@map("code_lab_rooms")
}

model CodeLabRoomItem {
  id         Int @id @default(autoincrement())
  roomId     Int @map("room_id")
  exerciseId Int @map("exercise_id")

  /// LOC chốt tại lúc chọn — xem chú thích ở đầu khối về vì sao không đọc lại.
  loc       Int                   @default(0)
  sortOrder Int                   @default(0) @map("sort_order")
  status    CodeLabRoomItemStatus @default(PENDING)

  /// Bài giảng mở đầu do AI soạn cho ĐÚNG bài này (DocBlock-ish JSON). Lưu lại
  /// vì nó không đổi theo người đọc và soạn lại mỗi lần vào phòng là đốt tiền.
  introJson  Json? @map("intro_json")
  /// Kết quả chấm gần nhất của bài nộp (JSON: điểm, từng mục, câu hỏi vấn đáp).
  reviewJson Json? @map("review_json")
  /// Bài hướng dẫn "cách review với thầy", chỉ sinh sau khi bài đã PASSED.
  guideJson  Json? @map("guide_json")

  passedAt  DateTime? @map("passed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  room     CodeLabRoom          @relation("LabRoomItems", fields: [roomId], references: [id], onDelete: Cascade)
  exercise CodeExercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  activeIn CodeLabRoom?         @relation("LabRoomActiveItem")
  messages CodeLabRoomMessage[]

  /// `name` đặt tên khoá phía Prisma Client, `map` đặt tên INDEX phía
  /// Postgres — hai thứ khác nhau. Thiếu `map` thì DB tự đặt
  /// `code_lab_room_items_room_id_exercise_id_key`, lệch với migration viết
  /// tay, và `migrate diff` sẽ đòi đổi tên ở mỗi lần deploy.
  @@unique([roomId, exerciseId], name: "uk_lab_room_item", map: "uk_lab_room_item")
  @@index([roomId, sortOrder], name: "idx_lab_room_item_order")
  @@index([exerciseId], name: "idx_lab_room_item_exercise")
  @@map("code_lab_room_items")
}

model CodeLabRoomMessage {
  id     Int @id @default(autoincrement())
  roomId Int @map("room_id")
  /// Hội thoại gắn với ĐÚNG một bài: đổi bài là đổi ngữ cảnh, và trộn hai bài
  /// vào một mạch chat là cách nhanh nhất để gia sư trả lời về nhầm đề.
  itemId Int @map("item_id")

  /// 'user' | 'assistant'
  role    String @db.VarChar(16)
  content String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  room CodeLabRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  item CodeLabRoomItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt], name: "idx_lab_room_msg_item")
  @@map("code_lab_room_messages")
}

// ─── Web analytics — page views (added 2026-07-20) ───────────────
// One row per page view. Deliberately NOT one row per request: the
// site is a Next.js app, so most navigation is client-side and a
// server request log would miss it entirely — the client reports
// each route change instead.
//
// `sessionId` is a random id the browser keeps for the tab session.
// It is never linked to an identity and never leaves as-is: it
// exists so "3 pages by one person" doesn't read as 3 visitors.
// `isBot` rows are KEPT rather than dropped, so a traffic spike can
// be explained ("that was Googlebot") instead of silently inflating
// the numbers — every aggregate filters them out by default.
model PageView {
  id        Int      @id @default(autoincrement())
  path      String   @db.VarChar(500)
  // Page title as the client saw it — useful when a path is opaque.
  title     String?  @db.VarChar(300)
  referrer  String?  @db.VarChar(500)
  sessionId String   @map("session_id") @db.VarChar(64)
  userId    Int?     @map("user_id")
  // 'mobile' | 'tablet' | 'desktop', derived server-side from the UA.
  device    String?  @db.VarChar(16)
  isBot     Boolean  @default(false) @map("is_bot")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)], name: "idx_pageview_created_at")
  @@index([path, createdAt(sort: Desc)], name: "idx_pageview_path_time")
  @@index([sessionId], name: "idx_pageview_session")
  @@index([isBot, createdAt(sort: Desc)], name: "idx_pageview_bot_time")
  @@map("page_views")
}

// ─── RoadMap (roadmap.sh-style learning paths) ───────────────────────
// Standalone visual roadmaps, Role-based or Skill-based. Each roadmap is a set
// of ordered stages, each with nodes placed on a central spine (left/right
// branches). A node can deep-link into a Code Lab track, another roadmap, or an
// external URL. Node completion is per-user (RoadmapDone). Fully additive.
model Roadmap {
  id          Int      @id @default(autoincrement())
  slug        String   @unique(map: "uk_roadmap_slug") @db.VarChar(150)
  title       String   @db.VarChar(150)
  type        String   @default("role") @db.VarChar(10) // role | skill
  description String?  @db.Text
  icon        String?  @db.VarChar(48) // lucide icon name
  color       String?  @db.VarChar(20)
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("PUBLISHED") @db.VarChar(16) // PUBLISHED | DRAFT
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  nodes RoadmapNode[]

  @@index([type, sortOrder], name: "idx_roadmap_type_order")
  @@map("roadmaps")
}

model RoadmapNode {
  id          Int      @id @default(autoincrement())
  roadmapId   Int      @map("roadmap_id")
  stage       Int      @default(0) // group index
  stageLabel  String   @map("stage_label") @db.VarChar(120)
  order       Int      @default(0) // order within the stage
  side        String   @default("center") @db.VarChar(10) // center | left | right
  kind        String   @default("primary") @db.VarChar(16) // primary | alternative | info
  title       String   @db.VarChar(255)
  subtitle    String?  @db.VarChar(255)
  icon        String?  @db.VarChar(48)
  description String?  @db.Text // shown when the node is opened
  linkType    String?  @map("link_type") @db.VarChar(32) // code-lab | roadmap | external
  linkRef     String?  @map("link_ref") @db.VarChar(500) // track slug / roadmap slug / URL
  // Curated learning resources (roadmap.sh-style): [{ type, title, url, premium? }]
  resources   Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roadmap Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  doneBy  RoadmapDone[]

  @@index([roadmapId, stage, order], name: "idx_roadmap_node_order")
  @@map("roadmap_nodes")
}

model RoadmapDone {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  nodeId    Int      @map("node_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  node RoadmapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId], map: "uk_roadmap_done")
  @@index([userId], name: "idx_roadmap_done_user")
  @@map("roadmap_done")
}

// ════════════════════════════════════════════════════════════════
// MAKER LAB — hardware / embedded project hub
// ════════════════════════════════════════════════════════════════
//
// One hub for every physical build: robots, IoT nodes, drones,
// whatever board they run on. A MakerProject is the *design*
// (bill of materials, wiring, firmware plan); a MakerDevice is a
// *physical unit* someone actually built and powered on.
//
// Devices talk to the backend over a dedicated binary WebSocket
// (`/device-ws`, see src/socket/device.gateway.ts) — NOT socket.io,
// because firmware libraries on microcontrollers speak plain
// WebSocket and we stream raw audio frames both ways. The browser
// console keeps using socket.io as everywhere else on the site.
// ════════════════════════════════════════════════════════════════

enum MakerPlatform {
  ESP32
  ESP32_S3
  ESP8266
  RP2040
  STM32
  ARDUINO
  RASPBERRY_PI
  JETSON
  OTHER
}

enum MakerProjectStatus {
  PLANNING // still on paper
  SOURCING // buying parts
  BUILDING // assembling
  TESTING // works, being tuned
  LIVE // finished and running
  ARCHIVED
}

enum MakerComponentCategory {
  MCU // brain: dev boards, SoMs
  AUDIO_IN // microphones
  AUDIO_OUT // amplifiers, speakers
  DISPLAY // screens, LEDs
  MOTION // motors, servos, wheels
  DRIVER // motor drivers, level shifters
  SENSOR // IMU, distance, touch, camera
  POWER // cells, BMS, regulators, capacitors
  MECHANICAL // chassis, screws, standoffs
  CONNECTIVITY // antennas, extra radios
  TOOL // soldering iron, multimeter — not part of the build
  MISC
}

enum MakerDeviceStatus {
  OFFLINE
  ONLINE
  ERROR
  UPDATING
}

enum MakerCommandStatus {
  PENDING // queued, device not connected yet
  SENT // pushed over the socket
  ACKED // device confirmed
  FAILED
  EXPIRED // device never came back in time
}

/// A hardware build: the design, not the physical unit.
model MakerProject {
  id       Int                @id @default(autoincrement())
  slug     String             @unique(map: "uk_maker_project_slug") @db.VarChar(150)
  name     String             @db.VarChar(150)
  tagline  String?            @db.VarChar(255)
  platform MakerPlatform      @default(ESP32_S3)
  status   MakerProjectStatus @default(PLANNING)

  summary     String? @db.Text // markdown intro
  difficulty  Int     @default(3) // 1..5
  estHours    Int?    @map("est_hours")
  estCostVnd  Int?    @map("est_cost_vnd")
  coverImage  String? @map("cover_image") @db.VarChar(500)
  accentColor String? @map("accent_color") @db.VarChar(20)

  /// [{ title, detail, done }] — what this build is trying to achieve.
  goals Json?

  /// [{ title, detail, difficulty, status, dependsOn[] }] — the upgrade
  /// backlog shown on the Overview tab.
  features Json?

  /// { nodes: [...], edges: [...] } — data behind the system flow diagram.
  architecture Json?

  /// [{ group, from, fromPin, to, toPin, wireColor, note }] — pin map
  /// rendered as both a table and the wiring diagram.
  wiring Json?

  /// [{ name, file, purpose, status, notes, code }] — firmware roadmap.
  firmwareModules Json? @map("firmware_modules")

  /// [{ date, title, body, mediaUrl }] — build diary.
  buildLog Json? @map("build_log")

  /// { commands[], errors[], snippets[] } — sổ tay tích luỹ trong lúc
  /// làm: lệnh hay dùng, lỗi đã gặp kèm cách sửa, đoạn code hay copy.
  /// Ba tháng nữa không ai nhớ vì sao `memory_type` phải là `qio_opi`;
  /// chỗ này là để nhớ hộ.
  notebook Json?

  /// { reference, dimensions, bays[], parts[], assembly[] } — the
  /// physical shell: how big it is, which printed piece is which, and
  /// crucially WHERE each component sits inside. Separate from
  /// `wiring` because "does the battery fit behind the speaker" is a
  /// different question from "which pin does the speaker use", and
  /// the answer to the first one decides whether the build is
  /// possible at all.
  enclosure Json?

  featured  Boolean  @default(false)
  published Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  components MakerComponent[]
  devices    MakerDevice[]
  firmwares  MakerFirmware[]
  persona    MakerPersona?
  plans      MakerPlan[]      @relation("MakerPlanProject")

  @@index([published, sortOrder], name: "idx_maker_project_pub_order")
  @@index([platform], name: "idx_maker_project_platform")
  @@map("maker_projects")
}

/// One line of the bill of materials.
model MakerComponent {
  id        Int                    @id @default(autoincrement())
  projectId Int                    @map("project_id")
  category  MakerComponentCategory @default(MISC)

  name         String  @db.VarChar(200)
  partNumber   String? @map("part_number") @db.VarChar(120)
  qty          Int     @default(1)
  unitPriceVnd Int?    @map("unit_price_vnd")

  vendorName String? @map("vendor_name") @db.VarChar(120)
  vendorUrl  String? @map("vendor_url") @db.VarChar(500)

  /// Key into the hand-drawn SVG library on the frontend
  /// (components/maker-lab/PartIcon.tsx). Falls back to a generic
  /// icon per category when unknown.
  svgKey String? @map("svg_key") @db.VarChar(60)

  /// Real photo, uploaded to R2 later. When set it wins over svgKey.
  imageUrl String? @map("image_url") @db.VarChar(500)

  /// { voltage: "3.3V", interface: "I2S", ... } — free-form spec sheet.
  specs Json?

  /// The part that actually makes this page useful: why THIS part and
  /// not the obvious cheaper one.
  whyThisPart String? @map("why_this_part") @db.Text

  /// Full technical write-up:
  /// { overview, howItWorks, pinout[], usage, code{}, gotchas[],
  ///   datasheetUrl, sim } — everything you'd otherwise go hunting
  /// through a PDF and four forum threads for. `sim` names an
  /// interactive simulation the frontend renders for this part
  /// (see components/maker-lab/PartSimulation.tsx).
  docs Json?

  /// [{ name, note, priceVnd }] — acceptable substitutes.
  alternatives Json?

  required  Boolean @default(true)
  /// Shopping checklist — flipped from the BOM tab once bought.
  acquired  Boolean @default(false)
  notes     String? @db.Text
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project MakerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder], name: "idx_maker_component_project_order")
  @@index([projectId, category], name: "idx_maker_component_project_cat")
  @@map("maker_components")
}

/// A physical board that connects to the gateway.
model MakerDevice {
  id        Int    @id @default(autoincrement())
  projectId Int    @map("project_id")
  ownerId   Int    @map("owner_id")
  name      String @db.VarChar(120)

  /// Public identifier the firmware sends on connect.
  deviceKey String @unique(map: "uk_maker_device_key") @map("device_key") @db.VarChar(64)

  /// bcrypt hash of the shared secret. The plaintext is shown to the
  /// user exactly once, at registration — same rule as an API token.
  secretHash String @map("secret_hash") @db.VarChar(120)

  status          MakerDeviceStatus @default(OFFLINE)
  lastSeenAt      DateTime?         @map("last_seen_at")
  firmwareVersion String?           @map("firmware_version") @db.VarChar(40)
  ipAddress       String?           @map("ip_address") @db.VarChar(64)
  rssi            Int? // WiFi signal, dBm
  batteryPct      Int?              @map("battery_pct")
  uptimeSec       Int?              @map("uptime_sec")

  /// Anything else the firmware wants to report about itself.
  meta Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project       MakerProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner         User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  telemetry     MakerTelemetry[]
  commands      MakerCommand[]
  logs          MakerDeviceLog[]
  conversations MakerConversation[]

  @@index([ownerId], name: "idx_maker_device_owner")
  @@index([projectId], name: "idx_maker_device_project")
  @@map("maker_devices")
}

/// Sensor readings. High volume — pruned by a cron job (30 days).
model MakerTelemetry {
  id         Int      @id @default(autoincrement())
  deviceId   Int      @map("device_id")
  /// { battery: 87, rssi: -54, distanceMm: 320, pitch: 1.2, ... }
  payload    Json
  recordedAt DateTime @default(now()) @map("recorded_at")

  device MakerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt], name: "idx_maker_telemetry_device_time")
  @@map("maker_telemetry")
}

/// A control action sent down to a device.
model MakerCommand {
  id         Int                @id @default(autoincrement())
  deviceId   Int                @map("device_id")
  issuedById Int?               @map("issued_by_id")
  type       String             @db.VarChar(40) // move | stop | say | face | reboot | ota | config
  payload    Json?
  status     MakerCommandStatus @default(PENDING)
  error      String?            @db.Text
  sentAt     DateTime?          @map("sent_at")
  ackedAt    DateTime?          @map("acked_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  device   MakerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issuedBy User?       @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([deviceId, createdAt], name: "idx_maker_command_device_time")
  @@index([status], name: "idx_maker_command_status")
  @@map("maker_commands")
}

/// A firmware build available for over-the-air update.
model MakerFirmware {
  id           Int      @id @default(autoincrement())
  projectId    Int      @map("project_id")
  version      String   @db.VarChar(40) // semver
  r2Key        String   @map("r2_key") @db.VarChar(500)
  sha256       String   @db.VarChar(64)
  sizeBytes    Int      @map("size_bytes")
  releaseNotes String?  @map("release_notes") @db.Text
  isLatest     Boolean  @default(false) @map("is_latest")
  createdAt    DateTime @default(now()) @map("created_at")

  project MakerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version], map: "uk_maker_firmware_project_version")
  @@index([projectId, isLatest], name: "idx_maker_firmware_latest")
  @@map("maker_firmwares")
}

/// Serial-style log lines pushed up by the device.
model MakerDeviceLog {
  id        Int      @id @default(autoincrement())
  deviceId  Int      @map("device_id")
  level     String   @default("info") @db.VarChar(8) // debug|info|warn|error
  message   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  device MakerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt], name: "idx_maker_devicelog_device_time")
  @@map("maker_device_logs")
}

/// Trí nhớ hội thoại của robot — mỗi dòng là MỘT lượt nói.
///
/// Trước 13/08/2026 lịch sử nằm trong một `Map` trong RAM: giữ 4 lượt, xoá
/// sau 30 phút im lặng, và restart backend là quên sạch. Người dùng kể tên
/// con mèo lúc sáng, chiều hỏi lại thì robot đã quên — không phải vì model
/// yếu (đo thật: model nhớ tốt tới ~450 lượt) mà vì app chỉ đưa cho nó 4.
///
/// Volume tương tự `MakerTelemetry`, nên cũng cần cron dọn — xem
/// `donHoiThoaiCu()` trong voiceLoop.ts.
model MakerConversation {
  id       Int    @id @default(autoincrement())
  deviceId Int    @map("device_id")
  /// 'user' = người nói, 'assistant' = robot đáp.
  role     String @db.VarChar(12)
  content  String @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  device MakerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// DESC vì truy vấn duy nhất là "N lượt GẦN NHẤT của một thiết bị" —
  /// luôn đọc từ mới nhất lùi lại. Phải khai ở đây chứ không chỉ trong file
  /// SQL viết tay, nếu không `migrate diff` báo drift mãi.
  @@index([deviceId, createdAt(sort: Desc)], name: "idx_maker_conv_device_time")
  @@map("maker_conversations")
}

/// How the robot talks — the personality layer, editable from the web.
model MakerPersona {
  id        Int    @id @default(autoincrement())
  projectId Int    @unique(map: "uk_maker_persona_project") @map("project_id")
  name      String @default("Assistant") @db.VarChar(80)

  /// The system prompt. This is what makes the robot sound like YOU.
  systemPrompt String @map("system_prompt") @db.Text

  /// TTS routing. Swapping to a cloned voice later = change these two
  /// fields, no code change (see src/services/makerlab/tts.ts).
  voiceProvider String  @default("edge") @map("voice_provider") @db.VarChar(24)
  voiceId       String? @map("voice_id") @db.VarChar(120)
  language      String  @default("vi-VN") @db.VarChar(12)

  /// { humor: 4, formality: 2, verbosity: 2, catchphrases: [...] }
  traits Json?

  /// [{ user, bot }] — few-shot examples that pin down the voice far
  /// better than adjectives in the prompt do.
  sampleDialogues Json? @map("sample_dialogues")

  wakeWord    String? @map("wake_word") @db.VarChar(60)
  temperature Float   @default(0.8)
  maxTokens   Int     @default(220) @map("max_tokens")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project MakerProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("maker_personas")
}

// ════════════════════════════════════════════════════════════
// Kế hoạch theo giờ — robot nhắc việc, hướng dẫn, chấm xong
// ════════════════════════════════════════════════════════════
//
// ⚠️ VÌ SAO KHÔNG DÙNG `NoteDatabase` CHO VIỆC NÀY.
//
// Notes đã có cơ sở dữ liệu có kiểu (DATE, CHECKBOX…) và nhìn qua thì
// đây đúng là việc của nó. Nhưng nó lưu kiểu EAV: `note_database_cells`
// giữ giá trị trong cột `value Json?`, khoá theo `(rowId, propertyId)`.
// Hỏi "việc nào tới hạn trong phút tới" trên hình dạng đó nghĩa là join
// `rows → cells → properties`, lọc theo TÊN cột do người dùng tự đặt,
// rồi phân tích JSON — quét toàn bảng, MỖI PHÚT MỘT LẦN, và hỏng ngay
// khi người ta đổi tên cột.
//
// Notes đúng cho việc VIẾT, sai cho việc HẸN GIỜ. Nên: bảng riêng có
// cột giờ là số nguyên đã đánh chỉ mục, còn hướng dẫn dài thì trỏ sang
// một trang Notes qua `noteId`.

enum MakerPlanKind {
  ONCE // đúng một ngày, xong là thôi
  DAILY // mỗi ngày
  WEEKDAYS // thứ 2 → thứ 6
  WEEKLY // theo `thu`, ví dụ [1,3,5]
}

enum MakerRunState {
  PENDING // đã tới giờ, đang chờ người xác nhận
  DONE
  SKIPPED // người dùng bảo bỏ qua hôm nay
  MISSED // quá hạn ân xá mà không ai đụng tới
}

/// ĐỊNH NGHĨA một việc — "7 giờ sáng tập thể dục, mỗi ngày".
model MakerPlan {
  id        Int @id @default(autoincrement())
  ownerId   Int @map("owner_id")
  projectId Int @map("project_id")

  title String @db.VarChar(200)

  /// Robot đọc đoạn này để HƯỚNG DẪN, không chỉ nhắc suông. Giữ ngắn —
  /// nó bị đọc thành tiếng, và người ta đang đứng chờ.
  huongDan String? @map("huong_dan") @db.Text

  /// Trang Notes chứa hướng dẫn dài. CỐ Ý KHÔNG khai khoá ngoại: khai
  /// thì phải thêm back-relation vào `Note` — một model đang bị cả web
  /// dùng — cho một liên kết tuỳ chọn. Id mồ côi được xử lúc đọc.
  noteId Int? @map("note_id")

  kind MakerPlanKind @default(DAILY)

  /// Số PHÚT kể từ 00:00 GIỜ ĐỊA PHƯƠNG, 0..1439.
  ///
  /// ⚠️ Số nguyên chứ không phải `DateTime`, và giờ ĐỊA PHƯƠNG chứ
  /// không phải UTC. Container chạy UTC còn người dùng ở +07; lưu
  /// `DateTime` thì "7 giờ sáng" thành 00:00 UTC, rồi một hôm nào đó có
  /// người đọc nó ra giờ máy chủ và báo thức kêu lúc 2 giờ chiều.
  /// Lưu ý định ("7 giờ sáng, ở múi này") rồi quy đổi lúc so.
  gio Int

  tz String @default("Asia/Ho_Chi_Minh") @db.VarChar(64)

  /// Thứ trong tuần cho `WEEKLY`. 0 = Chủ nhật … 6 = Thứ bảy.
  thu Int[] @default([])

  /// Ngày cho `ONCE`, dạng "2026-08-20" theo `tz`. Chuỗi chứ không phải
  /// `Date` — cùng lý do với `gio`.
  ngayMot String? @map("ngay_mot") @db.VarChar(10)

  /// Nhắc sớm bao nhiêu phút trước giờ. 0 = đúng giờ.
  nhacTruoc Int @default(0) @map("nhac_truoc")

  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner   User           @relation("MakerPlanOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  project MakerProject   @relation("MakerPlanProject", fields: [projectId], references: [id], onDelete: Cascade)
  runs    MakerPlanRun[]

  @@index([ownerId, active], map: "idx_maker_plan_owner")
  @@index([projectId, active], map: "idx_maker_plan_project")
  @@map("maker_plans")
}

/// MỘT LẦN việc đó xuất hiện, trong đúng một ngày.
///
/// Chỉ sinh ra khi tới giờ, KHÔNG dựng sẵn cả tháng lúc nửa đêm: dựng
/// sẵn thì một đêm máy chủ chết là hôm sau mất trắng lịch, mà không ai
/// biết cho tới lúc chuông không kêu.
model MakerPlanRun {
  id     Int @id @default(autoincrement())
  planId Int @map("plan_id")

  /// "2026-08-17" theo `plan.tz`. Đây là khoá chống nhắc hai lần.
  ngay String @db.VarChar(10)

  state MakerRunState @default(PENDING)

  /// Lúc robot NÓI RA. Rỗng nghĩa là tới giờ rồi mà chưa nói được —
  /// robot đang offline chẳng hạn — nên vòng sau còn thử lại.
  nhacLuc DateTime? @map("nhac_luc")

  xongLuc DateTime? @map("xong_luc")

  /// Hoãn tới lúc nào ("nhắc lại sau 10 phút").
  hoanToi DateTime? @map("hoan_toi")

  /// Người dùng nói gì lúc báo xong — "xong rồi nhưng chạy có 2km".
  ghiChu String? @map("ghi_chu") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan MakerPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, ngay], map: "uk_maker_plan_run_day")
  @@index([ngay, state], map: "idx_maker_plan_run_day_state")
  @@map("maker_plan_runs")
}

// ============================================================
// THÔNG BÁO ĐẨY — thẻ định danh thiết bị
// ============================================================

model DeviceToken {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  // Thẻ APNs dạng hex 64 ký tự. Để VarChar(200) vì Apple không cam kết
  // độ dài này là vĩnh viễn, và thẻ FCM (nếu sau này thêm Android) dài hơn.
  token      String   @unique(map: "uk_device_token") @db.VarChar(200)
  // ios | android — để sau thêm nền tảng khác không phải đổi bảng.
  platform   String   @default("ios") @db.VarChar(20)
  // Bản đóng gói TestFlight/App Store dùng máy chủ push KHÁC bản chạy từ
  // Xcode. Gửi nhầm máy chủ thì Apple trả `BadDeviceToken` và thông báo im
  // lặng không tới nơi — nên phải nhớ thiết bị này thuộc môi trường nào.
  sandbox    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  // Mỗi lần app mở lại là cập nhật, để dọn thẻ chết sau này.
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_device_token_user")
  @@map("device_tokens")
}

/// Thời khoá biểu — một BUỔI HỌC LẶP hằng tuần, không phải một sự kiện lịch.
///
/// Vì sao không dùng lại `DashboardTask`: việc thì gắn với MỘT ngày cụ thể
/// (`date`), còn buổi học lặp mỗi tuần suốt cả kỳ. Nhét vào bảng việc thì
/// hoặc phải sinh ~15 dòng cho mỗi môn mỗi kỳ, hoặc phải nhồi thêm cột lặp
/// theo thứ — cả hai đều làm hỏng phần thống kê việc.
model ClassSchedule {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  subject   String  @db.VarChar(200)
  classCode String? @map("class_code") @db.VarChar(50)
  teacher   String? @db.VarChar(150)
  room      String? @db.VarChar(100)

  /// 2..8 theo lối gọi của người Việt: 2 = thứ Hai … 8 = Chủ nhật.
  /// KHÔNG dùng 0-6 kiểu `Date.getDay()`: người dùng gõ "thứ 2" và mọi
  /// trường học ở đây đánh số như vậy, nên đổi hệ ở tầng dữ liệu là mời
  /// một lỗi lệch-một vào chỗ khó thấy nhất.
  weekday Int

  /// "HH:mm" 24 giờ. Chuỗi chứ không DateTime: một buổi học không có NGÀY,
  /// nó chỉ có giờ trong tuần. Lưu DateTime thì phải bịa ra một ngày gốc,
  /// và ngày bịa đó sẽ bị múi giờ kéo lệch sang hôm trước/hôm sau.
  startTime String @map("start_time") @db.VarChar(5)
  endTime   String @map("end_time") @db.VarChar(5)

  /// Slot của FAP (0..12). Trường xếp lịch theo SLOT chứ không theo giờ tự do:
  /// Slot 1 = 7:30–9:50 · 2 = 10:00–12:20 · 3 = 12:50–15:10 · 4 = 15:20–17:40.
  ///
  /// Giữ CẢ `slot` LẪN `startTime`/`endTime`: slot để nhập nhanh và xếp hàng
  /// khi hiện bảng tuần, còn giờ vẫn là nguồn sự thật để đặt lời nhắc — trường
  /// có thể đổi khung giờ slot giữa kỳ, và khi đó lịch đã nhập vẫn phải kêu
  /// đúng giờ người dùng đang học cho tới khi họ sửa.
  slot Int?

  /// Hai nút FAP để sẵn trên mỗi ô lịch, và là thứ sinh viên bấm nhiều nhất
  /// trong ngày học.
  meetUrl      String? @map("meet_url") @db.VarChar(500)
  materialsUrl String? @map("materials_url") @db.VarChar(500)

  color String? @db.VarChar(20)
  note  String? @db.Text

  /// Nhắc trước bao nhiêu PHÚT. 0 = không nhắc.
  remindMinutes Int @default(30) @map("remind_minutes")

  /// Khoảng thời gian của kỳ học. Rỗng = không giới hạn.
  /// Có nó thì lịch kỳ trước không hiện chồng lên kỳ này, và thông báo
  /// nhắc học tự tắt khi hết kỳ mà không cần ai nhớ đi xoá.
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  attendances ClassAttendance[]

  @@index([userId, weekday], map: "idx_class_schedule_user_day")
  @@map("class_schedules")
}

/// Điểm danh MỘT buổi của MỘT môn.
///
/// Vì sao một bảng riêng chứ không đếm bằng một con số trên `ClassSchedule`:
/// một con số `soBuoiVang` thì không bao giờ sửa lại được cho đúng. Ghi nhầm
/// một buổi là phải nhớ trừ đi bằng tay, và không ai biết buổi nào đã ghi.
/// Có dòng theo NGÀY thì bấm lại là sửa được, và xem lại được đã nghỉ hôm nào.
model ClassAttendance {
  id         Int @id @default(autoincrement())
  userId     Int @map("user_id")
  scheduleId Int @map("schedule_id")

  /// Ngày diễn ra buổi học. `@db.Date` chứ không DateTime: một buổi thuộc về
  /// một NGÀY, và giữ cả giờ thì hai lần ghi cùng ngày thành hai dòng khác nhau.
  date DateTime @db.Date

  /// 'co' = có mặt · 'vang' = vắng · 'phep' = vắng có phép.
  /// Chuỗi chứ không enum, cùng lý do như `scope` của việc: thêm trạng thái mới
  /// (vd 'muon' — đi muộn) không phải một migration.
  status String @db.VarChar(8)

  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule ClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// Một buổi chỉ có MỘT bản ghi. Không có ràng buộc này thì bấm hai lần là
  /// hai dòng, và số buổi nghỉ đếm ra gấp đôi — con số quyết định đỗ/trượt.
  @@unique([scheduleId, date], map: "uk_class_attendance_buoi")
  @@index([userId, date], map: "idx_class_attendance_user_date")
  @@map("class_attendances")
}

/// Một KỲ HỌC. Kỳ ở đây cố định 10 tuần, tuần 8 là tuần thi.
///
/// Vì sao cần bảng riêng thay vì suy từ `ClassSchedule.startDate`: suy được số
/// tuần thì phải lấy min(startDate) của mọi buổi học, mà người dùng có thể
/// nhập lịch mà bỏ trống ngày kỳ — khi đó "Tuần mấy" im lặng sai. Và kỳ là
/// thứ người ta nói tới độc lập với lịch: "kỳ này mình học 5 môn".
model HocKy {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  /// "Fall 2026", "Kỳ 1 năm 3" — do người dùng đặt.
  ten String @db.VarChar(120)

  /// NGÀY THỨ HAI của tuần 1. Chuẩn hoá về thứ Hai lúc ghi để phép tính
  /// "tuần thứ mấy" chỉ là một phép chia, không phải một chuỗi if.
  batDau DateTime @map("bat_dau") @db.Date

  /// Số tuần của kỳ. Mặc định 10 theo lối FPT, nhưng để đổi được — trường
  /// khác và kỳ hè có số tuần khác.
  soTuan Int @default(10) @map("so_tuan")

  /// Tuần thi. Mặc định 8. Để riêng chứ không suy ra `soTuan - 2`: lịch thi
  /// có thể rơi vào tuần khác tuỳ kỳ, và đoán sai thì app tô nhầm tuần.
  tuanThi Int @default(8) @map("tuan_thi")

  /// Chỉ MỘT kỳ được coi là đang học. App hiện lịch của kỳ này.
  dangHoc Boolean @default(true) @map("dang_hoc")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lichThi LichThi[]
  monHoc  MonHocKy[]

  @@index([userId, dangHoc], map: "idx_hoc_ky_user")
  @@map("hoc_ky")
}

/// Một BUỔI THI. Khác `ClassSchedule` ở chỗ nó xảy ra ĐÚNG MỘT LẦN vào một
/// ngày cụ thể, không lặp hằng tuần — nên nó là ngày, không phải thứ.
model LichThi {
  id      Int  @id @default(autoincrement())
  userId  Int  @map("user_id")
  hocKyId Int? @map("hoc_ky_id")

  monHoc String  @map("mon_hoc") @db.VarChar(200)
  maMon  String? @map("ma_mon") @db.VarChar(50)

  /// 'PE' | 'FE' | 'PT' | 'ME' | 'NOI' | 'NGHE' | 'VIET' | 'KHAC'.
  /// Chuỗi chứ không enum: mỗi môn một kiểu thi (tiếng Nhật có thi nói và
  /// nghe riêng), và thêm một loại mới không đáng một migration.
  loai String @db.VarChar(16)

  /// Ngày thi cụ thể.
  ngay DateTime @db.Date

  batDau  String @map("bat_dau") @db.VarChar(5)
  ketThuc String @map("ket_thuc") @db.VarChar(5)

  phong     String? @db.VarChar(100)
  /// Số báo danh / số máy. FAP có cột này và nó là thứ phải nhớ khi vào phòng.
  soBaoDanh String? @map("so_bao_danh") @db.VarChar(50)

  ghiChu String? @map("ghi_chu") @db.Text

  /// Nhắc trước bao nhiêu phút. Mặc định 60 chứ không 30 như buổi học: thi
  /// thường ở phòng lạ và phải tới sớm.
  nhacTruoc Int @default(60) @map("nhac_truoc")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hocKy HocKy? @relation(fields: [hocKyId], references: [id], onDelete: SetNull)

  @@index([userId, ngay], map: "idx_lich_thi_user_ngay")
  @@map("lich_thi")
}

// ============================================================
// HUẤN LUYỆN HỌC KỲ (/hoc-tap) — 02/10/2026
// ------------------------------------------------------------
// AI soạn việc học theo môn/tuần; người học NỘP BẰNG CHỨNG, chỉ AI (hoặc
// Claude Code qua token, hoặc admin) được chấm và tích. Tỷ lệ trượt do mã
// tính (src/services/hocTap/ruiRo.ts), không do AI đoán.
// Kế hoạch: docs/hoc-tap-coach-plan.md
// ============================================================

/// Một MÔN trong một kỳ của một người.
model MonHocKy {
  id      Int @id @default(autoincrement())
  userId  Int @map("user_id")
  hocKyId Int @map("hoc_ky_id")

  maMon String @map("ma_mon") @db.VarChar(30)
  ten   String @db.VarChar(200)

  /// Khoá Academy tương ứng (nếu có). Không khoá ngoại: khoá có thể bị seed lại.
  courseId   Int?    @map("course_id")
  courseSlug String? @map("course_slug") @db.VarChar(255)

  /// Người học tự mô tả: "chưa biết gì, chưa có nền web"… AI đọc khi soạn kế hoạch.
  trinhDo String? @map("trinh_do") @db.Text
  /// Mục tiêu: "qua môn", "8 điểm"…
  mucTieu String? @map("muc_tieu") @db.VarChar(200)
  /// Các khoá nền phải học trước: [{slug,ten}].
  nenTang Json?   @map("nen_tang")
  mau     String? @db.VarChar(20)
  thuTu   Int     @default(0) @map("thu_tu")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hocKy   HocKy          @relation(fields: [hocKyId], references: [id], onDelete: Cascade)
  nhiemVu NhiemVuHoc[]
  ruiRo   RuiRoHocNgay[]

  @@unique([hocKyId, maMon], map: "uk_mon_hoc_ky_ma")
  @@index([userId], map: "idx_mon_hoc_ky_user")
  @@map("mon_hoc_ky")
}

/// Một VIỆC HỌC: bài học, bài tập, lab, quiz, đề PE/FE luyện, ghi chú…
model NhiemVuHoc {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")
  monId  Int @map("mon_id")

  /// Tuần của kỳ (1..soTuan). Việc nền tảng bù cho tuần đã qua vẫn gắn tuần hiện tại.
  tuan Int
  /// 'NEN_TANG' | 'BAI_HOC' | 'BAI_TAP' | 'LAB' | 'QUIZ' | 'PE' | 'FE' | 'ON_TAP' | 'GHI_CHU'
  loai String @db.VarChar(16)

  tieuDe          String  @map("tieu_de") @db.VarChar(255)
  /// Hướng dẫn chi tiết (markdown): làm gì, gõ gì, nộp gì.
  huongDan        String? @map("huong_dan") @db.Text
  /// Bằng chứng cần nộp: "ảnh Terminal bước 2–4 + câu trả lời…".
  yeuCauBangChung String? @map("yeu_cau_bang_chung") @db.Text
  lienKet         String? @map("lien_ket") @db.VarChar(500)

  /// Thời lượng bấm giờ (phút).
  thoiLuongPhut Int      @default(30) @map("thoi_luong_phut")
  hanChot       DateTime @map("han_chot")
  trongSo       Int      @default(1) @map("trong_so")
  thuTu         Int      @default(0) @map("thu_tu")

  /// 'CHUA_LAM' | 'DANG_LAM' | 'CHO_CHAM' | 'DAT' | 'CHUA_DAT'
  trangThai String    @default("CHUA_LAM") @map("trang_thai") @db.VarChar(12)
  batDauLuc DateTime? @map("bat_dau_luc")
  nopLuc    DateTime? @map("nop_luc")

  /// Kết quả lần chấm gần nhất.
  diem      Float?
  nhanXet   String?   @map("nhan_xet") @db.Text
  loiCanSua Json?     @map("loi_can_sua")
  /// 'AI' | 'CLAUDE' | 'ADMIN'
  nguoiCham String?   @map("nguoi_cham") @db.VarChar(10)
  chamLuc   DateTime? @map("cham_luc")

  /// Ai tạo việc: 'AI' | 'CLAUDE' | 'NGUOI_HOC'
  nguon String @default("AI") @db.VarChar(12)

  /// GIỜ HỌC dự kiến (xếp lịch tự động quanh lịch lớp, hoặc người học kéo).
  /// Tới giờ ⇒ nhắc; quá 15' chưa bấm Bắt đầu ⇒ cảnh báo + tính "bỏ lỡ giờ học" vào tỷ lệ trượt.
  gioBatDau   DateTime? @map("gio_bat_dau")
  /// Đã gửi lời nhắc "tới giờ" / "đang trễ" — để cron không gửi lặp.
  daNhacLuc   DateTime? @map("da_nhac_luc")
  daBaoTreLuc DateTime? @map("da_bao_tre_luc")
  /// VẤN ĐÁP chống học vẹt: bằng chứng đạt ⇒ AI hỏi lại 2–3 câu về CHÍNH bài đã nộp;
  /// trả lời đúng mới DAT. { cauHoi: string[], traLoi?: string[], ketQua?: {...}, diemBangChung: number }
  vanDap      Json?     @map("van_dap")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mon       MonHocKy       @relation(fields: [monId], references: [id], onDelete: Cascade)
  bangChung BangChungHoc[]

  @@index([userId, hanChot], map: "idx_nhiem_vu_hoc_user_han")
  @@index([monId, tuan], map: "idx_nhiem_vu_hoc_mon_tuan")
  @@index([userId, gioBatDau], map: "idx_nhiem_vu_hoc_user_gio")
  @@map("nhiem_vu_hoc")
}

/// Một LẦN NỘP bằng chứng cho một việc (nộp lại được nhiều lần).
model BangChungHoc {
  id        Int @id @default(autoincrement())
  userId    Int @map("user_id")
  nhiemVuId Int @map("nhiem_vu_id")
  lanNop    Int @default(1) @map("lan_nop")

  noiDung String? @map("noi_dung") @db.Text
  /// ["https://github.com/..."]
  lienKet Json?   @map("lien_ket")
  /// [{url, ten, loai}] — tệp đã lên R2.
  tep     Json?

  /// Kết quả chấm đầy đủ (JSON của AI đã được mã kiểm lại).
  ketQua    Json?
  diem      Float?
  dat       Boolean?
  nguoiCham String?   @map("nguoi_cham") @db.VarChar(10)
  chamLuc   DateTime? @map("cham_luc")
  /// Nộp sau khi hết thời lượng bấm giờ.
  nopTre    Boolean   @default(false) @map("nop_tre")

  createdAt DateTime @default(now()) @map("created_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nhiemVu NhiemVuHoc @relation(fields: [nhiemVuId], references: [id], onDelete: Cascade)

  @@index([nhiemVuId], map: "idx_bang_chung_hoc_nv")
  @@map("bang_chung_hoc")
}

/// Ảnh chụp tỷ lệ trượt mỗi ngày (monId null = cả kỳ) để vẽ biểu đồ.
model RuiRoHocNgay {
  id      Int      @id @default(autoincrement())
  userId  Int      @map("user_id")
  monId   Int?     @map("mon_id")
  ngay    DateTime @db.Date
  tyLe    Int      @map("ty_le")
  tienDo  Int      @map("tien_do")
  chiTiet Json?    @map("chi_tiet")

  createdAt DateTime @default(now()) @map("created_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mon  MonHocKy? @relation(fields: [monId], references: [id], onDelete: Cascade)

  @@index([userId, ngay], map: "idx_rui_ro_hoc_user_ngay")
  @@map("rui_ro_hoc_ngay")
}

// ============================================================
// 30. VÍ ĐIỂM · GÓI PRO TRẢ PHÍ · CHUYỂN KHOẢN ĐỐI SOÁT
// ------------------------------------------------------------
// Thêm 13/09/2026. Ba khối gắn với nhau:
//
//  1. VÍ ĐIỂM — người dùng nạp tiền thật, nhận ĐIỂM theo tỉ lệ
//     CỐ ĐỊNH 1 điểm = 1 VND (xem POINTS_PER_VND ở points.service.ts).
//     Điểm KHÔNG quy đổi ngược ra tiền, KHÔNG chuyển cho người khác,
//     KHÔNG hết hạn. Số dư là `PointAccount.balance`, còn mọi thay đổi
//     đều PHẢI đi qua một dòng `PointTransaction` — sổ cái là nguồn sự
//     thật, `balance` chỉ là bản tổng hợp để đọc nhanh. Không bao giờ
//     ghi `balance` mà không ghi kèm một dòng sổ trong CÙNG transaction.
//
//  2. GÓI PRO — `ProPlan` là bảng giá (1/3/6/12 tháng), `ProOrder` là
//     một lượt mua. Trả xong → `grantProToUser(days, 'PURCHASE')`, cộng
//     dồn lên hạn cũ nếu còn hạn.
//
//  3. CHUYỂN KHOẢN ĐỐI SOÁT TAY — cổng dự phòng khi PayOS chết.
//     `BankTransfer` giữ mã tham chiếu duy nhất mà người mua phải ghi
//     vào nội dung chuyển khoản; admin bấm xác nhận thì đơn mới được
//     giao. `PaymentSetting` giữ thông tin tài khoản nhận (một hàng duy
//     nhất, sửa trong trang quản trị — KHÔNG hardcode trong mã).
//
// Tiền VND lưu Int (đồng, không có phần lẻ) — Decimal chỉ dùng cho các
// bảng cũ đã trót dùng. Điểm cũng là Int. Không có float ở bất cứ đâu.
// ============================================================

/// Số dư điểm của một người dùng. Một hàng cho mỗi người, tạo lười
/// (lazy) lần đầu người đó chạm tới ví.
model PointAccount {
  id     Int @id @default(autoincrement())
  userId Int @unique(map: "uk_point_account_user") @map("user_id")

  /// Điểm khả dụng. LUÔN bằng tổng `amount` của mọi PointTransaction
  /// của người này — bất biến này được kiểm bằng `npm run points:audit`.
  balance Int @default(0)

  /// Cộng dồn để hiển thị/đối soát, không tham gia tính toán số dư.
  totalEarned Int @default(0) @map("total_earned")
  totalSpent  Int @default(0) @map("total_spent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_accounts")
}

/// Sổ cái điểm — CHỈ THÊM, không bao giờ sửa/xoá một dòng đã ghi.
/// Muốn đảo một giao dịch thì ghi một dòng ngược dấu (kind=REFUND).
model PointTransaction {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  /// Dương = cộng điểm, âm = trừ điểm. Không bao giờ bằng 0.
  amount       Int
  /// Số dư NGAY SAU giao dịch này — chụp lại để dựng lại lịch sử mà
  /// không phải cộng dồn cả sổ.
  balanceAfter Int @map("balance_after")

  /// TOPUP | BONUS | SPEND | REFUND | ADMIN_ADJUST | EXPIRE
  kind String @db.VarChar(24)

  /// Trỏ tới chứng từ gốc: TOPUP_ORDER | SHOP_ORDER | PRO_ORDER | COURSE_ORDER
  refKind String? @map("ref_kind") @db.VarChar(24)
  refId   Int?    @map("ref_id")

  description String @db.VarChar(255)

  /// Chốt chống-ghi-hai-lần. Mọi lối vào cộng/trừ điểm PHẢI truyền khoá
  /// này (vd `topup:42`, `shop:1337`); UNIQUE ở DB là thứ thật sự chặn,
  /// không phải câu `if` trong mã — webhook cổng thanh toán gọi lại
  /// nhiều lần là chuyện bình thường, không phải ngoại lệ.
  idempotencyKey String? @unique(map: "uk_point_tx_idem") @map("idempotency_key") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], name: "idx_point_tx_user_created")
  @@index([refKind, refId], name: "idx_point_tx_ref")
  @@map("point_transactions")
}

/// Mốc nạp dựng sẵn + % thưởng. Admin sửa được, không cần deploy.
model TopupTier {
  id           Int     @id @default(autoincrement())
  amountVnd    Int     @map("amount_vnd")
  /// % điểm thưởng cộng thêm (0 = không thưởng). 10 nghĩa là +10%.
  bonusPercent Int     @default(0) @map("bonus_percent")
  label        String? @db.VarChar(80)
  popular      Boolean @default(false)
  active       Boolean @default(true)
  sortOrder    Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("point_topup_tiers")
}

/// Một lượt nạp tiền vào ví. PENDING cho tới khi cổng/admin xác nhận.
model TopupOrder {
  id        Int    @id @default(autoincrement())
  orderCode String @unique(map: "uk_topup_order_code") @db.VarChar(50)
  userId    Int    @map("user_id")

  amountVnd    Int @map("amount_vnd")
  /// Điểm gốc (= amountVnd) và điểm thưởng, tách ra để hoá đơn nói rõ.
  basePoints   Int @map("base_points")
  bonusPoints  Int @default(0) @map("bonus_points")
  totalPoints  Int @map("total_points")
  /// Chụp lại % thưởng lúc tạo đơn — mốc thưởng đổi sau đó không được
  /// làm thay đổi đơn đã tạo.
  bonusPercent Int @default(0) @map("bonus_percent")

  /// PENDING | PAID | CANCELLED | FAILED | EXPIRED
  status        String    @default("PENDING") @db.VarChar(20)
  /// PAYOS | BANK_TRANSFER
  paymentMethod String    @default("PAYOS") @map("payment_method") @db.VarChar(30)
  paymentId     String?   @map("payment_id") @db.VarChar(120)
  paidAt        DateTime? @map("paid_at")
  /// Quá hạn thì không cho trả nữa (dọn bằng job, xem expireStaleOrders).
  expiresAt     DateTime? @map("expires_at")

  /// Khoá do client sinh, chặn double-click tạo hai đơn. Unique THEO
  /// NGƯỜI để hai người vô tình trùng UUID không đạp nhau.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey], name: "uk_topup_idempotency")
  @@index([userId, status], name: "idx_topup_user_status")
  @@index([status, createdAt(sort: Desc)], name: "idx_topup_status_created")
  @@map("point_topup_orders")
}

/// Bảng giá Pro. Giá lưu VND; `months` quyết định số ngày được cộng.
model ProPlan {
  id   Int    @id @default(autoincrement())
  code String @unique(map: "uk_pro_plan_code") @db.VarChar(30)
  name String @db.VarChar(120)

  months           Int
  priceVnd         Int  @map("price_vnd")
  /// Giá gốc để gạch ngang trên UI (null = không khuyến mãi).
  originalPriceVnd Int? @map("original_price_vnd")

  description String? @db.Text
  badge       String? @db.VarChar(40)
  popular     Boolean @default(false)
  active      Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders ProOrder[]

  @@map("pro_plans")
}

/// Một lượt mua gói Pro. Trả bằng ĐIỂM hoặc bằng cổng thanh toán.
model ProOrder {
  id        Int    @id @default(autoincrement())
  orderCode String @unique(map: "uk_pro_order_code") @db.VarChar(50)
  userId    Int    @map("user_id")
  planId    Int?   @map("plan_id")

  /// Chụp lại lúc mua — đổi bảng giá sau đó không được sửa đơn cũ.
  planCode   String @map("plan_code") @db.VarChar(30)
  planName   String @map("plan_name") @db.VarChar(120)
  months     Int
  amountVnd  Int    @map("amount_vnd")
  /// Số điểm đã trừ (khi trả bằng ví). 0 nghĩa là trả bằng cổng.
  pointsUsed Int    @default(0) @map("points_used")

  /// PENDING | PAID | CANCELLED | FAILED | EXPIRED | REFUNDED
  status        String    @default("PENDING") @db.VarChar(20)
  /// POINTS | PAYOS | BANK_TRANSFER
  paymentMethod String    @default("POINTS") @map("payment_method") @db.VarChar(30)
  paymentId     String?   @map("payment_id") @db.VarChar(120)
  paidAt        DateTime? @map("paid_at")
  expiresAt     DateTime? @map("expires_at")

  /// Số ngày Pro thực cấp (chụp lại để đối soát khi months đổi nghĩa).
  grantedDays Int?    @map("granted_days")
  /// Chốt: true sau khi đã cộng hạn Pro. Webhook gọi lại không cộng lần hai.
  granted     Boolean @default(false)

  idempotencyKey String? @map("idempotency_key") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan ProPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey], name: "uk_pro_order_idempotency")
  @@index([userId, status], name: "idx_pro_order_user_status")
  @@index([status, createdAt(sort: Desc)], name: "idx_pro_order_status_created")
  @@index([planId], name: "idx_pro_order_plan")
  @@map("pro_subscription_orders")
}

/// Thông tin tài khoản nhận chuyển khoản + cấu hình đối soát.
/// MỘT hàng duy nhất (id = 1), sửa trong trang quản trị.
model PaymentSetting {
  id Int @id @default(1)

  bankTransferEnabled Boolean @default(false) @map("bank_transfer_enabled")
  /// Mã BIN ngân hàng theo chuẩn VietQR (vd "970436" = Vietcombank).
  bankBin             String? @map("bank_bin") @db.VarChar(20)
  bankName            String? @map("bank_name") @db.VarChar(120)
  bankAccountNo       String? @map("bank_account_no") @db.VarChar(40)
  bankAccountName     String? @map("bank_account_name") @db.VarChar(120)
  /// Số phút người mua có để chuyển khoản trước khi đơn hết hạn.
  transferTtlMinutes  Int     @default(60) @map("transfer_ttl_minutes")
  /// Ghi chú hiện trên trang hướng dẫn chuyển khoản.
  note                String? @db.Text

  updatedBy Int?     @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("payment_settings")
}

/// Một lượt chuyển khoản chờ đối soát. `refCode` là thứ người mua PHẢI
/// ghi vào nội dung chuyển khoản — admin dò theo nó.
model BankTransfer {
  id      Int    @id @default(autoincrement())
  refCode String @unique(map: "uk_bank_transfer_ref") @map("ref_code") @db.VarChar(40)

  /// SHOP | COURSE | TOPUP | PRO — đơn nào đang chờ khoản này.
  orderKind String @map("order_kind") @db.VarChar(20)
  orderId   Int    @map("order_id")
  /// Mã đơn dạng chữ, để admin tra cứu không cần join.
  orderCode String @map("order_code") @db.VarChar(50)

  userId    Int? @map("user_id")
  amountVnd Int  @map("amount_vnd")

  /// AWAITING | CONFIRMED | REJECTED | EXPIRED
  status String @default("AWAITING") @db.VarChar(20)

  /// Ảnh biên lai người mua tải lên (không bắt buộc).
  proofUrl  String? @map("proof_url") @db.VarChar(500)
  buyerNote String? @map("buyer_note") @db.VarChar(500)

  adminNote   String?   @map("admin_note") @db.VarChar(500)
  confirmedBy Int?      @map("confirmed_by")
  confirmedAt DateTime? @map("confirmed_at")
  expiresAt   DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)], name: "idx_bank_transfer_status_created")
  @@index([orderKind, orderId], name: "idx_bank_transfer_order")
  @@index([userId], name: "idx_bank_transfer_user")
  @@map("bank_transfer_payments")
}

/// Yêu cầu đổi key/tài khoản số bị hỏng. Duyệt thì hệ thống tự lấy một
/// key AVAILABLE khác trong kho, gắn cho người mua và thu hồi key cũ.
model KeyReplacementRequest {
  id          Int @id @default(autoincrement())
  userId      Int @map("user_id")
  orderId     Int @map("order_id")
  orderItemId Int @map("order_item_id")

  /// Chụp lại để admin đọc mà không phải join.
  orderCode   String @map("order_code") @db.VarChar(50)
  productName String @map("product_name") @db.VarChar(255)

  reason String @db.Text

  /// PENDING | APPROVED | REJECTED
  status String @default("PENDING") @db.VarChar(20)

  /// Key cũ bị thu hồi và key mới được cấp (nếu duyệt).
  oldKeyId Int? @map("old_key_id")
  newKeyId Int? @map("new_key_id")

  adminNote  String?   @map("admin_note") @db.VarChar(500)
  resolvedBy Int?      @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)], name: "idx_key_repl_status_created")
  @@index([userId], name: "idx_key_repl_user")
  @@index([orderItemId], name: "idx_key_repl_item")
  @@map("product_key_replacement_requests")
}

// ============================================================
// 31. XIN KEY OPENCODE (cổng key con LLM) — 13/09/2026
// ------------------------------------------------------------
// Người dùng Pro xin một key con để dùng AI trong OpenCode trên máy họ.
// Đơn nằm ở PENDING cho tới khi admin duyệt; chưa duyệt thì người dùng
// KHÔNG thấy key nào.
//
// ⚠️ Admin DÁN key vào lúc duyệt, hệ thống không tự tạo. Cụm New API
// (`services/cong-llm/`) chạy ở mạng docker riêng, backend không gọi tới
// được — và giao diện quản trị của nó cố ý chỉ mở qua SSH tunnel. Admin
// vốn đã phải vào đó để đặt hạn mức cho key, nên dán thêm một lần không
// tốn công, mà đổi lại không phải nhét token quản trị của New API vào
// backend.
//
// ⚠️ `keyValue` là BÍ MẬT THẬT. Chỉ trả về cho ĐÚNG chủ đơn, và không bao
// giờ ghi vào log. Cột `keyHien` là bản che để hiện ở danh sách admin.
// ============================================================

model LlmKeyRequest {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  /// Người dùng tự khai dùng để làm gì — admin đọc trước khi duyệt.
  reason String @db.Text

  /// PENDING | APPROVED | REJECTED | REVOKED
  status String @default("PENDING") @db.VarChar(20)

  /// Key con thật, admin dán lúc duyệt. Null khi chưa duyệt.
  keyValue String? @map("key_value") @db.VarChar(200)
  /// Bản che (vd "sk-…a1b2") để hiện ở danh sách mà không lộ key.
  keyHien  String? @map("key_hien") @db.VarChar(40)
  /// Hạn mức admin đặt cho key này ở New API, chép lại để hiển thị.
  quotaUsd Int?    @map("quota_usd")

  /// REQUEST = người dùng xin ở /llm-key (admin duyệt tay).
  /// SHOP    = mua gói ở /shop, hệ thống tự cấp ngay khi thanh toán xong.
  source    String    @default("REQUEST") @db.VarChar(20)
  /// Sản phẩm đã bán ra key này (chỉ với source = SHOP).
  productId Int?      @map("product_id")
  /// Hết hạn gói. Null = không hạn (key xin tay). Quá hạn thì key thôi được
  /// tính vào ví chung và `canh` khoá nó ở New API.
  expiresAt DateTime? @map("expires_at")

  adminNote  String?   @map("admin_note") @db.VarChar(500)
  resolvedBy Int?      @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)], name: "idx_llm_key_req_status_created")
  @@index([userId], name: "idx_llm_key_req_user")
  @@index([keyValue], map: "idx_llm_key_req_key")
  @@map("llm_key_requests")
}

/// Xin thêm hạn mức model Cuong Fable 5 (`claude-fable-5`) trong AI Code.
///
/// Fable tốn token gấp 3,5 lần nên Pro có một hạn mức riêng mỗi 30 ngày
/// (`services/agent/fable.ts`). Dùng hết ⇒ người dùng bấm "Xin thêm" ⇒ admin
/// duyệt ở /admin/commerce?tab=fable ⇒ được cộng `soToken` trong cửa sổ đó.
/// Admin tự dùng thì không bị giới hạn nên không cần bảng này.
model FableQuotaRequest {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  /// Người dùng tự khai cần thêm để làm gì.
  reason String @db.Text

  /// PENDING | APPROVED | REJECTED
  status String @default("PENDING") @db.VarChar(20)

  /// Số token được CỘNG khi duyệt (admin chọn). Null khi chưa duyệt.
  soToken Int? @map("so_token")

  adminNote  String?   @map("admin_note") @db.VarChar(500)
  resolvedBy Int?      @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)], name: "idx_fable_req_status_created")
  @@index([userId, resolvedAt], name: "idx_fable_req_user_resolved")
  @@map("fable_quota_requests")
}

// ============================================================
// APPLE IN-APP PURCHASE
//
// Apple là MỘT CÁCH TRẢ TIỀN NỮA cho đúng gói Pro đã bán trên web, không
// phải một hệ Pro thứ hai. Việc cấp quyền vẫn đi qua `grantProToUser()` —
// cùng hàm mà đổi mã, admin cấp tay, ví điểm, VietQR và PayOS đang gọi — nên
// hạn cộng dồn giống hệt và web đọc được ngay mà không cần đồng bộ gì.
// ============================================================

/// Ràng MỘT lượt mua của Apple vào ĐÚNG MỘT tài khoản CuongThai, vĩnh viễn.
///
/// ⛔ Vì sao phải là bảng riêng với khoá chính, chứ không phải một cột trong
/// bảng giao dịch: `originalTransactionId` định danh LƯỢT MUA, còn mỗi lần
/// gia hạn lại sinh một `transactionId` MỚI dùng chung lượt mua đó. Nếu đặt
/// UNIQUE lên `original_transaction_id` trong bảng giao dịch thì gói tự gia
/// hạn sẽ đâm khoá ngay lần gia hạn đầu.
///
/// Còn không ràng gì cả thì một người mua một lần rồi đăng nhập năm tài khoản
/// khác nhau, mỗi tài khoản nhận Pro một lượt. Khoá chính ở đây khiến điều đó
/// KHÔNG THỂ xảy ra ở tầng cơ sở dữ liệu, không phụ thuộc vào việc mã ứng
/// dụng có nhớ kiểm hay không.
model AppleIapLink {
  originalTransactionId String   @id @map("original_transaction_id") @db.VarChar(64)
  userId                Int      @map("user_id")
  /// `appAccountToken` app gửi kèm lúc mua — Apple trả lại nguyên trong giao
  /// dịch. Dùng để quy được chủ sở hữu cả khi lượt mua tới qua thông báo máy
  /// chủ (lúc đó không có phiên đăng nhập nào để hỏi).
  appAccountToken       String?  @map("app_account_token") @db.VarChar(64)
  firstSeenAt           DateTime @default(now()) @map("first_seen_at")

  giaoDich AppleIapTransaction[]

  @@index([userId], map: "ix_apple_iap_link_user")
  @@map("apple_iap_links")
}

/// Một giao dịch đã xác minh chữ ký và đã cấp Pro.
///
/// `transactionId` là khoá duy nhất ⇒ gửi lại cùng một JWS bao nhiêu lần cũng
/// chỉ cấp Pro MỘT lần. Cần thiết thật sự: StoreKit gửi lại giao dịch chưa
/// `finish()` ở mỗi lần mở app, và `Transaction.updates` cũng phát lại.
model AppleIapTransaction {
  id                    Int       @id @default(autoincrement())
  transactionId         String    @unique(map: "uk_apple_iap_transaction") @map("transaction_id") @db.VarChar(64)
  originalTransactionId String    @map("original_transaction_id") @db.VarChar(64)
  userId                Int       @map("user_id")
  productId             String    @map("product_id") @db.VarChar(64)
  /// Số ngày đã cộng cho lượt này. Lưu lại vì bảng giá đổi được, còn sổ sách
  /// thì phải giữ đúng con số lúc bán.
  grantedDays           Int       @map("granted_days")
  purchaseDate          DateTime  @map("purchase_date")
  /// Chỉ gói tự gia hạn mới có.
  expiresDate           DateTime? @map("expires_date")
  /// "Sandbox" hoặc "Production". ⚠️ Giữ lại để không bao giờ lẫn: giao dịch
  /// Sandbox KHÔNG được cấp Pro thật trên production.
  environment           String    @map("environment") @db.VarChar(16)
  /// Apple hoàn tiền / thu hồi. Có giá trị ⇒ đã gỡ Pro tương ứng.
  revokedAt             DateTime? @map("revoked_at")
  revocationReason      Int?      @map("revocation_reason")
  /// Payload đã giải mã, giữ nguyên để đối soát về sau.
  rawPayload            Json      @map("raw_payload")
  /// Lúc Pro thực sự được cấp. `null` = đã ghi nhận nhưng CHƯA cấp — người
  /// dùng đã trả tiền mà chưa có quyền. Lưới cứu quét đúng cột này.
  grantedAt             DateTime? @map("granted_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  link AppleIapLink @relation(fields: [originalTransactionId], references: [originalTransactionId], onDelete: Cascade)

  @@index([userId], map: "ix_apple_iap_txn_user")
  @@index([originalTransactionId], map: "ix_apple_iap_txn_original")
  @@map("apple_iap_transactions")
}

// ═══════════════════════════════════════════════════════════════════════
// 32. HỘP THƯ ADMIN — mọi việc cần admin biết đổ về MỘT chỗ
// ═══════════════════════════════════════════════════════════════════════
//
// Vì sao cần: sidebar /admin đang có 43 mục, và những thứ CẦN XỬ LÝ nằm rải
// rác trong đó — đơn xin key thì lẫn trong một tab của /admin/commerce. Người
// dùng nói đúng nguyên văn: "xin duyệt key nãy tôi phải mò mãi mới thấy".
// Không có chỗ nào trả lời được câu "bây giờ có gì đang chờ tôi?".
//
// Đây KHÔNG dùng lại `SocialNotification`: bảng đó bắt buộc có `senderId` trỏ
// tới một User (thanh toán thành công thì "người gửi" là ai?), `type` giới hạn
// VARCHAR(20) với danh sách cố định, và cái chuông của nó là chuông MẠNG XÃ
// HỘI của người dùng — trộn việc vận hành vào đó là làm hỏng cả hai.
//
// Thông báo ở đây là CHUNG cho mọi admin, không theo từng người: web này một
// admin, và "đơn đã xử lý" thì mọi admin đều nên thấy là đã xong.
model AdminNotification {
  id Int @id @default(autoincrement())

  /// XIN_KEY · DON_MOI · DA_THANH_TOAN · CHUYEN_KHOAN_CHO_DUYET · DOI_KEY
  /// BAO_CAO · XOA_TAI_KHOAN · NAP_DIEM · MUA_PRO · KHAC
  loai    String  @db.VarChar(32)
  tieuDe  String  @map("tieu_de") @db.VarChar(200)
  noiDung String? @map("noi_dung") @db.Text

  /// Đường dẫn trong /admin — bấm vào là tới ĐÚNG chỗ xử lý, không phải mò.
  duongDan String? @map("duong_dan") @db.VarChar(300)

  /// `can_xu_ly` = có việc phải làm (đếm riêng, hiện số đỏ).
  /// `thuong`    = chỉ để biết (đơn đã thanh toán xong, có người nạp điểm…).
  mucDo String @default("thuong") @map("muc_do") @db.VarChar(16)

  /// Người gây ra sự kiện. KHÔNG đặt khoá ngoại: xoá tài khoản thì thông báo
  /// vẫn phải còn, nếu không thì đúng những ca đáng điều tra nhất lại biến mất.
  userId   Int? @map("user_id")
  entityId Int? @map("entity_id")

  /// Chặn trùng khi webhook thanh toán gọi lại nhiều lần. Ví dụ
  /// "DA_THANH_TOAN:shop:1234". Null = sự kiện không cần chống trùng.
  khoaChongTrung String? @unique(map: "uk_admin_notif_khoa") @map("khoa_chong_trung") @db.VarChar(120)

  daDoc  Boolean   @default(false) @map("da_doc")
  docLuc DateTime? @map("doc_luc")
  /// Khác `daDoc`: đọc rồi vẫn có thể CHƯA xử lý xong.
  daXuLy Boolean   @default(false) @map("da_xu_ly")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([daDoc, createdAt(sort: Desc)], name: "idx_admin_notif_chua_doc")
  @@index([mucDo, daXuLy], name: "idx_admin_notif_can_xu_ly")
  @@index([createdAt(sort: Desc)], name: "idx_admin_notif_thoi_gian")
  @@map("admin_notifications")
}

/// Nội dung IELTS phục vụ cho app (iOS/iPad) — MỘT bảng, payload JSON.
///
/// ⚠️ BẢNG NÀY LÀ BẢN SAO, KHÔNG PHẢI NGUỒN. Nguồn sự thật vẫn là các tệp
/// TypeScript của web ở `frontend/src/app/tech-trends/ielts/data/**`, và
/// `scripts/ielts-seed.mjs` đọc THẲNG chúng rồi ghi vào đây. Trang web không
/// đọc bảng này — nó vẫn import tệp TS như cũ.
///
/// Vì sao không chép dữ liệu sang app: `seed.ts` từng tự chép lại một union
/// enum, qua sạch cả checklist, rồi vỡ trên production (08/08/2026). Bản chép
/// tay là mầm trôi dạt. Ở đây bản sao do MÁY dựng lại từ đúng tệp gốc mỗi lần
/// seed, nên nó không thể lệch khỏi web quá một lần chạy seeder.
///
/// Vì sao MỘT bảng chứ không 10 bảng: backend không truy vấn vào trong payload
/// — nó chỉ trả nguyên khối cho app. Dựng 10 bảng để rồi `SELECT *` cả 10 là
/// công việc không ai trả tiền.
///
/// Vì sao chia theo `kind` chứ không một khối `bundle`: chặng 1 nặng ~300 KB.
/// App mở tab Đọc thì chỉ nên tải phần đọc, không phải cả chặng qua 4G.
model IeltsContent {
  id        Int      @id @default(autoincrement())
  /// `stage1`…`stage4`, hoặc `shared` cho thứ dùng chung cả khoá.
  stage     String   @db.VarChar(12)
  /// meta | units | vocab | readings | listenings | writings | speakings
  /// | exercises | questionTypes — hoặc roadmap | life | exam | typing (shared).
  kind      String   @db.VarChar(24)
  payload   Json     @db.JsonB
  /// Số mục trong payload — để `/roadmap` nói được "chặng 1 có 5 bài đọc"
  /// mà không phải tải cả payload lên rồi đếm.
  soMuc     Int      @default(0) @map("so_muc")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([stage, kind], name: "uk_ielts_stage_kind", map: "uk_ielts_stage_kind")
  @@map("ielts_content")
}

/// Tiến độ học IELTS của từng người.
///
/// Trang web cất tiến độ trong `localStorage` (khoá `ielts:…`), nên nó chết
/// theo trình duyệt và iPad không bao giờ thấy được thứ đã học trên iPhone.
/// Bảng này để tiến độ đi theo NGƯỜI, không theo máy.
///
/// `muc` là id của mục trong payload JSON (id bài đọc, id từ, id bài tập…) —
/// không có khoá ngoại tới đâu cả, vì nội dung sống trong JSON chứ không phải
/// trong bảng quan hệ. Đổi lại: xoá một bài đọc khỏi web sẽ để lại một hàng
/// tiến độ mồ côi, vô hại và rẻ hơn nhiều so với dựng 10 bảng nội dung.
model IeltsProgress {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  stage     String   @db.VarChar(12)
  /// units | vocab | readings | listenings | writings | speakings | exercises
  kind      String   @db.VarChar(24)
  muc       String   @db.VarChar(120)
  /// Xong hẳn chưa. Từ vựng thì đây là "đã thuộc".
  xong      Boolean  @default(true)
  /// Điểm/phần trăm nếu mục đó có chấm (bài tập, đề thi). Không có thì null.
  diem      Int?
  ghiChu    String?  @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, stage, kind, muc], name: "uk_ielts_tien_do", map: "uk_ielts_tien_do")
  @@index([userId, stage], name: "idx_ielts_tien_do_user_stage")
  @@map("ielts_progress")
}

/// Thẻ từ IELTS (flashcard 100 từ/ngày, 07/10/2026) — trạng thái lặp lại ngắt
/// quãng (SM-2 cải biên, `src/services/ielts/srs.ts`) của MỘT từ với MỘT người.
/// Nội dung từ (nghĩa, IPA, ví dụ) nằm ở web; ở đây chỉ có khoá từ (`tu`,
/// chữ thường) — thêm bộ từ không phải đụng CSDL. Không FK sang users, theo
/// cùng kiểu `ielts_progress`.
model IeltsVocabCard {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tu        String    @db.VarChar(80)
  /// Hệ số dễ (SM-2), 1.3–3.0.
  ease      Float     @default(2.5)
  /// Khoảng ôn hiện tại, tính bằng ngày (0 = đang học trong buổi).
  khoang    Float     @default(0)
  /// Số lần nhớ liên tiếp.
  lan       Int       @default(0)
  /// Số lần quên sau khi đã nhớ.
  quen      Int       @default(0)
  hanLuc    DateTime  @map("han_luc")
  lanCuoi   DateTime? @map("lan_cuoi")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([userId, tu], name: "uk_ielts_the_tu", map: "uk_ielts_the_tu")
  @@index([userId, hanLuc], name: "idx_ielts_the_tu_han")
  @@map("ielts_vocab_cards")
}

/// Nhật ký mỗi lần chấm thẻ — để vẽ biểu đồ 30 ngày, tính chuỗi ngày và tỷ lệ
/// "nhớ sau ≥ 7 ngày" bằng số thật, không ước lượng.
model IeltsVocabReview {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tu        String   @db.VarChar(80)
  /// 1 Quên · 2 Khó · 3 Nhớ · 4 Dễ
  diem      Int      @db.SmallInt
  /// Số ngày kể từ lần ôn trước (null = lần đầu gặp).
  cachNgay  Float?   @map("cach_ngay")
  moi       Boolean  @default(false)
  /// Ngày theo giờ Việt Nam, 'YYYY-MM-DD'.
  ngay      String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, ngay], name: "idx_ielts_on_tu_ngay")
  @@map("ielts_vocab_reviews")
}

/// Mục tiêu học từ mới mỗi ngày (mặc định 100).
model IeltsDailyGoal {
  userId    Int      @id @map("user_id")
  tuMoi     Int      @default(100) @map("tu_moi")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ielts_daily_goals")
}

/// Sổ lỗi IELTS tự động (07/10/2026) — mỗi câu làm sai ở phòng thi/luyện tập
/// thành một dòng; người học ghi lý do + "công thức rút ra"; ôn lại có giãn
/// cách (≥ 2 ngày rồi 7 ngày) để không nhớ đáp án.
model IeltsMistake {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  /// Khoá nguồn duy nhất của câu, vd. `cdt:doc-01:12` — sai lại thì cộng dồn.
  nguon     String    @db.VarChar(160)
  /// doc | nghe | viet | noi | tuvung
  kyNang    String    @map("ky_nang") @db.VarChar(12)
  /// Dạng câu hỏi, vd. TFNG, Matching headings, Gap-fill…
  dang      String    @db.VarChar(48)
  cauHoi    String    @map("cau_hoi") @db.Text
  daChon    String    @map("da_chon") @db.Text
  dapAn     String    @map("dap_an") @db.Text
  giaiThich String?   @map("giai_thich") @db.Text
  /// Mã lý do sai (xem LY_DO trong soLoi.service.ts).
  lyDo      String?   @map("ly_do") @db.VarChar(24)
  congThuc  String?   @map("cong_thuc") @db.Text
  /// Đủ dữ liệu để LÀM LẠI câu (loại, lựa chọn, đáp án chấp nhận).
  duLieu    Json?     @map("du_lieu") @db.JsonB
  lanSai    Int       @default(1) @map("lan_sai")
  /// 0 = chờ ôn lần 1 (sau 2 ngày) · 1 = chờ ôn lần 2 (sau 7 ngày) · 2 = đã vững
  buoc      Int       @default(0)
  hanOn     DateTime  @map("han_on")
  daXong    Boolean   @default(false) @map("da_xong")
  lanOnCuoi DateTime? @map("lan_on_cuoi")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([userId, nguon], name: "uk_ielts_so_loi", map: "uk_ielts_so_loi")
  @@index([userId, hanOn], name: "idx_ielts_so_loi_han")
  @@map("ielts_mistakes")
}

/// Một lượt làm đề ở phòng thi máy tính (CDT) — Practice hoặc Full test.
model IeltsCdtAttempt {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  deId      String   @map("de_id") @db.VarChar(40)
  /// doc | nghe | viet
  kyNang    String   @map("ky_nang") @db.VarChar(12)
  /// practice | full
  cheDo     String   @map("che_do") @db.VarChar(12)
  dung      Int?
  tong      Int?
  band      Float?
  giay      Int      @default(0)
  /// Câu trả lời, cờ, bài viết, kết quả AI chấm — để xem lại.
  chiTiet   Json?    @map("chi_tiet") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, deId], name: "idx_ielts_cdt_user_de")
  @@map("ielts_cdt_attempts")
}

// ============================================================
// CT WORK — quản lý dự án kiểu Jira (23/09/2026)
// ============================================================
// Kế hoạch tổng: docs/work-hub-plan.md. Mọi bảng mang tiền tố `work_`.
//
// Vai trò, trạng thái, loại thẻ… đều là CHUỖI chứ không enum — cùng lý do
// như DashboardTask: thêm một giá trị mới không phải viết migration. Danh
// sách giá trị hợp lệ sống ở src/services/work/constants.ts, và mọi chỗ ghi
// đều kiểm bằng zod trước khi chạm DB.
//
// Quyền KHÔNG suy ra ở đây. Nó được tính ở đúng một chỗ:
// src/services/work/permissions.ts.

/// Không gian làm việc: một nhóm, một lớp, một công ty. Chứa nhiều dự án.
model WorkSpace {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  slug        String    @unique(map: "uk_work_space_slug") @db.VarChar(60)
  description String?   @db.Text
  ownerId     Int       @map("owner_id")
  /// CTW-23: logo không gian (URL công khai trên R2) — cổng khách mang thương hiệu studio.
  logoUrl     String?   @map("logo_url") @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  /// Xoá mềm. Dữ liệu dự án của người khác nằm trong này — xoá cứng
  /// bằng một cú bấm nhầm là mất cả kỳ đồ án của cả nhóm.
  deletedAt   DateTime? @map("deleted_at")

  owner    User           @relation("WorkSpaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  WorkMember[]
  invites  WorkInvite[]
  projects WorkProject[]
  timeOff  WorkTimeOff[]
  audit    WorkAuditLog[]
  teams    WorkTeam[]
  agents   WorkAgent[]

  @@index([ownerId], name: "idx_work_space_owner")
  @@map("work_spaces")
}

/// Thành viên cấp không gian. role: OWNER | ADMIN | MEMBER | GUEST.
/// GUEST (giảng viên, khách hàng) chỉ thấy dự án mà mình được thêm tên.
model WorkMember {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  userId      Int      @map("user_id")
  role        String   @default("MEMBER") @db.VarChar(16)
  joinedAt    DateTime @default(now()) @map("joined_at")

  workspace WorkSpace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId], name: "uk_work_member", map: "uk_work_member")
  @@index([userId], name: "idx_work_member_user")
  @@map("work_members")
}

/// Lời mời qua email hoặc link. Chỉ lưu BĂM của token — token thật chỉ
/// nằm trong link gửi đi, lộ bảng này cũng không dùng được link.
model WorkInvite {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  /// Có thì người nhận vào thẳng dự án này với `projectRole`.
  projectId   Int?      @map("project_id")
  /// Null = link mời ai cũng dùng được (tới khi hết lượt/hết hạn).
  email       String?   @db.VarChar(100)
  role        String    @default("MEMBER") @db.VarChar(16)
  projectRole String?   @map("project_role") @db.VarChar(16)
  tokenHash   String    @unique(map: "uk_work_invite_token") @map("token_hash") @db.VarChar(128)
  invitedById Int       @map("invited_by_id")
  maxUses     Int       @default(1) @map("max_uses")
  usedCount   Int       @default(0) @map("used_count")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace WorkSpace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   WorkProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User         @relation("WorkInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId], name: "idx_work_invite_space")
  @@map("work_invites")
}

/// Một dự án. `key` là tiền tố mã thẻ (SWP → SWP-12), duy nhất trong không gian.
model WorkProject {
  id             Int       @id @default(autoincrement())
  workspaceId    Int       @map("workspace_id")
  key            String    @db.VarChar(10)
  name           String    @db.VarChar(120)
  description    String?   @db.Text
  /// SCRUM | KANBAN | TESTING
  type           String    @default("SCRUM") @db.VarChar(16)
  /// Mẫu đã dùng lúc tạo (BLANK | SWR302 | SWT301 | SWP391 | FREELANCE | COMPANY).
  /// Chỉ để hiển thị — cấu hình thật đã được chép vào các bảng con.
  template       String    @default("BLANK") @db.VarChar(32)
  /// Loại dự án (04/10/2026): PERSONAL | SCHOOL | SOFTWARE | CLIENT. NULL = dự án
  /// tạo trước lớp studio ⇒ suy ra từ `template` lúc đọc (studio.ts projectKindOf),
  /// KHÔNG ghi ngược vào DB. Mô-đun bật/tắt nằm ở settings.modules, không suy từ đây.
  kind           String?   @db.VarChar(16)
  /// WORKSPACE: thành viên không gian vào được (quyền MEMBER).
  /// PRIVATE: chỉ người có tên trong work_project_members.
  visibility     String    @default("WORKSPACE") @db.VarChar(16)
  /// Bộ đếm cấp số thẻ. Tăng bằng UPDATE … RETURNING trong transaction nên
  /// hai người tạo thẻ cùng lúc không bao giờ trùng số.
  issueCounter   Int       @default(0) @map("issue_counter")
  leadId         Int?      @map("lead_id")
  /// Cấu hình nhỏ không đáng một cột: đơn vị ước lượng, Definition of Done…
  settings       Json      @default("{}")
  /// CTW-23: nhận diện dự án — ảnh (URL công khai trên R2), emoji, màu (#rrggbb).
  avatarUrl      String?   @map("avatar_url") @db.VarChar(500)
  iconEmoji      String?   @map("icon_emoji") @db.VarChar(16)
  color          String?   @db.VarChar(16)
  // ── UX-D ── ảnh bìa dự án (09/10/2026): "preset:<id>" (thư viện có sẵn, frontend/public/images/work-covers)
  // hoặc URL công khai của ảnh người dùng tải lên (R2, JPEG đã nén lại). coverPositionY = điểm lấy nét dọc 0–100 (%).
  coverUrl       String?   @map("cover_url") @db.VarChar(500)
  coverPositionY Int?      @map("cover_position_y")
  // ── hết UX-D ──
  archivedAt     DateTime? @map("archived_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  workspace         WorkSpace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead              User?                  @relation("WorkProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  members           WorkProjectMember[]
  invites           WorkInvite[]
  workflows         WorkWorkflow[]
  issueTypes        WorkIssueType[]
  issues            WorkIssue[]
  labels            WorkLabel[]
  components        WorkComponent[]
  sprints           WorkSprint[]
  testPlans         WorkTestPlan[]
  testCycles        WorkTestCycle[]
  customFields      WorkCustomField[]
  savedFilters      WorkSavedFilter[]
  dashboards        WorkDashboard[]
  versions          WorkVersion[]
  automations       WorkAutomationRule[]
  github            WorkGithubConnection?
  devActivity       WorkDevActivity[]
  publicLinks       WorkPublicLink[]
  aiThreads         WorkAiThread[]
  chatHooks         WorkChatHook[]
  gitlab            WorkGitlabConnection?
  editLocks         WorkEditLock[]
  stages            WorkStage[]
  approvals         WorkApproval[]
  handoffs          WorkHandoff[]
  issueAliases      WorkIssueAlias[]
  /// Tài liệu dự án kiểu Confluence (đợt S2a, mô-đun `docs`).
  pages             WorkPage[]
  /// Nghiệm thu UAT (đợt S2b, mô-đun `clientPortal`).
  uatRequests       WorkUatRequest[]
  /// Đợt S3b: yêu cầu thay đổi (CR), sổ RAID, cuộc họp.
  changeRequests    WorkChangeRequest[]
  raidItems         WorkRaidItem[]
  meetings          WorkMeeting[]
  /// Đợt S4: tài chính dự án (mô-đun finance), báo cáo khách tự động (mô-đun reports), xuất trọn dự án.
  financeSettings   WorkFinanceSettings?
  rates             WorkRate[]
  timesheets        WorkTimesheet[]
  budgetLines       WorkBudgetLine[]
  expenses          WorkExpense[]
  paymentMilestones WorkPaymentMilestone[]
  reportSchedule    WorkReportSchedule?
  clientReports     WorkClientReport[]
  exports           WorkProjectExport[]
  /// Đợt S5a: service desk & SLA (mô-đun serviceDesk) — cấu hình + bản ghi Problem.
  deskSettings      WorkDeskSettings?
  deskProblems      WorkDeskProblem[]
  /// Đợt S6: lịch sử chấm Spec Fidelity (trang tài liệu / tập thẻ yêu cầu).
  specReviews       WorkSpecReview[]
  /// Resources (06/10/2026): thư viện link/tài nguyên của dự án (mô-đun resources).
  resourceGroups    WorkResourceGroup[]
  resources         WorkResource[]
  /// Đợt 1b (08/10/2026): tài liệu kiểm thử chuẩn FPT — Report 5.1 Unit + 5.2 Integration.
  fptTestDoc        WorkFptTestDoc?
  fptChanges        WorkFptChange[]
  unitFunctions     WorkUnitFunction[]
  itModules         WorkItModule[]
  /// CTW đợt 3B: WBS + ước lượng, thông tin môn học, Weekly Report, AI Usage Report.
  wbsItems          WorkWbsItem[]
  fptReportDoc      WorkFptReportDoc?
  weeklyReports     WorkWeeklyReport[]
  aiUsageLogs       WorkAiUsageLog[]
  /// CTW đợt 3A: ảnh chèn trong trình soạn thảo (Docs, mô tả thẻ, bình luận).
  docImages         WorkDocImage[]
  /// CTW đợt 4: SRS có cấu trúc (actor, UC, BR, màn, phân quyền màn, Non-UI), truy vết tay, defect log.
  srsActors         WorkSrsActor[]
  useCases          WorkUseCase[]
  businessRules     WorkBusinessRule[]
  srsScreens        WorkSrsScreen[]
  srsFunctions      WorkSrsFunction[]
  traceLinks        WorkTraceLink[]
  defectInfos       WorkDefectInfo[]
  /// CTW K-3: kênh chat của dự án (xoá dự án ⇒ xoá kênh + tin + tệp theo dây chuyền).
  channels          WorkChannel[]
  /// CTW Đóng góp: commit/PR từ webhook (cả commit không nhắc mã thẻ), danh tính git ↔ người, phiếu đánh giá chéo.
  devContributions  WorkDevContribution[]
  gitIdentities     WorkGitIdentity[]
  peerRounds        WorkPeerRound[]
  /// CTW Diagram: sơ đồ của dự án (Mermaid/Excalidraw) + phiên bản + bình luận.
  diagrams          WorkDiagram[]
  // ── CTW đợt 4b ── SWR302 (Wiegers): feature FE-n, bảng ưu tiên, glossary, data dictionary, cấu hình
  swrFeatures       WorkFeature[]
  swrPriorityRows   WorkPriorityRow[]
  swrGlossary       WorkGlossaryTerm[]
  swrDataElements   WorkDataElement[]
  swrSettings       WorkSwrSettings?
  requirementInfos  WorkRequirementInfo[]
  // ── hết CTW đợt 4b ──
  /// CTW K-2: cấu hình họp (hạn lưu audio, trần phiên âm/ngày, nhắc họp).
  meetingSettings   WorkMeetingSettings?
  /// CTW đợt 5: nhóm của lớp học sinh ra dự án này (tối đa một) + điểm rubric theo mốc.
  classGroup        WorkClassGroup?        @relation("WorkClassGroupProject")
  grades            WorkGrade[]            @relation("WorkGradeProject")
  /// Phiếu yêu cầu của khách đã sinh ra dự án này (tối đa một).
  clientRequest     ProjectRequest?

  @@unique([workspaceId, key], name: "uk_work_project_key", map: "uk_work_project_key")
  @@map("work_projects")
}

/// Vai trò trong một dự án: ADMIN | MEMBER | VIEWER | TEACHER | CLIENT.
model WorkProjectMember {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  userId        Int      @map("user_id")
  role          String   @default("MEMBER") @db.VarChar(16)
  /// Số giờ làm được mỗi ngày cho dự án này (capacity). Null = chưa khai.
  capacityHours Float?   @map("capacity_hours")
  createdAt     DateTime @default(now()) @map("created_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User        @relation("WorkProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId], name: "uk_work_project_member", map: "uk_work_project_member")
  @@index([userId], name: "idx_work_project_member_user")
  @@map("work_project_members")
}

/// Quy trình: tập trạng thái + luồng chuyển. Mỗi dự án có một quy trình
/// mặc định; loại thẻ có thể trỏ sang quy trình riêng (vd Bug có Retest).
model WorkWorkflow {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  name      String   @db.VarChar(80)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  project     WorkProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statuses    WorkStatus[]
  transitions WorkTransition[]
  issueTypes  WorkIssueType[]

  @@index([projectId], name: "idx_work_workflow_project")
  @@map("work_workflows")
}

/// Một trạng thái. category (TODO | IN_PROGRESS | DONE) là thứ báo cáo
/// đọc — burndown không quan tâm cột tên "Retest" hay "QA", chỉ hỏi nó
/// đã xong chưa.
model WorkStatus {
  id         Int    @id @default(autoincrement())
  workflowId Int    @map("workflow_id")
  name       String @db.VarChar(60)
  category   String @db.VarChar(16)
  color      String @default("#64748b") @db.VarChar(16)
  position   Int    @default(0)
  /// Giới hạn số thẻ cùng lúc trong cột (WIP). Null = không giới hạn.
  wipLimit   Int?   @map("wip_limit")

  workflow        WorkWorkflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  issues          WorkIssue[]
  transitionsFrom WorkTransition[] @relation("WorkTransitionFrom")
  transitionsTo   WorkTransition[] @relation("WorkTransitionTo")

  @@index([workflowId, position], name: "idx_work_status_workflow")
  @@map("work_statuses")
}

/// Luồng chuyển được phép. Quy trình KHÔNG có dòng nào = chuyển tự do giữa
/// mọi trạng thái (mặc định của Kanban). fromStatusId null = từ bất kỳ đâu.
model WorkTransition {
  id           Int     @id @default(autoincrement())
  workflowId   Int     @map("workflow_id")
  fromStatusId Int?    @map("from_status_id")
  toStatusId   Int     @map("to_status_id")
  name         String? @db.VarChar(60)
  /// Điều kiện của luồng chuyển (04/10/2026 — trước đó là cột chết):
  ///   { requireApproval?: true, teamIds?: number[] }
  /// Kiểm trong issueChange.ts (assertTransitionAllowed) với người/AI; luật tự
  /// động và hệ thống không bị chặn (cùng luật với Done rules). `{}` = không điều kiện.
  rules        Json    @default("{}")

  workflow   WorkWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromStatus WorkStatus?  @relation("WorkTransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   WorkStatus   @relation("WorkTransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@index([workflowId], name: "idx_work_transition_workflow")
  @@map("work_transitions")
}

/// Loại thẻ theo dự án. `key`: EPIC | STORY | TASK | BUG | SUBTASK | TEST | REQUIREMENT.
/// `level` là tầng phân cấp: 1 = epic, 0 = việc thường, -1 = việc con.
/// Cha của một thẻ luôn có level cao hơn đúng 1 bậc (kiểm ở service).
model WorkIssueType {
  id         Int     @id @default(autoincrement())
  projectId  Int     @map("project_id")
  key        String  @db.VarChar(16)
  name       String  @db.VarChar(40)
  icon       String  @default("task") @db.VarChar(24)
  color      String  @default("#3b82f6") @db.VarChar(16)
  level      Int     @default(0)
  workflowId Int?    @map("workflow_id")
  position   Int     @default(0)
  archived   Boolean @default(false)

  project  WorkProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflow WorkWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  issues   WorkIssue[]

  @@unique([projectId, key], name: "uk_work_issue_type", map: "uk_work_issue_type")
  @@map("work_issue_types")
}

/// Thẻ việc. Mọi thay đổi PHẢI đi qua applyIssueChange() trong
/// src/services/work/issueChange.ts để lịch sử, socket, thông báo và luật
/// tự động không bao giờ lệch nhau.
model WorkIssue {
  id                   Int       @id @default(autoincrement())
  projectId            Int       @map("project_id")
  number               Int
  typeId               Int       @map("type_id")
  statusId             Int       @map("status_id")
  parentId             Int?      @map("parent_id")
  sprintId             Int?      @map("sprint_id")
  fixVersionId         Int?      @map("fix_version_id")
  /// Bộ phận phụ trách (lớp studio, mô-đun `teams`). Đổi qua applyIssueChange.
  teamId               Int?      @map("team_id")
  /// Giai đoạn của dự án (mô-đun `stages`). Đổi qua applyIssueChange.
  stageId              Int?      @map("stage_id")
  /// Cổng khách (đợt S2b): thẻ ĐÃ CHIA SẺ cho khách. Khách (vai CLIENT, dự án bật
  /// clientPortal) chỉ thấy thẻ có cờ này ở MỌI đường đọc. Thẻ khách tự gửi ⇒ true.
  clientVisible        Boolean   @default(false) @map("client_visible")
  clientSharedAt       DateTime? @map("client_shared_at")
  title                String    @db.VarChar(255)
  /// JSON của TipTap — cùng định dạng với Ghi chú để dùng lại trình soạn thảo.
  descriptionJson      Json?     @map("description_json")
  /// Bản chữ trơn của mô tả: cho tìm kiếm, cho AI, cho xem trước.
  descriptionText      String?   @map("description_text") @db.Text
  /// 1 = Cao nhất · 2 = Cao · 3 = Vừa · 4 = Thấp · 5 = Thấp nhất (thứ tự của Jira).
  priority             Int       @default(3)
  assigneeId           Int?      @map("assignee_id")
  reporterId           Int?      @map("reporter_id")
  storyPoints          Float?    @map("story_points")
  originalEstimateMin  Int?      @map("original_estimate_min")
  remainingEstimateMin Int?      @map("remaining_estimate_min")
  timeSpentMin         Int       @default(0) @map("time_spent_min")
  startDate            DateTime? @map("start_date") @db.Date
  dueDate              DateTime? @map("due_date") @db.Date
  /// Thứ tự trên board/backlog — khoá phân số gồm [0-9a-z] (xem rank.ts).
  /// Chỉ dùng chữ thường và số để thứ tự của collation DB trùng thứ tự byte.
  rank                 String    @db.VarChar(64)
  resolution           String?   @db.VarChar(32)
  resolvedAt           DateTime? @map("resolved_at")
  /// Tăng mỗi lần sửa. Client gửi kèm số nó đang cầm; lệch = có người vừa
  /// sửa trước ⇒ trả 409 thay vì đè mất thay đổi của họ.
  version              Int       @default(0)
  /// Đợt S6 — nguồn gốc AI (provenance): thẻ được tạo/sửa nội dung qua đề xuất AI đã áp dụng, commit/PR có trailer
  /// `Co-Authored-By:` của một model AI, hoặc gắn tay. Đổi qua applyIssueChange (lịch sử field `aiAssisted`).
  aiAssisted           Boolean   @default(false) @map("ai_assisted")
  /// Model AI gần nhất (tên model hoặc tên trong trailer). Null = gắn tay / không rõ.
  aiModel              String?   @map("ai_model") @db.VarChar(120)
  aiAssistedAt         DateTime? @map("ai_assisted_at")
  /// Người BẤM áp dụng đề xuất AI gần nhất (không FK — như nhật ký). Luật "AI-assisted work needs an independent
  /// reviewer" loại người này + người báo khỏi danh sách người duyệt hợp lệ.
  aiAppliedById        Int?      @map("ai_applied_by_id")
  /// CTW-11: cờ "Bị chặn" (impediment) — lý do + người cắm. Null = không bị chặn.
  flaggedAt            DateTime? @map("flagged_at")
  flagReason           String?   @map("flag_reason") @db.VarChar(500)
  flaggedById          Int?      @map("flagged_by_id")
  /// CTW-6: cột SINH TỰ ĐỘNG trong Postgres (GENERATED ALWAYS … STORED) = lower + bỏ dấu tiếng Việt.
  /// CHỈ ĐỌC — không bao giờ ghi (Postgres từ chối). Xem fold.ts + migration 20261006120000.
  titleFold            String?   @default(dbgenerated("lower(translate((COALESCE(title, ''::character varying))::text, 'àÀáÁảẢãÃạẠăĂằẰắẮẳẲẵẴặẶâÂầẦấẤẩẨẫẪậẬèÈéÉẻẺẽẼẹẸêÊềỀếẾểỂễỄệỆìÌíÍỉỈĩĨịỊòÒóÓỏỎõÕọỌôÔồỒốỐổỔỗỖộỘơƠờỜớỚởỞỡỠợỢùÙúÚủỦũŨụỤưƯừỪứỨửỬữỮựỰỳỲýÝỷỶỹỸỵỴđĐ̛̣̀́̃̉̆̂'::text, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaeeeeeeeeeeeeeeeeeeeeeeiiiiiiiiiioooooooooooooooooooooooooooooooooouuuuuuuuuuuuuuuuuuuuuuyyyyyyyyyydd'::text))")) @map("title_fold")
  descriptionFold      String?   @default(dbgenerated("lower(translate(COALESCE(description_text, ''::text), 'àÀáÁảẢãÃạẠăĂằẰắẮẳẲẵẴặẶâÂầẦấẤẩẨẫẪậẬèÈéÉẻẺẽẼẹẸêÊềỀếẾểỂễỄệỆìÌíÍỉỈĩĨịỊòÒóÓỏỎõÕọỌôÔồỒốỐổỔỗỖộỘơƠờỜớỚởỞỡỠợỢùÙúÚủỦũŨụỤưƯừỪứỨửỬữỮựỰỳỲýÝỷỶỹỸỵỴđĐ̛̣̀́̃̉̆̂'::text, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaeeeeeeeeeeeeeeeeeeeeeeiiiiiiiiiioooooooooooooooooooooooooooooooooouuuuuuuuuuuuuuuuuuuuuuyyyyyyyyyydd'::text))")) @map("description_fold")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  project         WorkProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // NoAction chứ KHÔNG Restrict: Postgres kiểm RESTRICT ngay lập tức, nên xoá
  // dự án (cascade xuống loại thẻ, trạng thái VÀ thẻ) bị chặn khi loại thẻ bị
  // xoá trước thẻ. NO ACTION kiểm ở cuối câu lệnh — xoá dây chuyền chạy được,
  // còn xoá riêng một trạng thái đang có thẻ vẫn bị chặn. Bắt được bằng test DB.
  type            WorkIssueType           @relation(fields: [typeId], references: [id], onDelete: NoAction)
  status          WorkStatus              @relation(fields: [statusId], references: [id], onDelete: NoAction)
  parent          WorkIssue?              @relation("WorkIssueParent", fields: [parentId], references: [id], onDelete: SetNull)
  children        WorkIssue[]             @relation("WorkIssueParent")
  sprint          WorkSprint?             @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  fixVersion      WorkVersion?            @relation(fields: [fixVersionId], references: [id], onDelete: SetNull)
  team            WorkTeam?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  stage           WorkStage?              @relation("WorkIssueStage", fields: [stageId], references: [id], onDelete: SetNull)
  gateOf          WorkStage[]             @relation("WorkStageGateIssue")
  approvals       WorkApproval[]
  handoffs        WorkHandoff[]
  aliases         WorkIssueAlias[]
  pageLinks       WorkPageIssueLink[]
  /// Đợt S3b: CR sinh từ thẻ này · liên kết CR/RAID · việc từ biên bản họp.
  crSourceOf      WorkChangeRequest[]     @relation("WorkCrSourceIssue")
  crLinks         WorkChangeRequestLink[]
  raidLinks       WorkRaidLink[]
  meetingActions  WorkMeetingAction[]
  /// Đợt S5a: phần service desk của thẻ (loại yêu cầu, P1–P4, SLA, CSAT) — chỉ thẻ đi qua service desk.
  deskTicket      WorkDeskTicket?
  assignee        User?                   @relation("WorkIssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter        User?                   @relation("WorkIssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  linksOut        WorkIssueLink[]         @relation("WorkIssueLinkFrom")
  linksIn         WorkIssueLink[]         @relation("WorkIssueLinkTo")
  labels          WorkIssueLabel[]
  components      WorkIssueComponent[]
  comments        WorkComment[]
  attachments     WorkAttachment[]
  history         WorkHistory[]
  watchers        WorkWatcher[]
  testCase        WorkTestCase?
  defectOf        WorkTestRunDefect[]
  customValues    WorkCustomValue[]
  worklogs        WorkWorklog[]
  devActivity     WorkDevActivity[]
  /// Resources (06/10/2026): "Web links" kiểu Jira trên chi tiết thẻ.
  webLinks        WorkIssueWebLink[]
  /// CTW đợt 3B (A3): thuộc tính WBS/ước lượng.
  wbsItem         WorkWbsItem?
  /// CTW đợt 4: UC/màn/Non-UI đặc tả thẻ này (RTM) + phần defect log của thẻ Bug.
  useCases        WorkUseCase[]           @relation("WorkUseCaseIssue")
  srsScreens      WorkSrsScreen[]         @relation("WorkSrsScreenIssue")
  srsFunctions    WorkSrsFunction[]       @relation("WorkSrsFunctionIssue")
  defectInfo      WorkDefectInfo?         @relation("WorkDefectInfoIssue")
  // ── CTW đợt 4b ── phân loại + thuộc tính + vòng đời của thẻ REQUIREMENT (Wiegers)
  requirementInfo WorkRequirementInfo?    @relation("WorkRequirementInfoIssue")

  @@unique([projectId, number], name: "uk_work_issue_number", map: "uk_work_issue_number")
  @@index([projectId, statusId, rank], name: "idx_work_issue_board")
  @@index([projectId, sprintId], name: "idx_work_issue_sprint")
  @@index([assigneeId], name: "idx_work_issue_assignee")
  @@index([parentId], name: "idx_work_issue_parent")
  @@index([fixVersionId], name: "idx_work_issue_fix_version")
  @@index([teamId], name: "idx_work_issue_team")
  @@index([stageId], name: "idx_work_issue_stage")
  @@index([projectId, clientVisible], name: "idx_work_issue_client")
  @@map("work_issues")
}

/// Liên kết giữa hai thẻ: BLOCKS | RELATES | DUPLICATES | CLONES | TESTS.
/// Lưu MỘT chiều (from → to); chiều ngược ("bị chặn bởi") suy ra khi đọc.
model WorkIssueLink {
  id          Int      @id @default(autoincrement())
  fromIssueId Int      @map("from_issue_id")
  toIssueId   Int      @map("to_issue_id")
  type        String   @db.VarChar(16)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  fromIssue WorkIssue @relation("WorkIssueLinkFrom", fields: [fromIssueId], references: [id], onDelete: Cascade)
  toIssue   WorkIssue @relation("WorkIssueLinkTo", fields: [toIssueId], references: [id], onDelete: Cascade)

  @@unique([fromIssueId, toIssueId, type], name: "uk_work_issue_link", map: "uk_work_issue_link")
  @@index([toIssueId], name: "idx_work_issue_link_to")
  @@map("work_issue_links")
}

model WorkLabel {
  id        Int    @id @default(autoincrement())
  projectId Int    @map("project_id")
  name      String @db.VarChar(50)
  color     String @default("#64748b") @db.VarChar(16)

  project WorkProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  WorkIssueLabel[]

  @@unique([projectId, name], name: "uk_work_label", map: "uk_work_label")
  @@map("work_labels")
}

model WorkIssueLabel {
  issueId Int @map("issue_id")
  labelId Int @map("label_id")

  issue WorkIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label WorkLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId], name: "idx_work_issue_label_label")
  @@map("work_issue_labels")
}

/// Thành phần của sản phẩm (Frontend, API, Thanh toán…) — lọc và chia việc.
model WorkComponent {
  id          Int     @id @default(autoincrement())
  projectId   Int     @map("project_id")
  name        String  @db.VarChar(60)
  description String? @db.Text
  leadId      Int?    @map("lead_id")

  project WorkProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  WorkIssueComponent[]

  @@unique([projectId, name], name: "uk_work_component", map: "uk_work_component")
  @@map("work_components")
}

model WorkIssueComponent {
  issueId     Int @map("issue_id")
  componentId Int @map("component_id")

  issue     WorkIssue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  component WorkComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([issueId, componentId])
  @@index([componentId], name: "idx_work_issue_component_component")
  @@map("work_issue_components")
}

/// Bình luận. authorId null + isAi = true là lời của trợ lý AI.
model WorkComment {
  id         Int       @id @default(autoincrement())
  issueId    Int       @map("issue_id")
  authorId   Int?      @map("author_id")
  isAi       Boolean   @default(false) @map("is_ai")
  bodyJson   Json      @map("body_json")
  bodyText   String    @map("body_text") @db.Text
  /// Cổng khách (đợt S2b): INTERNAL = ghi chú nội bộ (mặc định) · PUBLIC = trả lời khách.
  /// Khách (vai CLIENT ở dự án bật clientPortal) chỉ thấy PUBLIC; bình luận của khách luôn PUBLIC.
  /// Dự án không bật cổng khách: cột này không được đọc (hành vi cũ).
  visibility String    @default("INTERNAL") @db.VarChar(16)
  createdAt  DateTime  @default(now()) @map("created_at")
  editedAt   DateTime? @map("edited_at")
  deletedAt  DateTime? @map("deleted_at")
  /// CTW đợt 5b K-1: trả lời theo luồng — MỘT cấp như Jira/GitHub (trả lời một trả lời ⇒ server gắn vào gốc).
  parentId   Int?      @map("parent_id")

  issue       WorkIssue             @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author      User?                 @relation("WorkCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reactions   WorkCommentReaction[]
  /// CTW đợt 5b K-1: luồng trả lời + tệp/voice note gắn trong bình luận.
  parent      WorkComment?          @relation("WorkCommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies     WorkComment[]         @relation("WorkCommentThread")
  attachments WorkAttachment[]      @relation("WorkCommentAttachment")

  @@index([issueId, createdAt], name: "idx_work_comment_issue")
  @@index([parentId], map: "idx_work_comment_parent")
  @@map("work_comments")
}

/// Cảm xúc trên bình luận (👍 🎉 …) — bật/tắt, mỗi người một lần cho mỗi emoji.
/// Không sinh thông báo (chống spam). Danh sách emoji hợp lệ do server kiểm.
model WorkCommentReaction {
  id        Int      @id @default(autoincrement())
  commentId Int      @map("comment_id")
  userId    Int      @map("user_id")
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  comment WorkComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation("WorkCommentReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji], name: "uk_work_comment_reaction", map: "uk_work_comment_reaction")
  @@index([userId], name: "idx_work_comment_reaction_user")
  @@map("work_comment_reactions")
}

model WorkAttachment {
  id            Int       @id @default(autoincrement())
  issueId       Int       @map("issue_id")
  uploaderId    Int?      @map("uploader_id")
  r2Key         String    @map("r2_key") @db.VarChar(500)
  fileName      String    @map("file_name") @db.VarChar(255)
  mime          String    @db.VarChar(100)
  size          Int
  /// Bằng chứng của một lần chạy test (ảnh chụp lỗi…). File vẫn thuộc thẻ test case.
  runId         Int?      @map("run_id")
  /// Cổng khách (đợt S2b): tệp chia sẻ cho khách (thẻ cũng phải được chia sẻ). Tệp khách tải lên ⇒ true.
  clientVisible Boolean   @default(false) @map("client_visible")
  /// Tệp BÀN GIAO (Deliverables trong cổng khách) — luôn kèm clientVisible.
  deliverable   Boolean   @default(false)
  deliveredAt   DateTime? @map("delivered_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  /// CTW đợt 5b K-1: tệp tải lên từ Ô BÌNH LUẬN (kể cả lúc chưa gửi) — không hiện ở khối Attachments của thẻ,
  /// không tính trần 50 tệp/thẻ. commentId = bình luận chứa nó (null = bản nháp chưa gửi).
  forComment    Boolean   @default(false) @map("for_comment")
  commentId     Int?      @map("comment_id")

  issue    WorkIssue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader User?          @relation("WorkAttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  run      WorkTestRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  comment  WorkComment?   @relation("WorkCommentAttachment", fields: [commentId], references: [id], onDelete: SetNull)
  voice    WorkVoiceNote?

  @@index([issueId], name: "idx_work_attachment_issue")
  @@index([runId], name: "idx_work_attachment_run")
  @@index([commentId], map: "idx_work_attachment_comment")
  @@map("work_attachments")
}

/// Lịch sử từng trường. actorKind: USER | AI | AUTOMATION | SYSTEM — để
/// trang đóng góp thành viên không tính công của AI cho người bấm.
model WorkHistory {
  id        Int      @id @default(autoincrement())
  issueId   Int      @map("issue_id")
  actorId   Int?     @map("actor_id")
  actorKind String   @default("USER") @map("actor_kind") @db.VarChar(16)
  field     String   @db.VarChar(40)
  fromValue String?  @map("from_value") @db.Text
  toValue   String?  @map("to_value") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  issue WorkIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User?     @relation("WorkHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt], name: "idx_work_history_issue")
  @@index([actorId, createdAt], name: "idx_work_history_actor")
  @@map("work_history")
}

model WorkWatcher {
  issueId   Int      @map("issue_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  issue WorkIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User      @relation("WorkWatcherUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([userId], name: "idx_work_watcher_user")
  @@map("work_watchers")
}

/// Sprint. state: PLANNED | ACTIVE | CLOSED. Mỗi dự án tối đa một ACTIVE —
/// chốt ở service bằng cách khoá dòng dự án (FOR UPDATE) trước khi bắt đầu.
/// KHÔNG dùng chỉ mục duy nhất một phần: Prisma không khai được nó, và
/// `migrate diff` sẽ báo lệch mãi mãi.
model WorkSprint {
  id              Int       @id @default(autoincrement())
  projectId       Int       @map("project_id")
  name            String    @db.VarChar(100)
  goal            String?   @db.Text
  state           String    @default("PLANNED") @db.VarChar(16)
  startAt         DateTime? @map("start_at")
  endAt           DateTime? @map("end_at")
  completedAt     DateTime? @map("completed_at")
  /// Chốt lúc bấm Bắt đầu / Kết thúc — nuôi biểu đồ velocity.
  committedPoints Float?    @map("committed_points")
  completedPoints Float?    @map("completed_points")
  position        Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  /// Chụp lúc bấm Complete: thẻ xong / chưa xong / thêm giữa chừng / bị bỏ ra.
  /// Phải chụp lúc đóng — sau đó thẻ chưa xong đã dời sang sprint khác, và
  /// không còn cách nào biết chúng từng thuộc sprint này ngoài lịch sử.
  report          Json?

  project   WorkProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    WorkIssue[]
  snapshots WorkSprintSnapshot[]

  @@index([projectId, state], name: "idx_work_sprint_project")
  @@map("work_sprints")
}

/// Số liệu một ngày của sprint đang chạy — nuôi burndown/burnup. Cron ghi đè
/// dòng của NGÀY HÔM NAY (giờ VN) mỗi giờ, nên dòng cuối của ngày ≈ cuối ngày
/// và backend tắt vài giờ cũng không mất điểm nào.
model WorkSprintSnapshot {
  id              Int      @id @default(autoincrement())
  sprintId        Int      @map("sprint_id")
  /// YYYY-MM-DD theo giờ Việt Nam.
  day             String   @db.VarChar(10)
  totalPoints     Float    @default(0) @map("total_points")
  remainingPoints Float    @default(0) @map("remaining_points")
  totalIssues     Int      @default(0) @map("total_issues")
  doneIssues      Int      @default(0) @map("done_issues")
  updatedAt       DateTime @updatedAt @map("updated_at")

  sprint WorkSprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@unique([sprintId, day], name: "uk_work_sprint_snapshot", map: "uk_work_sprint_snapshot")
  @@map("work_sprint_snapshots")
}

// ─── CT Work — quản lý kiểm thử (đợt 3, thay plugin Xray) ─────────────
// Test case LÀ một thẻ loại TEST (có bình luận, người phụ trách, liên kết…);
// bảng này chỉ giữ phần riêng của test: điều kiện trước, các bước, Gherkin.

/// Phần "kiểm thử" của một thẻ loại TEST. kind: MANUAL (các bước) | GHERKIN.
model WorkTestCase {
  id            Int      @id @default(autoincrement())
  issueId       Int      @unique(map: "uk_work_test_case_issue") @map("issue_id")
  kind          String   @default("MANUAL") @db.VarChar(16)
  preconditions String?  @db.Text
  gherkin       String?  @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")

  issue WorkIssue          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  steps WorkTestStep[]
  plans WorkTestPlanCase[]
  runs  WorkTestRun[]

  @@map("work_test_cases")
}

model WorkTestStep {
  id         Int     @id @default(autoincrement())
  testCaseId Int     @map("test_case_id")
  position   Int
  action     String  @db.Text
  data       String? @db.Text
  expected   String? @db.Text

  testCase WorkTestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId, position], name: "idx_work_test_step_case")
  @@map("work_test_steps")
}

/// Kế hoạch kiểm thử: một tập test case (vd "Regression v1.0", "Lab 3 — Login").
model WorkTestPlan {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  name        String    @db.VarChar(120)
  description String?   @db.Text
  createdById Int?      @map("created_by_id")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  project WorkProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases   WorkTestPlanCase[]
  cycles  WorkTestCycle[]

  @@index([projectId], name: "idx_work_test_plan_project")
  @@map("work_test_plans")
}

model WorkTestPlanCase {
  planId     Int @map("plan_id")
  testCaseId Int @map("test_case_id")

  plan     WorkTestPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  testCase WorkTestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@id([planId, testCaseId])
  @@map("work_test_plan_cases")
}

/// Một đợt chạy test (vd "Sprint 3 — Chrome", "UAT with client").
/// state: PLANNED | IN_PROGRESS | DONE.
model WorkTestCycle {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  planId      Int?      @map("plan_id")
  name        String    @db.VarChar(120)
  environment String?   @db.VarChar(120)
  build       String?   @db.VarChar(80)
  state       String    @default("PLANNED") @db.VarChar(16)
  startAt     DateTime? @map("start_at")
  endAt       DateTime? @map("end_at")
  createdById Int?      @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  project WorkProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plan    WorkTestPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  runs    WorkTestRun[]

  @@index([projectId], name: "idx_work_test_cycle_project")
  @@map("work_test_cycles")
}

/// Một lần chạy một test case trong một cycle.
/// status: TODO | IN_PROGRESS | PASS | FAIL | BLOCKED | SKIP | RETEST.
/// RETEST = bug gây ra lỗi vừa được chuyển sang Retest ⇒ cần chạy lại.
model WorkTestRun {
  id           Int       @id @default(autoincrement())
  cycleId      Int       @map("cycle_id")
  testCaseId   Int       @map("test_case_id")
  status       String    @default("TODO") @db.VarChar(16)
  assigneeId   Int?      @map("assignee_id")
  executedById Int?      @map("executed_by_id")
  executedAt   DateTime? @map("executed_at")
  comment      String?   @db.Text
  /// Chụp lại Gherkin lúc tạo lần chạy (test sửa về sau không đổi lần chạy cũ).
  gherkin      String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  cycle      WorkTestCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  testCase   WorkTestCase         @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  assignee   User?                @relation("WorkTestRunAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  executedBy User?                @relation("WorkTestRunExecutor", fields: [executedById], references: [id], onDelete: SetNull)
  steps      WorkTestStepResult[]
  defects    WorkTestRunDefect[]
  evidence   WorkAttachment[]

  @@unique([cycleId, testCaseId], name: "uk_work_test_run", map: "uk_work_test_run")
  @@index([testCaseId], name: "idx_work_test_run_case")
  @@map("work_test_runs")
}

/// Kết quả từng bước — CHỤP LẠI nội dung bước lúc tạo lần chạy, để sửa/xoá
/// bước của test case về sau không làm sai lịch sử lần chạy đã xong.
model WorkTestStepResult {
  id       Int     @id @default(autoincrement())
  runId    Int     @map("run_id")
  position Int
  action   String  @db.Text
  data     String? @db.Text
  expected String? @db.Text
  status   String  @default("TODO") @db.VarChar(16)
  actual   String? @db.Text

  run WorkTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, position], name: "idx_work_step_result_run")
  @@map("work_test_step_results")
}

/// Bug tìm ra khi chạy test (một lần chạy có thể có nhiều bug và ngược lại).
model WorkTestRunDefect {
  runId     Int      @map("run_id")
  issueId   Int      @map("issue_id")
  createdAt DateTime @default(now()) @map("created_at")

  run   WorkTestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  issue WorkIssue   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([runId, issueId])
  @@index([issueId], name: "idx_work_run_defect_issue")
  @@map("work_test_run_defects")
}

// ─── CT Work — tài liệu kiểm thử chuẩn FPT (đợt 1b, 08/10/2026) ──────────
// Report 5.1 Unit Test (ma trận UTCID × Condition/Confirmation, dấu "O", loại N/A/B)
// và Report 5.2 Integration Test (mỗi module một sheet: bước, mong đợi, 4 vòng chạy).
// Xuất/nhập Excel đúng mẫu trường — xem src/services/work/fptTests.service.ts.

/// Thông tin trang Cover/Statistics dùng chung cho hai báo cáo — một dòng/dự án.
model WorkFptTestDoc {
  projectId     Int       @id @map("project_id")
  /// null ⇒ dùng tên dự án / mã dự án.
  projectName   String?   @map("project_name") @db.VarChar(200)
  projectCode   String?   @map("project_code") @db.VarChar(40)
  creator       String?   @db.VarChar(120)
  reviewer      String?   @db.VarChar(120)
  version       String    @default("1.0") @db.VarChar(20)
  unitIssueDate DateTime? @map("unit_issue_date") @db.Date
  intIssueDate  DateTime? @map("int_issue_date") @db.Date
  /// "Test Environment Setup Description" (Server, Database, Web Browser…).
  environment   String?   @db.Text
  /// "Normal number of Test cases/KLOC" — chỉ tiêu trường đặt 100.
  tcPerKloc     Int       @default(100) @map("tc_per_kloc")
  unitNotes     String?   @map("unit_notes") @db.Text
  intNotes      String?   @map("int_notes") @db.Text
  /// CTW đợt 3B (A14): Report 5.3 System Test dùng chung Cover — ngày phát hành + ghi chú riêng.
  sysIssueDate  DateTime? @map("sys_issue_date") @db.Date
  sysNotes      String?   @map("sys_notes") @db.Text
  updatedAt     DateTime  @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("work_fpt_test_docs")
}

/// Record of change trên Cover. report: UNIT | INT. action: A | D | M.
model WorkFptChange {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  report        String   @db.VarChar(4)
  effectiveDate DateTime @map("effective_date") @db.Date
  version       String   @db.VarChar(20)
  changeItem    String?  @map("change_item") @db.VarChar(200)
  action        String   @default("A") @db.VarChar(1)
  description   String?  @db.Text
  reference     String?  @db.VarChar(300)
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, report], name: "idx_work_fpt_change_project")
  @@map("work_fpt_changes")
}

/// Một HÀM được unit test (một dòng sheet Functions + một sheet ma trận riêng).
model WorkUnitFunction {
  id              Int      @id @default(autoincrement())
  projectId       Int      @map("project_id")
  /// Lớp/module (vd AuthService) — sheet Functions gộp ô theo cột này.
  moduleName      String   @map("module_name") @db.VarChar(120)
  methodName      String   @map("method_name") @db.VarChar(120)
  /// Tên sheet trong Excel (≤31 ký tự, duy nhất trong file) — null ⇒ suy từ methodName.
  sheetName       String?  @map("sheet_name") @db.VarChar(31)
  description     String?  @db.Text
  preCondition    String?  @map("pre_condition") @db.Text
  testRequirement String?  @map("test_requirement") @db.Text
  /// Tham chiếu mã: đường dẫn tệp#dòng hoặc link GitHub.
  codeRef         String?  @map("code_ref") @db.VarChar(500)
  /// Số dòng mã của hàm ⇒ KLOC ⇒ chỉ tiêu số test case.
  loc             Int?
  createdBy       String?  @map("created_by") @db.VarChar(120)
  executedBy      String?  @map("executed_by") @db.VarChar(120)
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project WorkProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rows    WorkUnitRow[]
  cases   WorkUnitCase[]

  @@index([projectId, position], name: "idx_work_unit_function_project")
  @@map("work_unit_functions")
}

/// Một dòng của ma trận: section COND (Condition) | CONFIRM (Confirmation).
/// groupName = nhóm in ở cột B (Precondition, tên tham số, Return, Exception, Log message…);
/// label = chú thích cột C (vd "255 characters"); value = giá trị cột D.
model WorkUnitRow {
  id         Int     @id @default(autoincrement())
  functionId Int     @map("function_id")
  section    String  @db.VarChar(8)
  groupName  String  @map("group_name") @db.VarChar(120)
  label      String? @db.VarChar(200)
  value      String? @db.Text
  position   Int

  function WorkUnitFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  marks    WorkUnitMark[]

  @@index([functionId, position], name: "idx_work_unit_row_function")
  @@map("work_unit_rows")
}

/// Một test case UTCIDnn (số thứ tự = position + 1). type: N | A | B. result: P | F | null (chưa chạy).
model WorkUnitCase {
  id         Int       @id @default(autoincrement())
  functionId Int       @map("function_id")
  position   Int
  type       String    @default("N") @db.VarChar(1)
  result     String?   @db.VarChar(1)
  executedAt DateTime? @map("executed_at") @db.Date
  /// Defect ID như trong mẫu (vd "CTW-12") — giao diện tự nối sang thẻ nếu khớp mã dự án.
  defectId   String?   @map("defect_id") @db.VarChar(60)
  note       String?   @db.Text

  function WorkUnitFunction @relation(fields: [functionId], references: [id], onDelete: Cascade)
  marks    WorkUnitMark[]

  @@index([functionId, position], name: "idx_work_unit_case_function")
  @@map("work_unit_cases")
}

/// Ô đánh dấu "O" của ma trận (dòng × test case).
model WorkUnitMark {
  rowId  Int @map("row_id")
  caseId Int @map("case_id")

  row      WorkUnitRow  @relation(fields: [rowId], references: [id], onDelete: Cascade)
  testCase WorkUnitCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@id([rowId, caseId])
  @@index([caseId], name: "idx_work_unit_mark_case")
  @@map("work_unit_marks")
}

/// Một MODULE/luồng integration test (một sheet của Report 5.2).
model WorkItModule {
  id              Int      @id @default(autoincrement())
  projectId       Int      @map("project_id")
  name            String   @db.VarChar(120)
  sheetName       String?  @map("sheet_name") @db.VarChar(31)
  /// Tiền tố mã test case trong sheet: "AT" ⇒ <AT1>, <AT2>…
  idPrefix        String   @default("IT") @map("id_prefix") @db.VarChar(10)
  description     String?  @db.Text
  preCondition    String?  @map("pre_condition") @db.Text
  testRequirement String?  @map("test_requirement") @db.Text
  /// CTW đợt 3B (A14): INT = sheet module của Report 5.2 · SYS = sheet workflow của Report 5.3 (Round 1–3).
  kind            String   @default("INT") @db.VarChar(4)
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project WorkProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cases   WorkItCase[]

  @@index([projectId, kind, position], name: "idx_work_it_module_kind")
  @@index([projectId, position], name: "idx_work_it_module_project")
  @@map("work_it_modules")
}

/// Một integration test case. section = dòng nhóm (vd "Login") in phía trên các case liền nhau.
/// rounds = [{ status: Passed|Failed|Pending|N/A, date: "YYYY-MM-DD"|null, tester }] — tối đa 4 vòng như mẫu.
model WorkItCase {
  id            Int     @id @default(autoincrement())
  moduleId      Int     @map("module_id")
  position      Int
  section       String? @db.VarChar(200)
  description   String  @db.Text
  procedure     String? @db.Text
  testData      String? @map("test_data") @db.Text
  expected      String? @db.Text
  actual        String? @db.Text
  preConditions String? @map("pre_conditions") @db.Text
  evidence      String? @db.Text
  note          String? @db.Text
  rounds        Json    @default("[]")

  module WorkItModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, position], name: "idx_work_it_case_module")
  @@map("work_it_cases")
}

// ── CTW đợt 3B ── (09/10/2026) Excel / báo cáo theo mẫu FPT: WBS + ước lượng (A3), Weekly Report (A21),
// AI Usage Report (A29), thông tin môn học dùng chung cho các báo cáo nộp trường.

/// A3 — thuộc tính WBS/ước lượng của MỘT thẻ (sheet WBS của Report2_Project Tracking).
/// complexity null ⇒ suy từ fields/transactions theo bảng quy đổi (settings.estimationMatrix),
/// rồi tới trường tuỳ chỉnh "Complexity". plannedDays null ⇒ man-day theo bảng quy đổi.
model WorkWbsItem {
  issueId      Int      @id @map("issue_id")
  projectId    Int      @map("project_id")
  /// Screen | Function | Non-UI (cột Type của mẫu).
  kind         String?  @db.VarChar(12)
  /// Simple | Medium | Complex.
  complexity   String?  @db.VarChar(12)
  /// Số trường dữ liệu / số giao dịch — tiêu chí của mẫu (≤7/≤15/>15 field, ≤3/≤7/>7 transaction).
  fields       Int?
  transactions Int?
  feature      String?  @db.VarChar(120)
  subFeature   String?  @map("sub_feature") @db.VarChar(120)
  plannedDays  Float?   @map("planned_days")
  note         String?  @db.VarChar(1000)
  updatedAt    DateTime @updatedAt @map("updated_at")

  issue   WorkIssue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], name: "idx_work_wbs_item_project")
  @@map("work_wbs_items")
}

/// Thông tin môn học/nhóm dùng chung cho Weekly Report + AI Usage Report (sheet 0.Overview).
/// week1Start = thứ Hai của tuần 1 học kỳ ⇒ đánh số "Week n". students = [{ code, name, role, aiTools }].
model WorkFptReportDoc {
  projectId    Int       @id @map("project_id")
  subjectCode  String?   @map("subject_code") @db.VarChar(20)
  subjectName  String?   @map("subject_name") @db.VarChar(120)
  classCode    String?   @map("class_code") @db.VarChar(40)
  semester     String?   @db.VarChar(40)
  lecturer     String?   @db.VarChar(120)
  groupCode    String?   @map("group_code") @db.VarChar(60)
  projectTitle String?   @map("project_title") @db.VarChar(200)
  week1Start   DateTime? @map("week1_start") @db.Date
  students     Json      @default("[]")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("work_fpt_report_docs")
}

/// A21 — một kỳ Weekly Report (một sheet "Week n" của mẫu SEP490). data = { status, issues, plan, matters, grades }
/// — bản người dùng sửa được; "Refresh" điền lại từ dữ liệu tuần. Khoá lạc quan theo `version`.
model WorkWeeklyReport {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  weekStart   DateTime @map("week_start") @db.Date
  weekNo      Int?     @map("week_no")
  data        Json     @default("{}")
  version     Int      @default(0)
  createdById Int?     @map("created_by_id")
  updatedById Int?     @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, weekStart], name: "uk_work_weekly_report", map: "uk_work_weekly_report")
  @@map("work_weekly_reports")
}

/// A29 — một dòng nhật ký dùng AI (SWP391 Template0, sheet "n. Week n"). source AUTO = tự ghi từ provenance
/// (thẻ aiAssisted, lượt agent, hội thoại AI) với sourceKey để không ghi trùng; MANUAL = người nhập tay.
/// issueId/userId KHÔNG có FK — như nhật ký, thẻ/người bị xoá thì dòng khai báo vẫn đứng.
model WorkAiUsageLog {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  usedAt     DateTime @map("used_at") @db.Date
  phase      String   @db.VarChar(40)
  task       String   @db.VarChar(300)
  tool       String   @db.VarChar(120)
  output     String?  @db.Text
  validation String?  @db.Text
  evidence   String?  @db.VarChar(1000)
  measure    String?  @db.VarChar(300)
  value      Int?
  risks      String?  @db.Text
  source     String   @default("MANUAL") @db.VarChar(8)
  sourceKey  String?  @map("source_key") @db.VarChar(80)
  issueId    Int?     @map("issue_id")
  userId     Int?     @map("user_id")
  userName   String?  @map("user_name") @db.VarChar(120)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sourceKey], name: "uk_work_ai_usage_source", map: "uk_work_ai_usage_source")
  @@index([projectId, usedAt], name: "idx_work_ai_usage_project")
  @@map("work_ai_usage_logs")
}

// ── hết CTW đợt 3B ──

// ─── CT Work — tuỳ biến & tìm kiếm (đợt 5) ────────────────────────────

/// Trường tuỳ chỉnh của dự án. kind: TEXT | NUMBER | DATE | SELECT | MULTISELECT
/// | USER | URL | CHECKBOX. options (SELECT/MULTISELECT): [{ id, label, color }].
/// typeKeys null = áp cho mọi loại thẻ; có mảng thì chỉ các loại đó.
model WorkCustomField {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  name      String   @db.VarChar(60)
  kind      String   @db.VarChar(16)
  options   Json     @default("[]")
  typeKeys  Json?    @map("type_keys")
  required  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  project WorkProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  WorkCustomValue[]

  @@unique([projectId, name], name: "uk_work_custom_field", map: "uk_work_custom_field")
  @@map("work_custom_fields")
}

/// Giá trị trường tuỳ chỉnh của một thẻ (JSON theo kind: chuỗi, số, "YYYY-MM-DD",
/// id lựa chọn, mảng id, id người, true/false).
model WorkCustomValue {
  issueId Int  @map("issue_id")
  fieldId Int  @map("field_id")
  value   Json

  issue WorkIssue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  field WorkCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([issueId, fieldId])
  @@index([fieldId], name: "idx_work_custom_value_field")
  @@map("work_custom_values")
}

/// Bộ lọc đã lưu (truy vấn kiểu JQL). shared = cả dự án thấy.
model WorkSavedFilter {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  ownerId   Int      @map("owner_id")
  name      String   @db.VarChar(100)
  query     String   @db.Text
  shared    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User        @relation("WorkSavedFilterOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([projectId], name: "idx_work_saved_filter_project")
  @@map("work_saved_filters")
}

/// Dashboard: danh sách widget (JSON) — mỗi widget { id, kind, title, query?,
/// groupBy?, sprintId?, size }. Dữ liệu widget tính lúc xem, không lưu.
model WorkDashboard {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  ownerId   Int      @map("owner_id")
  name      String   @db.VarChar(100)
  shared    Boolean  @default(true)
  widgets   Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User        @relation("WorkDashboardOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([projectId], name: "idx_work_dashboard_project")
  @@map("work_dashboards")
}

// ═══ CT Work đợt 6 — kế hoạch dài hạn, tự động hoá, email ═══════════

/// Ngày nghỉ của một người trong không gian — capacity trừ đi những ngày này.
model WorkTimeOff {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  userId      Int      @map("user_id")
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  note        String?  @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")

  workspace WorkSpace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkTimeOffUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId], name: "idx_work_time_off_user")
  @@map("work_time_off")
}

/// Phiên bản / đợt phát hành. status: UNRELEASED | RELEASED | ARCHIVED.
model WorkVersion {
  id           Int       @id @default(autoincrement())
  projectId    Int       @map("project_id")
  name         String    @db.VarChar(60)
  description  String?   @db.Text
  startDate    DateTime? @map("start_date") @db.Date
  releaseDate  DateTime? @map("release_date") @db.Date
  status       String    @default("UNRELEASED") @db.VarChar(16)
  releasedAt   DateTime? @map("released_at")
  releaseNotes String?   @map("release_notes") @db.Text
  position     Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")

  project           WorkProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues            WorkIssue[]
  uatRequests       WorkUatRequest[]
  crLinks           WorkChangeRequestLink[]
  /// Đợt S4: mốc thanh toán gắn version (UAT của version được duyệt ⇒ mốc DUE).
  paymentMilestones WorkPaymentMilestone[]

  @@unique([projectId, name], name: "uk_work_version", map: "uk_work_version")
  @@map("work_versions")
}

/// Một lần ghi giờ làm. Tổng minutes = work_issues.time_spent_min (giữ khớp trong transaction).
model WorkWorklog {
  id          Int      @id @default(autoincrement())
  issueId     Int      @map("issue_id")
  userId      Int      @map("user_id")
  minutes     Int
  startedAt   DateTime @map("started_at")
  note        String?  @db.VarChar(1000)
  /// CTW-28: MANUAL (người/agent tự ghi) | AGENT_AUTO (timesheet agent sinh từ lease — GĐ1 A12).
  source      String   @default("MANUAL") @db.VarChar(10)
  /// CTW đợt 4 (A24): hoạt động theo sheet TimeLogs của mẫu (Training | Analyzing | Designing | Coding | Testing | Deploying)
  /// và sản phẩm công việc (Report1…7 / mô-đun). null ⇒ bản xuất suy từ tiêu đề thẻ như trước.
  activity    String?  @db.VarChar(16)
  workProduct String?  @map("work_product") @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at")

  issue WorkIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User      @relation("WorkWorklogUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId], name: "idx_work_worklog_issue")
  @@index([userId, startedAt], name: "idx_work_worklog_user")
  @@map("work_worklogs")
}

/// Luật "khi… nếu… thì…". config = { trigger: {...}, conditions: [...], actions: [...] }.
/// createdById không có FK: người tạo rời dự án thì luật vẫn chạy (dưới tên AUTOMATION).
model WorkAutomationRule {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  name        String    @db.VarChar(100)
  enabled     Boolean   @default(true)
  trigger     String    @db.VarChar(32)
  config      Json      @default("{}")
  createdById Int?      @map("created_by_id")
  runCount    Int       @default(0) @map("run_count")
  lastRunAt   DateTime? @map("last_run_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project       WorkProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs          WorkAutomationLog[]
  /// CTW đợt 5: lần tạo thẻ của việc định kỳ (trigger scheduled.recurring) — khoá chống trùng.
  recurringRuns WorkRecurringRun[]

  @@index([projectId, trigger], name: "idx_work_automation_trigger")
  @@map("work_automation_rules")
}

/// Nhật ký chạy luật. status: SUCCESS | NO_MATCH | FAILED | LOOP_BLOCKED | THROTTLED.
/// issueId không có FK: thẻ bị xoá thì nhật ký vẫn còn để đọc.
model WorkAutomationLog {
  id         Int      @id @default(autoincrement())
  ruleId     Int      @map("rule_id")
  issueId    Int?     @map("issue_id")
  status     String   @db.VarChar(16)
  message    String   @db.Text
  durationMs Int      @default(0) @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  rule WorkAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt], name: "idx_work_automation_log_rule")
  @@map("work_automation_logs")
}

/// Cài đặt email CT Work của một người. emailMode: INSTANT | DIGEST | OFF.
/// Giờ im lặng tính theo giờ VN; thư rơi vào giờ im lặng dồn sang thư gộp.
model WorkNotifySetting {
  userId       Int       @id @map("user_id")
  emailMode    String    @default("INSTANT") @map("email_mode") @db.VarChar(12)
  quietStart   Int?      @map("quiet_start")
  quietEnd     Int?      @map("quiet_end")
  lastDigestAt DateTime? @map("last_digest_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation("WorkNotifySettingUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("work_notify_settings")
}

/// Hàng đợi thư gộp: mỗi dòng là một mục sẽ vào thư gộp kế tiếp.
model WorkEmailQueue {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  kind      String    @db.VarChar(32)
  subject   String    @db.VarChar(255)
  url       String?   @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")

  user User @relation("WorkEmailQueueUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt], name: "idx_work_email_queue_user")
  @@map("work_email_queue")
}

// ═══ CT Work đợt 7 — tích hợp, quản trị, chia sẻ ════════════════════

/// Kết nối GitHub của một dự án qua webhook. secret dùng để kiểm chữ ký
/// HMAC nên phải giữ nguyên văn (không băm được).
model WorkGithubConnection {
  id           Int       @id @default(autoincrement())
  projectId    Int       @unique(map: "uk_work_github_project") @map("project_id")
  repoFullName String?   @map("repo_full_name") @db.VarChar(200)
  secret       String    @db.VarChar(100)
  /// { prOpenedStatusId?, prMergedStatusId? }
  config       Json      @default("{}")
  lastEventAt  DateTime? @map("last_event_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("work_github_connections")
}

/// Commit / nhánh / PR gắn vào thẻ theo mã KEY-123. kind: COMMIT | BRANCH | PR.
model WorkDevActivity {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  issueId    Int      @map("issue_id")
  kind       String   @db.VarChar(12)
  externalId String   @map("external_id") @db.VarChar(200)
  title      String   @db.VarChar(500)
  url        String   @db.VarChar(500)
  state      String?  @db.VarChar(16)
  author     String?  @db.VarChar(100)
  repo       String?  @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue   WorkIssue   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, kind, externalId], name: "uk_work_dev_activity", map: "uk_work_dev_activity")
  @@index([projectId], name: "idx_work_dev_activity_project")
  @@map("work_dev_activity")
}

/// Nhật ký quản trị: ai đổi quyền, xoá gì, tạo token… actorId không FK —
/// nhật ký phải sống lâu hơn tài khoản.
model WorkAuditLog {
  id          Int      @id @default(autoincrement())
  workspaceId Int      @map("workspace_id")
  projectId   Int?     @map("project_id")
  actorId     Int?     @map("actor_id")
  actorName   String?  @map("actor_name") @db.VarChar(100)
  action      String   @db.VarChar(48)
  targetType  String?  @map("target_type") @db.VarChar(24)
  targetId    Int?     @map("target_id")
  summary     String   @db.VarChar(500)
  detail      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace WorkSpace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt], name: "idx_work_audit_ws")
  @@index([projectId, createdAt], name: "idx_work_audit_project")
  @@map("work_audit_logs")
}

/// Link công khai chỉ đọc cho giảng viên/khách. Token giữ nguyên văn để chủ
/// dự án copy lại được; thu hồi = revokedAt. options: { board, backlog, reports, tests }.
model WorkPublicLink {
  id           Int       @id @default(autoincrement())
  projectId    Int       @map("project_id")
  token        String    @unique(map: "uk_work_public_link_token") @db.VarChar(64)
  label        String?   @db.VarChar(100)
  options      Json      @default("{}")
  createdById  Int?      @map("created_by_id")
  expiresAt    DateTime? @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastViewedAt DateTime? @map("last_viewed_at")
  viewCount    Int       @default(0) @map("view_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], name: "idx_work_public_link_project")
  @@map("work_public_links")
}

/// API token cá nhân (giống Jira). Chỉ lưu sha256 — token nguyên văn hiện
/// đúng một lần lúc tạo. scopes: ["read"] | ["read","write"].
model WorkApiToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  name       String    @db.VarChar(100)
  tokenHash  String    @unique(map: "uk_work_api_token_hash") @map("token_hash") @db.VarChar(64)
  prefix     String    @db.VarChar(16)
  scopes     Json      @default("[\"read\"]")
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  lastUsedIp String?   @map("last_used_ip") @db.VarChar(64)
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  /// CTW-28: token của AI agent (null = token cá nhân của người). Có ⇒ apiTokenAuth gắn req.agent, rào chắn áp.
  agentId    Int? @map("agent_id")
  /// Phạm vi dự án của token agent: [] = mọi dự án agent là thành viên; có phần tử = chỉ các dự án đó.
  projectIds Json @default("[]") @map("project_ids")

  user  User       @relation("WorkApiTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  agent WorkAgent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_work_api_token_user")
  @@index([agentId], name: "idx_work_api_token_agent")
  @@map("work_api_tokens")
}

// ─── CT Work — AI agent là thành viên hạng nhất (CTW-28, 06/10/2026) ───────────
// Thiết kế: docs/ct-work-ai-agents-thiet-ke.md. Agent LÀ một User kind=AGENT + hồ sơ WorkAgent —
// mọi khoá ngoại sẵn có (assignee, author, actor, worklog…) trỏ users.id nên không bảng nào phải mọc cột thứ hai.

/// Hồ sơ AI agent — một dòng cho mỗi user kind=AGENT. ownerId = NGƯỜI chịu trách nhiệm (bắt buộc, HUMAN).
/// status: ACTIVE | PAUSED (đọc được, ghi ⇒ 423) | RETIRED (token chết, rời dự án, user.enabled=false — id giữ nguyên).
model WorkAgent {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique(map: "uk_work_agent_user") @map("user_id")
  workspaceId     Int       @map("workspace_id")
  ownerId         Int       @map("owner_id")
  model           String    @db.VarChar(80)
  roleText        String?   @map("role_text") @db.VarChar(300)
  capabilities    Json      @default("{}")
  /// EXTERNAL (tự chạy, nhận việc qua MCP/webhook — GĐ1) | BUILTIN (CT Work chạy qua cổng LLM — GĐ2)
  runtime         String    @default("EXTERNAL") @db.VarChar(12)
  status          String    @default("ACTIVE") @db.VarChar(12)
  parallelSlots   Int       @default(1) @map("parallel_slots")
  dailyCostCapUsd Float?    @map("daily_cost_cap_usd")
  /// GĐ2: system prompt riêng của agent dựng sẵn (≤ 20.000 ký tự).
  instructions    String?   @db.Text
  lastSeenAt      DateTime? @map("last_seen_at")
  createdById     Int?      @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  retiredAt       DateTime? @map("retired_at")

  user      User             @relation("WorkAgentUser", fields: [userId], references: [id], onDelete: Cascade)
  owner     User             @relation("WorkAgentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  workspace WorkSpace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tokens    WorkApiToken[]
  leases    WorkAgentLease[]
  usage     WorkAgentUsage[]
  webhooks  WorkWebhook[]
  runs      WorkAgentRun[]

  @@index([workspaceId, status], name: "idx_work_agent_ws")
  @@index([ownerId], name: "idx_work_agent_owner")
  @@map("work_agents")
}

/// "Đang làm" — agent nhận (claim) một thẻ. Hết hạn mà không heartbeat ⇒ sweeper đánh EXPIRED + cắm cờ Blocked.
/// status: ACTIVE | RELEASED | EXPIRED.
/// Mỗi thẻ chỉ MỘT lease ACTIVE: `activeIssueId` = issueId khi ACTIVE, NULL khi đã kết thúc; UNIQUE trên cột này
/// (Postgres cho nhiều NULL) — thay cho partial unique index mà Prisma không khai được, để `migrate diff` sạch.
model WorkAgentLease {
  id            Int       @id @default(autoincrement())
  agentId       Int       @map("agent_id")
  issueId       Int       @map("issue_id")
  projectId     Int       @map("project_id")
  activeIssueId Int?      @unique(map: "uk_work_agent_lease_active") @map("active_issue_id")
  claimedAt     DateTime  @default(now()) @map("claimed_at")
  heartbeatAt   DateTime  @default(now()) @map("heartbeat_at")
  expiresAt     DateTime  @map("expires_at")
  status        String    @default("ACTIVE") @db.VarChar(10)
  releasedAt    DateTime? @map("released_at")
  /// Ghi chú tiến độ gần nhất (heartbeat) — hiện trên thẻ "🤖 working: …".
  progress      String?   @db.VarChar(300)
  progressPct   Int?      @map("progress_pct")

  agent WorkAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status], name: "idx_work_agent_lease_agent")
  @@index([issueId], name: "idx_work_agent_lease_issue")
  @@index([status, expiresAt], name: "idx_work_agent_lease_expiry")
  @@map("work_agent_leases")
}

/// Chi phí/token của agent theo thẻ. source: REPORTED (agent tự khai qua MCP) | GATEWAY (CT Work đo thật, GĐ2).
model WorkAgentUsage {
  id              Int      @id @default(autoincrement())
  agentId         Int      @map("agent_id")
  projectId       Int      @map("project_id")
  issueId         Int?     @map("issue_id")
  runId           Int?     @map("run_id")
  model           String   @db.VarChar(80)
  inputTokens     Int      @default(0) @map("input_tokens")
  outputTokens    Int      @default(0) @map("output_tokens")
  cacheReadTokens Int      @default(0) @map("cache_read_tokens")
  costUsd         Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 6)
  source          String   @db.VarChar(10)
  note            String?  @db.VarChar(200)
  createdAt       DateTime @default(now()) @map("created_at")

  agent WorkAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt], name: "idx_work_agent_usage_agent")
  @@index([projectId, createdAt], name: "idx_work_agent_usage_project")
  @@index([issueId], name: "idx_work_agent_usage_issue")
  @@map("work_agent_usage")
}

/// Webhook RA NGOÀI cho agent/hệ thống khác — JSON ký HMAC-SHA256, KHÔNG mang nội dung thẻ/bình luận.
/// secret lưu nguyên văn (cần để ký) — API luôn che. Của agent (agentId) hoặc của dự án (projectId).
model WorkWebhook {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  projectId   Int?      @map("project_id")
  agentId     Int?      @map("agent_id")
  url         String    @db.VarChar(600)
  secret      String    @db.VarChar(100)
  events      Json      @default("[]")
  enabled     Boolean   @default(true)
  createdById Int?      @map("created_by_id")
  lastSentAt  DateTime? @map("last_sent_at")
  lastError   String?   @map("last_error") @db.VarChar(300)
  failCount   Int       @default(0) @map("fail_count")
  createdAt   DateTime  @default(now()) @map("created_at")

  agent WorkAgent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([workspaceId], name: "idx_work_webhook_ws")
  @@index([agentId], name: "idx_work_webhook_agent")
  @@map("work_webhooks")
}

/// Hộp thư sự kiện của agent (nguồn cho SSE + hàng chờ gửi webhook). Mỗi sự kiện liên quan tới một agent = 1 dòng.
/// delivery (gửi webhook): PENDING | SENT | FAILED | SKIPPED (agent không có webhook nào).
model WorkAgentInbox {
  id        Int       @id @default(autoincrement())
  agentId   Int       @map("agent_id")
  projectId Int       @map("project_id")
  issueId   Int?      @map("issue_id")
  type      String    @db.VarChar(32)
  payload   Json
  createdAt DateTime  @default(now()) @map("created_at")
  ackedAt   DateTime? @map("acked_at")
  delivery  String    @default("PENDING") @db.VarChar(10)
  attempts  Int       @default(0)
  nextTryAt DateTime? @map("next_try_at")

  @@index([agentId, id], name: "idx_work_agent_inbox_agent")
  @@index([delivery, nextTryAt], name: "idx_work_agent_inbox_delivery")
  @@map("work_agent_inbox")
}

/// GĐ2: một lượt chạy của agent dựng sẵn trên một thẻ. status: QUEUED | RUNNING | DONE | FAILED | CANCELLED | CAPPED.
/// Bảng tạo sẵn ở GĐ1 (migration chỉ-thêm một lần), chưa có mã ghi.
model WorkAgentRun {
  id            Int       @id @default(autoincrement())
  agentId       Int       @map("agent_id")
  projectId     Int       @map("project_id")
  issueId       Int       @map("issue_id")
  /// WRITE_SPEC | ANALYZE | SPLIT_EPIC | WRITE_TESTS | TRIAGE_DESK | CUSTOM
  task          String    @db.VarChar(24)
  status        String    @default("QUEUED") @db.VarChar(12)
  requestedById Int       @map("requested_by_id")
  input         Json      @default("{}")
  steps         Json      @default("[]")
  resultText    String?   @map("result_text") @db.Text
  error         String?   @db.VarChar(500)
  costUsd       Decimal   @default(0) @map("cost_usd") @db.Decimal(12, 6)
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  agent WorkAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([issueId], name: "idx_work_agent_run_issue")
  @@index([status, createdAt], name: "idx_work_agent_run_status")
  @@map("work_agent_runs")
}

/// Hội thoại với trợ lý AI trong một dự án CT Work — lưu ở SERVER để không mất khi
/// đóng khung/tải lại trang, và để cả nhóm xem + hỏi tiếp hội thoại của nhau.
/// visibility: PROJECT (mọi thành viên xem được) | PRIVATE (chỉ người tạo).
model WorkAiThread {
  id            Int       @id @default(autoincrement())
  projectId     Int       @map("project_id")
  createdById   Int?      @map("created_by_id")
  title         String    @db.VarChar(160)
  visibility    String    @default("PROJECT") @db.VarChar(12)
  /// CHAT (mặc định) | DEFENSE (AI đóng vai hội đồng bảo vệ, hỏi–chấm từng câu)
  mode          String    @default("CHAT") @db.VarChar(12)
  issueNumber   Int?      @map("issue_number")
  messageCount  Int       @default(0) @map("message_count")
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  project   WorkProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("WorkAiThreadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  messages  WorkAiMessage[]

  @@index([projectId, lastMessageAt], name: "idx_work_ai_thread_project")
  @@map("work_ai_threads")
}

/// Một lượt trong hội thoại AI. `actions` = đề xuất của AI kèm TRẠNG THÁI áp dụng
/// ([{action, status, summary?, number?, error?, byId?, at?}]) — lưu ở server để hai
/// người cùng xem không áp dụng trùng một đề xuất. `error` ≠ null: câu hỏi chưa được trả lời.
model WorkAiMessage {
  id          Int      @id @default(autoincrement())
  threadId    Int      @map("thread_id")
  role        String   @db.VarChar(12)
  authorId    Int?     @map("author_id")
  content     String   @db.Text
  title       String?  @db.VarChar(120)
  issueNumber Int?     @map("issue_number")
  actions     Json?
  error       String?  @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at")

  thread WorkAiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User?        @relation("WorkAiMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([threadId, id], name: "idx_work_ai_message_thread")
  @@map("work_ai_messages")
}

/// Gửi thông báo dự án ra kênh chat của nhóm (Discord / Slack / Google Chat) qua
/// incoming webhook. URL là BÍ MẬT (ai có nó gửi được tin vào kênh) ⇒ bảng riêng,
/// chỉ ADMIN dự án đọc — không nằm trong settings (settings gửi cho mọi người xem dự án).
/// events: ["issue.created","issue.assigned","issue.done","comment.created"].
model WorkChatHook {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  kind        String    @db.VarChar(16)
  name        String    @db.VarChar(80)
  url         String    @db.VarChar(600)
  events      Json      @default("[]")
  enabled     Boolean   @default(true)
  createdById Int?      @map("created_by_id")
  lastSentAt  DateTime? @map("last_sent_at")
  lastError   String?   @map("last_error") @db.VarChar(300)
  createdAt   DateTime  @default(now()) @map("created_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], name: "idx_work_chat_hook_project")
  @@map("work_chat_hooks")
}

/// Tích hợp GitLab (gitlab.com hoặc GitLab tự host) qua webhook — cùng ý với GitHub:
/// commit / nhánh / merge request nhắc KEY-123 ⇒ panel Development của thẻ đó.
/// GitLab gửi token nguyên văn trong header X-Gitlab-Token (không ký HMAC).
model WorkGitlabConnection {
  id          Int       @id @default(autoincrement())
  projectId   Int       @unique(map: "uk_work_gitlab_project") @map("project_id")
  repoPath    String?   @map("repo_path") @db.VarChar(200)
  token       String    @db.VarChar(100)
  /// { mrOpenedStatusId?, mrMergedStatusId? }
  config      Json      @default("{}")
  lastEventAt DateTime? @map("last_event_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("work_gitlab_connections")
}

/// "Khoá chỉnh sửa" CÁ NHÂN theo dự án: có dòng = người này đang khoá dự án đó
/// (lướt kế hoạch không sợ lỡ tay kéo/sửa). Server chặn mọi lệnh ghi của CHÍNH người
/// đó trong dự án (423 WORK_EDIT_LOCKED); người khác không bị ảnh hưởng.
model WorkEditLock {
  userId    Int      @map("user_id")
  projectId Int      @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("work_edit_locks")
}

// ─── CT Work — LỚP STUDIO đợt S1 (04/10/2026) ────────────────────
// Bộ phận · giai đoạn + cổng · phê duyệt · bàn giao. Mỗi thứ là một MÔ-ĐUN bật
// theo dự án (settings.modules — xem src/services/work/studio.ts). Dự án tạo
// trước đợt này không có settings.modules ⇒ mọi mô-đun TẮT, hành vi y như cũ.
// ⚠️ Khoá ngoại trỏ VÀO hoặc nằm TRÊN work_issues đều DEFERRABLE INITIALLY
// DEFERRED (migration viết tay) — Prisma không khai được, xem
// 20260923131000_ct_work_issue_fk_deferred.

/// Bộ phận (BA, Dev, QA…) — cấp KHÔNG GIAN để một bộ phận phục vụ nhiều dự án.
/// Trưởng bộ phận = thành viên có role LEAD (có thể nhiều người), không có cột
/// leadId riêng để khỏi hai nguồn sự thật.
model WorkTeam {
  id          Int       @id @default(autoincrement())
  workspaceId Int       @map("workspace_id")
  /// Mã ngắn in hoa (BA, DEV, DEVOPS) — JQL `team = BA` khớp mã hoặc tên.
  key         String    @db.VarChar(16)
  name        String    @db.VarChar(80)
  color       String    @default("#64748b") @db.VarChar(16)
  description String?   @db.Text
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace    WorkSpace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members      WorkTeamMember[]
  issues       WorkIssue[]
  handoffsFrom WorkHandoff[]    @relation("WorkHandoffFromTeam")
  handoffsTo   WorkHandoff[]    @relation("WorkHandoffToTeam")
  /// Đợt S4: đơn giá theo bộ phận.
  rates        WorkRate[]

  @@unique([workspaceId, key], name: "uk_work_team_key", map: "uk_work_team_key")
  @@map("work_teams")
}

/// Thành viên bộ phận. role: LEAD | MEMBER.
model WorkTeamMember {
  id        Int      @id @default(autoincrement())
  teamId    Int      @map("team_id")
  userId    Int      @map("user_id")
  role      String   @default("MEMBER") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  team WorkTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User     @relation("WorkTeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId], name: "uk_work_team_member", map: "uk_work_team_member")
  @@index([userId], name: "idx_work_team_member_user")
  @@map("work_team_members")
}

/// Giai đoạn của dự án (slug khớp /about/quy-trinh/<slug> với dự án khách).
/// status: NOT_STARTED | ACTIVE | GATE_REVIEW | DONE. Sang DONE CHỈ qua phê
/// duyệt cổng (WorkApproval targetType STAGE_GATE).
model WorkStage {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  n           Int
  slug        String    @db.VarChar(80)
  name        String    @db.VarChar(160)
  status      String    @default("NOT_STARTED") @db.VarChar(16)
  /// Thẻ "cổng chất lượng" của giai đoạn (checklist điều kiện ra).
  gateIssueId Int?      @map("gate_issue_id")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project           WorkProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  gateIssue         WorkIssue?              @relation("WorkStageGateIssue", fields: [gateIssueId], references: [id], onDelete: SetNull)
  issues            WorkIssue[]             @relation("WorkIssueStage")
  approvals         WorkApproval[]
  pages             WorkPage[]
  uatRequests       WorkUatRequest[]
  crLinks           WorkChangeRequestLink[]
  raidLinks         WorkRaidLink[]
  /// Đợt S4: ngân sách / chi phí / mốc thanh toán theo giai đoạn.
  budgetLines       WorkBudgetLine[]
  expenses          WorkExpense[]
  paymentMilestones WorkPaymentMilestone[]
  /// Đợt S6: lần chấm Spec Fidelity thuộc giai đoạn (cổng "Spec Fidelity gate" đọc lần mới nhất).
  specReviews       WorkSpecReview[]

  @@unique([projectId, n], name: "uk_work_stage_n", map: "uk_work_stage_n")
  @@unique([projectId, slug], name: "uk_work_stage_slug", map: "uk_work_stage_slug")
  @@map("work_stages")
}

/// Một yêu cầu phê duyệt. targetType: ISSUE | STAGE_GATE (chừa DOC, CR cho đợt sau).
/// mode: SEQUENTIAL (lần lượt theo position) | PARALLEL (ai cũng duyệt được ngay).
/// status: PENDING | APPROVED | REJECTED | CANCELLED.
/// `contentHash` = SHA-256 của nội dung đối tượng LÚC TẠO; mỗi bước lưu hash lúc
/// QUYẾT ĐỊNH (chữ ký). Đối tượng đổi sau khi duyệt ⇒ đọc ra cờ lệch, không tự huỷ.
model WorkApproval {
  id              Int       @id @default(autoincrement())
  projectId       Int       @map("project_id")
  targetType      String    @map("target_type") @db.VarChar(16)
  issueId         Int?      @map("issue_id")
  stageId         Int?      @map("stage_id")
  /// Trang tài liệu được duyệt (targetType DOC, đợt S2a).
  pageId          Int?      @map("page_id")
  /// Yêu cầu thay đổi được duyệt (targetType CR, đợt S3b).
  changeRequestId Int?      @map("change_request_id")
  title           String    @db.VarChar(200)
  description     String?   @db.Text
  mode            String    @default("SEQUENTIAL") @db.VarChar(16)
  status          String    @default("PENDING") @db.VarChar(16)
  createdById     Int?      @map("created_by_id")
  dueAt           DateTime? @map("due_at")
  contentHash     String?   @map("content_hash") @db.VarChar(64)
  /// Đợt S6: lần chấm Spec Fidelity đính kèm lúc gửi duyệt cổng giai đoạn (bằng chứng chất lượng đặc tả).
  specReviewId    Int?      @map("spec_review_id")
  /// CTW-1 (06/10/2026): lời nhắn HIỆN VỚI KHÁCH khi gửi duyệt cổng giai đoạn — `description` vẫn là ghi chú nội bộ.
  clientNote      String?   @map("client_note") @db.Text
  /// CTW-1/13: bằng chứng của cổng {issueIds, pageNumbers, attachmentIds, openIssues, openReason}.
  evidence        Json?
  decidedAt       DateTime? @map("decided_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project       WorkProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specReview    WorkSpecReview?    @relation(fields: [specReviewId], references: [id], onDelete: SetNull)
  issue         WorkIssue?         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  stage         WorkStage?         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  page          WorkPage?          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  changeRequest WorkChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  createdBy     User?              @relation("WorkApprovalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  steps         WorkApprovalStep[]
  /// targetType UAT (đợt S2b): chi tiết nghiệm thu (hạng mục, tài liệu, điều kiện, thẻ sinh ra).
  uat           WorkUatRequest?

  @@index([projectId, status], name: "idx_work_approval_project")
  @@index([issueId], name: "idx_work_approval_issue")
  @@index([stageId], name: "idx_work_approval_stage")
  @@index([pageId], name: "idx_work_approval_page")
  @@index([changeRequestId], name: "idx_work_approval_cr")
  @@map("work_approvals")
}

/// Một người duyệt trong một yêu cầu. decision: PENDING | APPROVED | REJECTED | SKIPPED.
model WorkApprovalStep {
  id          Int       @id @default(autoincrement())
  approvalId  Int       @map("approval_id")
  approverId  Int       @map("approver_id")
  position    Int       @default(0)
  decision    String    @default("PENDING") @db.VarChar(16)
  comment     String?   @db.Text
  decidedAt   DateTime? @map("decided_at")
  ip          String?   @db.VarChar(64)
  contentHash String?   @map("content_hash") @db.VarChar(64)

  approval WorkApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  approver User         @relation("WorkApprovalStepApprover", fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([approvalId, approverId], name: "uk_work_approval_step", map: "uk_work_approval_step")
  @@index([approverId, decision], name: "idx_work_approval_step_approver")
  @@map("work_approval_steps")
}

/// Bàn giao một thẻ giữa bộ phận/người. status: PENDING | ACCEPTED | RETURNED | CANCELLED.
/// checklist: [{ text, done }] — nhận bàn giao cần tick đủ.
model WorkHandoff {
  id           Int       @id @default(autoincrement())
  projectId    Int       @map("project_id")
  issueId      Int       @map("issue_id")
  fromTeamId   Int?      @map("from_team_id")
  fromUserId   Int?      @map("from_user_id")
  toTeamId     Int?      @map("to_team_id")
  toUserId     Int?      @map("to_user_id")
  checklist    Json      @default("[]")
  note         String?   @db.Text
  status       String    @default("PENDING") @db.VarChar(16)
  returnReason String?   @map("return_reason") @db.Text
  createdById  Int?      @map("created_by_id")
  decidedById  Int?      @map("decided_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  decidedAt    DateTime? @map("decided_at")

  project   WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue     WorkIssue   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  fromTeam  WorkTeam?   @relation("WorkHandoffFromTeam", fields: [fromTeamId], references: [id], onDelete: SetNull)
  toTeam    WorkTeam?   @relation("WorkHandoffToTeam", fields: [toTeamId], references: [id], onDelete: SetNull)
  fromUser  User?       @relation("WorkHandoffFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser    User?       @relation("WorkHandoffToUser", fields: [toUserId], references: [id], onDelete: SetNull)
  createdBy User?       @relation("WorkHandoffCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([issueId], name: "idx_work_handoff_issue")
  @@index([projectId, status], name: "idx_work_handoff_project")
  @@index([toTeamId, status], name: "idx_work_handoff_to_team")
  @@index([toUserId, status], name: "idx_work_handoff_to_user")
  @@map("work_handoffs")
}

/// Mã cũ của thẻ đã chuyển sang dự án khác (SWP-12 → ABC-3): link cũ vẫn tìm ra
/// thẻ. Số cũ không bao giờ bị cấp lại vì issueCounter chỉ tăng.
model WorkIssueAlias {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  number    Int
  issueId   Int      @map("issue_id")
  createdAt DateTime @default(now()) @map("created_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue   WorkIssue   @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([projectId, number], name: "uk_work_issue_alias", map: "uk_work_issue_alias")
  @@index([issueId], name: "idx_work_issue_alias_issue")
  @@map("work_issue_aliases")
}

// ─── CT Work — TÀI LIỆU DỰ ÁN kiểu Confluence (đợt S2a, 04/10/2026) ──────────
// Mô-đun `docs` (settings.modules.docs). Xem src/services/work/pages.service.ts.

/// Một trang tài liệu của dự án. Cây qua parentId; thứ tự anh em theo position.
/// status: DRAFT | IN_REVIEW | APPROVED | ARCHIVED.
/// visibility: INTERNAL (chỉ đội) | CLIENT (khách/GUEST đọc được — cổng khách đợt S2b).
/// `number` cấp theo dự án (DOC-1, DOC-2…) — URL /work/<ws>/<KEY>/docs/<number>.
/// `version` tăng mỗi lần lưu: client gửi kèm số đang cầm, lệch ⇒ 409 (không đè).
model WorkPage {
  id             Int       @id @default(autoincrement())
  projectId      Int       @map("project_id")
  number         Int
  parentId       Int?      @map("parent_id")
  title          String    @db.VarChar(255)
  /// JSON của TipTap (cùng định dạng với mô tả thẻ, thêm bảng).
  contentJson    Json?     @map("content_json")
  /// Chữ trơn rút từ contentJson — cho tìm kiếm, xuất, so sánh phiên bản.
  contentText    String?   @map("content_text") @db.Text
  status         String    @default("DRAFT") @db.VarChar(16)
  visibility     String    @default("INTERNAL") @db.VarChar(16)
  ownerId        Int?      @map("owner_id")
  lastEditedById Int?      @map("last_edited_by_id")
  /// Mẫu đã dùng lúc tạo (tên file trong content/quy-trinh/mau, không đuôi .md).
  templateKey    String?   @map("template_key") @db.VarChar(64)
  /// Giai đoạn của dự án (mô-đun stages) mà trang thuộc về.
  stageId        Int?      @map("stage_id")
  position       Int       @default(0)
  version        Int       @default(0)
  /// Đợt S6 — nguồn gốc AI: trang được tạo/sửa qua đề xuất AI đã áp dụng (hoặc gắn tay).
  aiAssisted     Boolean   @default(false) @map("ai_assisted")
  aiModel        String?   @map("ai_model") @db.VarChar(120)
  aiAssistedAt   DateTime? @map("ai_assisted_at")
  aiAppliedById  Int?      @map("ai_applied_by_id")
  /// CTW-6: cột SINH TỰ ĐỘNG (lower + bỏ dấu) — CHỈ ĐỌC, xem fold.ts.
  titleFold      String?   @default(dbgenerated("lower(translate((COALESCE(title, ''::character varying))::text, 'àÀáÁảẢãÃạẠăĂằẰắẮẳẲẵẴặẶâÂầẦấẤẩẨẫẪậẬèÈéÉẻẺẽẼẹẸêÊềỀếẾểỂễỄệỆìÌíÍỉỈĩĨịỊòÒóÓỏỎõÕọỌôÔồỒốỐổỔỗỖộỘơƠờỜớỚởỞỡỠợỢùÙúÚủỦũŨụỤưƯừỪứỨửỬữỮựỰỳỲýÝỷỶỹỸỵỴđĐ̛̣̀́̃̉̆̂'::text, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaeeeeeeeeeeeeeeeeeeeeeeiiiiiiiiiioooooooooooooooooooooooooooooooooouuuuuuuuuuuuuuuuuuuuuuyyyyyyyyyydd'::text))")) @map("title_fold")
  contentFold    String?   @default(dbgenerated("lower(translate(COALESCE(content_text, ''::text), 'àÀáÁảẢãÃạẠăĂằẰắẮẳẲẵẴặẶâÂầẦấẤẩẨẫẪậẬèÈéÉẻẺẽẼẹẸêÊềỀếẾểỂễỄệỆìÌíÍỉỈĩĨịỊòÒóÓỏỎõÕọỌôÔồỒốỐổỔỗỖộỘơƠờỜớỚởỞỡỠợỢùÙúÚủỦũŨụỤưƯừỪứỨửỬữỮựỰỳỲýÝỷỶỹỸỵỴđĐ̛̣̀́̃̉̆̂'::text, 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaeeeeeeeeeeeeeeeeeeeeeeiiiiiiiiiioooooooooooooooooooooooooooooooooouuuuuuuuuuuuuuuuuuuuuuyyyyyyyyyydd'::text))")) @map("content_fold")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  project      WorkProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       WorkPage?           @relation("WorkPageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     WorkPage[]          @relation("WorkPageTree")
  owner        User?               @relation("WorkPageOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lastEditedBy User?               @relation("WorkPageEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  stage        WorkStage?          @relation(fields: [stageId], references: [id], onDelete: SetNull)
  versions     WorkPageVersion[]
  issueLinks   WorkPageIssueLink[]
  comments     WorkPageComment[]
  approvals    WorkApproval[]
  /// Đợt S5a: Problem có trang postmortem này.
  postmortemOf WorkDeskProblem[]
  /// Đợt S6: lịch sử chấm Spec Fidelity của trang.
  specReviews  WorkSpecReview[]
  /// CTW K-3b: trạng thái đồng soạn thảo (Yjs) + bình luận gắn đoạn văn.
  collab       WorkPageCollab?
  anchors      WorkPageAnchor[]

  @@unique([projectId, number], name: "uk_work_page_number", map: "uk_work_page_number")
  @@index([projectId, parentId, position], name: "idx_work_page_tree")
  @@index([stageId], name: "idx_work_page_stage")
  @@map("work_pages")
}

/// Bản chụp một trang. kind: CREATE | EDIT | RESTORE | MANUAL. Lưu liên tiếp của
/// CÙNG người trong vài phút gộp vào bản EDIT cuối (không sinh hàng trăm bản).
model WorkPageVersion {
  id          Int      @id @default(autoincrement())
  pageId      Int      @map("page_id")
  n           Int
  kind        String   @default("EDIT") @db.VarChar(16)
  title       String   @db.VarChar(255)
  contentJson Json?    @map("content_json")
  contentText String?  @map("content_text") @db.Text
  authorId    Int?     @map("author_id")
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  page   WorkPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author User?    @relation("WorkPageVersionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([pageId, n], name: "uk_work_page_version", map: "uk_work_page_version")
  @@map("work_page_versions")
}

/// Trang ↔ thẻ (hai chiều: trang thấy thẻ, thẻ thấy "Linked docs").
model WorkPageIssueLink {
  id          Int      @id @default(autoincrement())
  pageId      Int      @map("page_id")
  issueId     Int      @map("issue_id")
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  page      WorkPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  issue     WorkIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("WorkPageIssueLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([pageId, issueId], name: "uk_work_page_issue", map: "uk_work_page_issue")
  @@index([issueId], name: "idx_work_page_issue_issue")
  @@map("work_page_issue_links")
}

/// Bình luận trên trang (@nhắc tên ⇒ WORK_MENTION như bình luận thẻ).
model WorkPageComment {
  id        Int       @id @default(autoincrement())
  pageId    Int       @map("page_id")
  authorId  Int?      @map("author_id")
  bodyJson  Json      @map("body_json")
  bodyText  String    @map("body_text") @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")
  /// CTW đợt 5b K-1: trả lời theo luồng (một cấp) — như bình luận thẻ.
  parentId  Int?      @map("parent_id")

  page    WorkPage          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author  User?             @relation("WorkPageCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parent  WorkPageComment?  @relation("WorkPageCommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies WorkPageComment[] @relation("WorkPageCommentThread")
  /// CTW K-3b: bình luận gốc gắn vào một đoạn văn bản của trang.
  anchor  WorkPageAnchor?

  @@index([pageId, createdAt], name: "idx_work_page_comment_page")
  @@index([parentId], map: "idx_work_page_comment_parent")
  @@map("work_page_comments")
}

// ─── CT Work — CỔNG KHÁCH đợt S2b (04/10/2026, mô-đun `clientPortal`) ──────────

/// Một yêu cầu nghiệm thu (UAT sign-off) — đi kèm MỘT WorkApproval (targetType UAT)
/// mà người duyệt là khách. Hạng mục = thẻ clientVisible (id, chụp lúc tạo); tài liệu =
/// số trang CLIENT; tệp = id tệp clientVisible. `contentHash` của phê duyệt băm cả bộ
/// (approvalContent.ts uatContent). Từ chối ⇒ thẻ BUG/CR sinh ra ghi ở createdIssueIds.
model WorkUatRequest {
  id              Int      @id @default(autoincrement())
  projectId       Int      @map("project_id")
  approvalId      Int      @unique(map: "uk_work_uat_approval") @map("approval_id")
  versionId       Int?     @map("version_id")
  stageId         Int?     @map("stage_id")
  /// Lần nghiệm thu thứ mấy của cùng mốc (1, 2…) — để biên bản ghi "lần 2".
  round           Int      @default(1)
  environment     String?  @db.VarChar(200)
  build           String?  @db.VarChar(120)
  /// number[] — id thẻ (work_issues.id) là hạng mục nghiệm thu.
  itemIssueIds    Json     @default("[]") @map("item_issue_ids")
  /// number[] — số trang tài liệu (work_pages.number, visibility CLIENT).
  pageNumbers     Json     @default("[]") @map("page_numbers")
  /// number[] — id tệp (work_attachments.id, clientVisible).
  attachmentIds   Json     @default("[]") @map("attachment_ids")
  /// Khách duyệt CÓ ĐIỀU KIỆN: điều kiện ghi ở đây (và trên biên bản).
  conditions      String?  @db.Text
  /// number[] — thẻ BUG/CR tự sinh khi khách từ chối.
  createdIssueIds Json     @default("[]") @map("created_issue_ids")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project  WorkProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approval WorkApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  version  WorkVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  stage    WorkStage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([projectId], name: "idx_work_uat_project")
  @@map("work_uat_requests")
}

// ─── CT Work — QUẢN TRỊ DỰ ÁN đợt S3b (04/10/2026) ──────────────────────────
// Ba mô-đun: `changeRequests` (CR — PMBOK change control / PRINCE2 change authority),
// `raid` (sổ Risk · Assumption · Issue · Dependency), `meetings` (họp + biên bản +
// việc cần làm + lời mời .ics). Xem src/services/work/{changeRequests,raid,meetings}.service.ts.

/// Yêu cầu thay đổi (CR). Đối tượng RIÊNG — không phải loại thẻ (loại thẻ/JQL/board
/// giữ nguyên). status: DRAFT | SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | IMPLEMENTED.
/// Phân tích ảnh hưởng có cấu trúc (phạm vi, +ngày, chi phí số + đơn vị tự do, rủi ro,
/// phương án thay thế) là NỘI DUNG được băm khi duyệt (approvalContent.crContent).
/// `clientVisible` = đã chia sẻ cho khách (khách mới được đứng tên duyệt).
model WorkChangeRequest {
  id              Int       @id @default(autoincrement())
  projectId       Int       @map("project_id")
  number          Int
  title           String    @db.VarChar(255)
  status          String    @default("DRAFT") @db.VarChar(16)
  /// Mô tả (TipTap) — khung từ mẫu phieu-yeu-cau-thay-doi.md.
  descriptionJson Json?     @map("description_json")
  descriptionText String?   @map("description_text") @db.Text
  /// Lý do / giá trị kinh doanh.
  reason          String?   @db.Text
  /// LOW | MEDIUM | HIGH
  urgency         String    @default("MEDIUM") @db.VarChar(8)
  impactScope     String?   @map("impact_scope") @db.Text
  /// Số ngày lịch thêm (âm = sớm hơn). Null = chưa đánh giá.
  scheduleDays    Int?      @map("schedule_days")
  /// Chi phí — chỉ ghi lại, KHÔNG tính giá. Đơn vị tiền ghi tự do (VND, USD, man-day…).
  costAmount      Float?    @map("cost_amount")
  costCurrency    String?   @map("cost_currency") @db.VarChar(16)
  impactRisk      String?   @map("impact_risk") @db.Text
  alternatives    String?   @db.Text
  clientVisible   Boolean   @default(false) @map("client_visible")
  clientSharedAt  DateTime? @map("client_shared_at")
  requesterId     Int?      @map("requester_id")
  ownerId         Int?      @map("owner_id")
  createdById     Int?      @map("created_by_id")
  /// Thẻ gốc (vd yêu cầu CHANGE khách gửi qua cổng).
  sourceIssueId   Int?      @map("source_issue_id")
  submittedAt     DateTime? @map("submitted_at")
  decidedAt       DateTime? @map("decided_at")
  implementedAt   DateTime? @map("implemented_at")
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  project     WorkProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requester   User?                   @relation("WorkCrRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  owner       User?                   @relation("WorkCrOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy   User?                   @relation("WorkCrCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sourceIssue WorkIssue?              @relation("WorkCrSourceIssue", fields: [sourceIssueId], references: [id], onDelete: SetNull)
  links       WorkChangeRequestLink[]
  approvals   WorkApproval[]
  raidLinks   WorkRaidLink[]

  @@unique([projectId, number], name: "uk_work_cr_number", map: "uk_work_cr_number")
  @@index([projectId, status], name: "idx_work_cr_project")
  @@map("work_change_requests")
}

/// CR ↔ thẻ / giai đoạn / version. role: AFFECTED (bị ảnh hưởng) | IMPLEMENTS (thẻ thực hiện CR).
/// Đúng MỘT trong ba cột đích khác null (kiểm trong service).
model WorkChangeRequestLink {
  id              Int      @id @default(autoincrement())
  changeRequestId Int      @map("change_request_id")
  role            String   @default("AFFECTED") @db.VarChar(16)
  issueId         Int?     @map("issue_id")
  stageId         Int?     @map("stage_id")
  versionId       Int?     @map("version_id")
  createdById     Int?     @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  changeRequest WorkChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  issue         WorkIssue?        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  stage         WorkStage?        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  version       WorkVersion?      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  createdBy     User?             @relation("WorkCrLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([changeRequestId], name: "idx_work_cr_link_cr")
  @@index([issueId], name: "idx_work_cr_link_issue")
  @@map("work_change_request_links")
}

/// Một dòng sổ RAID. type: RISK | ASSUMPTION | ISSUE | DEPENDENCY.
/// status: OPEN | MONITORING | MITIGATED | CLOSED (Assumption: UNVALIDATED | VALIDATED | INVALID).
/// Điểm = probability (1–5) × impact (1–5) — tính khi đọc, không lưu.
/// response: AVOID | MITIGATE | TRANSFER | ACCEPT. `reviewNotifiedFor` = ngày xem lại đã nhắc (chống nhắc lặp).
model WorkRaidItem {
  id                Int       @id @default(autoincrement())
  projectId         Int       @map("project_id")
  number            Int
  type              String    @db.VarChar(16)
  title             String    @db.VarChar(255)
  description       String?   @db.Text
  /// Nhóm (Phạm vi · Lịch · Nguồn lực · Kỹ thuật… — theo so-dang-ky-rui-ro.md), chữ tự do.
  category          String?   @db.VarChar(60)
  ownerId           Int?      @map("owner_id")
  status            String    @db.VarChar(16)
  probability       Int?
  impact            Int?
  response          String?   @db.VarChar(16)
  mitigation        String?   @db.Text
  /// Dấu hiệu sớm (trigger).
  trigger           String?   @db.Text
  reviewDate        DateTime? @map("review_date") @db.Date
  reviewNotifiedFor DateTime? @map("review_notified_for") @db.Date
  /// Đợt S4: rủi ro được phép nêu trong BÁO CÁO TUẦN cho khách (chỉ tiêu đề + mức + hướng xử lý),
  /// và chỉ khi lịch báo cáo bật "include risks". Sổ RAID vẫn không bao giờ mở cho khách.
  clientVisible     Boolean   @default(false) @map("client_visible")
  createdById       Int?      @map("created_by_id")
  closedAt          DateTime? @map("closed_at")
  version           Int       @default(0)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  project   WorkProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner     User?             @relation("WorkRaidOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("WorkRaidCreator", fields: [createdById], references: [id], onDelete: SetNull)
  links     WorkRaidLink[]
  history   WorkRaidHistory[]
  /// CTW đợt 4 (A22): phần riêng của câu hỏi Q&A (type QUESTION).
  question  WorkRaidQuestion?

  @@unique([projectId, number], name: "uk_work_raid_number", map: "uk_work_raid_number")
  @@index([projectId, type, status], name: "idx_work_raid_project")
  @@index([reviewDate], name: "idx_work_raid_review")
  @@map("work_raid_items")
}

/// Dòng RAID ↔ thẻ / giai đoạn / CR (đúng một đích).
model WorkRaidLink {
  id              Int      @id @default(autoincrement())
  raidId          Int      @map("raid_id")
  issueId         Int?     @map("issue_id")
  stageId         Int?     @map("stage_id")
  changeRequestId Int?     @map("change_request_id")
  createdById     Int?     @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  raid          WorkRaidItem       @relation(fields: [raidId], references: [id], onDelete: Cascade)
  issue         WorkIssue?         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  stage         WorkStage?         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  changeRequest WorkChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  createdBy     User?              @relation("WorkRaidLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([raidId], name: "idx_work_raid_link_raid")
  @@index([issueId], name: "idx_work_raid_link_issue")
  @@map("work_raid_links")
}

/// Lịch sử thay đổi một dòng RAID (trường · từ · thành).
model WorkRaidHistory {
  id        Int      @id @default(autoincrement())
  raidId    Int      @map("raid_id")
  actorId   Int?     @map("actor_id")
  field     String   @db.VarChar(40)
  fromValue String?  @map("from_value") @db.Text
  toValue   String?  @map("to_value") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  raid  WorkRaidItem @relation(fields: [raidId], references: [id], onDelete: Cascade)
  actor User?        @relation("WorkRaidHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([raidId, createdAt], name: "idx_work_raid_history")
  @@map("work_raid_history")
}

/// Một cuộc họp. type: KICKOFF | DAILY | WEEKLY | DEMO | RETRO | STEERING | CLIENT | OTHER.
/// status: SCHEDULED | DONE | CANCELLED. Giờ lưu UTC + múi giờ IANA để hiển thị.
/// Chỉ LƯU link Meet/Zoom/Teams — không tự dựng gọi video. `sequence` tăng mỗi lần đổi
/// giờ/địa điểm (SEQUENCE của iCalendar). Khách thấy cuộc họp CÓ MỜI họ; biên bản chỉ khi
/// `minutesShared` (cổng khách).
model WorkMeeting {
  id              Int       @id @default(autoincrement())
  projectId       Int       @map("project_id")
  number          Int
  title           String    @db.VarChar(255)
  type            String    @default("OTHER") @db.VarChar(16)
  status          String    @default("SCHEDULED") @db.VarChar(16)
  startsAt        DateTime  @map("starts_at")
  endsAt          DateTime  @map("ends_at")
  timezone        String    @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  location        String?   @db.VarChar(255)
  meetingUrl      String?   @map("meeting_url") @db.VarChar(500)
  agendaJson      Json?     @map("agenda_json")
  agendaText      String?   @map("agenda_text") @db.Text
  minutesJson     Json?     @map("minutes_json")
  minutesText     String?   @map("minutes_text") @db.Text
  /// string[] — quyết định đã chốt.
  decisions       Json      @default("[]")
  minutesShared   Boolean   @default(false) @map("minutes_shared")
  minutesSharedAt DateTime? @map("minutes_shared_at")
  organizerId     Int?      @map("organizer_id")
  /// Cuộc họp trước trong chuỗi "Duplicate next week".
  previousId      Int?      @map("previous_id")
  sequence        Int       @default(0)
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  project   WorkProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizer User?                 @relation("WorkMeetingOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  previous  WorkMeeting?          @relation("WorkMeetingSeries", fields: [previousId], references: [id], onDelete: SetNull)
  next      WorkMeeting[]         @relation("WorkMeetingSeries")
  attendees WorkMeetingAttendee[]
  actions   WorkMeetingAction[]

  // ── CTW K-2 ── agenda có cấu trúc, link bản ghi hình ngoài (K12), mốc đã nhắc họp (K21), ghi âm + đề xuất biên bản AI.
  /// [{ id, title, presenterId, minutes, ref }] — ref = mã thẻ "FP-12" / trang "DOC-3" / URL.
  agendaItems   Json                      @default("[]") @map("agenda_items")
  recordingUrl  String?                   @map("recording_url") @db.VarChar(500)
  remindedAt    DateTime?                 @map("reminded_at")
  recordings    WorkMeetingRecording[]
  minutesDrafts WorkMeetingMinutesDraft[]
  // ── hết CTW K-2 ──

  @@unique([projectId, number], name: "uk_work_meeting_number", map: "uk_work_meeting_number")
  @@index([projectId, startsAt], name: "idx_work_meeting_project")
  @@map("work_meetings")
}

model WorkMeetingAttendee {
  id        Int      @id @default(autoincrement())
  meetingId Int      @map("meeting_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  // ── CTW K-2 ── RSVP (YES|NO|MAYBE + lý do) và điểm danh (PRESENT|LATE|EXCUSED|ABSENT; AUTO khi bấm "Vào họp" / MANUAL
  // khi chủ trì đánh dấu). `invited` = false ⇒ người tự vào họp không có lời mời (walk-in).
  invited          Boolean   @default(true)
  rsvp             String?   @db.VarChar(8)
  rsvpNote         String?   @map("rsvp_note") @db.VarChar(300)
  rsvpAt           DateTime? @map("rsvp_at")
  attendance       String?   @db.VarChar(8)
  attendanceSource String?   @map("attendance_source") @db.VarChar(6)
  markedById       Int?      @map("marked_by_id")
  joinedAt         DateTime? @map("joined_at")
  leftAt           DateTime? @map("left_at")
  // ── hết CTW K-2 ──

  meeting WorkMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User        @relation("WorkMeetingAttendeeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId], name: "uk_work_meeting_attendee", map: "uk_work_meeting_attendee")
  @@index([userId], name: "idx_work_meeting_attendee_user")
  @@map("work_meeting_attendees")
}

/// Việc cần làm từ biên bản. `issueId` = thẻ đã tạo từ việc này (nút "Create issues").
model WorkMeetingAction {
  id         Int       @id @default(autoincrement())
  meetingId  Int       @map("meeting_id")
  position   Int       @default(0)
  text       String    @db.VarChar(500)
  assigneeId Int?      @map("assignee_id")
  dueDate    DateTime? @map("due_date") @db.Date
  issueId    Int?      @map("issue_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  meeting  WorkMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  assignee User?       @relation("WorkMeetingActionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  issue    WorkIssue?  @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@index([meetingId, position], name: "idx_work_meeting_action")
  @@index([issueId], name: "idx_work_meeting_action_issue")
  @@map("work_meeting_actions")
}

// ─── CT Work — TÀI CHÍNH · BÁO CÁO · XUẤT TRỌN đợt S4 (04/10/2026) ───────────
// Mô-đun `finance` (đơn giá, timesheet tuần, ngân sách, chi phí, mốc thanh toán) và
// `reports` (báo cáo tuần cho khách tự động, steering, thuyết trình). Xuất trọn dự án
// (ZIP) không phải mô-đun — quyền ADMIN dự án. CHỈ THEO DÕI: không xuất hoá đơn (hoá đơn
// điện tử ở VN phải qua nhà cung cấp được cấp phép). Cột người (createdById, userId…) KHÔNG
// có FK tới users: số liệu kế toán phải sống lâu hơn tài khoản (như work_audit_logs).
// Xem src/services/work/{finance,financeRules,clientReports,projectExport}.ts.

/// Cấu hình tài chính một dự án: đơn vị tiền (VND mặc định, hoặc USD), giá trị hợp đồng (để
/// mốc thanh toán tính theo %), tổng ngân sách (null ⇒ tổng các dòng ngân sách).
/// `alertLevel` = ngưỡng cảnh báo vượt ngân sách đã báo (0 | 80 | 100) — chống báo lặp.
model WorkFinanceSettings {
  id            Int      @id @default(autoincrement())
  projectId     Int      @unique(map: "uk_work_finance_project") @map("project_id")
  currency      String   @default("VND") @db.VarChar(3)
  contractValue Float?   @map("contract_value")
  budgetTotal   Float?   @map("budget_total")
  alertLevel    Int      @default(0) @map("alert_level")
  updatedById   Int?     @map("updated_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("work_finance_settings")
}

/// Đơn giá theo giờ. scope: DEFAULT | ROLE (vai trong dự án) | TEAM (bộ phận) | USER (người).
/// Ưu tiên khi định giá một dòng giờ: USER → TEAM của thẻ → TEAM của người → ROLE → DEFAULT.
/// `effectiveFrom` null = áp dụng từ đầu; nhiều dòng cùng phạm vi ⇒ lấy dòng có ngày lớn nhất ≤ ngày làm.
model WorkRate {
  id            Int       @id @default(autoincrement())
  projectId     Int       @map("project_id")
  scope         String    @db.VarChar(8)
  projectRole   String?   @map("project_role") @db.VarChar(16)
  teamId        Int?      @map("team_id")
  userId        Int?      @map("user_id")
  hourlyRate    Float     @map("hourly_rate")
  effectiveFrom DateTime? @map("effective_from") @db.Date
  note          String?   @db.VarChar(200)
  createdById   Int?      @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    WorkTeam?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([projectId, scope], name: "idx_work_rate_project")
  @@map("work_rates")
}

/// Timesheet TUẦN (T2→CN giờ VN) của một người trong một dự án — chỉ có dòng khi đã nộp.
/// status: SUBMITTED | APPROVED | RETURNED | REOPENED. SUBMITTED/APPROVED ⇒ khoá ghi/xoá giờ của tuần.
/// Mở khoá tuần đã duyệt: ADMIN + lý do (audit) ⇒ REOPENED, dòng định giá bị xoá cho tới khi duyệt lại.
model WorkTimesheet {
  id           Int       @id @default(autoincrement())
  projectId    Int       @map("project_id")
  userId       Int       @map("user_id")
  userName     String    @map("user_name") @db.VarChar(120)
  weekStart    DateTime  @map("week_start") @db.Date
  status       String    @db.VarChar(16)
  totalMinutes Int       @default(0) @map("total_minutes")
  note         String?   @db.VarChar(1000)
  submittedAt  DateTime? @map("submitted_at")
  decidedAt    DateTime? @map("decided_at")
  decidedById  Int?      @map("decided_by_id")
  returnReason String?   @map("return_reason") @db.Text
  reopenedAt   DateTime? @map("reopened_at")
  reopenedById Int?      @map("reopened_by_id")
  reopenReason String?   @map("reopen_reason") @db.Text
  /// Chi phí đã chốt lúc duyệt (tổng cost các dòng) — null khi chưa duyệt.
  approvedCost Float?    @map("approved_cost")
  version      Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  project WorkProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines   WorkTimesheetLine[]

  @@unique([projectId, userId, weekStart], name: "uk_work_timesheet", map: "uk_work_timesheet")
  @@index([projectId, status], name: "idx_work_timesheet_project")
  @@map("work_timesheets")
}

/// Bản chụp giờ ĐÃ DUYỆT (một dòng / một worklog) + đơn giá áp lúc duyệt. Không FK tới
/// thẻ/worklog: thẻ bị chuyển dự án hay xoá thì số liệu kế toán đã duyệt vẫn đứng nguyên.
model WorkTimesheetLine {
  id          Int      @id @default(autoincrement())
  timesheetId Int      @map("timesheet_id")
  worklogId   Int?     @map("worklog_id")
  issueId     Int?     @map("issue_id")
  issueKey    String   @map("issue_key") @db.VarChar(24)
  issueTitle  String   @map("issue_title") @db.VarChar(255)
  teamId      Int?     @map("team_id")
  stageId     Int?     @map("stage_id")
  day         DateTime @db.Date
  minutes     Int
  rate        Float?
  rateSource  String?  @map("rate_source") @db.VarChar(16)
  cost        Float?
  note        String?  @db.VarChar(1000)

  timesheet WorkTimesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([timesheetId], name: "idx_work_timesheet_line")
  @@map("work_timesheet_lines")
}

/// Một dòng ngân sách (hạng mục). category: LABOR | EQUIPMENT | SERVICES | OTHER. Gắn giai đoạn tuỳ chọn.
model WorkBudgetLine {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  name      String   @db.VarChar(160)
  category  String   @default("LABOR") @db.VarChar(16)
  stageId   Int?     @map("stage_id")
  amount    Float
  position  Int      @default(0)
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  WorkProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage    WorkStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  expenses WorkExpense[]

  @@index([projectId], name: "idx_work_budget_line_project")
  @@map("work_budget_lines")
}

/// Chi phí khác nhập tay (thiết bị, dịch vụ ngoài, bản quyền, đi lại…). category: EQUIPMENT |
/// SERVICES | LICENSE | TRAVEL | OTHER.
model WorkExpense {
  id           Int      @id @default(autoincrement())
  projectId    Int      @map("project_id")
  spentOn      DateTime @map("spent_on") @db.Date
  category     String   @default("OTHER") @db.VarChar(16)
  description  String   @db.VarChar(500)
  vendor       String?  @db.VarChar(160)
  amount       Float
  budgetLineId Int?     @map("budget_line_id")
  stageId      Int?     @map("stage_id")
  createdById  Int?     @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project    WorkProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLine WorkBudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  stage      WorkStage?      @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([projectId, spentOn], name: "idx_work_expense_project")
  @@map("work_expenses")
}

/// Mốc thanh toán. Số tiền = `amount`, hoặc `percent` × giá trị hợp đồng. trigger: MANUAL | UAT |
/// STAGE_GATE — UAT của version/giai đoạn gắn được duyệt, hoặc cổng giai đoạn được duyệt ⇒ PLANNED → DUE.
/// status: PLANNED | DUE | INVOICED (số hoá đơn ghi TAY từ hệ thống hoá đơn bên ngoài) | PAID.
/// `clientVisible` = khách thấy mốc này trong cổng (tên, số tiền, hạn, trạng thái — không gì khác).
model WorkPaymentMilestone {
  id                    Int       @id @default(autoincrement())
  projectId             Int       @map("project_id")
  number                Int
  name                  String    @db.VarChar(160)
  percent               Float?
  amount                Float?
  trigger               String    @default("MANUAL") @db.VarChar(16)
  versionId             Int?      @map("version_id")
  stageId               Int?      @map("stage_id")
  dueDate               DateTime? @map("due_date") @db.Date
  status                String    @default("PLANNED") @db.VarChar(16)
  becameDueAt           DateTime? @map("became_due_at")
  triggeredByApprovalId Int?      @map("triggered_by_approval_id")
  invoiceNumber         String?   @map("invoice_number") @db.VarChar(80)
  invoicedAt            DateTime? @map("invoiced_at")
  paidAt                DateTime? @map("paid_at")
  clientVisible         Boolean   @default(false) @map("client_visible")
  note                  String?   @db.VarChar(1000)
  position              Int       @default(0)
  createdById           Int?      @map("created_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  project WorkProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version WorkVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  stage   WorkStage?   @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@unique([projectId, number], name: "uk_work_payment_number", map: "uk_work_payment_number")
  @@index([versionId], name: "idx_work_payment_version")
  @@index([stageId], name: "idx_work_payment_stage")
  @@map("work_payment_milestones")
}

/// Lịch báo cáo tuần cho khách (mô-đun reports + clientPortal). Thiếu dòng ⇒ mặc định
/// (bật, Thứ Sáu 16:00 giờ VN). weekday 1 = Thứ Hai … 7 = Chủ Nhật (ISO).
model WorkReportSchedule {
  id             Int       @id @default(autoincrement())
  projectId      Int       @unique(map: "uk_work_report_schedule_project") @map("project_id")
  /// CTW-3: mặc định TẮT — gửi ra ngoài là hành động đối ngoại; bật lần đầu phải xem trước + xác nhận.
  enabled        Boolean   @default(false)
  weekday        Int       @default(5)
  hour           Int       @default(16)
  timezone       String    @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  includeRisks   Boolean   @default(false) @map("include_risks")
  includeChanges Boolean   @default(true) @map("include_changes")
  updatedById    Int?      @map("updated_by_id")
  /// CTW-3: lần xác nhận bật đầu tiên (sau khi xem trước). Null = chưa ai xác nhận ⇒ bật phải kèm confirm.
  confirmedAt    DateTime? @map("confirmed_at")
  confirmedById  Int?      @map("confirmed_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("work_report_schedules")
}

/// Lịch sử báo cáo. kind: CLIENT_WEEKLY (khách đọc trong cổng khi clientVisible) | STEERING (nội bộ).
/// source: AUTO (cron, không LLM) | MANUAL (nhân viên gửi tay, có thể "AI polish").
/// `data` = dữ liệu dựng XÁC ĐỊNH lúc tạo (chụp lại, không đổi về sau). `autoKey` (vd "2026-W40")
/// chống gửi tự động hai lần một tuần — UNIQUE (projectId, autoKey), NULL không đụng nhau.
model WorkClientReport {
  id             Int       @id @default(autoincrement())
  projectId      Int       @map("project_id")
  number         Int
  kind           String    @db.VarChar(16)
  source         String    @db.VarChar(8)
  periodStart    DateTime  @map("period_start") @db.Date
  periodEnd      DateTime  @map("period_end") @db.Date
  title          String    @db.VarChar(200)
  data           Json
  bodyMarkdown   String?   @map("body_markdown") @db.Text
  aiPolished     Boolean   @default(false) @map("ai_polished")
  clientVisible  Boolean   @default(false) @map("client_visible")
  sentAt         DateTime? @map("sent_at")
  recipientCount Int       @default(0) @map("recipient_count")
  autoKey        String?   @map("auto_key") @db.VarChar(24)
  createdById    Int?      @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, number], name: "uk_work_client_report_number", map: "uk_work_client_report_number")
  @@unique([projectId, autoKey], name: "uk_work_client_report_auto", map: "uk_work_client_report_auto")
  @@index([projectId, kind, createdAt], name: "idx_work_client_report_project")
  @@map("work_client_reports")
}

/// Một lần XUẤT TRỌN dự án (ZIP: JSON đầy đủ + manifest tệp, tuỳ chọn kèm nội dung tệp).
/// status: QUEUED | RUNNING | DONE | FAILED | EXPIRED. Tệp nằm trên Cloudflare R2 — `filePath` giữ KEY R2
/// (`work-exports/<projectId>/<id>.zip`), KHÔNG BAO GIỜ đĩa VPS; tải qua link ký HMAC ⇒ presigned URL; hết
/// `expiresAt` thì cron xoá object. Chưa có nhập lại (restore) — định dạng mang `formatVersion` để sau này nhập được.
model WorkProjectExport {
  id              Int       @id @default(autoincrement())
  projectId       Int       @map("project_id")
  requestedById   Int?      @map("requested_by_id")
  status          String    @default("QUEUED") @db.VarChar(16)
  progress        Int       @default(0)
  stage           String?   @db.VarChar(120)
  includeFiles    Boolean   @default(false) @map("include_files")
  filePath        String?   @map("file_path") @db.VarChar(500)
  fileName        String?   @map("file_name") @db.VarChar(200)
  size            Int?
  tableCounts     Json?     @map("table_counts")
  attachmentCount Int       @default(0) @map("attachment_count")
  attachmentBytes Float     @default(0) @map("attachment_bytes")
  filesIncluded   Int       @default(0) @map("files_included")
  error           String?   @db.Text
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt], name: "idx_work_export_project")
  @@map("work_project_exports")
}

/// Đợt S5c — một lần NHẬP LẠI dự án từ ZIP xuất trọn (S4, formatVersion 1) vào không gian `workspaceId`.
/// Luôn tạo DỰ ÁN MỚI (projectId = dự án mới khi xong). UPLOADED (đã kiểm + chạy thử, ZIP nằm trên R2 ở `filePath`)
/// → QUEUED → RUNNING → DONE | FAILED; CANCELLED / EXPIRED (24 giờ không bấm nhập ⇒ xoá ZIP). Không FK (dòng nhật
/// ký sống độc lập với không gian/dự án/người) — projectImport.service.ts.
model WorkProjectImport {
  id            Int       @id @default(autoincrement())
  workspaceId   Int       @map("workspace_id")
  requestedById Int?      @map("requested_by_id")
  status        String    @default("UPLOADED") @db.VarChar(16)
  progress      Int       @default(0)
  stage         String?   @db.VarChar(120)
  /// Key R2 của ZIP đã tải lên (null sau khi nhập xong / huỷ / hết hạn).
  filePath      String?   @map("file_path") @db.VarChar(500)
  fileName      String?   @map("file_name") @db.VarChar(200)
  size          Int?
  sourceKey     String?   @map("source_key") @db.VarChar(10)
  sourceName    String?   @map("source_name") @db.VarChar(120)
  projectKey    String?   @map("project_key") @db.VarChar(10)
  projectName   String?   @map("project_name") @db.VarChar(120)
  projectId     Int?      @map("project_id")
  /// Chạy thử: số dòng từng bảng, ánh xạ người, bộ phận, tệp, cảnh báo.
  plan          Json?
  /// Kết quả: số dòng đã nhập / bỏ qua từng bảng.
  result        Json?
  error         String?   @db.Text
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")

  @@index([workspaceId, createdAt], name: "idx_work_import_workspace")
  @@index([status], name: "idx_work_import_status")
  @@map("work_project_imports")
}

/// Đợt S5a — cấu hình SERVICE DESK & SLA của một dự án (mô-đun `serviceDesk`). Một dòng/dự án; THIẾU dòng
/// ⇒ mặc định trong slaRules.ts (T2–T6 08:00–17:00 Asia/Ho_Chi_Minh, P1 30 phút/4 giờ …). JSON được chuẩn
/// hoá khi đọc (goalsOf / matrixOf / requestTypesOf) — giá trị sai kiểu rơi về mặc định, không bao giờ vỡ.
model WorkDeskSettings {
  id                Int      @id @default(autoincrement())
  projectId         Int      @unique(map: "uk_work_desk_settings_project") @map("project_id")
  timezone          String   @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  /// Ngày làm theo ISO (1 = Thứ Hai … 7 = Chủ nhật).
  workDays          Json     @default("[1,2,3,4,5]") @map("work_days")
  /// Phút từ 00:00 giờ địa phương; start < end.
  workStart         Int      @default(480) @map("work_start")
  workEnd           Int      @default(1020) @map("work_end")
  /// ["YYYY-MM-DD", …] — ngày lễ không tính giờ.
  holidays          Json     @default("[]")
  /// { P1: { firstResponseMin, resolutionMin, calendar: BUSINESS|ALWAYS }, … }
  goals             Json     @default("{}")
  /// Impact × Urgency ⇒ P: { HIGH: { HIGH: "P1", … }, … }
  matrix            Json     @default("{}")
  /// Loại yêu cầu (Incident / Service request / Question / Change) + trường form riêng.
  requestTypes      Json     @default("[]") @map("request_types")
  /// Trạng thái thẻ mà khi VÀO ⇒ tạm dừng đồng hồ ("Waiting for customer").
  pauseStatusIds    Json     @default("[]") @map("pause_status_ids")
  /// Trạng thái thẻ mà khi VÀO ⇒ tính là first response.
  responseStatusIds Json     @default("[]") @map("response_status_ids")
  atRiskPercent     Int      @default(75) @map("at_risk_percent")
  updatedById       Int?     @map("updated_by_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("work_desk_settings")
}

/// Đợt S5a — phần service desk của MỘT thẻ: loại yêu cầu, Impact × Urgency ⇒ `priority` P1–P4 (TÁCH khỏi
/// `work_issues.priority` 1–5 — SLA chỉ đọc cột này), người yêu cầu, câu trả lời form, chờ khách, first
/// response, CSAT. Trạng thái SLA LUÔN tính lại từ `work_sla_events` (slaRules.computeSla); các cột frStatus/resStatus…
/// chỉ là BẢN CHỤP gần nhất cho hàng đợi sắp xếp/lọc, cron 5 phút cập nhật. `frAlert`/`resAlert` = mức cảnh
/// báo đã gửi (0 · 1 AT_RISK · 2 BREACHED) — mỗi mốc báo đúng một lần. Cột người KHÔNG FK tới users.
model WorkDeskTicket {
  id                Int       @id @default(autoincrement())
  issueId           Int       @unique(map: "uk_work_desk_ticket_issue") @map("issue_id")
  /// INCIDENT | SERVICE_REQUEST | QUESTION | CHANGE
  requestType       String    @map("request_type") @db.VarChar(24)
  /// HIGH | MEDIUM | LOW
  impact            String    @db.VarChar(8)
  urgency           String    @db.VarChar(8)
  /// P1 | P2 | P3 | P4
  priority          String    @db.VarChar(2)
  /// PORTAL (khách gửi) | STAFF (nhân viên tạo / đưa thẻ vào desk)
  channel           String    @default("STAFF") @db.VarChar(8)
  requesterId       Int?      @map("requester_id")
  /// Câu trả lời các trường form của loại yêu cầu { key: value }.
  fields            Json      @default("{}")
  waiting           Boolean   @default(false)
  waitingSince      DateTime? @map("waiting_since")
  /// Trạng thái thẻ trước khi vào "chờ khách" — khách trả lời ⇒ đưa về (nếu luồng cho phép).
  statusBeforeWait  Int?      @map("status_before_wait")
  firstResponseAt   DateTime? @map("first_response_at")
  firstResponseById Int?      @map("first_response_by_id")
  frStatus          String    @default("ON_TRACK") @map("fr_status") @db.VarChar(12)
  resStatus         String    @default("ON_TRACK") @map("res_status") @db.VarChar(12)
  frDueAt           DateTime? @map("fr_due_at")
  resDueAt          DateTime? @map("res_due_at")
  frBreachedAt      DateTime? @map("fr_breached_at")
  resBreachedAt     DateTime? @map("res_breached_at")
  frAlert           Int       @default(0) @map("fr_alert")
  resAlert          Int       @default(0) @map("res_alert")
  slaCheckedAt      DateTime? @map("sla_checked_at")
  problemId         Int?      @map("problem_id")
  csatRequestedAt   DateTime? @map("csat_requested_at")
  csatRating        Int?      @map("csat_rating")
  csatComment       String?   @map("csat_comment") @db.Text
  csatAt            DateTime? @map("csat_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  issue   WorkIssue        @relation(fields: [issueId], references: [id], onDelete: Cascade)
  problem WorkDeskProblem? @relation(fields: [problemId], references: [id], onDelete: SetNull)
  events  WorkSlaEvent[]

  @@index([problemId], name: "idx_work_desk_ticket_problem")
  @@map("work_desk_tickets")
}

/// Đợt S5a — dòng sự kiện SLA (chỉ thêm, không sửa): START · PAUSE · RESUME · FIRST_RESPONSE · RESOLVE ·
/// REOPEN · PRIORITY (value = mức mới). Đủ để tính lại CHÍNH XÁC trạng thái SLA ở bất kỳ thời điểm nào.
model WorkSlaEvent {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  kind      String   @db.VarChar(16)
  at        DateTime
  value     String?  @db.VarChar(32)
  actorId   Int?     @map("actor_id")
  note      String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  ticket WorkDeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, at], name: "idx_work_sla_event_ticket")
  @@map("work_sla_events")
}

/// Đợt S5a — PROBLEM (ITIL 4 Problem management): nguyên nhân chung của nhiều Incident. Incident nối vào
/// qua `work_desk_tickets.problem_id`. "Create postmortem" ⇒ trang Docs (S2a) từ mẫu bao-cao-su-co-postmortem.md.
/// status: OPEN | INVESTIGATING | KNOWN_ERROR | RESOLVED | CLOSED. Nội bộ — khách không bao giờ thấy.
model WorkDeskProblem {
  id               Int       @id @default(autoincrement())
  projectId        Int       @map("project_id")
  number           Int
  title            String    @db.VarChar(255)
  description      String?   @db.Text
  status           String    @default("OPEN") @db.VarChar(16)
  rootCause        String?   @map("root_cause") @db.Text
  workaround       String?   @db.Text
  ownerId          Int?      @map("owner_id")
  postmortemPageId Int?      @map("postmortem_page_id")
  createdById      Int?      @map("created_by_id")
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  project    WorkProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  postmortem WorkPage?        @relation(fields: [postmortemPageId], references: [id], onDelete: SetNull)
  incidents  WorkDeskTicket[]

  @@unique([projectId, number], name: "uk_work_desk_problem_number", map: "uk_work_desk_problem_number")
  @@map("work_desk_problems")
}

/// KEY GIA HẠN hạn mức AI Code (02/10/2026) — mỗi hàng là MỘT lần người dùng
/// nhập đúng key do admin đặt (`services/agent/keyGiaHan.ts`). Cộng `soToken`
/// vào trần token của cửa sổ 5 giờ TRƯỢT, chỉ khi `phienBan` còn khớp với key
/// hiện hành — admin đổi/tắt key là mọi lần cấp cũ thôi tính ngay. KHÔNG nới
/// trần TIỀN (ví agent) — đó là lưới bảo vệ ví của chủ web.
model AgentQuotaGrant {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  soToken   Int      @map("so_token")
  phienBan  Int      @map("phien_ban")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], name: "idx_agent_quota_grant_user_created")
  @@map("agent_quota_grants")
}

// ============================================================
// CRM NHẸ CHO STUDIO (CT Work đợt S5b, 05/10/2026) — /admin/crm
// ============================================================
// Pipeline B2B tối giản (kiểu Pipedrive): tổ chức · người liên hệ · deal ·
// hoạt động · đề xuất có link khách chấp thuận. CHỈ ADMIN. Luật nghiệp vụ
// thuần ở src/services/crm/rules.ts; đồng bộ phiếu ↔ deal ở crm.service.ts.

model CrmOrganization {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
  industry  String?  @db.VarChar(120)
  /// Quy mô (chữ ngắn: "1-10", "11-50"…)
  size      String?  @db.VarChar(30)
  website   String?  @db.VarChar(300)
  /// Mã số thuế — tuỳ chọn
  taxCode   String?  @map("tax_code") @db.VarChar(20)
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contacts CrmContact[]
  deals    CrmDeal[]

  @@index([name], map: "idx_crm_org_name")
  @@map("crm_organizations")
}

/// Người liên hệ — dữ liệu cá nhân (Luật BVDLCN 91/2025/QH15 + NĐ 356/2025/NĐ-CP).
/// Ẩn danh hoá: xoá PII, đặt `anonymizedAt`, GIỮ số liệu deal.
model CrmContact {
  id               Int       @id @default(autoincrement())
  orgId            Int?      @map("org_id")
  name             String    @db.VarChar(120)
  title            String?   @db.VarChar(120)
  /// Luôn lưu chữ thường (ghép phiếu theo email).
  email            String?   @db.VarChar(254)
  phone            String?   @db.VarChar(30)
  /// EMAIL | PHONE | ZALO | MEETING | OTHER
  preferredChannel String?   @map("preferred_channel") @db.VarChar(20)
  /// Đồng ý được liên hệ / xử lý dữ liệu + thời điểm + nguồn bằng chứng.
  consent          Boolean   @default(false)
  consentAt        DateTime? @map("consent_at")
  consentSource    String?   @map("consent_source") @db.VarChar(120)
  note             String?   @db.Text
  anonymizedAt     DateTime? @map("anonymized_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  org        CrmOrganization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  deals      CrmDeal[]
  activities CrmActivity[]

  @@index([email], map: "idx_crm_contact_email")
  @@index([orgId], map: "idx_crm_contact_org")
  @@map("crm_contacts")
}

/// LEAD → QUALIFIED → DISCOVERY → PROPOSAL → NEGOTIATION → WON | LOST.
model CrmDeal {
  id               Int       @id @default(autoincrement())
  title            String    @db.VarChar(200)
  orgId            Int?      @map("org_id")
  contactId        Int?      @map("contact_id")
  /// id gói ở frontend/src/app/about/nhan-du-an/packages.ts
  packageId        String?   @map("package_id") @db.VarChar(40)
  /// Giá trị ƯỚC TÍNH do người nhập — hệ thống không tự tính.
  valueAmount      Decimal?  @map("value_amount") @db.Decimal(18, 2)
  currency         String    @default("VND") @db.VarChar(3)
  /// % ghi đè; null = theo giai đoạn (rules.ts STAGE_PROBABILITY).
  probability      Int?
  stage            String    @default("LEAD") @db.VarChar(20)
  lostReason       String?   @map("lost_reason") @db.Text
  expectedCloseAt  DateTime? @map("expected_close_at") @db.Date
  ownerId          Int?      @map("owner_id")
  source           String?   @db.VarChar(100)
  projectRequestId Int?      @unique(map: "uk_crm_deal_project_request") @map("project_request_id")
  isRoleplay       Boolean   @default(false) @map("is_roleplay")
  /// Bảng đánh giá phù hợp (checklist-danh-gia-phu-hop.md): điểm, rủi ro, quyết định go/no-go.
  qualification    Json?
  ndaSigned        Boolean   @default(false) @map("nda_signed")
  ndaSignedAt      DateTime? @map("nda_signed_at") @db.Date
  ndaFileKey       String?   @map("nda_file_key") @db.VarChar(500)
  ndaFileName      String?   @map("nda_file_name") @db.VarChar(255)
  stageChangedAt   DateTime  @default(now()) @map("stage_changed_at")
  wonAt            DateTime? @map("won_at")
  lostAt           DateTime? @map("lost_at")
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  org            CrmOrganization?     @relation(fields: [orgId], references: [id], onDelete: SetNull)
  contact        CrmContact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner          User?                @relation("CrmDealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  projectRequest ProjectRequest?      @relation(fields: [projectRequestId], references: [id], onDelete: SetNull)
  activities     CrmActivity[]
  proposals      CrmProposal[]
  stageChanges   CrmDealStageChange[]

  @@index([stage, updatedAt(sort: Desc)], map: "idx_crm_deal_stage")
  @@index([contactId], map: "idx_crm_deal_contact")
  @@index([orgId], map: "idx_crm_deal_org")
  @@map("crm_deals")
}

/// Lịch sử chuyển giai đoạn — nguồn của báo cáo chuyển đổi + chu kỳ.
model CrmDealStageChange {
  id        Int      @id @default(autoincrement())
  dealId    Int      @map("deal_id")
  fromStage String?  @map("from_stage") @db.VarChar(20)
  toStage   String   @map("to_stage") @db.VarChar(20)
  actorId   Int?     @map("actor_id")
  at        DateTime @default(now())

  deal CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, at], map: "idx_crm_stage_change_deal")
  @@map("crm_deal_stage_changes")
}

/// CALL | EMAIL | MEETING | NOTE | TASK — gắn deal và/hoặc contact.
model CrmActivity {
  id          Int       @id @default(autoincrement())
  dealId      Int?      @map("deal_id")
  contactId   Int?      @map("contact_id")
  type        String    @db.VarChar(10)
  subject     String    @db.VarChar(200)
  body        String?   @db.Text
  dueAt       DateTime? @map("due_at")
  done        Boolean   @default(false)
  doneAt      DateTime? @map("done_at")
  /// Đã báo admin "tới hạn" (cron) — đổi hạn thì xoá để báo lại.
  notifiedAt  DateTime? @map("notified_at")
  createdById Int?      @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  deal    CrmDeal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([dealId, createdAt], map: "idx_crm_activity_deal")
  @@index([contactId], map: "idx_crm_activity_contact")
  @@index([type, done, dueAt], map: "idx_crm_activity_due")
  @@map("crm_activities")
}

/// Đề xuất (de-xuat-giai-phap.md + bao-gia.md) — Markdown, có phiên bản.
/// DRAFT sửa được; SENT trở đi ĐÓNG BĂNG nội dung (hash), khách Accept/Decline qua link token.
model CrmProposal {
  id                Int       @id @default(autoincrement())
  dealId            Int       @map("deal_id")
  version           Int
  title             String    @db.VarChar(200)
  content           String    @db.Text
  /// DRAFT | SENT | ACCEPTED | REJECTED
  status            String    @default("DRAFT") @db.VarChar(10)
  token             String?   @unique(map: "uk_crm_proposal_token") @db.VarChar(64)
  tokenExpiresAt    DateTime? @map("token_expires_at")
  tokenRevokedAt    DateTime? @map("token_revoked_at")
  /// sha256 nội dung lúc gửi (rules.ts proposalHash).
  contentHash       String?   @map("content_hash") @db.VarChar(64)
  sentAt            DateTime? @map("sent_at")
  viewedAt          DateTime? @map("viewed_at")
  respondedAt       DateTime? @map("responded_at")
  responseName      String?   @map("response_name") @db.VarChar(120)
  responseNote      String?   @map("response_note") @db.Text
  responseIp        String?   @map("response_ip") @db.VarChar(64)
  responseUserAgent String?   @map("response_user_agent") @db.VarChar(500)
  createdById       Int?      @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  deal CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, version], name: "uk_crm_proposal_version", map: "uk_crm_proposal_version")
  @@map("crm_proposals")
}

// ─── CT Work — SPEC FIDELITY đợt S6 (05/10/2026) ──────────────────────────────

/// Một lần chấm "Spec Fidelity" (4 chiều: completeness · consistency · unambiguity · verifiability, 0–100) của MỘT
/// trang tài liệu (scope PAGE, gắn số phiên bản lúc chấm) hoặc MỘT tập thẻ REQUIREMENT/STORY (scope ISSUES — cả dự
/// án / một epic / một giai đoạn). `findings`: [{ id, dimension, severity, rule, ref, excerpt, why, suggestion,
/// rewrite?, target, source: rule|ai, status: open|applied|dismissed, appliedAt?, appliedById? }]. `untraced`: yêu cầu
/// không truy được tới test. `semantic`: OK | UNAVAILABLE (LLM lỗi — phần xác định vẫn đủ) | SKIPPED.
/// createdById KHÔNG FK (lịch sử sống lâu hơn tài khoản).
model WorkSpecReview {
  id            Int      @id @default(autoincrement())
  projectId     Int      @map("project_id")
  scope         String   @db.VarChar(16)
  pageId        Int?     @map("page_id")
  pageVersion   Int?     @map("page_version")
  stageId       Int?     @map("stage_id")
  epicNumber    Int?     @map("epic_number")
  scopeLabel    String   @map("scope_label") @db.VarChar(200)
  overall       Int
  completeness  Int
  consistency   Int
  unambiguity   Int
  verifiability Int
  itemCount     Int      @default(0) @map("item_count")
  findings      Json     @default("[]")
  untraced      Json     @default("[]")
  stats         Json     @default("{}")
  semantic      String   @default("SKIPPED") @db.VarChar(16)
  model         String?  @db.VarChar(120)
  createdById   Int?     @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  project   WorkProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page      WorkPage?      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  stage     WorkStage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  approvals WorkApproval[]

  @@index([projectId, scope, createdAt], name: "idx_work_spec_review_project")
  @@index([pageId, createdAt], name: "idx_work_spec_review_page")
  @@index([stageId, createdAt], name: "idx_work_spec_review_stage")
  @@map("work_spec_reviews")
}

// ─── CT Work — RESOURCES (06/10/2026, mô-đun `resources`) ───────────────────────
// Thư viện link của dự án: repo GitHub, Figma, tài liệu, âm thanh, Mixamo… xếp theo
// nhóm, ghim lên sidebar, mở một cú bấm. Luật thuần ở services/work/resourceRules.ts.

/// Nhóm tài nguyên (Source code · Docs · Design…). Nhóm mặc định tạo khi dự án mở mô-đun lần đầu.
model WorkResourceGroup {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  name      String   @db.VarChar(80)
  /// Emoji / ký hiệu ngắn hiện cạnh tên nhóm.
  icon      String?  @db.VarChar(16)
  /// Màu nhấn (#rrggbb).
  color     String?  @db.VarChar(16)
  rank      Int      @default(0)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   WorkProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resources WorkResource[]

  @@index([projectId, rank], name: "idx_work_resource_group_project")
  @@map("work_resource_groups")
}

/// Một link/tài nguyên. `createdById` KHÔNG FK (như WorkSpecReview) — link sống lâu hơn tài khoản.
model WorkResource {
  id              Int       @id @default(autoincrement())
  projectId       Int       @map("project_id")
  /// Null = "Ungrouped" (nhóm bị xoá ⇒ SetNull).
  groupId         Int?      @map("group_id")
  title           String    @db.VarChar(200)
  /// http / https / mailto, ≤ 2000 ký tự (resourceRules.normalizeUrl).
  url             String    @db.VarChar(2000)
  description     String?   @db.Text
  tags            String[]  @default([])
  /// Tự nhận từ URL: github, gitlab, figma, gdrive, gdocs, youtube, notion, unity, freesound, mixamo, polyhaven, mail, link…
  kind            String    @default("link") @db.VarChar(24)
  faviconUrl      String?   @map("favicon_url") @db.VarChar(500)
  pinned          Boolean   @default(false)
  pinnedToSidebar Boolean   @default(false) @map("pinned_to_sidebar")
  /// TEAM: chỉ đội làm · CLIENT: khách thấy qua cổng khách (/portal/resources).
  visibility      String    @default("TEAM") @db.VarChar(8)
  rank            Int       @default(0)
  createdById     Int?      @map("created_by_id")
  lastOpenedAt    DateTime? @map("last_opened_at")
  openCount       Int       @default(0) @map("open_count")
  /// OK | BROKEN | UNKNOWN — job kiểm link chết hằng tuần.
  linkStatus      String    @default("UNKNOWN") @map("link_status") @db.VarChar(8)
  checkedAt       DateTime? @map("checked_at")
  /// Xem trước (GitHub: stars, lastCommitAt, description, defaultBranch, fetchedAt) + ghi chú kiểm link.
  meta            Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project  WorkProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  group    WorkResourceGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  webLinks WorkIssueWebLink[]

  @@index([projectId, groupId, rank], name: "idx_work_resource_project")
  @@index([checkedAt], name: "idx_work_resource_checked")
  @@map("work_resources")
}

/// "Web links" trên thẻ: trỏ tới một Resource, HOẶC url + title gõ thẳng. url/title luôn được chép
/// (ảnh chụp) để link còn dùng được khi Resource bị xoá (resourceId ⇒ null).
model WorkIssueWebLink {
  id          Int      @id @default(autoincrement())
  issueId     Int      @map("issue_id")
  resourceId  Int?     @map("resource_id")
  url         String   @db.VarChar(2000)
  title       String   @db.VarChar(200)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  issue    WorkIssue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  resource WorkResource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([issueId], name: "idx_work_issue_web_link_issue")
  @@index([resourceId], name: "idx_work_issue_web_link_resource")
  @@map("work_issue_web_links")
}

// ── CTW đợt 3A ── (09/10/2026) TÀI LIỆU: ảnh trong trình soạn thảo ─────────────────────
/// Ảnh chèn vào RichEditor (trang Docs, mô tả thẻ, bình luận) — một dòng mỗi ảnh tải lên. Nội dung TipTap chỉ lưu
/// đường dẫn `/api/v1/work/projects/:pid/images/:id`; quyền xem ảnh = quyền xem dự án (kiểm mỗi lần tải).
/// Tệp nằm ở kho lưu trữ (R2 trên production) dưới `work/<pid>/img/…`. Trùng nội dung (sha256) trong cùng dự án ⇒ dùng lại dòng cũ.
/// uploaderId KHÔNG có khoá ngoại: xoá người dùng không được kéo theo ảnh đang nằm trong tài liệu của nhóm.
model WorkDocImage {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  uploaderId Int?     @map("uploader_id")
  r2Key      String   @map("r2_key") @db.VarChar(500)
  fileName   String   @map("file_name") @db.VarChar(255)
  mime       String   @db.VarChar(100)
  size       Int
  width      Int?
  height     Int?
  sha256     String   @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sha256], map: "idx_work_doc_image_project_sha")
  @@map("work_doc_images")
}

// ─── THƯ VIỆN SÁCH (/books) — tiến độ đọc theo người (05/10/2026) ───────────────
// App desktop có mục "Library" để đọc sách mỗi ngày: nhớ đọc tới đâu (đổi máy vẫn
// đọc tiếp), dấu trang, tổng phút đọc, mục tiêu phút/ngày + chuỗi ngày. Không FK tới
// users (cùng kiểu IeltsProgress) — xoá tài khoản thì dọn theo user_id.

/// Một cuốn sách một người đang đọc / đã đọc.
model BookReading {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  /// Tên tệp sách không đuôi, vd "09-git-from-zero-to-confident".
  slug       String    @db.VarChar(120)
  /// Chương đang đọc (chỉ số .chap-open, từ 0).
  chapter    Int       @default(0)
  /// Vị trí đọc trên CẢ cuốn, 0–100 (tỉ lệ cuộn) — mở lại là về đúng chỗ.
  percent    Float     @default(0)
  /// Tổng số giây đã đọc cuốn này (chỉ tính lúc cửa sổ đang mở và có tương tác).
  seconds    Int       @default(0)
  /// Dấu trang: [{ p: percent, c: chapter, t: tiêu đề chương, at: ISO }].
  bookmarks  Json?
  startedAt  DateTime  @default(now()) @map("started_at")
  lastReadAt DateTime  @default(now()) @map("last_read_at")
  /// Lần đầu cuộn tới ≥ 98% — "Đã đọc xong".
  finishedAt DateTime? @map("finished_at")

  @@unique([userId, slug], name: "uk_book_reading_user_slug", map: "uk_book_reading_user_slug")
  @@index([userId, lastReadAt], name: "idx_book_reading_user_last")
  @@map("book_readings")
}

/// Số giây đọc sách của một người trong MỘT ngày (giờ Việt Nam) — mục tiêu ngày + chuỗi ngày.
model BookReadingDay {
  id      Int    @id @default(autoincrement())
  userId  Int    @map("user_id")
  /// "YYYY-MM-DD" theo giờ Việt Nam.
  day     String @db.VarChar(10)
  seconds Int    @default(0)

  @@unique([userId, day], name: "uk_book_reading_day", map: "uk_book_reading_day")
  @@map("book_reading_days")
}

/// Ngày có học của một khoá kiểu sách (IELTS sach1, Dekiru, JP jp1, CH ch1) — chuỗi ngày học
/// liên tiếp + màn chào buổi sáng của CuongMini (05/10/2026). Một dòng = một người · một khoá · một ngày
/// (giờ Việt Nam); `soViec` đếm số lần ghi tiến độ bài/bài tập/luyện nói trong ngày đó.
model HocNgay {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  stage     String   @db.VarChar(12)
  /// "YYYY-MM-DD" theo giờ Việt Nam.
  day       String   @db.VarChar(10)
  soViec    Int      @default(1) @map("so_viec")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, stage, day], name: "uk_hoc_ngay", map: "uk_hoc_ngay")
  @@map("hoc_ngay")
}

/// Đối kháng realtime (05/10/2026) — một ván đã xong: cờ vua/cờ tướng/tiến lên/caro. Xem docs/doi-khang-spec.md.
model DoiKhangVan {
  id        Int      @id @default(autoincrement())
  tro       String   @db.VarChar(12)
  maPhong   String   @map("ma_phong") @db.VarChar(8)
  /// userId theo ghế; bot = 0.
  nguoiChoi Int[]    @map("nguoi_choi")
  coBot     Boolean  @default(false) @map("co_bot")
  ketQua    Json     @map("ket_qua")
  soNuoc    Int      @default(0) @map("so_nuoc")
  lichSu    Json     @map("lich_su")
  batDau    DateTime @map("bat_dau")
  ketThuc   DateTime @default(now()) @map("ket_thuc")

  @@index([nguoiChoi], type: Gin, map: "idx_doi_khang_van_nguoi")
  @@index([tro, ketThuc], map: "idx_doi_khang_van_tro")
  @@map("doi_khang_van")
}

/// Xếp hạng Elo theo trò (ván có bot không tính).
model DoiKhangHang {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tro       String   @db.VarChar(12)
  elo       Int      @default(1200)
  thang     Int      @default(0)
  thua      Int      @default(0)
  hoa       Int      @default(0)
  chuoi     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, tro], name: "uk_doi_khang_hang", map: "uk_doi_khang_hang")
  @@index([tro, elo], map: "idx_doi_khang_hang_elo")
  @@map("doi_khang_hang")
}

// ── CTW đợt 3C ── (09/10/2026) "Dùng được khi KHÔNG có Claude": agent DỰNG SẴN (runtime BUILTIN) chạy trên máy chủ.
// Trần tiền theo agent/ngày đã có sẵn (WorkAgent.dailyCostCapUsd, GĐ1); lượt chạy ghi ở WorkAgentRun (GĐ1, chưa từng
// có mã ghi); chi phí đo thật ghi WorkAgentUsage source GATEWAY. Ở đây chỉ THÊM trần chung của cả không gian.

/// Trần chi phí agent BUILTIN của một không gian (đặt trên trang AI agents). Không có dòng ⇒ mặc định an toàn trong mã
/// (builtinAgent.service BUILTIN_DEFAULTS). Không khoá ngoại tới work_spaces: chỉ-thêm, không đụng model WorkSpace.
model WorkBuiltinBudget {
  workspaceId Int      @id @map("workspace_id")
  /// Tổng USD/ngày (giờ VN) cho MỌI agent BUILTIN của không gian.
  dailyCapUsd Decimal  @default(10) @map("daily_cap_usd") @db.Decimal(10, 4)
  /// USD tối đa cho MỘT lượt chạy (một thẻ).
  runCapUsd   Decimal  @default(2) @map("run_cap_usd") @db.Decimal(10, 4)
  /// Số bước (lời gọi model) tối đa mỗi lượt.
  maxSteps    Int      @default(12) @map("max_steps")
  updatedById Int?     @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("work_builtin_budgets")
}

// ── hết CTW đợt 3C ──

// ── CTW đợt 4 ── (09/10/2026) SRS CÓ CẤU TRÚC & TRUY VẾT: actor / use case / business rule / màn hình / phân quyền màn
// (Report 3 FPT), liên kết truy vết tay (RTM), phần defect log của thẻ Bug (Severity…), Q&A log (RAID loại QUESTION).
// Mọi khoá ngoại tới work_issues: DEFERRABLE INITIALLY DEFERRED (luật 20260923131000_ct_work_issue_fk_deferred).

/// A6 — tác nhân (bảng "1.3.1 Actors" của Report 3). kind: PERSON (người dùng) | SYSTEM (hệ thống ngoài, timer…).
model WorkSrsActor {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  name        String   @db.VarChar(120)
  description String?  @db.Text
  kind        String   @default("PERSON") @db.VarChar(12)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project    WorkProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  primaryOf  WorkUseCase[]       @relation("WorkUseCasePrimaryActor")
  screenAuth WorkSrsScreenAuth[]

  @@unique([projectId, name], name: "uk_work_srs_actor_name", map: "uk_work_srs_actor_name")
  @@map("work_srs_actors")
}

/// A6 — một Use Case (UC-<number>): dòng bảng "1.3.2 Use Cases" + bảng đặc tả ở "2. Use Case Specifications".
/// Luồng (normal/alternative/exception) là chữ nhiều dòng đánh số như mẫu ("1. …", "2A. …", "3E. …").
/// status: PROPOSED (AI/agent đề xuất — chờ người duyệt, KHÔNG vào bản xuất) | DRAFT | APPROVED.
/// issueId: thẻ REQUIREMENT/STORY/EPIC mà UC đặc tả (truy vết RTM).
model WorkUseCase {
  id                Int      @id @default(autoincrement())
  projectId         Int      @map("project_id")
  number            Int
  name              String   @db.VarChar(200)
  feature           String?  @db.VarChar(120)
  primaryActorId    Int?     @map("primary_actor_id")
  /// Id tác nhân phụ (WorkSrsActor) — mảng, không FK (actor bị xoá ⇒ lọc khi đọc).
  secondaryActorIds Int[]    @default([]) @map("secondary_actor_ids")
  trigger           String?  @db.Text
  description       String?  @db.Text
  preconditions     String?  @db.Text
  postconditions    String?  @db.Text
  normalFlow        String?  @map("normal_flow") @db.Text
  alternativeFlows  String?  @map("alternative_flows") @db.Text
  exceptionFlows    String?  @map("exception_flows") @db.Text
  /// HIGH | MEDIUM | LOW
  priority          String   @default("MEDIUM") @db.VarChar(8)
  status            String   @default("DRAFT") @db.VarChar(10)
  issueId           Int?     @map("issue_id")
  aiModel           String?  @map("ai_model") @db.VarChar(80)
  createdById       Int?     @map("created_by_id")
  updatedById       Int?     @map("updated_by_id")
  version           Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  project      WorkProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  primaryActor WorkSrsActor?     @relation("WorkUseCasePrimaryActor", fields: [primaryActorId], references: [id], onDelete: SetNull)
  issue        WorkIssue?        @relation("WorkUseCaseIssue", fields: [issueId], references: [id], onDelete: SetNull)
  rules        WorkUseCaseRule[]

  @@unique([projectId, number], name: "uk_work_use_case_number", map: "uk_work_use_case_number")
  @@index([issueId], map: "idx_work_use_case_issue")
  @@map("work_use_cases")
}

/// A7 — sổ Business Rules (BR-<number>, bảng "5.1 Business Rules" của Report 3).
model WorkBusinessRule {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  number      Int
  name        String   @db.VarChar(200)
  definition  String?  @db.Text
  category    String?  @db.VarChar(60)
  status      String   @default("DRAFT") @db.VarChar(10)
  aiModel     String?  @map("ai_model") @db.VarChar(80)
  createdById Int?     @map("created_by_id")
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project  WorkProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  useCases WorkUseCaseRule[]

  @@unique([projectId, number], name: "uk_work_business_rule_number", map: "uk_work_business_rule_number")
  @@map("work_business_rules")
}

/// UC tham chiếu BR (nhiều–nhiều).
model WorkUseCaseRule {
  useCaseId Int @map("use_case_id")
  ruleId    Int @map("rule_id")

  useCase WorkUseCase      @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  rule    WorkBusinessRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@id([useCaseId, ruleId])
  @@index([ruleId], map: "idx_work_use_case_rule_rule")
  @@map("work_use_case_rules")
}

/// A6 — một màn hình (Screens Flow + hàng của ma trận Screen Authorization).
model WorkSrsScreen {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  name        String   @db.VarChar(160)
  feature     String?  @db.VarChar(120)
  description String?  @db.Text
  position    Int      @default(0)
  issueId     Int?     @map("issue_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project  WorkProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue    WorkIssue?          @relation("WorkSrsScreenIssue", fields: [issueId], references: [id], onDelete: SetNull)
  linksOut WorkSrsScreenLink[] @relation("WorkSrsScreenFrom")
  linksIn  WorkSrsScreenLink[] @relation("WorkSrsScreenTo")
  auth     WorkSrsScreenAuth[]

  @@unique([projectId, name], name: "uk_work_srs_screen_name", map: "uk_work_srs_screen_name")
  @@map("work_srs_screens")
}

/// Mũi tên của Screens Flow: từ màn này sang màn kia (nhãn = hành động).
model WorkSrsScreenLink {
  id     Int     @id @default(autoincrement())
  fromId Int     @map("from_id")
  toId   Int     @map("to_id")
  label  String? @db.VarChar(120)

  from WorkSrsScreen @relation("WorkSrsScreenFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   WorkSrsScreen @relation("WorkSrsScreenTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId], name: "uk_work_srs_screen_link", map: "uk_work_srs_screen_link")
  @@index([toId], map: "idx_work_srs_screen_link_to")
  @@map("work_srs_screen_links")
}

/// Ô "X" của ma trận Screen Authorization (màn × tác nhân).
model WorkSrsScreenAuth {
  screenId Int @map("screen_id")
  actorId  Int @map("actor_id")

  screen WorkSrsScreen @relation(fields: [screenId], references: [id], onDelete: Cascade)
  actor  WorkSrsActor  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@id([screenId, actorId])
  @@index([actorId], map: "idx_work_srs_screen_auth_actor")
  @@map("work_srs_screen_auth")
}

/// A6 — chức năng không giao diện (bảng "1.4.3 Non-UI Functions": Feature · System Function · Description).
model WorkSrsFunction {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  feature     String?  @db.VarChar(120)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  position    Int      @default(0)
  issueId     Int?     @map("issue_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue   WorkIssue?  @relation("WorkSrsFunctionIssue", fields: [issueId], references: [id], onDelete: SetNull)

  @@index([projectId, position], map: "idx_work_srs_function_project")
  @@map("work_srs_functions")
}

/// A19 — liên kết truy vết đặt TAY (bổ sung cho phần tự dò): nguồn (UC | ISSUE | BR) ⇒ đích
/// SRS | SDS (trang Docs số `pageNumber` + đề mục `heading`) · UNIT (hàm 5.1) · IT (module 5.2) · ST (workflow 5.3)
/// (`targetId`) · CODE (lớp.phương thức / đường dẫn ở `ref`). Đa hình ⇒ không FK tới nguồn/đích, chỉ tới dự án.
model WorkTraceLink {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  sourceKind  String   @map("source_kind") @db.VarChar(8)
  sourceId    Int      @map("source_id")
  targetKind  String   @map("target_kind") @db.VarChar(8)
  targetId    Int?     @map("target_id")
  pageNumber  Int?     @map("page_number")
  heading     String?  @db.VarChar(255)
  ref         String?  @db.VarChar(300)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sourceKind, sourceId], map: "idx_work_trace_link_source")
  @@map("work_trace_links")
}

/// A16 + B5 — phần DEFECT LOG của một thẻ Bug (sheet Defects của Project Tracking): Severity (khác Priority),
/// Activity (Review | UT | IT | ST | AT), Product (Software Package | Report1…7), Product details.
/// sourceReviewId/sourceFindingId: bug sinh từ một phát hiện của spec review (một chạm) — không FK (lịch sử).
model WorkDefectInfo {
  issueId         Int      @id @map("issue_id")
  projectId       Int      @map("project_id")
  severity        String?  @db.VarChar(10)
  activity        String?  @db.VarChar(8)
  product         String?  @db.VarChar(40)
  productDetails  String?  @map("product_details") @db.VarChar(300)
  sourceReviewId  Int?     @map("source_review_id")
  sourceFindingId String?  @map("source_finding_id") @db.VarChar(20)
  updatedAt       DateTime @updatedAt @map("updated_at")

  issue   WorkIssue   @relation("WorkDefectInfoIssue", fields: [issueId], references: [id], onDelete: Cascade)
  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "idx_work_defect_info_project")
  @@index([sourceReviewId], map: "idx_work_defect_info_review")
  @@map("work_defect_info")
}

/// A22 — phần riêng của dòng RAID loại QUESTION (Q&A log, sheet Q&A của Project Tracking): hỏi ai, ai hỏi,
/// ưu tiên, trả lời. Ngày = askedOn; hạn = WorkRaidItem.reviewDate; câu hỏi = WorkRaidItem.title.
model WorkRaidQuestion {
  raidId       Int       @id @map("raid_id")
  askedOn      DateTime  @map("asked_on") @db.Date
  askedBy      String?   @map("asked_by") @db.VarChar(120)
  askedTo      String?   @map("asked_to") @db.VarChar(120)
  /// LOW | MEDIUM | HIGH (đúng danh sách của mẫu).
  priority     String    @default("MEDIUM") @db.VarChar(8)
  answer       String?   @db.Text
  answeredAt   DateTime? @map("answered_at")
  answeredById Int?      @map("answered_by_id")

  raid WorkRaidItem @relation(fields: [raidId], references: [id], onDelete: Cascade)

  @@map("work_raid_questions")
}

// ── hết CTW đợt 4 ──

// ── CTW đợt 5b K-1 ── (10/10/2026) BÌNH LUẬN ĐẦY ĐỦ + VOICE NOTE: luồng trả lời (WorkComment.parentId,
// WorkPageComment.parentId), tệp trong bình luận (WorkAttachment.commentId/forComment) và phần riêng của voice note.

/// Voice note = một WorkAttachment (audio/*, nằm trong bình luận) + dòng này: độ dài và bản phiên âm (Groq Whisper
/// qua interview/voice/stt.ts). Phiên âm cũng được nối vào WorkComment.bodyText để JQL `text ~` / `comment ~` tìm được.
/// transcriptStatus: PENDING (chờ/đang chạy) · DONE · NO_SPEECH (Whisper không nghe ra lời / bị lọc bịa) ·
/// NO_KEY (máy chủ chưa có GROQ_API_KEY — vẫn lưu audio) · LIMIT (hết trần lượt/ngày của dự án) · FAILED.
model WorkVoiceNote {
  attachmentId     Int       @id @map("attachment_id")
  durationMs       Int       @map("duration_ms")
  transcriptStatus String    @default("PENDING") @map("transcript_status") @db.VarChar(12)
  transcript       String?   @db.Text
  /// Mã ISO-639-1 Whisper tự dò (vi/en/…).
  language         String?   @db.VarChar(12)
  transcribedAt    DateTime? @map("transcribed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  attachment WorkAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([transcriptStatus, transcribedAt], map: "idx_work_voice_note_status")
  @@map("work_voice_notes")
}

// ── hết CTW đợt 5b K-1 ──

// ── CTW K-3 ── (10/10/2026) KÊNH CHAT DỰ ÁN: #general tự có + kênh chủ đề (PUBLIC trong đội / PRIVATE theo thành viên /
// CLIENT với khách — mặc định không có, ADMIN bật). Quyền đi theo permissions.ts (chatRules.ts — hàm thuần): khách
// (CLIENT) và GUEST (trừ TEACHER) KHÔNG thấy kênh nội bộ. Tin nhắn markdown (chữ thô, client vẽ bằng react-markdown
// không HTML thô), @username, luồng trả lời một cấp, ghim, cảm xúc, tệp/ảnh/voice note (R2 + phiên âm Groq của K-1).

/// Một kênh của dự án. name = chữ thường không dấu (`general`, `frontend`…), duy nhất trong dự án.
/// kind: PUBLIC (mọi người của đội thấy) · PRIVATE (chỉ thành viên kênh — WorkChannelMember.explicit) ·
/// CLIENT (đội + khách của dự án). isGeneral = kênh #general tự sinh (không xoá/không đổi loại được).
/// callUrl/callStartedAt: "Gọi nhóm" gần nhất (Jitsi tự sinh hoặc link Meet dán vào) — dùng lại trong 4 giờ.
model WorkChannel {
  id            Int       @id @default(autoincrement())
  projectId     Int       @map("project_id")
  name          String    @db.VarChar(40)
  topic         String?   @db.VarChar(250)
  kind          String    @default("PUBLIC") @db.VarChar(12)
  isGeneral     Boolean   @default(false) @map("is_general")
  createdById   Int?      @map("created_by_id")
  callUrl       String?   @map("call_url") @db.VarChar(500)
  callStartedAt DateTime? @map("call_started_at")
  lastMessageAt DateTime? @map("last_message_at")
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  project   WorkProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?                @relation("WorkChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members   WorkChannelMember[]
  messages  WorkChannelMessage[]
  files     WorkChannelFile[]

  @@unique([projectId, name], map: "uk_work_channel_name")
  @@index([projectId], map: "idx_work_channel_project")
  @@map("work_channels")
}

/// Người ↔ kênh: thành viên tường minh của kênh PRIVATE (explicit = true) VÀ trạng thái riêng của MỌI người với mọi kênh
/// (dòng tạo lúc cần): tin đã đọc tới đâu, tắt tiếng tới khi nào, chế độ báo (DEFAULT | ALL | MENTIONS).
/// mutedUntil ≥ năm 2999 = "cho tới khi bật lại".
model WorkChannelMember {
  channelId  Int       @map("channel_id")
  userId     Int       @map("user_id")
  explicit   Boolean   @default(false)
  lastReadId Int       @default(0) @map("last_read_id")
  lastReadAt DateTime? @map("last_read_at")
  mutedUntil DateTime? @map("muted_until")
  notify     String    @default("DEFAULT") @db.VarChar(12)
  createdAt  DateTime  @default(now()) @map("created_at")

  channel WorkChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation("WorkChannelMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId], map: "idx_work_channel_member_user")
  @@map("work_channel_members")
}

/// Một tin. kind: USER · SYSTEM (gọi nhóm, tạo thẻ, đổi kênh — meta mô tả). body = markdown thô (≤ 8000 ký tự,
/// đã bỏ ký tự điều khiển). parentId = gốc luồng (một cấp). mentions = id người được @nhắc (đã lọc theo quyền xem kênh).
/// refs = liên kết nội bộ đã nhận ra (thẻ/Docs/test/họp) — xem trước được dựng LÚC ĐỌC theo quyền của người xem.
/// clientKey = khoá chống gửi trùng của hàng chờ ngoại tuyến (cùng tác giả + cùng khoá ⇒ trả lại tin cũ).
model WorkChannelMessage {
  id          Int       @id @default(autoincrement())
  channelId   Int       @map("channel_id")
  authorId    Int?      @map("author_id")
  kind        String    @default("USER") @db.VarChar(12)
  body        String    @db.Text
  parentId    Int?      @map("parent_id")
  replyCount  Int       @default(0) @map("reply_count")
  lastReplyAt DateTime? @map("last_reply_at")
  mentions    Int[]     @default([])
  refs        Json?
  meta        Json?
  pinnedAt    DateTime? @map("pinned_at")
  pinnedById  Int?      @map("pinned_by_id")
  clientKey   String?   @map("client_key") @db.VarChar(64)
  editedAt    DateTime? @map("edited_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  channel   WorkChannel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User?                 @relation("WorkChannelMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parent    WorkChannelMessage?   @relation("WorkChannelThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies   WorkChannelMessage[]  @relation("WorkChannelThread")
  reactions WorkChannelReaction[]
  files     WorkChannelFile[]

  @@unique([authorId, clientKey], map: "uk_work_channel_message_client_key")
  @@index([channelId, id], map: "idx_work_channel_message_channel")
  @@index([parentId], map: "idx_work_channel_message_parent")
  @@map("work_channel_messages")
}

/// Cảm xúc trên tin (mỗi người một lần mỗi emoji). Không sinh thông báo.
model WorkChannelReaction {
  id        Int      @id @default(autoincrement())
  messageId Int      @map("message_id")
  userId    Int      @map("user_id")
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  message WorkChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User               @relation("WorkChannelReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji], map: "uk_work_channel_reaction")
  @@map("work_channel_reactions")
}

/// Tệp / ảnh / voice note trong tin (R2 khoá `work/<dự án>/chat/<kênh>/…`). messageId null = bản nháp chưa gửi
/// (dọn sau 24 giờ). Voice note: durationMs + phiên âm (cùng trạng thái với WorkVoiceNote của K-1).
model WorkChannelFile {
  id               Int       @id @default(autoincrement())
  channelId        Int       @map("channel_id")
  messageId        Int?      @map("message_id")
  uploaderId       Int?      @map("uploader_id")
  r2Key            String    @map("r2_key") @db.VarChar(500)
  fileName         String    @map("file_name") @db.VarChar(255)
  mime             String    @db.VarChar(100)
  size             Int
  durationMs       Int?      @map("duration_ms")
  transcriptStatus String?   @map("transcript_status") @db.VarChar(12)
  transcript       String?   @db.Text
  language         String?   @db.VarChar(12)
  transcribedAt    DateTime? @map("transcribed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  channel  WorkChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message  WorkChannelMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploader User?               @relation("WorkChannelFileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([channelId], map: "idx_work_channel_file_channel")
  @@index([messageId], map: "idx_work_channel_file_message")
  @@index([transcriptStatus, transcribedAt], map: "idx_work_channel_file_stt")
  @@map("work_channel_files")
}

/// Cài đặt chat CHUNG của một người (đồng bộ web ↔ app desktop): tắt tiếng mọi kênh tới khi nào, chế độ báo
/// (ALL | MENTIONS), âm báo, thông báo hệ thống, email tóm tắt tin chưa đọc (mặc định TẮT — đi thư gộp 08:00 có sẵn).
/// Giờ im lặng dùng chung WorkNotifySetting.quietStart/quietEnd.
model WorkChatPref {
  userId       Int       @id @map("user_id")
  mutedUntil   DateTime? @map("muted_until")
  notify       String    @default("ALL") @db.VarChar(12)
  sound        Boolean   @default(true)
  desktop      Boolean   @default(true)
  emailDigest  Boolean   @default(false) @map("email_digest")
  lastDigestAt DateTime? @map("last_digest_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation("WorkChatPrefUser", fields: [userId], references: [id], onDelete: Cascade)

  @@map("work_chat_prefs")
}

// ── hết CTW K-3 ──

// ── CTW Đóng góp ── (10/10/2026) ĐÓNG GÓP & HIỆU SUẤT THÀNH VIÊN (A26 LOC thật, A27 đánh giá chéo). Bộ chỉ số tính TRỰC
// TIẾP từ dữ liệu sẵn có (contrib.service.ts) — chỉ thêm những gì dữ liệu cũ thiếu: commit/PR đủ (kể cả không nhắc mã thẻ)
// kèm dòng thêm/xoá, ánh xạ danh tính git ↔ người, và phiếu đánh giá chéo ẩn danh.

/// Một commit / PR nhận từ webhook GitHub/GitLab. Khác WorkDevActivity (chỉ commit NHẮC mã thẻ, gắn vào thẻ): bảng này
/// giữ MỌI commit của repo đã nối để đếm đóng góp code. additions/deletions/filesChanged = null khi webhook không gửi
/// (push của GitHub chỉ có danh sách tệp; số dòng chỉ có ở sự kiện pull_request). Người = suy LÚC ĐỌC từ
/// authorLogin/authorEmail/authorName qua WorkGitIdentity + khớp username/email — đổi ánh xạ không cần ghi lại dữ liệu.
model WorkDevContribution {
  id           Int      @id @default(autoincrement())
  projectId    Int      @map("project_id")
  /// GITHUB | GITLAB
  provider     String   @db.VarChar(8)
  /// COMMIT | PR
  kind         String   @db.VarChar(8)
  externalId   String   @map("external_id") @db.VarChar(200)
  repo         String?  @db.VarChar(200)
  title        String?  @db.VarChar(300)
  url          String?  @db.VarChar(500)
  /// PR: open | draft | merged | closed.
  state        String?  @db.VarChar(16)
  authorLogin  String?  @map("author_login") @db.VarChar(100)
  authorName   String?  @map("author_name") @db.VarChar(100)
  authorEmail  String?  @map("author_email") @db.VarChar(200)
  additions    Int?
  deletions    Int?
  filesChanged Int?     @map("files_changed")
  /// Số thẻ (KEY-n) nhắc trong commit/PR — cho chế độ xem theo task.
  issueNumbers Int[]    @default([]) @map("issue_numbers")
  occurredAt   DateTime @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind, externalId], map: "uk_work_dev_contribution")
  @@index([projectId, occurredAt], map: "idx_work_dev_contribution_project")
  @@map("work_dev_contributions")
}

/// Ánh xạ tay "danh tính git" (login / email / tên tác giả, chữ thường) ⇒ người trong dự án. Trưởng nhóm gán khi commit
/// không tự khớp được (vd tên máy "DESKTOP-ABC" hay email cá nhân khác email tài khoản).
model WorkGitIdentity {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  identity    String   @db.VarChar(200)
  userId      Int      @map("user_id")
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User        @relation("WorkGitIdentityUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, identity], map: "uk_work_git_identity")
  @@index([userId], map: "idx_work_git_identity_user")
  @@map("work_git_identities")
}

/// Một đợt đánh giá chéo (theo sprint / giai đoạn / khoảng tuỳ chọn). status: OPEN (đang nhận phiếu) | CLOSED.
/// criteria = [{ key, label, description }] (4–5 tiêu chí, thang 1–5). sprintId/stageId chỉ để hiển thị — không FK
/// (xoá sprint không xoá phiếu đã chấm).
model WorkPeerRound {
  id          Int       @id @default(autoincrement())
  projectId   Int       @map("project_id")
  title       String    @db.VarChar(160)
  /// SPRINT | STAGE | CUSTOM
  scope       String    @default("CUSTOM") @db.VarChar(12)
  sprintId    Int?      @map("sprint_id")
  stageId     Int?      @map("stage_id")
  status      String    @default("OPEN") @db.VarChar(12)
  criteria    Json      @default("[]")
  closesAt    DateTime? @map("closes_at")
  closedAt    DateTime? @map("closed_at")
  createdById Int?      @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project WorkProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviews WorkPeerReview[]

  @@index([projectId, createdAt], map: "idx_work_peer_round_project")
  @@map("work_peer_rounds")
}

/// Phiếu của MỘT người chấm cho MỘT người được chấm trong một đợt. scores = { <criterion key>: 1..5 }.
/// reviewerId KHÔNG BAO GIỜ trả ra API (ẩn danh với mọi vai, kể cả trưởng nhóm) — chỉ dùng để sửa phiếu của chính mình
/// và đếm ai đã nộp.
model WorkPeerReview {
  id          Int      @id @default(autoincrement())
  roundId     Int      @map("round_id")
  reviewerId  Int      @map("reviewer_id")
  revieweeId  Int      @map("reviewee_id")
  scores      Json     @default("{}")
  comment     String?  @db.Text
  submittedAt DateTime @default(now()) @map("submitted_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  round    WorkPeerRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  reviewer User          @relation("WorkPeerReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User          @relation("WorkPeerReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([roundId, reviewerId, revieweeId], map: "uk_work_peer_review")
  @@index([roundId, revieweeId], map: "idx_work_peer_review_reviewee")
  @@index([reviewerId], map: "idx_work_peer_review_reviewer")
  @@index([revieweeId], map: "idx_work_peer_review_reviewee_user")
  @@map("work_peer_reviews")
}

// ── hết CTW Đóng góp ──

// ── CTW Diagram ── (10/10/2026) DIAGRAM STUDIO + AI VẼ SƠ ĐỒ: sơ đồ của dự án (Mermaid hoặc Excalidraw), mỗi lần lưu
// là một PHIÊN BẢN (khôi phục được), bình luận trên sơ đồ, AI vẽ từ CHÍNH dữ liệu dự án (UC/actor/BR/màn/workflow/repo)
// kèm kiểm tra "mọi thực thể có nguồn" (origin.sources/assumptions). Sơ đồ ĐÃ DUYỆT (approvedVersion) mới vào Report 3/4;
// khối nhúng trong trang Docs trỏ tới sơ đồ bằng dòng đầu `%% ctw-diagram:<id>@latest|@<v>` (Mermaid) hoặc alt ảnh
// (Excalidraw) — đổi phiên bản ⇒ trang được cập nhật. Liên kết thẻ/UC/trang KHÔNG có FK (đa nguồn, lọc khi đọc).

/// Một sơ đồ (D-<number>). format: MERMAID | EXCALIDRAW. diagramType: SEQUENCE | USE_CASE | ERD | CLASS | ACTIVITY |
/// STATE | DEPLOYMENT | ARCHITECTURE | DATA_FLOW | SWIMLANE | GANTT | JOURNEY | TIMELINE | MINDMAP | SCREEN_FLOW |
/// FLOWCHART | WHITEBOARD | OTHER. status: PROPOSED (AI/agent vẽ — chờ người duyệt) | DRAFT | APPROVED.
model WorkDiagram {
  id              Int       @id @default(autoincrement())
  projectId       Int       @map("project_id")
  number          Int
  format          String    @default("MERMAID") @db.VarChar(12)
  diagramType     String    @map("diagram_type") @db.VarChar(16)
  title           String    @db.VarChar(200)
  description     String?   @db.Text
  /// Nhóm chức năng (Report 4 "2.n <Feature>") — lấy từ UC khi AI vẽ, người sửa được.
  feature         String?   @db.VarChar(120)
  status          String    @default("DRAFT") @db.VarChar(10)
  /// Số phiên bản đang hiện (WorkDiagramVersion.number).
  currentVersion  Int       @default(1) @map("current_version")
  /// Phiên bản người đã duyệt — bản này (không phải bản nháp mới hơn) đi vào Report 3/4.
  approvedVersion Int?      @map("approved_version")
  issueId         Int?      @map("issue_id")
  useCaseId       Int?      @map("use_case_id")
  pageNumber      Int?      @map("page_number")
  aiModel         String?   @map("ai_model") @db.VarChar(80)
  createdById     Int?      @map("created_by_id")
  updatedById     Int?      @map("updated_by_id")
  /// Khoá lạc quan (tăng mỗi lần ghi).
  rev             Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  project  WorkProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions WorkDiagramVersion[]
  comments WorkDiagramComment[]

  @@unique([projectId, number], name: "uk_work_diagram_number", map: "uk_work_diagram_number")
  @@index([projectId, diagramType], map: "idx_work_diagram_type")
  @@index([useCaseId], map: "idx_work_diagram_use_case")
  @@map("work_diagrams")
}

/// Một phiên bản của sơ đồ. state: ACCEPTED (đã/đang là bản hiện hành) | PROPOSED (AI/agent đề xuất sửa một sơ đồ đã
/// có — chờ người nhận) | DISCARDED. origin = { generator, sources[], assumptions[], checks } khi AI vẽ / nhập tệp.
/// previewImageId = WorkDocImage PNG xem trước (Excalidraw — để nhúng vào Docs/xuất Word).
model WorkDiagramVersion {
  id             Int      @id @default(autoincrement())
  diagramId      Int      @map("diagram_id")
  number         Int
  source         String   @db.Text
  note           String?  @db.VarChar(300)
  state          String   @default("ACCEPTED") @db.VarChar(10)
  origin         Json?
  previewImageId Int?     @map("preview_image_id")
  authorId       Int?     @map("author_id")
  aiModel        String?  @map("ai_model") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at")

  diagram WorkDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  @@unique([diagramId, number], name: "uk_work_diagram_version", map: "uk_work_diagram_version")
  @@map("work_diagram_versions")
}

/// Bình luận trên sơ đồ — gắn được vào phiên bản và một phần tử (anchor = tên participant/entity/nút), trả lời theo luồng.
model WorkDiagramComment {
  id            Int       @id @default(autoincrement())
  diagramId     Int       @map("diagram_id")
  authorId      Int?      @map("author_id")
  parentId      Int?      @map("parent_id")
  versionNumber Int?      @map("version_number")
  anchor        String?   @db.VarChar(160)
  body          String    @db.Text
  resolvedAt    DateTime? @map("resolved_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  diagram WorkDiagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)

  @@index([diagramId, createdAt], map: "idx_work_diagram_comment")
  @@map("work_diagram_comments")
}

// ── hết CTW Diagram ──

// ── CTW đợt 5 ── (10/10/2026) GIẢNG VIÊN & LỚP HỌC: lớp (mã lớp/link mời, danh sách MSSV, nhóm ⇒ dự án theo mẫu môn),
// rubric chấm của giảng viên + điểm theo mốc (nhóm / từng thành viên, công bố mới thấy, lịch sử), và việc định kỳ
// (luật tự động trigger `scheduled.recurring` ⇒ chống tạo trùng bằng `dedup_key`). Mỗi nhóm ở KHÔNG GIAN RIÊNG của nhóm
// (giảng viên vào với vai GUEST + TEACHER dự án) ⇒ nhóm khác không thấy nhau; hub giảng viên đọc xuyên không gian.

/// Một lớp học phần (vd SWP391 · SE1840 · FA26). joinCode = mã lớp người dùng gõ (8 ký tự, không lẫn 0/O/1/I) — lưu
/// trần vì giảng viên cần xem lại; đổi mã = tạo mã mới (mã cũ hết hiệu lực ngay). teacherEmail: lớp do trưởng nhóm tạo
/// ⇒ giảng viên nhận vai khi tự mở link bằng đúng email này.
model WorkClass {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(120)
  /// SWP391 | SWT301 | SWR302 | SEP490 | ISP490 | OTHER — quyết định mẫu dự án của nhóm.
  subject       String    @db.VarChar(16)
  classCode     String    @map("class_code") @db.VarChar(32)
  term          String    @db.VarChar(16)
  ownerId       Int       @map("owner_id")
  teacherId     Int?      @map("teacher_id")
  teacherEmail  String?   @map("teacher_email") @db.VarChar(100)
  joinCode      String    @unique(map: "uk_work_class_join_code") @map("join_code") @db.VarChar(16)
  joinExpiresAt DateTime? @map("join_expires_at")
  joinOpen      Boolean   @default(true) @map("join_open")
  maxGroupSize  Int       @default(6) @map("max_group_size")
  timezone      String    @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  week1Start    DateTime? @map("week1_start") @db.Date
  archivedAt    DateTime? @map("archived_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  owner    User               @relation("WorkClassOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  teacher  User?              @relation("WorkClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  groups   WorkClassGroup[]
  students WorkClassStudent[]

  @@index([ownerId], map: "idx_work_class_owner")
  @@index([teacherId], map: "idx_work_class_teacher")
  @@map("work_classes")
}

/// Một nhóm trong lớp ⇒ đúng một dự án (ở không gian riêng của nhóm). projectId null = dự án đã bị xoá.
model WorkClassGroup {
  id        Int      @id @default(autoincrement())
  classId   Int      @map("class_id")
  number    Int
  name      String   @db.VarChar(80)
  projectId Int?     @unique(map: "uk_work_class_group_project") @map("project_id")
  leaderId  Int?     @map("leader_id")
  createdAt DateTime @default(now()) @map("created_at")

  class    WorkClass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  project  WorkProject?       @relation("WorkClassGroupProject", fields: [projectId], references: [id], onDelete: SetNull)
  students WorkClassStudent[]

  @@unique([classId, number], map: "uk_work_class_group_number")
  @@map("work_class_groups")
}

/// Một sinh viên của lớp: dòng nhập từ danh sách (ROSTER: MSSV/họ tên/email, chưa có tài khoản cũng được) hoặc tự vào
/// bằng mã (JOIN). Vào lớp bằng tài khoản có email trùng dòng ROSTER ⇒ gắn vào đúng dòng đó (không sinh dòng mới).
model WorkClassStudent {
  id          Int       @id @default(autoincrement())
  classId     Int       @map("class_id")
  userId      Int?      @map("user_id")
  email       String?   @db.VarChar(100)
  studentCode String?   @map("student_code") @db.VarChar(20)
  fullName    String?   @map("full_name") @db.VarChar(120)
  groupId     Int?      @map("group_id")
  source      String    @default("ROSTER") @db.VarChar(8)
  invitedAt   DateTime? @map("invited_at")
  inviteCount Int       @default(0) @map("invite_count")
  joinedAt    DateTime? @map("joined_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  class WorkClass       @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User?           @relation("WorkClassStudentUser", fields: [userId], references: [id], onDelete: SetNull)
  group WorkClassGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([classId, email], map: "uk_work_class_student_email")
  @@unique([classId, userId], map: "uk_work_class_student_user")
  @@unique([classId, studentCode], map: "uk_work_class_student_code")
  @@index([userId], map: "idx_work_class_student_user")
  @@map("work_class_students")
}

/// Rubric chấm của MỘT giảng viên (dùng lại cho mọi nhóm). criteria = [{ key, name, weight, description, levels: [{ score,
/// label, description }] }] — trọng số cộng 100. scaleMax = thang điểm (10).
model WorkRubric {
  id          Int       @id @default(autoincrement())
  /// Người tạo. NULL = tài khoản người tạo đã bị xoá (QA 10/10, P2-2): rubric MỒ CÔI vẫn sống vì `WorkGrade.rubric`
  /// là Restrict — xoá rubric theo người (Cascade như trước) làm admin xoá giảng viên ra P2003, còn đổi điểm sang
  /// Cascade thì mất ĐIỂM ĐÃ CÔNG BỐ của sinh viên. SET NULL giữ nguyên điểm + lịch sử; rubric mồ côi không ai sửa
  /// được (mọi lối sửa lọc `ownerId = userId`) nhưng vẫn hiện kèm điểm và giảng viên khác của dự án vẫn chấm tiếp được.
  ownerId     Int?      @map("owner_id")
  name        String    @db.VarChar(120)
  subject     String?   @db.VarChar(16)
  description String?   @db.Text
  criteria    Json      @default("[]")
  scaleMax    Float     @default(10) @map("scale_max")
  templateKey String?   @map("template_key") @db.VarChar(32)
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner  User?       @relation("WorkRubricOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  grades WorkGrade[]

  @@index([ownerId], map: "idx_work_rubric_owner")
  @@map("work_rubrics")
}

/// Điểm theo MỐC (milestone = "SWP-M1", "Report 3"…; stageId gắn giai đoạn nếu có, không FK) cho cả nhóm (subjectKey
/// 'TEAM') hoặc một thành viên ('U<userId>'). Sinh viên chỉ thấy khi publishedAt khác null. graderId / subjectUserId
/// không FK — như nhật ký, người rời dự án thì điểm đã chấm vẫn đứng.
model WorkGrade {
  id            Int       @id @default(autoincrement())
  projectId     Int       @map("project_id")
  rubricId      Int       @map("rubric_id")
  milestone     String    @db.VarChar(80)
  stageId       Int?      @map("stage_id")
  subjectKey    String    @map("subject_key") @db.VarChar(24)
  subjectUserId Int?      @map("subject_user_id")
  scores        Json      @default("{}")
  notes         Json      @default("{}")
  comment       String?   @db.Text
  total         Float?
  graderId      Int       @map("grader_id")
  publishedAt   DateTime? @map("published_at")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  project WorkProject        @relation("WorkGradeProject", fields: [projectId], references: [id], onDelete: Cascade)
  rubric  WorkRubric         @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  history WorkGradeHistory[]

  @@unique([projectId, rubricId, milestone, subjectKey], map: "uk_work_grade_subject")
  @@map("work_grades")
}

/// Lịch sử điểm: mỗi lần lưu / công bố / thu hồi một dòng (bản chụp điểm + nhận xét lúc đó).
model WorkGradeHistory {
  id          Int       @id @default(autoincrement())
  gradeId     Int       @map("grade_id")
  action      String    @db.VarChar(12)
  scores      Json      @default("{}")
  total       Float?
  comment     String?   @db.Text
  publishedAt DateTime? @map("published_at")
  actorId     Int       @map("actor_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  grade WorkGrade @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@index([gradeId, createdAt], map: "idx_work_grade_history")
  @@map("work_grade_history")
}

/// Việc định kỳ (C12): mỗi lần luật `scheduled.recurring` tạo thẻ ghi một dòng với dedup_key = "rec:<ruleId>:<ngày>"
/// (UNIQUE) — hai tiến trình cùng chạy / chạy lại sau sự cố cũng không bao giờ tạo trùng thẻ cho cùng một lần lặp.
model WorkRecurringRun {
  id         Int      @id @default(autoincrement())
  ruleId     Int      @map("rule_id")
  dedupKey   String   @unique(map: "uk_work_recurring_dedup") @map("dedup_key") @db.VarChar(120)
  occurrence String   @db.VarChar(10)
  issueId    Int?     @map("issue_id")
  createdAt  DateTime @default(now()) @map("created_at")

  rule WorkAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt], map: "idx_work_recurring_run_rule")
  @@map("work_recurring_runs")
}

// ── hết CTW đợt 5 ──

// ── CTW đợt 4b ── (10/10/2026) SWR302 — HỒ SƠ WIEGERS + DỮ LIỆU & SÁU LIÊN KẾT (rà soát R4/R5/R6/R12/R16/R23/R27):
// sổ Feature FE-n (gốc của chuỗi FE → UC → FR), phân loại + thuộc tính + vòng đời của thẻ REQUIREMENT (lịch sử ghi vào
// work_history của thẻ), bảng ưu tiên Wiegers (benefit/penalty/cost/risk + trọng số), Glossary, Data Dictionary (phần tử
// nguyên thuỷ + cấu trúc "A + B + 1:n{C}"), cấu hình SWR của dự án (trọng số, số đếm đã khai trong Estimation Tool, danh từ
// bỏ qua khi kiểm liên kết #4). Liên kết feature ↔ UC/thẻ đa hình (không FK tới đích, lọc khi đọc) như work_trace_links.

/// R5 — một Feature (FE-<number>) của Vision & Scope §2.1. scope: IN (trong phạm vi) | OUT (Limitations & Exclusions §2.4).
/// versionId = bản phát hành (WorkVersion) của feature — KHÔNG FK (bản phát hành bị xoá ⇒ coi như chưa xếp, lọc khi đọc).
/// epicIssueId = epic hiện thực feature — KHÔNG FK (thẻ xoá mềm). priority: HIGH | MEDIUM | LOW.
model WorkFeature {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  number      Int
  name        String   @db.VarChar(160)
  description String?  @db.Text
  scope       String   @default("IN") @db.VarChar(4)
  priority    String?  @db.VarChar(8)
  versionId   Int?     @map("version_id")
  epicIssueId Int?     @map("epic_issue_id")
  position    Int      @default(0)
  createdById Int?     @map("created_by_id")
  rev         Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project WorkProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links   WorkFeatureLink[]

  @@unique([projectId, number], name: "uk_work_feature_number", map: "uk_work_feature_number")
  @@map("work_features")
}

/// FE-n ⇒ đích: UC (WorkUseCase.id) | ISSUE (WorkIssue.id — yêu cầu/story/epic). Đa hình ⇒ không FK tới đích.
model WorkFeatureLink {
  id        Int      @id @default(autoincrement())
  featureId Int      @map("feature_id")
  kind      String   @db.VarChar(8)
  targetId  Int      @map("target_id")
  createdAt DateTime @default(now()) @map("created_at")

  feature WorkFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, kind, targetId], name: "uk_work_feature_link", map: "uk_work_feature_link")
  @@index([kind, targetId], map: "idx_work_feature_link_target")
  @@map("work_feature_links")
}

/// R6 — phần Wiegers của một thẻ REQUIREMENT: reqType BUSINESS | USER | FUNCTIONAL | QUALITY | CONSTRAINT |
/// EXTERNAL_INTERFACE | DATA; subtype = nhóm chất lượng (QUALITY) hoặc loại giao tiếp (EXTERNAL_INTERFACE);
/// lifecycle PROPOSED → APPROVED → IMPLEMENTED → VERIFIED, DELETED / REJECTED; reqVersion tăng mỗi lần sửa thuộc tính.
model WorkRequirementInfo {
  issueId    Int      @id @map("issue_id")
  projectId  Int      @map("project_id")
  reqType    String   @default("FUNCTIONAL") @map("req_type") @db.VarChar(20)
  subtype    String?  @db.VarChar(24)
  priority   String?  @db.VarChar(8)
  lifecycle  String   @default("PROPOSED") @db.VarChar(12)
  source     String?  @db.VarChar(300)
  ownerId    Int?     @map("owner_id")
  rationale  String?  @db.Text
  stability  String?  @db.VarChar(8)
  reqVersion Int      @default(1) @map("req_version")
  updatedAt  DateTime @updatedAt @map("updated_at")

  issue   WorkIssue   @relation("WorkRequirementInfoIssue", fields: [issueId], references: [id], onDelete: Cascade)
  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, reqType], map: "idx_work_requirement_info_type")
  @@map("work_requirement_info")
}

/// R12 — một dòng của bảng ưu tiên Wiegers: đích FE (WorkFeature.id) | UC (WorkUseCase.id); 4 điểm 1–9.
model WorkPriorityRow {
  id         Int      @id @default(autoincrement())
  projectId  Int      @map("project_id")
  targetKind String   @map("target_kind") @db.VarChar(8)
  targetId   Int      @map("target_id")
  benefit    Int      @default(1)
  penalty    Int      @default(1)
  cost       Int      @default(1)
  risk       Int      @default(1)
  note       String?  @db.VarChar(300)
  position   Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, targetKind, targetId], name: "uk_work_priority_row", map: "uk_work_priority_row")
  @@map("work_priority_rows")
}

/// R16 — một thuật ngữ của Glossary (aliases = cách gọi khác cần thống nhất, vd "FC", "warehouse").
model WorkGlossaryTerm {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  term        String   @db.VarChar(160)
  definition  String   @db.Text
  aliases     String[] @default([])
  source      String?  @db.VarChar(200)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, term], name: "uk_work_glossary_term", map: "uk_work_glossary_term")
  @@map("work_glossary_terms")
}

/// R16 — một phần tử của Data Dictionary (mẫu Wiegers ch.13): kind PRIMITIVE (dataType/length/values) | STRUCTURE
/// (composition "Request ID + Requester + (Vendor) + 1:10{Requested Chemical}"). isKey = định danh của cấu trúc (ERD).
model WorkDataElement {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  name        String   @db.VarChar(120)
  description String?  @db.Text
  kind        String   @default("PRIMITIVE") @db.VarChar(10)
  composition String?  @db.Text
  dataType    String?  @map("data_type") @db.VarChar(60)
  length      String?  @db.VarChar(20)
  values      String?  @db.Text
  isKey       Boolean  @default(false) @map("is_key")
  position    Int      @default(0)
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name], name: "uk_work_data_element", map: "uk_work_data_element")
  @@map("work_data_elements")
}

/// Cấu hình SWR302 của dự án: trọng số bảng ưu tiên (mặc định 1/1/1/1 như sheet Template của Wiegers), số đếm đã khai
/// trong Requirements Estimation Tool (liên kết #6), danh từ bỏ qua khi kiểm liên kết #4.
model WorkSwrSettings {
  projectId      Int      @id @map("project_id")
  weightBenefit  Float    @default(1) @map("weight_benefit")
  weightPenalty  Float    @default(1) @map("weight_penalty")
  weightCost     Float    @default(1) @map("weight_cost")
  weightRisk     Float    @default(1) @map("weight_risk")
  declaredCounts Json?    @map("declared_counts")
  ignoredNouns   String[] @default([]) @map("ignored_nouns")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("work_swr_settings")
}

// ── hết CTW đợt 4b ──

// ── CTW K-2 ── (10/10/2026) HỌP GHI ÂM → PHIÊN ÂM → AI BIÊN BẢN (rà soát K9–K14, K21). Ghi âm chỉ khi mọi người đang ở
// phòng họp CT Work đã ĐỒNG Ý (ghi lại ai/lúc nào); audio cắt đoạn ~1–2 phút, tải dần lên R2 qua backend; Groq Whisper
// phiên âm nền từng đoạn; AI viết biên bản dạng ĐỀ XUẤT, mỗi quyết định/việc phải trích được dòng transcript. Audio có
// hạn lưu (mặc định 30 ngày, theo dự án) — job dọn xoá object R2 nhưng GIỮ bản chép lời. Cột người (userId…) không FK
// tới users (như work_audit_logs): biên bản phải sống lâu hơn tài khoản. Xem src/services/work/meetingRec*.ts.

/// Cấu hình họp của dự án. `sttDailyLimit` null ⇒ env WORK_MEETING_STT_DAILY (mặc định 240 đoạn/ngày).
model WorkMeetingSettings {
  projectId          Int      @id @map("project_id")
  audioRetentionDays Int      @default(30) @map("audio_retention_days")
  sttDailyLimit      Int?     @map("stt_daily_limit")
  reminderMinutes    Int      @default(10) @map("reminder_minutes")
  remindInChat       Boolean  @default(true) @map("remind_in_chat")
  updatedAt          DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("work_meeting_settings")
}

/// Một lượt ghi âm (LIVE từ micro) hoặc một tệp tải lên (UPLOAD). status: CONSENT (đang hỏi đồng ý) → RECORDING →
/// ENDED; STOPPED = có người từ chối / dừng giữa chừng. `expiresAt` = hạn xoá audio; `audioDeletedAt` = đã xoá audio.
model WorkMeetingRecording {
  id             Int       @id @default(autoincrement())
  meetingId      Int       @map("meeting_id")
  startedById    Int?      @map("started_by_id")
  source         String    @default("LIVE") @db.VarChar(8)
  status         String    @default("CONSENT") @db.VarChar(12)
  fileName       String?   @map("file_name") @db.VarChar(255)
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")
  durationMs     Int       @default(0) @map("duration_ms")
  expiresAt      DateTime? @map("expires_at")
  audioDeletedAt DateTime? @map("audio_deleted_at")
  deletedById    Int?      @map("deleted_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  meeting  WorkMeeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  consents WorkMeetingConsent[]
  chunks   WorkMeetingChunk[]

  @@index([meetingId], name: "idx_work_meeting_rec_meeting")
  @@index([expiresAt], name: "idx_work_meeting_rec_expires")
  @@map("work_meeting_recordings")
}

/// Ai đồng ý / từ chối ghi âm, lúc nào (bằng chứng đồng ý — NĐ 13/2023).
model WorkMeetingConsent {
  id          Int      @id @default(autoincrement())
  recordingId Int      @map("recording_id")
  userId      Int      @map("user_id")
  decision    String   @db.VarChar(8)
  at          DateTime @default(now())

  recording WorkMeetingRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@unique([recordingId, userId], name: "uk_work_meeting_consent", map: "uk_work_meeting_consent")
  @@map("work_meeting_consents")
}

/// Một đoạn audio (~1–2 phút). `seq` duy nhất trong lượt ghi ⇒ gửi lại sau rớt mạng không nhân đôi. `startMs` = vị trí
/// đoạn trong lượt ghi. `segments` = [{ start, end, text, speakerId? }] (giây, tính trong đoạn). `r2Key` null = audio đã xoá.
model WorkMeetingChunk {
  id            Int       @id @default(autoincrement())
  recordingId   Int       @map("recording_id")
  seq           Int
  r2Key         String?   @map("r2_key") @db.VarChar(500)
  mime          String    @db.VarChar(100)
  size          Int
  startMs       Int       @map("start_ms")
  durationMs    Int       @map("duration_ms")
  speakerId     Int?      @map("speaker_id")
  uploaderId    Int?      @map("uploader_id")
  status        String    @default("PENDING") @db.VarChar(12)
  attempts      Int       @default(0)
  error         String?   @db.VarChar(300)
  text          String?   @db.Text
  segments      Json?
  language      String?   @db.VarChar(12)
  transcribedAt DateTime? @map("transcribed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  recording WorkMeetingRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@unique([recordingId, seq], name: "uk_work_meeting_chunk", map: "uk_work_meeting_chunk")
  @@index([status, transcribedAt], name: "idx_work_meeting_chunk_status")
  @@map("work_meeting_chunks")
}

/// Biên bản AI dạng ĐỀ XUẤT: { summary, decisions[], actions[], openIssues[] } — mỗi mục có `evidence` (id dòng
/// transcript + trích dẫn) hoặc `unsupported: true`. Chủ trì duyệt ⇒ APPLIED (đổ vào biên bản), hoặc DISMISSED.
model WorkMeetingMinutesDraft {
  id          Int       @id @default(autoincrement())
  meetingId   Int       @map("meeting_id")
  recordingId Int?      @map("recording_id")
  createdById Int?      @map("created_by_id")
  status      String    @default("PROPOSED") @db.VarChar(10)
  language    String    @default("vi") @db.VarChar(8)
  content     Json
  model       String?   @db.VarChar(80)
  decidedById Int?      @map("decided_by_id")
  decidedAt   DateTime? @map("decided_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  meeting WorkMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt], name: "idx_work_meeting_minutes_draft")
  @@map("work_meeting_minutes_drafts")
}

// ── hết CTW K-2 ──

// ── CTW K-3b ── (10/10/2026) ĐỒNG SOẠN THẢO REALTIME CHO DOCS (Hocuspocus + Yjs, khuôn của Notes) + BÌNH LUẬN GẮN
// ĐOẠN VĂN (K18 + K19/K7). Trang vẫn là nguồn sự thật cho lịch sử/xuất/tìm kiếm/RTM: gateway ghi trạng thái Yjs vào
// đây VÀ chụp lại thành work_pages.content_json + work_page_versions (xem socket/work-docs-collaboration.gateway.ts).

/// Trạng thái CRDT (Yjs) của một trang Docs. `contentHash` = băm nội dung trang lúc gateway ghi lần cuối — trang bị sửa
/// NGOÀI phiên cộng tác (script, seed, collab đang tắt) thì lần mở sau khớp lại theo kiểu diff, không mất lịch sử Yjs.
/// `clientUsers` = { clientID Yjs: userId } do MÁY CHỦ ghi (tác giả theo đoạn, không tin client). `disabled` = công tắc
/// theo trang (công tắc theo dự án nằm ở work_projects.settings.collab.enabled).
model WorkPageCollab {
  pageId         Int       @id @map("page_id")
  state          Bytes?
  stateVector    Bytes?    @map("state_vector")
  byteSize       Int       @default(0) @map("byte_size")
  updateCount    Int       @default(0) @map("update_count")
  contentHash    String?   @map("content_hash") @db.VarChar(64)
  clientUsers    Json?     @map("client_users")
  disabled       Boolean   @default(false)
  lastSnapshotAt DateTime? @map("last_snapshot_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  page WorkPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("work_page_collab")
}

/// Bình luận GẮN ĐOẠN VĂN (K19/K7): bình luận gốc (work_page_comments) + mark TipTap `commentAnchor{id}` trong nội dung.
/// Trả lời đi theo luồng sẵn có (parentId). Resolve ẩn tô sáng nhưng giữ mark (mở lại được).
model WorkPageAnchor {
  id           Int       @id @default(autoincrement())
  pageId       Int       @map("page_id")
  commentId    Int       @unique @map("comment_id")
  anchorId     String    @map("anchor_id") @db.VarChar(40)
  quote        String    @db.VarChar(500)
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById Int?      @map("resolved_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  page    WorkPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  comment WorkPageComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([pageId, anchorId], name: "uk_work_page_anchor", map: "uk_work_page_anchor")
  @@map("work_page_anchors")
}

// ── hết CTW K-3b ──
