  TEXT

  @@map("lang_reading_type")
}

enum LangItemType {
  VOCAB
  ALPHABET
  GRAMMAR
  LISTENING
  CONVERSATION
  READING
  QNA

  @@map("lang_item_type")
}

enum LangLearnStatus {
