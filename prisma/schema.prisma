// ============================================================
// CuongHoangDev API - Prisma Schema
// Source of truth for the Node.js backend runtime.
// Database: PostgreSQL with pgvector extension
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. USERS & AUTHENTICATION
// ============================================================

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique(map: "roles_name_key") @db.VarChar(50)

  users UserRole[]

  @@map("roles")
}

model User {
  id               Int       @id @default(autoincrement())
  username         String    @unique(map: "uk_user_username") @db.VarChar(50)
  password         String?   @db.VarChar(255)
  email            String    @unique(map: "uk_user_email") @db.VarChar(100)
  fullName         String?   @map("full_name") @db.VarChar(100)
  bio              String?   @db.Text
  avatarUrl        String?   @map("avatar_url") @db.VarChar(500)
  coverPhotoUrl    String?   @map("cover_photo_url") @db.VarChar(500)
  lastActiveAt     DateTime? @map("last_active_at")
  /// Cho người khác thấy mình đang hoạt động / hoạt động lúc nào.
  ///
  /// Tắt thì phải chặn CẢ HAI đường, không chỉ giấu dòng chữ:
  ///   · `peer.lastActiveAt` trả `null` (không có mốc để tính "N phút trước")
  ///   · socket KHÔNG phát `presence:update` cho mình nữa (không có chấm xanh)
  /// Giấu một đường thôi thì trạng thái vẫn rò qua đường kia.
  ///
  /// Mặc định `true` — đúng với hành vi đang chạy, nên bật cờ này không làm
  /// đổi trải nghiệm của ai cho tới khi họ tự tắt.
  showActiveStatus Boolean   @default(true) @map("show_active_status")

  // ─── Extended profile (Phase 1) ─────────────────────────
  // displayName: tên hiển thị (có thể khác username, dùng cho UI
  // trên header feed). Null → fallback về fullName → username.
  displayName        String?      @map("display_name") @db.VarChar(100)
  // gender: 'MALE' | 'FEMALE' | 'OTHER' | null (tuỳ chọn).
  gender             String?      @db.VarChar(20)
  // birthYear: năm sinh 4 chữ số (1900..currentYear). Null nếu user
  // không muốn tiết lộ. Lưu riêng năm (không phải full DOB) để
  // giảm thiểu PII và dễ tính tuổi trên feed.
  birthYear          Int?         @map("birth_year")
  // phone: optional, không bắt buộc (giữ nguyên pattern 10-15 số
  // quốc tế). Không dùng cho 2FA trong phase này.
  phone              String?      @db.VarChar(20)
  // socialLinks: JSON map { github?, twitter?, linkedin?, website?, youtube?, facebook? }
  // — schema-free, mỗi frontend tự định nghĩa key khi đọc.
  socialLinks        Json?        @map("social_links")
  // Phase 3 add — back-relation for the new SocialLink model.
  // Kept separate from the legacy JSON column above so we don't
  // break existing data; the mobile route uses this relation.
  socialLinkProfiles SocialLink[]

  enabled               Boolean @default(true)
  accountNonExpired     Boolean @default(true) @map("account_non_expired")
  accountNonLocked      Boolean @default(true) @map("account_non_locked")
  credentialsNonExpired Boolean @default(true) @map("credentials_non_expired")

  // Per-user access to the /music page, used when the global music
  // access mode (AppSetting "music_access_mode") is SPECIFIC. Admins
  // always have access regardless of this flag.
  musicAccess Boolean @default(false) @map("music_access")

  // ─── Pro membership (unlocks music page, AI chat Pro/Max, Interview AI
  //     grading, full Academy). Admins are always effectively Pro regardless.
  //     `proExpiresAt` null while isPro=true means a LIFETIME membership. ─────
  isPro        Boolean   @default(false) @map("is_pro")
  proSince     DateTime? @map("pro_since")
  proExpiresAt DateTime? @map("pro_expires_at")
  proSource    String?   @map("pro_source") @db.VarChar(20) // CODE | ADMIN

  // ─── Account security (Giai đoạn 1 — bảo mật cao) ────────────────────
  // Email verification
  emailVerified   Boolean   @default(false) @map("email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")

  // Account lockout (sau 5 lần nhập sai → khoá 15 phút)
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockoutUntil      DateTime? @map("lockout_until")
  lastFailedLoginAt DateTime? @map("last_failed_login_at")

  // Login tracking (phát hiện thiết bị lạ)
  lastLoginAt        DateTime? @map("last_login_at")
  lastLoginIp        String?   @map("last_login_ip") @db.VarChar(64)
  lastLoginUserAgent String?   @map("last_login_user_agent") @db.VarChar(500)

  // ─── MFA (TOTP) cho admin — kiểu STEP-UP (04/10/2026) ────────────────
  // Đăng nhập không đổi; token chỉ mang claim `mfaAt` sau khi nhập đúng mã,
  // và `requireAdmin` đòi claim đó khi `mfaEnabled`. Xem src/services/mfa/.
  // mfaSecret: secret base32 đã MÃ HOÁ (AES-256-GCM, AAD = userId) — không
  //   bao giờ lưu dạng rõ. Có giá trị mà mfaEnabled=false = đang thiết lập dở.
  // mfaRecoveryCodes: HMAC-SHA256 (+ tiêu ngoài CSDL) của 10 mã khôi phục;
  //   dùng mã nào thì xoá đúng phần tử đó (array_remove) ⇒ mỗi mã một lần.
  // mfaLastUsedStep: bước TOTP (30s) của mã gần nhất được chấp nhận — chặn
  //   dùng lại cùng một mã trong cửa sổ ±1.
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaSecret        String?   @map("mfa_secret") @db.Text
  mfaRecoveryCodes String[]  @default([]) @map("mfa_recovery_codes")
  mfaEnabledAt     DateTime? @map("mfa_enabled_at")
  mfaLastUsedStep  Int?      @map("mfa_last_used_step")
  // Theme preference: dark or light
  theme            String?   @default("dark") @map("theme") @db.VarChar(10)
  // Cross-device settings blob (added 2026-08-08). Everything the user
  // configures in /settings that isn't already its own column lives here:
  //   { sound: { masterEnabled, volume, enabled: {kind: bool} },
  //     ui:    { locale, reduceMotion },
  //     notify:{ types: {NEW_REACTION: bool, ...}, browserPush } }
  // JSON (not columns) because the shape grows every time a new
  // notification kind or toggle is added — a column per toggle would
  // mean a migration per toggle. Null = "never touched, use defaults".
  // The uploaded MP3 blobs stay in the browser's IndexedDB; only the
  // names/toggles round-trip here.
  preferences      Json?     @map("preferences")

  provider   String? @db.VarChar(50)
  providerId String? @map("provider_id") @db.VarChar(255)

  roleVersion BigInt @default(0) @map("role_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles                   UserRole[]
  posts                   Post[]                   @relation("PostAuthor")
  courses                 Course[]                 @relation("CourseInstructor")
  enrollments             Enrollment[]
  certificates            Certificate[]
  musicPlaylists          MusicPlaylist[]
  // Cyber-music Phase 1: per-user play queue (idempotent upsert).
  musicQueueItems         MusicQueueItem[]
  // Cyber-music Phase 2a: per-user likes + play counts (additive).
  musicLikes              MusicLike[]
  musicPlayCounts         MusicPlayCount[]
  fileAttachments         FileAttachment[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  blogComments            Comment[]
  devPostComments         PostComment[]
  examQuestionComments    ExamQuestionComment[]
  courseReviews           CourseReview[]
  productReviews          ProductReview[]
  shopOrders              ShopOrder[]
  courseOrders            CourseOrder[]
  refundedCourseOrders    CourseOrder[]            @relation("CourseOrderRefunder")
  chatSessions            ChatSession[]
  chatFolders             ChatFolder[]
  chatFeedback            ChatFeedback[]
  assignmentSubmissions   AssignmentSubmission[]
  aiConfigUpdates         AiConfig[]               @relation("AiConfigUpdater")
  musicHistories          MusicHistory[]
  socialPosts             SocialPost[]
  socialLikes             SocialLike[]
  socialComments          SocialComment[]
  socialCommentLikes      SocialCommentLike[]
  socialSaves             SocialSave[]
  socialShares            SocialShare[]
  // Saved Collections (multi-folder bookmark system). The
  // relation `feedCollections` is the list of collections
  // the user OWNS. The relation `feedSavedPosts` is the
  // junction table that stores which posts they've saved
  // into which collections.
  feedCollections         FeedCollection[]         @relation("FeedCollectionOwner")
  feedSavedPosts          FeedSavedPost[]
  // Stories (Phase 6)
  stories                 Story[]
  storyHighlights         StoryHighlight[]
  storyViews              StoryView[]
  storyHides              StoryHide[]
  deviceTokens            DeviceToken[]
  classSchedules          ClassSchedule[]
  classAttendances        ClassAttendance[]
  lessonTutorAsks         LessonTutorAsk[]
  codeExerciseTutorAsks   CodeExerciseTutorAsk[]
  hocKy                   HocKy[]
  lichThi                 LichThi[]
  monHocKy                MonHocKy[]
  nhiemVuHoc              NhiemVuHoc[]
  bangChungHoc            BangChungHoc[]
  ruiRoHocNgay            RuiRoHocNgay[]

  // Notification graph — who is the receiver / sender on social
  // notifications. The reverse relations are defined on
  // SocialNotification above.
  socialNotificationsReceived SocialNotification[]   @relation("NotificationsReceived")
  socialNotificationsSent     SocialNotification[]   @relation("NotificationsSent")
  socialPollVotes             SocialPollVote[]
  techTrendArticles           TechTrendArticle[]     @relation("TechTrendAuthor")
  techTrendComments           TechTrendComment[]
  techTrendCommentLikes       TechTrendCommentLike[]
  advisorComments             AdvisorComment[]
  advisorCommentLikes         AdvisorCommentLike[]
  advisorCommentReports       AdvisorCommentReport[]
  gamePlays                   GamePlay[]
  announcements               Announcement[]         @relation("AnnouncementAuthor")

  cyberProfile   CyberProfile?
  cyberTasks     CyberTask[]
  cyberInventory CyberInventory?
  discountCodes  DiscountCode[]
  savedCodes     UserSavedCode[]

  // ─── Direct messaging (Phase 6) ─────────────────────────
  // Per-user flag controlling whether strangers (users with no
  // prior interaction) can start a new conversation. Default on;
  // users can flip it off in /profile settings. Admins and users
  // the viewer has already exchanged messages with bypass this
  // check — the flag only gates the very first contact.
  allowMessagesFromStrangers Boolean @default(true) @map("allow_messages_from_strangers")

  messageThreadsAsUser  MessageThread[]   @relation("ThreadAsUser")
  messageThreadsAsAdmin MessageThread[]   @relation("ThreadAsAdmin")
  messageThreadsAsUserA MessageThread[]   @relation("ThreadUserA")
  messageThreadsAsUserB MessageThread[]   @relation("ThreadUserB")
  messagesSent          Message[]         @relation("MessageSender")
  messageReads          MessageRead[]     @relation("MessageReadUser")
  nicknamesOwned        ThreadNickname[]  @relation("NicknameOwner")
  nicknamesTargeted     ThreadNickname[]  @relation("NicknameTarget")
  reactions             MessageReaction[] @relation("ReactionUser")
  blocksCreated         UserBlock[]       @relation("UserBlocksCreated")
  blocksReceived        UserBlock[]       @relation("UserBlocksReceived")
  reportsFiled          ThreadReport[]    @relation("ThreadReportsFiled")
  reportsResolved       ThreadReport[]    @relation("ThreadReportsResolved")

  // ─── Personal dashboard (per-user, never deleted) ────────
  // Each user owns exactly one DashboardState row. The 1:N
  // dashboardTasks relation stores both active and archived
  // (soft-deleted) tasks — see DashboardTask.archivedAt below.
  // We persist state on the server (instead of just localStorage)
  // so the dashboard follows the user across devices, survives
  // cache clears, and is recoverable from the DB if the client
  // gets wiped. Server is the source of truth; the client still
  // keeps a localStorage mirror for offline-first behavior.
  dashboardState        DashboardState?
  dashboardTasks        DashboardTask[]
  dashboardCelebrations DashboardCelebration[]
  dashboardUyTinLog     DashboardUyTinLog[]

  // ─── Personal Hub — bookmark manager (Phase 7) ─────
  // User-owned folders + links. Every row is scoped by userId;
  // all routes put `userId` in their WHERE clause to prevent
  // cross-tenant reads. Cascade on delete so removing a user
  // takes their Hub data with it (no orphans).
  hubFolders          HubFolder[]
  hubLinks            HubLink[]
  hubFiles            HubFile[]
  langNotebookFolders LangNotebookFolder[] @relation("UserLangNotebookFolders")
  langNotebookEntries LangNotebookEntry[]  @relation("UserLangNotebookEntries")
  // Hub user-sharing (Phase 2): the rows where this user is
  // the owner (gave access) or the recipient (got access). Two
  // named relations because Prisma requires a unique name per
  // FK even when the target model is the same.
  hubSharesOwned      HubShare[]           @relation("HubShareOwner")
  hubSharesReceived   HubShare[]           @relation("HubShareRecipient")

  // ─── Voice Hub (admin creator channel — vlog/reaction/code-exp/podcast) ─
  voicePosts        VoicePost[]        @relation("VoicePostAuthor")
  voiceComments     VoiceComment[]
  voiceCommentLikes VoiceCommentLike[]
  voiceLikes        VoiceLike[]

  // ─── Orphaned upload cleanup (Phase 7) ─────────────────────────
  // PendingUpload rows track video uploads that have been started
  // but not yet linked to a post. Cron job cleans up expired rows.
  pendingUploads PendingUpload[]

  // Phase 4 add — Music Post. Admin uploads mp3 / m4a tracks
  // to R2 and tags them with a title + artist + cover. Users
  // pick one of these from the composer and clip a 1-second-
  // resolution snippet (< 40s) onto their post. We use Restrict
  // (not Cascade) on uploader so deleting the original admin
  // doesn't silently wipe every post that referenced the track.
  songsUploaded Song[]       @relation("SongUploader")
  // Phase 4 add — extended profile (bio, cover photo, location,
  // education, work, links). Optional 1-1 with user so legacy
  // rows keep working — defaults fill in on the next read.
  profile       UserProfile?

  // ─── Notes — personal study notebooks ──────────────────

  // ─── Notes — personal study notebooks ──────────────────
  // User-owned subjects → chapters → notes (+ attachments,
  // links, vocab). Same per-user scoping rule as Hub: every
  // row carries userId and every query filters on it. Cascade
  // on delete so removing a user removes their notes.
  noteSubjects               NoteSubject[]
  noteChapters               NoteChapter[]
  notes                      Note[]
  noteAttachments            NoteAttachment[]
  noteLinks                  NoteLink[]
  noteVocabEntries           NoteVocabEntry[]
  noteVersions               NoteVersion[]
  noteCommentsAuthored       NoteComment[]               @relation("NoteCommentAuthor")
  noteCommentsResolved       NoteComment[]               @relation("NoteCommentResolver")
  noteCommentMentions        NoteCommentMention[]
  noteDatabases              NoteDatabase[]
  noteSyncedBlocks           NoteSyncedBlock[]
  noteDatabaseRowsCreated    NoteDatabaseRow[]           @relation("NoteDatabaseRowCreator")
  noteDatabaseRowsUpdated    NoteDatabaseRow[]           @relation("NoteDatabaseRowUpdater")
  // Phase 4 add — notes subject sharing
  noteSubjectsOwned          NoteSubjectShare[]          @relation("NoteSubjectSharesOwned")
  noteSubjectsReceived       NoteSubjectShare[]          @relation("NoteSubjectSharesReceived")
  noteSubjectShareRecipients NoteSubjectShareRecipient[] @relation("UserShareRecipients")

  // ─── Social Follow Graph ────────────────────────────────
  following         Follow[]           @relation("Following")
  followers         Follow[]           @relation("Followers")
  // Phase 3: Post actions back-relations
  postFeedbacks     PostFeedback[]
  postNotifications PostNotification[]
  postReports       PostReport[]       @relation("PostReports")
  snoozesGiven      UserSnooze[]       @relation("Snoozer")
  snoozesReceived   UserSnooze[]       @relation("SnoozedBy")
  postArchives      PostArchive[]

  // ─── Friend Graph (two-way, FB-style requests) ──────────
  // Additive alongside the follow graph above. `friendshipsSent`
  // are rows where this user is the requester; `friendshipsReceived`
  // are rows where this user is the addressee (the one who
  // accepts/declines). See model Friendship below.
  friendshipsSent     Friendship[] @relation("FriendshipsSent")
  friendshipsReceived Friendship[] @relation("FriendshipsReceived")

  // Sticker packs this user (an admin) created.
  stickerPacksCreated StickerPack[] @relation("StickerPacksCreated")

  // ─── EXP_Hub — Snippet Library ──────────────────────────────
  // Snippets authored by this user
  snippets                Snippet[]
  // Bookmarks saved by this user (authenticated)
  snippetBookmarks        SnippetBookmark[]
  // Upvotes by this user (authenticated)
  snippetUpvotes          SnippetUpvote[]
  // Comments on snippets
  snippetComments         SnippetComment[]
  // Webhooks configured by this user
  snippetWebhooks         SnippetWebhook[]
  SnippetVersion          SnippetVersion[]
  // Emoji reactions on snippets / snippet comments
  snippetReactions        SnippetReaction[]
  snippetCommentReactions SnippetCommentReaction[]

  // ─── Code Lab — authored exercises + personal practice progress ──
  codeExercises CodeExercise[]
  codeProgress  CodeProgress[]
  // Phòng Lab: một phòng luyện có mục tiêu LOC, do chính người dùng lập.
  labRooms      CodeLabRoom[]

  // ─── My Language — learning progress (per-user, SRS) ─────────
  // Additive. Every row is scoped by userId; SM-2 spaced repetition
  // progress + quiz history live here. See models at end of file.
  languageProgress     LangUserProgress[]
  languageQuizzes      LangQuizResult[]
  langVocabFavorites   LangVocabFavorite[]
  langVocabCollections LangVocabCollection[]
  langRoadmapDone      LangRoadmapDone[]
  langGameStates       LangGameState[]
  langLessonProgress   LangLessonProgress[]
  roadmapDone          RoadmapDone[]

  // ─── Maker Lab — hardware/embedded projects & physical devices ───
  // A device is a real board (robot, sensor node) owned by this user;
  // commands are the control actions this user issued to any device.
  makerDevices  MakerDevice[]
  makerPlans    MakerPlan[]    @relation("MakerPlanOwner")
  makerCommands MakerCommand[]

  // ─── Account erasure requests (added 2026-08-08) ─────────────────
  // Two distinct relations to the same model, so each needs its own
  // @relation name: rows this user FILED, and rows this user REVIEWED
  // as an admin.
  deletionRequests AccountDeletionRequest[] @relation("DeletionRequester")
  deletionReviews  AccountDeletionRequest[] @relation("DeletionReviewer")

  // ─── Ví điểm · gói Pro trả phí (13/09/2026) ──────────────────────
  // pointAccount là 1-1 (một ví cho mỗi người, tạo lười); phần còn lại
  // là lịch sử. Xem mục 30 cuối file.
  pointAccount       PointAccount?
  pointTransactions  PointTransaction[]
  topupOrders        TopupOrder[]
  proOrders          ProOrder[]
  keyReplacements    KeyReplacementRequest[]
  llmKeyRequests     LlmKeyRequest[]
  fableQuotaRequests FableQuotaRequest[]
  /// Các lần nhập KEY GIA HẠN hạn mức AI Code (02/10/2026).
  agentQuotaGrants   AgentQuotaGrant[]
  /// Video người dùng tự thêm vào màn "Học bằng video".
  videoTuThem        VideoNguoiDung[]        @relation("VideoNguoiDungChuSoHuu")
  videoYeuThich      VideoYeuThich[]         @relation("VideoYeuThichChuSoHuu")

  // ─── CT Work — quản lý dự án kiểu Jira (23/09/2026) ─────────────
  // Xem mục "CT WORK" cuối file và docs/work-hub-plan.md.
  workSpacesOwned        WorkSpace[]             @relation("WorkSpaceOwner")
  workMemberships        WorkMember[]            @relation("WorkMemberUser")
  workInvitesSent        WorkInvite[]            @relation("WorkInviteSender")
  workProjectMemberships WorkProjectMember[]     @relation("WorkProjectMemberUser")
  workProjectsLed        WorkProject[]           @relation("WorkProjectLead")
  workIssuesAssigned     WorkIssue[]             @relation("WorkIssueAssignee")
  workIssuesReported     WorkIssue[]             @relation("WorkIssueReporter")
  workComments           WorkComment[]           @relation("WorkCommentAuthor")
  workCommentReactions   WorkCommentReaction[]   @relation("WorkCommentReactionUser")
  // ── CTW K-3 ── kênh chat dự án
  workChannelsCreated    WorkChannel[]           @relation("WorkChannelCreator")
  workChannelMembers     WorkChannelMember[]     @relation("WorkChannelMemberUser")
  workChannelMessages    WorkChannelMessage[]    @relation("WorkChannelMessageAuthor")
  workChannelReactions   WorkChannelReaction[]   @relation("WorkChannelReactionUser")
  workChannelFiles       WorkChannelFile[]       @relation("WorkChannelFileUploader")
  workChatPref           WorkChatPref?           @relation("WorkChatPrefUser")
  // ── hết CTW K-3 ──
  // ── CTW Đóng góp ── đánh giá chéo + danh tính git
  workPeerGiven          WorkPeerReview[]        @relation("WorkPeerReviewer")
  workPeerReceived       WorkPeerReview[]        @relation("WorkPeerReviewee")
  workGitIdentities      WorkGitIdentity[]       @relation("WorkGitIdentityUser")
  // ── hết CTW Đóng góp ──
  // ── CTW đợt 5 ── lớp học + rubric của giảng viên
  workClassesOwned       WorkClass[]             @relation("WorkClassOwner")
  workClassesTaught      WorkClass[]             @relation("WorkClassTeacher")
  workClassSeats         WorkClassStudent[]      @relation("WorkClassStudentUser")
  workRubrics            WorkRubric[]            @relation("WorkRubricOwner")
  // ── hết CTW đợt 5 ──
  workAttachments        WorkAttachment[]        @relation("WorkAttachmentUploader")
  workHistory            WorkHistory[]           @relation("WorkHistoryActor")
  workWatching           WorkWatcher[]           @relation("WorkWatcherUser")
  workTestRunsAssigned   WorkTestRun[]           @relation("WorkTestRunAssignee")
  workTestRunsExecuted   WorkTestRun[]           @relation("WorkTestRunExecutor")
  workSavedFilters       WorkSavedFilter[]       @relation("WorkSavedFilterOwner")
  workDashboards         WorkDashboard[]         @relation("WorkDashboardOwner")
  workTimeOff            WorkTimeOff[]           @relation("WorkTimeOffUser")
  workWorklogs           WorkWorklog[]           @relation("WorkWorklogUser")
  workNotifySetting      WorkNotifySetting?      @relation("WorkNotifySettingUser")
  workEmailQueue         WorkEmailQueue[]        @relation("WorkEmailQueueUser")
  workApiTokens          WorkApiToken[]          @relation("WorkApiTokenUser")
  workAiThreads          WorkAiThread[]          @relation("WorkAiThreadCreator")
  workAiMessages         WorkAiMessage[]         @relation("WorkAiMessageAuthor")
  workEditLocks          WorkEditLock[]
  // Lớp studio (04/10/2026): bộ phận, phê duyệt, bàn giao.
  workTeamMemberships    WorkTeamMember[]        @relation("WorkTeamMemberUser")
  workApprovalsCreated   WorkApproval[]          @relation("WorkApprovalCreator")
  workApprovalSteps      WorkApprovalStep[]      @relation("WorkApprovalStepApprover")
  workHandoffsFrom       WorkHandoff[]           @relation("WorkHandoffFromUser")
  workHandoffsTo         WorkHandoff[]           @relation("WorkHandoffToUser")
  workHandoffsCreated    WorkHandoff[]           @relation("WorkHandoffCreator")
  // Tài liệu dự án (đợt S2a, 04/10/2026)
  workPagesOwned         WorkPage[]              @relation("WorkPageOwner")
  workPagesEdited        WorkPage[]              @relation("WorkPageEditor")
  workPageVersions       WorkPageVersion[]       @relation("WorkPageVersionAuthor")
  workPageComments       WorkPageComment[]       @relation("WorkPageCommentAuthor")
  workPageIssueLinks     WorkPageIssueLink[]     @relation("WorkPageIssueLinkCreator")
  // Quản trị dự án (đợt S3b, 04/10/2026): CR · RAID · họp
  workCrRequested        WorkChangeRequest[]     @relation("WorkCrRequester")
  workCrOwned            WorkChangeRequest[]     @relation("WorkCrOwner")
  workCrCreated          WorkChangeRequest[]     @relation("WorkCrCreator")
  workCrLinksCreated     WorkChangeRequestLink[] @relation("WorkCrLinkCreator")
  workRaidOwned          WorkRaidItem[]          @relation("WorkRaidOwner")
  workRaidCreated        WorkRaidItem[]          @relation("WorkRaidCreator")
  workRaidLinksCreated   WorkRaidLink[]          @relation("WorkRaidLinkCreator")
  workRaidHistory        WorkRaidHistory[]       @relation("WorkRaidHistoryActor")
  workMeetingsOrganized  WorkMeeting[]           @relation("WorkMeetingOrganizer")
  workMeetingInvites     WorkMeetingAttendee[]   @relation("WorkMeetingAttendeeUser")
  workMeetingActions     WorkMeetingAction[]     @relation("WorkMeetingActionAssignee")
  /// CTW-28 (06/10/2026): HUMAN (mặc định) | AGENT — agent KHÔNG đăng nhập (login/JWT ⇒ 403 AGENT_NO_LOGIN),
  /// chỉ xác thực bằng token ctw_ gắn agent. Hồ sơ agent ở WorkAgent (1:1). Xem docs/ct-work-ai-agents-thiet-ke.md.
  kind                   String                  @default("HUMAN") @db.VarChar(8)
  workAgent              WorkAgent?              @relation("WorkAgentUser")
  workAgentsOwned        WorkAgent[]             @relation("WorkAgentOwner")
  // CRM nhẹ của studio (đợt S5b, 05/10/2026) — /admin/crm
  crmDealsOwned          CrmDeal[]               @relation("CrmDealOwner")

  @@index([email], name: "idx_users_email")
  @@map("users")
}

/// Account erasure request (Nghị định 13/2023 — quyền xoá dữ liệu).
///
/// Erasure is no longer self-service: the user FILES a request and an
/// admin approves it before `anonymizeAccount()` runs. Rationale — the
/// anonymisation is irreversible (it nulls the password, rotates the
/// email/username and bumps roleVersion), so a misclick or a hijacked
/// session used to be able to destroy an account with no recourse.
///
/// One PENDING row per user at a time; the partial-unique behaviour is
/// enforced in the service layer (Postgres partial indexes aren't
/// expressible in the Prisma schema) — see accountDeletion.service.ts.
model AccountDeletionRequest {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  /// Why the user wants out. Optional, shown to the reviewing admin.
  reason String? @db.VarChar(500)

  /// PENDING → APPROVED (account anonymised) | REJECTED | CANCELLED
  /// (withdrawn by the user before review).
  status String @default("PENDING") @db.VarChar(20)

  /// Snapshot of the identity at request time. After APPROVED the user
  /// row is anonymised, so without this the admin log would lose all
  /// trace of WHOSE account was erased.
  usernameAtRequest String? @map("username_at_request") @db.VarChar(50)
  emailAtRequest    String? @map("email_at_request") @db.VarChar(100)

  /// Admin decision trail.
  reviewedById Int?      @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  adminNote    String?   @map("admin_note") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User  @relation("DeletionRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("DeletionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId], name: "idx_deletion_req_user")
  @@index([status], name: "idx_deletion_req_status")
  @@map("account_deletion_requests")
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId], map: "pk_user_roles")
  @@map("user_roles")
}

// Generic site-wide key/value settings. Currently holds
// "music_access_mode" (ADMIN_ONLY | SPECIFIC | EVERYONE) governing
// who can see the /music page. Reusable for future global toggles.
model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String?  @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ─── Pro membership codes (global entitlement, unlike per-course CourseCode) ──
// An admin creates a ProCode with an optional duration (null = lifetime) and a
// use cap; a user redeems it to become Pro. Mirrors the CourseCode redeem
// pattern but grants an account-wide flag instead of a per-course enrollment.
model ProCode {
  id           Int             @id @default(autoincrement())
  code         String          @unique @db.VarChar(40)
  label        String?         @db.VarChar(120)
  durationDays Int?            @map("duration_days") // null = lifetime
  maxUses      Int             @default(1) @map("max_uses")
  usedCount    Int             @default(0) @map("used_count")
  isActive     Boolean         @default(true) @map("is_active")
  expiresAt    DateTime?       @map("expires_at") // the code's own validity window
  note         String?         @db.VarChar(255)
  createdBy    Int?            @map("created_by") // admin userId (no FK, matches interview convention)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  redemptions  ProRedemption[]

  @@map("pro_codes")
}

model ProRedemption {
  id          Int      @id @default(autoincrement())
  proCodeId   Int      @map("pro_code_id")
  userId      Int      @map("user_id") // no FK (matches interview convention)
  grantedDays Int?     @map("granted_days") // snapshot; null = lifetime
  createdAt   DateTime @default(now()) @map("created_at")
  proCode     ProCode  @relation(fields: [proCodeId], references: [id], onDelete: Cascade)

  @@unique([proCodeId, userId], name: "uk_pro_redemption")
  @@map("pro_redemptions")
}

