{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "cuong": {
      "npm": "@ai-sdk/anthropic",
      "name": "Cổng Cường (rambo)",
      "options": {
        "baseURL": "https://api.cuongthai.com/llm/v1",
        "apiKey": "{env:CUONG_LLM_KEY}"
      },
      "models": {
        "claude-sonnet-5": { "name": "Claude Sonnet 5", "limit": { "context": 180000, "output": 32000 } },
        "claude-sonnet-4-6": { "name": "Claude Sonnet 4.6", "limit": { "context": 180000, "output": 32000 } },
        "claude-opus-4-8": { "name": "Claude Opus 4.8", "limit": { "context": 180000, "output": 32000 } },
        "claude-opus-4-7": { "name": "Claude Opus 4.7", "limit": { "context": 180000, "output": 32000 } },
        "claude-opus-4-6": { "name": "Claude Opus 4.6", "limit": { "context": 180000, "output": 32000 } },
        "claude-haiku-4-5": { "name": "Claude Haiku 4.5", "limit": { "context": 180000, "output": 32000 } }
      }
    }
  },
  "model": "cuong/claude-sonnet-5"
}
